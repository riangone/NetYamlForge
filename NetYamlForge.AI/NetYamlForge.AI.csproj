<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core NuGet Dependencies -->
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Stateless" Version="5.20.1" />
    <PackageReference Include="PDFsharp" Version="7.0.0-preview-1" />
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="MimeKit" Version="4.15.1" />
    
    <!-- ASP.NET Core & SignalR -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    
    <!-- Microsoft Extensions (explicit packages for configuration binding) -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    
    <!-- HTTP Client for external API calls -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    
    <!-- JSON Schema Validation -->
    <PackageReference Include="JsonSchema.Net" Version="8.0.0" />
  </ItemGroup>

</Project>
