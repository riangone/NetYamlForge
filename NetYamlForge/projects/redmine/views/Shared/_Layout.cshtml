@* Redmine風プロジェクト固有レイアウト
   赤いトップナビ＋プロジェクトタブバーを持つ Redmine スタイルのレイアウトです。
   グローバルレイアウト（Views/Shared/_Layout.cshtml）の代わりに使用されます。 *@

@using NetYamlForge.Localization
@using NetYamlForge.Models
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject NetYamlForge.Services.IEntityMetadataProvider EntityMetadataProvider
@inject NetYamlForge.Services.ProjectScope ProjectScope

@{
    var currentProject = Context.GetRouteValue("project")?.ToString() ?? "redmine";
    var isAdminUser    = User?.IsInRole("Admin") ?? false;
    var currentCtrl    = Context.GetRouteValue("controller")?.ToString() ?? "";
    var currentEntity  = Context.Request.Query["entity"].ToString() ?? "";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Redmine Clone</title>
    <script type="importmap"></script>
    <link href="/lib/daisyui/daisyui.min.css" rel="stylesheet" type="text/css" />
    <script src="/lib/tailwindcss/browser.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Redmine カラーテーマ */
        :root {
            --rm-red: #c02020;
            --rm-red-dark: #a01010;
            --rm-nav-bg: #628DB6;
            --rm-nav-hover: #4a7a9e;
        }
        .rm-header {
            background: var(--rm-red);
        }
        .rm-header a, .rm-header .rm-logo {
            color: white;
        }
        .rm-header a:hover {
            color: #ffe0e0;
        }
        .rm-tabs {
            background: var(--rm-nav-bg);
        }
        .rm-tab-link {
            color: white;
            padding: 6px 12px;
            display: inline-block;
            font-size: 13px;
            border-bottom: 3px solid transparent;
            transition: background 0.15s;
        }
        .rm-tab-link:hover {
            background: var(--rm-nav-hover);
        }
        .rm-tab-link.active {
            background: var(--rm-nav-hover);
            border-bottom-color: white;
            font-weight: 600;
        }
        .rm-content {
            background: #fff;
            min-height: calc(100vh - 120px);
        }
        body {
            background: #e8e8e8;
            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
            font-size: 13px;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@* ═══════════════════════════════════════════
     TOP HEADER (Redmine 赤いヘッダーバー)
   ═══════════════════════════════════════════ *@
<div class="rm-header px-4 py-2 flex items-center justify-between">
    <div class="flex items-center gap-6">
        <a href="/@currentProject/Dashboard/Index" class="rm-logo text-xl font-bold tracking-wide">
            🔴 Redmine
        </a>
        <nav class="hidden sm:flex items-center gap-1 text-sm">
            <a href="/@currentProject/Dashboard/Index" class="rm-header px-3 py-1 rounded hover:bg-red-800">
                ホーム
            </a>
            <a href="/@currentProject/DynamicEntity/Index?entity=issue" class="rm-header px-3 py-1 rounded hover:bg-red-800">
                マイチケット
            </a>
        </nav>
    </div>

    <div class="flex items-center gap-3 text-sm text-white">
        @* 言語切替 *@
        <div class="flex gap-1 text-xs">
            @foreach (var (culture, label) in new[] { ("ja-JP","JA"), ("zh-CN","中文"), ("en-US","EN") })
            {
                var isCurrent = System.Globalization.CultureInfo.CurrentUICulture.Name == culture;
                <form asp-controller="Localization" asp-action="SetLanguage" method="post" style="display:inline">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <input type="hidden" name="culture" value="@culture" />
                    <button type="submit"
                            style="padding:2px 7px;border-radius:4px;border:1px solid rgba(255,255,255,0.4);color:white;background:@(isCurrent ? "rgba(255,255,255,0.25)" : "transparent");font-weight:@(isCurrent ? "700" : "400");cursor:pointer">
                        @label
                    </button>
                </form>
            }
        </div>

        @* ユーザーメニュー *@
        @if (isAuthenticated)
        {
            <div class="dropdown dropdown-end">
                <div tabindex="0" role="button" class="cursor-pointer hover:text-red-200 flex items-center gap-1">
                    <span class="text-xs">👤</span>
                    <span>@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name)</span>
                    <span class="text-xs">▾</span>
                </div>
                <ul tabindex="0" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-2 w-48 p-2 shadow text-base-content">
                    @if (isAdminUser)
                    {
                        <li><a asp-controller="Users" asp-action="Index" asp-route-project="@currentProject">ユーザー管理</a></li>
                        <li><a asp-controller="DynamicEntity" asp-action="ConfigDiagnostics" asp-route-project="@currentProject">設定診断</a></li>
                        <li class="divider my-1"></li>
                    }
                    <li>
                        <form asp-controller="Account" asp-action="Logout" asp-route-project="@currentProject" method="post">
                            <button type="submit" class="text-left w-full">ログアウト</button>
                        </form>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" asp-route-project="@currentProject" class="hover:text-red-200">ログイン</a>
        }
    </div>
</div>

@* ═══════════════════════════════════════════
     PROJECT TAB BAR (機能ナビゲーション)
   ═══════════════════════════════════════════ *@
<div class="rm-tabs px-4 flex items-center overflow-x-auto">
    @{
        bool IsDashboard() => string.Equals(currentCtrl, "Dashboard", StringComparison.OrdinalIgnoreCase);
        bool IsEntity(string e) => string.Equals(currentCtrl, "DynamicEntity", StringComparison.OrdinalIgnoreCase)
                                   && string.Equals(currentEntity, e, StringComparison.OrdinalIgnoreCase);
    }

    <a href="/@currentProject/Dashboard/Index"
       class="rm-tab-link @(IsDashboard() ? "active" : "")">
        📊 概要
    </a>
    <a href="/@currentProject/DynamicEntity/Index?entity=issue"
       class="rm-tab-link @(IsEntity("issue") ? "active" : "")">
        🎫 チケット
    </a>
    <a href="/@currentProject/DynamicEntity/Index?entity=time_entry"
       class="rm-tab-link @(IsEntity("time_entry") ? "active" : "")">
        ⏱️ 作業時間
    </a>
    <a href="/@currentProject/DynamicEntity/Index?entity=news"
       class="rm-tab-link @(IsEntity("news") ? "active" : "")">
        📰 ニュース
    </a>
    <a href="/@currentProject/DynamicEntity/Index?entity=wiki_page"
       class="rm-tab-link @(IsEntity("wiki_page") ? "active" : "")">
        📖 Wiki
    </a>
    <a href="/@currentProject/DynamicEntity/Index?entity=forum"
       class="rm-tab-link @(IsEntity("forum") ? "active" : "")">
        💬 フォーラム
    </a>
    <a href="/@currentProject/DynamicEntity/Index?entity=version"
       class="rm-tab-link @(IsEntity("version") ? "active" : "")">
        🏷️ バージョン
    </a>
    <a href="/@currentProject/DynamicEntity/Index?entity=member"
       class="rm-tab-link @(IsEntity("member") ? "active" : "")">
        👥 メンバー
    </a>
    @if (isAdminUser)
    {
        <div class="dropdown">
            <div tabindex="0" role="button" class="rm-tab-link cursor-pointer @(IsEntity("tracker") || IsEntity("issue_status") || IsEntity("issue_priority") || IsEntity("issue_category") || IsEntity("rm_project") ? "active" : "")">
                ⚙️ 設定 ▾
            </div>
            <ul tabindex="0" class="menu dropdown-content bg-base-100 rounded-box z-50 w-48 p-2 shadow text-base-content mt-1">
                <li><a href="/@currentProject/DynamicEntity/Index?entity=rm_project">📁 プロジェクト</a></li>
                <li><a href="/@currentProject/DynamicEntity/Index?entity=tracker">トラッカー</a></li>
                <li><a href="/@currentProject/DynamicEntity/Index?entity=issue_status">ステータス</a></li>
                <li><a href="/@currentProject/DynamicEntity/Index?entity=issue_priority">優先度</a></li>
                <li><a href="/@currentProject/DynamicEntity/Index?entity=issue_category">カテゴリ</a></li>
            </ul>
        </div>
    }
</div>

@* ═══════════════════════════════════════════
     MAIN CONTENT
   ═══════════════════════════════════════════ *@
<div class="rm-content">
    <div class="max-w-7xl mx-auto px-4 py-5">
        @RenderBody()
    </div>
</div>

@* ═══════════════════════════════════════════
     FOOTER
   ═══════════════════════════════════════════ *@
<footer class="text-center py-3 text-xs text-gray-500 bg-gray-100 border-t">
    Powered by <strong>NetYamlForge</strong> &mdash; Redmine Clone Demo
</footer>

@* CRUD 確認ダイアログモーダル *@
<dialog id="crud-confirm-modal" class="modal">
    <div class="modal-box max-w-sm">
        <h3 class="font-bold text-lg mb-4" id="crud-confirm-msg">確認</h3>
        <div class="flex gap-3 justify-end">
            <button id="crud-confirm-ok" class="btn btn-primary btn-sm">OK</button>
            <button id="crud-confirm-cancel" class="btn btn-ghost btn-sm">キャンセル</button>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

@* エンティティ選択ピッカーモーダル *@
<dialog id="entity-picker-modal" class="modal">
    <div class="modal-box max-w-3xl">
        <div class="flex items-center justify-between mb-3">
            <h3 id="entity-picker-title" class="font-bold text-lg">Select</h3>
            <form method="dialog"><button class="btn btn-ghost btn-sm btn-circle">✕</button></form>
        </div>
        <div class="mb-3">
            <input type="text" id="entity-picker-search" class="input input-bordered w-full"
                   placeholder="Search..." oninput="entityPickerSearch(this.value)" />
        </div>
        <div id="entity-picker-content" class="min-h-32"></div>
        <div id="entity-picker-multi-footer" class="mt-3 hidden">
            <form method="dialog"><button class="btn btn-primary">Done</button></form>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<script src="/lib/htmx/htmx.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    // CRUD 確認ダイアログ
    var _confirmCallback = null;
    function showConfirmDialog(msg, onOk) {
        _confirmCallback = onOk;
        var msgEl = document.getElementById('crud-confirm-msg');
        if (msgEl) msgEl.textContent = msg;
        document.getElementById('crud-confirm-modal').showModal();
    }
    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('crud-confirm-ok')?.addEventListener('click', function () {
            document.getElementById('crud-confirm-modal').close();
            if (_confirmCallback) { var cb = _confirmCallback; _confirmCallback = null; cb(); }
        });
        document.getElementById('crud-confirm-cancel')?.addEventListener('click', function () {
            document.getElementById('crud-confirm-modal').close();
            _confirmCallback = null;
        });
    });
    document.body.addEventListener('htmx:confirm', function (evt) {
        var msg = evt.detail.question;
        if (!msg) { evt.preventDefault(); evt.detail.issueRequest(true); return; }
        evt.preventDefault();
        showConfirmDialog(msg, function () { evt.detail.issueRequest(true); });
    });
    document.addEventListener('submit', function (evt) {
        var form = evt.target;
        var msg = form?.dataset?.confirmMsg;
        if (!msg) return;
        if (form.dataset.skipConfirm === '1') { delete form.dataset.skipConfirm; return; }
        evt.preventDefault();
        showConfirmDialog(msg, function () {
            form.dataset.skipConfirm = '1';
            if (typeof form.requestSubmit === 'function') form.requestSubmit(); else form.submit();
        });
    }, true);

    // エンティティ選択ピッカー
    var _pickerConfig = null;
    var _pickerSearchTimer = null;
    var _pickerBaseUrl = '/@currentProject/DynamicEntity/PickerList';
    function openEntityPicker(btn) {
        var fieldName = btn.dataset.pickerField, entity = btn.dataset.pickerEntity;
        var displayCol = btn.dataset.pickerDisplayCol || 'Id', query = btn.dataset.pickerQuery || '';
        var multi = btn.dataset.pickerMulti === 'true';
        _pickerConfig = { fieldName, entity, displayCol, query, multi, sourceButton: btn };
        var title = document.getElementById('entity-picker-title');
        if (title) title.textContent = 'Select ' + entity;
        var footer = document.getElementById('entity-picker-multi-footer');
        if (footer) footer.classList.toggle('hidden', !multi);
        document.getElementById('entity-picker-search').value = '';
        loadPickerContent('', 1);
        document.getElementById('entity-picker-modal').showModal();
    }
    function loadPickerContent(search, page) {
        if (!_pickerConfig) return;
        var cfg = _pickerConfig;
        var url = _pickerBaseUrl + '?entity=' + encodeURIComponent(cfg.entity)
            + '&targetField=' + encodeURIComponent(cfg.fieldName)
            + '&displayColumn=' + encodeURIComponent(cfg.displayCol)
            + '&displayColumns=' + encodeURIComponent(cfg.displayCol)
            + '&query=' + encodeURIComponent(cfg.query || '')
            + '&multi=' + (cfg.multi ? 'true' : 'false')
            + '&search=' + encodeURIComponent(search || '')
            + '&page=' + (page || 1);
        htmx.ajax('GET', url, { target: '#entity-picker-content', swap: 'innerHTML' });
    }
    function entityPickerSearch(value) {
        clearTimeout(_pickerSearchTimer);
        _pickerSearchTimer = setTimeout(function () { loadPickerContent(value, 1); }, 300);
    }
    function loadPickerPage(page) {
        var search = document.getElementById('entity-picker-search')?.value || '';
        loadPickerContent(search, page);
    }
    function pickerSelectFromRow(row) {
        if (!_pickerConfig) return;
        var id = row.dataset.pickerId, label = row.dataset.pickerLabel, cfg = _pickerConfig;
        var container = resolvePickerContainer(cfg.sourceButton);
        if (cfg.multi) {
            var hidden = findPickerElement(container, 'picker-value-' + cfg.fieldName);
            if (!hidden) return;
            var vals = hidden.value ? hidden.value.split(',').filter(v => v !== '') : [];
            if (vals.indexOf(id) !== -1) return;
            vals.push(id);
            hidden.value = vals.join(',');
            var chips = findPickerElement(container, 'picker-chips-' + cfg.fieldName);
            if (chips) {
                var chip = document.createElement('div');
                chip.className = 'badge badge-neutral gap-1';
                chip.dataset.id = id;
                chip.innerHTML = label + ' <button type="button" onclick="removePickerChip(\'' + cfg.fieldName + '\',\'' + id.replace(/'/g, "\\'") + '\',this.parentElement)">✕</button>';
                chips.appendChild(chip);
            }
        } else {
            var hidden2 = findPickerElement(container, 'picker-value-' + cfg.fieldName);
            var display = findPickerElement(container, 'picker-display-' + cfg.fieldName);
            if (hidden2) hidden2.value = id;
            if (display) { if (display.tagName === 'INPUT') display.value = label; else display.textContent = label; }
            document.getElementById('entity-picker-modal').close();
        }
    }
    function resolvePickerContainer(sourceEl) {
        return sourceEl?.closest?.('[data-picker-container]');
    }
    function findPickerElement(container, id) {
        var selector = '[id="' + id + '"]';
        return (container ? container.querySelector(selector) : null) || document.querySelector(selector);
    }
    function removePickerChip(fieldName, id, chipEl) {
        var container = resolvePickerContainer(chipEl);
        var hidden = findPickerElement(container, 'picker-value-' + fieldName);
        if (hidden) hidden.value = hidden.value.split(',').filter(v => v !== id && v !== '').join(',');
        chipEl?.remove();
    }
    function clearPickerValue(fieldName, sourceEl) {
        var container = resolvePickerContainer(sourceEl);
        var hidden = findPickerElement(container, 'picker-value-' + fieldName);
        var display = findPickerElement(container, 'picker-display-' + fieldName);
        if (hidden) hidden.value = '';
        if (display) { if (display.tagName === 'INPUT') display.value = ''; else display.textContent = '(All)'; }
    }
    function clearPickerFilterValue(fieldName, sourceEl) {
        var container = resolvePickerContainer(sourceEl);
        var hidden = findPickerElement(container, 'picker-value-' + fieldName);
        var display = findPickerElement(container, 'picker-display-' + fieldName);
        var chips  = findPickerElement(container, 'picker-chips-' + fieldName);
        if (hidden) hidden.value = '';
        if (display) { if (display.tagName === 'INPUT') display.value = ''; else display.textContent = '(All)'; }
        if (chips) chips.innerHTML = '';
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
