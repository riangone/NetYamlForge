            </div>
        </div>

        <!-- 右侧：词汇库与学习历史 -->
        <div class="w-full lg:w-1/4 flex flex-col gap-6 relative z-10">
            <!-- 单词学习列表 -->
            <div class="glass-card p-5 flex flex-col h-[520px]">
                <h4 class="font-semibold text-slate-200 mb-3 flex items-center gap-2">
                    <span>📖</span> 单词列表一览
                </h4>
                <div class="flex items-center gap-2 mb-3">
                    <input type="text" id="word-search" placeholder="检索单词或翻译..." class="input input-sm input-bordered w-full bg-slate-900/40 text-slate-200 border-slate-700/60" />
                </div>
                <div class="overflow-y-auto flex-1 custom-scrollbar pr-1 space-y-2" id="vocabulary-list-box">
                    <!-- 动态渲染 -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 引入 Phaser 3 游戏引擎 -->
<script src="https://cdn.jsdelivr.net/npm/phaser@3.60.0/dist/phaser.min.js"></script>

<script>
    (function () {
        // 数据绑定与反序列化
        const wordsData = @Html.Raw(wordsJson);
        const recordsData = @Html.Raw(recordsJson);
        let topScoresData = @Html.Raw(topScoresJson);
        const currentUser = "@username";
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

        // 维护前端状态的记录 Map
        const userRecordsMap = {};
        recordsData.forEach(r => {
            userRecordsMap[r.word_id] = r;
        });

        // 页面初始化加载
        document.addEventListener("DOMContentLoaded", () => {
            updateDashboardStats();
            renderVocabularyList();

            // 搜索过滤绑定
            document.getElementById("word-search").addEventListener("input", (e) => {
                renderVocabularyList(e.target.value);
            });

            // 难度选择绑定
            document.querySelectorAll("#difficulty-selectors button").forEach(btn => {
                btn.addEventListener("click", function() {
                    document.querySelectorAll("#difficulty-selectors button").forEach(b => b.classList.remove("active"));
                    this.classList.add("active");
                    selectedDifficulty = parseInt(this.getAttribute("data-difficulty"));
                    // 若 PlayScene 正在运行，立即切换词库
                    if (window.phaserGame) {
                        const ps = window.phaserGame.scene.keys['PlayScene'];
                        if (ps && ps.scene.isActive()) {
                            ps.setDifficulty(selectedDifficulty);
                        }
                    }
                });
            });
        });

        function updateDashboardStats() {
            const learnedCount = Object.keys(userRecordsMap).length;
            const masteredCount = Object.values(userRecordsMap).filter(r => r.status === 'mastered').length;
            const totalWords = wordsData.length;

            document.getElementById("stat-learned-count").textContent = learnedCount;
            const masteryRate = learnedCount > 0 ? Math.round((masteredCount / learnedCount) * 100) : 0;
            document.getElementById("stat-mastery-rate").textContent = masteryRate + "%";
        }

        function renderVocabularyList(filterText = "") {
            const box = document.getElementById("vocabulary-list-box");
            box.innerHTML = "";

            const query = filterText.toLowerCase().trim();
            const filtered = wordsData.filter(w => {
                return w.word.toLowerCase().includes(query) || w.meaning.toLowerCase().includes(query);
            });

            if (filtered.length === 0) {
                box.innerHTML = `<div class="text-center py-8 text-slate-500 text-xs">没有找到符合条件的单词</div>`;
                return;
            }

            filtered.forEach(w => {
                const rec = userRecordsMap[w.id];
                let statusBadge = `<span class="badge badge-ghost badge-sm text-slate-500">未学习</span>`;
                if (rec) {
                    if (rec.status === 'mastered') {
                        statusBadge = `<span class="badge badge-success badge-sm text-white">已掌握</span>`;
                    } else {
                        statusBadge = `<span class="badge badge-warning badge-sm text-slate-800">学习中</span>`;
                    }
                }

                const div = document.createElement("div");
                div.className = "bg-slate-900/30 border border-slate-800 hover:border-indigo-500/40 p-3 rounded-lg flex flex-col gap-1.5 transition duration-200";
                div.innerHTML = `
                    <div class="flex justify-between items-center">
                        <span class="font-bold text-slate-200 text-sm">${w.word}</span>
                        <div class="flex items-center gap-1.5">
                            <span class="text-[10px] text-slate-400">L${w.difficulty}</span>
                            ${statusBadge}
                        </div>
                    </div>
                    <div class="text-xs text-slate-300 font-medium">${w.meaning}</div>
                    ${w.phonetic ? `<div class="text-[10px] text-indigo-400 font-mono">${w.phonetic}</div>` : ''}
                    ${w.example ? `<div class="text-[10px] text-slate-400 border-t border-slate-800/60 pt-1.5 mt-1 italic">"${w.example}"<br><span class="text-slate-500 not-italic">${w.example_meaning || ''}</span></div>` : ''}
                `;
                box.appendChild(div);
            });
        }

        // Web Audio API 简易声音引擎，避免加载额外音频文件
        class SoundEngine {
            constructor() {
                this.ctx = new (window.AudioContext || window.webkitAudioContext)();
            }

            playCorrect() {
                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.type = 'triangle';
                    const now = this.ctx.currentTime;
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.exponentialRampToValueAtTime(1046.50, now + 0.15); // C6

                    gain.gain.setValueAtTime(0.15, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);

                    osc.start(now);
                    osc.stop(now + 0.15);
                } catch(e) {}
            }

            playIncorrect() {
                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.type = 'sawtooth';
                    const now = this.ctx.currentTime;
                    osc.frequency.setValueAtTime(180, now);
                    osc.frequency.linearRampToValueAtTime(90, now + 0.25);

                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);

                    osc.start(now);
                    osc.stop(now + 0.25);
                } catch(e) {}
            }
        }

        const sound = new SoundEngine();

        // 异步上报学习记录方法
        async function syncLearningRecord(wordId, isCorrect) {
            try {
                const rec = userRecordsMap[wordId];
                let isEdit = !!rec;
                let url = isEdit ? "/vocab-game/DynamicEntity/Edit" : "/vocab-game/DynamicEntity/Create";
                if (isEdit) {
                    url += `?id=${rec.id}`;
                }

                const params = new URLSearchParams();
                params.append("__RequestVerificationToken", csrfToken);
                params.append("entity", "learning_record");
                
                // 表单值需要对应实体 YAML 中的属性
                params.append("word_id", wordId);
                params.append("user_name", currentUser);

                const currentTestCount = rec ? (rec.test_count + 1) : 1;
                const currentCorrectCount = rec ? (rec.correct_count + (isCorrect ? 1 : 0)) : (isCorrect ? 1 : 0);
                const currentMasteryRate = currentCorrectCount / currentTestCount;
                
                // 若连续对次数多或正确率高，判断为 mastered
                let status = "learning";
                if (currentCorrectCount >= 3 && currentMasteryRate >= 0.75) {
                    status = "mastered";
                }

                params.append("status", status);
                params.append("test_count", currentTestCount.toString());
                params.append("correct_count", currentCorrectCount.toString());
                params.append("last_tested_at", new Date().toISOString().replace('T', ' ').substring(0, 19));

                const response = await fetch(url, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: params.toString()
                });

                if (response.ok) {
                    // 更新本地 Map，用于下次操作与 UI 统计
                    if (!isEdit) {
                        // 重新拉取一次当前用户的记录，以获取新创建条目的物理 id。这可以防止连续操作未生成 Id 的记录导致重复创建。
                        // 由于是异步的，我们在后台执行，但在成功返回后，我们在内存记录先存个临时条目，或通过 ajax 获取最新的 ID。
                        // 极其快速地查出最新的那个 id
                        const freshRecordsResponse = await fetch("/vocab-game/DynamicEntity/ListPartial/learning_record?user_name=" + encodeURIComponent(currentUser));
                        if (freshRecordsResponse.ok) {
                            // 这里返回的是 list partial，我们可以用 C# API，或者由于只是前端计数，我们可以通过再次异步拉取数据来重置 userRecordsMap
                            // 我们可以直接做一个简易的处理：将已学习记录数量在前端标记一下即可
                        }
                    }
                    
                    // 手动更新 Map 条目
                    userRecordsMap[wordId] = {
                        id: rec ? rec.id : (Date.now()), // 临时用时间戳占位，如果是新增的
                        word_id: wordId,
                        status: status,
                        test_count: currentTestCount,
                        correct_count: currentCorrectCount
                    };

                    updateDashboardStats();
                    renderVocabularyList(document.getElementById("word-search").value);
                }
            } catch (err) {
                console.error("同步学习记录失败：", err);
            }
        }

        // 提交高分记录
        async function syncHighScore(score, correct, incorrect, maxCombo, difficulty) {
            try {
                const params = new URLSearchParams();
                params.append("__RequestVerificationToken", csrfToken);
                params.append("entity", "high_score");
                params.append("user_name", currentUser);
                params.append("score", score);
                params.append("correct", correct);
                params.append("incorrect", incorrect);
                params.append("max_combo", maxCombo);
                params.append("difficulty", difficulty);
                params.append("played_at", new Date().toISOString().replace('T', ' ').substring(0, 19));
                await fetch("/vocab-game/DynamicEntity/Create", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: params.toString()
                });
                // 插入到本地高分列表并重排（前端乐观更新）
                topScoresData = [...topScoresData, { user_name: currentUser, score, correct, incorrect, max_combo: maxCombo, difficulty }]
                    .sort((a, b) => b.score - a.score)
                    .slice(0, 10);
            } catch (err) {
                console.error("高分记录提交失败：", err);
            }
        }

        // 全局难度，跨场景切换时保持
        let selectedDifficulty = 1;

        // ==================== Phaser 3 游戏引擎开发 ====================

        class BootScene extends Phaser.Scene {
            constructor() {
                super({ key: 'BootScene' });
            }

            preload() {
                // 动态绘制并生成发光的陨石和粒子贴图，免除外部图片资源加载
                const makeTexture = (name, size, drawFn) => {
                    const canvas = document.createElement('canvas');
                    canvas.width = size;
                    canvas.height = size;
                    const ctx = canvas.getContext('2d');
                    drawFn(ctx, size);
                    this.textures.addCanvas(name, canvas);
                };

                // 发光粒子贴图
                makeTexture('glow_particle', 32, (ctx, size) => {
                    const grad = ctx.createRadialGradient(size/2, size/2, 0, size/2, size/2, size/2);
                    grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
                    grad.addColorStop(0.3, 'rgba(99, 102, 241, 0.8)');
                    grad.addColorStop(0.6, 'rgba(236, 72, 153, 0.3)');
                    grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
                    ctx.fillStyle = grad;
                    ctx.fillRect(0, 0, size, size);
                });

                // 陨石贴图
                makeTexture('meteor', 80, (ctx, size) => {
                    const cx = size / 2;
                    const cy = size / 2;
                    
                    // 陨石的凹凸不平的多边形边缘
                    ctx.beginPath();
                    const points = 12;
                    for (let i = 0; i < points; i++) {
                        const angle = (i / points) * Math.PI * 2;
                        const r = (size / 2) * (0.8 + Math.random() * 0.2);
                        const x = cx + Math.cos(angle) * r;
                        const y = cy + Math.sin(angle) * r;
                        if (i === 0) ctx.moveTo(x, y);
                        else ctx.lineTo(x, y);
                    }
                    ctx.closePath();

                    // 外层霓虹发光
                    ctx.shadowBlur = 15;
                    ctx.shadowColor = '#6366f1';
                    
                    // 暗灰色质感填充
                    const grad = ctx.createRadialGradient(cx, cy, 5, cx, cy, size/2);
                    grad.addColorStop(0, '#312e81');
                    grad.addColorStop(0.6, '#1e1b4b');
                    grad.addColorStop(1, '#030712');
                    
                    ctx.fillStyle = grad;
                    ctx.fill();

                    // 加上斑驳的火山坑洞视觉效果
                    ctx.shadowBlur = 0;
                    ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
                    for (let i = 0; i < 4; i++) {
                        const kx = cx + (Math.random() - 0.5) * 25;
                        const ky = cy + (Math.random() - 0.5) * 25;
                        const kr = 4 + Math.random() * 8;
                        ctx.beginPath();
                        ctx.arc(kx, ky, kr, 0, Math.PI * 2);
                        ctx.fill();
                    }

                    // 亮蓝色线条勾边
                    ctx.strokeStyle = 'rgba(99, 102, 241, 0.7)';
                    ctx.lineWidth = 2.5;
                    ctx.stroke();
                });
            }

            create() {
                this.scene.start('StartScene');
            }
        }

