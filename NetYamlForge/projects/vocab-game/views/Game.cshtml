                // Next Level button (visible only if difficulty < 5 and score >= 300)
                const canNextLevel = this.stats.difficulty < 5 && this.stats.score >= 300;
                this.nextBtnBg = this.add.graphics();
                this.nextBtnText = this.add.text(0, 0, `下一关 Lv.${this.stats.difficulty + 1} ▶`, {
                    fontFamily: 'Plus Jakarta Sans', fontSize: '14px', fontWeight: 'bold', color: '#ffffff'
                }).setOrigin(0.5).setVisible(canNextLevel);
                this.nextBtnBg.setVisible(canNextLevel);
                this.nextZone = this.add.zone(0, 0, 170, 40).setInteractive({ useHandCursor: true }).setVisible(canNextLevel);
                if (canNextLevel) {
                    this.nextZone.on('pointerover', () => this._drawNextBtn(true));
                    this.nextZone.on('pointerout',  () => this._drawNextBtn(false));
                    this.nextZone.on('pointerdown', () => this.scene.start('PlayScene', { startDifficulty: this.stats.difficulty + 1 }));
                }

                this._layout();

                this.scale.on('resize', this.onResize, this);
                this.events.once('shutdown', () => this.scale.off('resize', this.onResize, this));
            }

            _layout() {
                const w = this.scale.width, h = this.scale.height;
                const panelW = Math.min(w - 40, 380);
                const cx = w / 2;
                const canNextLevel = this.nextBtnBg.visible;

                // Compute total block height and center it
                const statsH = 140;  // 5 rows × 26px + padding
                const lbH = 115;     // title + 5 rows
                const btnH = 44;
                const gap = 12;
                const totalH = 42 + gap + statsH + gap + lbH + gap + btnH;
                let y = (h - totalH) / 2;

                // Title
                this.titleText.setPosition(cx, y + 20);
                y += 42 + gap;

                // Stats panel background
                this.statPanel.clear();
                this.statPanel.fillStyle(0x1e293b, 0.85);
                this.statPanel.lineStyle(1.5, 0x334155, 1);
                this.statPanel.fillRoundedRect(cx - panelW / 2, y, panelW, statsH, 10);
                this.statPanel.strokeRoundedRect(cx - panelW / 2, y, panelW, statsH, 10);
                const rowStart = y + 14;
                this.statLabelTexts.forEach((lbl, i) => lbl.setPosition(cx - panelW / 2 + 16, rowStart + i * 24));
                this.statValueTexts.forEach((val, i) => val.setPosition(cx + panelW / 2 - 16, rowStart + i * 24));
                y += statsH + gap;

                // Leaderboard panel
                this.lbPanel.clear();
                this.lbPanel.fillStyle(0x172033, 0.85);
                this.lbPanel.lineStyle(1.5, 0x2d3748, 1);
                this.lbPanel.fillRoundedRect(cx - panelW / 2, y, panelW, lbH, 10);
                this.lbPanel.strokeRoundedRect(cx - panelW / 2, y, panelW, lbH, 10);
                this.lbTitle.setPosition(cx - panelW / 2 + 16, y + 8);
                const topFive = topScoresData.slice(0, 5);
                this.lbTexts.forEach((t, i) => {
                    const s = topFive[i];
                    if (s) {
                        const isMe = s.user_name === currentUser;
                        t.setText(`${i + 1}. ${s.user_name}   ${s.score}分   Lv.${s.difficulty}`);
                        t.setColor(isMe ? '#f59e0b' : '#94a3b8');
                    } else {
                        t.setText('');
                    }
                    t.setPosition(cx - panelW / 2 + 16, y + 28 + i * 17);
                });
                y += lbH + gap;

                // Buttons
                const btnY = y + btnH / 2;
                if (canNextLevel) {
                    const halfGap = 6;
                    const btnW = (panelW - halfGap * 2) / 2;
                    this._drawRetryBtn(false, cx - halfGap - btnW / 2, btnY, btnW, btnH);
                    this.retryBtnText.setPosition(cx - halfGap - btnW / 2, btnY);
                    this.retryZone.setSize(btnW, btnH).setPosition(cx - halfGap - btnW / 2, btnY);
                    this._drawNextBtn(false, cx + halfGap + btnW / 2, btnY, btnW, btnH);
                    this.nextBtnText.setPosition(cx + halfGap + btnW / 2, btnY);
                    this.nextZone.setSize(btnW, btnH).setPosition(cx + halfGap + btnW / 2, btnY);
                } else {
                    const btnW = Math.min(panelW, 220);
                    this._drawRetryBtn(false, cx, btnY, btnW, btnH);
                    this.retryBtnText.setPosition(cx, btnY);
                    this.retryZone.setSize(btnW, btnH).setPosition(cx, btnY);
                }
            }

            _drawRetryBtn(hover, x, y, w, h) {
                if (x === undefined) return;
                this.retryBtnBg.clear();
                this.retryBtnBg.fillStyle(hover ? 0x818cf8 : 0x6366f1, hover ? 1 : 0.9);
                this.retryBtnBg.fillRoundedRect(x - w / 2, y - h / 2, w, h, h / 2);
            }

            _drawNextBtn(hover, x, y, w, h) {
                if (x === undefined) return;
                this.nextBtnBg.clear();
                this.nextBtnBg.fillStyle(hover ? 0x34d399 : 0x10b981, hover ? 1 : 0.9);
                this.nextBtnBg.fillRoundedRect(x - w / 2, y - h / 2, w, h, h / 2);
            }

            onResize() { this._layout(); }
        }

        // 初始化 Phaser 3 游戏配置
        const config = {
            type: Phaser.AUTO,
            backgroundColor: '#0c1020',
            resolution: window.devicePixelRatio || 1,
            scene: [BootScene, StartScene, PlayScene, GameOverScene],
            scale: {
                mode: Phaser.Scale.RESIZE,
                autoCenter: Phaser.Scale.CENTER_BOTH,
                parent: 'game-container',
                fullscreenTarget: 'game-wrapper'
            },
            physics: {
                default: 'arcade',
                arcade: {
                    gravity: { y: 0 },
                    debug: false
                }
            }
        };

        window.phaserGame = new Phaser.Game(config);

        // ── 全屏切换逻辑 ──────────────────────────────────────────────────────
        const fsBtn        = document.getElementById('fullscreen-btn');
        const fsIconExpand   = document.getElementById('fs-icon-expand');
        const fsIconCompress = document.getElementById('fs-icon-compress');
        const gameWrapper  = document.getElementById('game-wrapper');

        let isFsMode = false;

        function updateFsIcon(on) {
            fsIconExpand.style.display   = on ? 'none'  : 'block';
            fsIconCompress.style.display = on ? 'block' : 'none';
        }

        function forcePhaserResize() {
            // 双 rAF 确保浏览器已完成 CSS layout 重算
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    const gc = document.getElementById('game-container');
                    const w = gc.clientWidth;
                    const h = gc.clientHeight;
                    if (w > 0 && h > 0) {
                        window.phaserGame.scale.resize(w, h);
                    }
                });
            });
        }

        function enterFs() {
            gameWrapper.classList.add('fs-mode');
            isFsMode = true;
            updateFsIcon(true);
            forcePhaserResize();
            try {
                if (gameWrapper.requestFullscreen) gameWrapper.requestFullscreen().catch(() => {});
                else if (gameWrapper.webkitRequestFullscreen) gameWrapper.webkitRequestFullscreen();
            } catch(e) {}
        }

        function exitFs() {
            gameWrapper.classList.remove('fs-mode');
            isFsMode = false;
            updateFsIcon(false);
            forcePhaserResize();
            try {
                if (document.exitFullscreen && document.fullscreenElement) document.exitFullscreen();
                else if (document.webkitExitFullscreen && document.webkitFullscreenElement) document.webkitExitFullscreen();
            } catch(e) {}
        }

        fsBtn.addEventListener('click', () => { isFsMode ? exitFs() : enterFs(); });

        function onNativeFullscreenExit() {
            const inNative = !!(document.fullscreenElement || document.webkitFullscreenElement);
            if (!inNative && isFsMode) {
                gameWrapper.classList.remove('fs-mode');
                isFsMode = false;
                updateFsIcon(false);
                forcePhaserResize();
            }
        }
        document.addEventListener('fullscreenchange',       onNativeFullscreenExit);
        document.addEventListener('webkitfullscreenchange', onNativeFullscreenExit);

        window.addEventListener('resize', () => { if (isFsMode) forcePhaserResize(); });

    })();
</script>
