                    <button class="btn btn-xs btn-outline bg-slate-800 text-slate-300 border-slate-700/70 difficulty-badge" data-difficulty="3">等级 3</button>
                    <button class="btn btn-xs btn-outline bg-slate-800 text-slate-300 border-slate-700/70 difficulty-badge" data-difficulty="4">等级 4</button>
                    <button class="btn btn-xs btn-outline bg-slate-800 text-slate-300 border-slate-700/70 difficulty-badge" data-difficulty="5">等级 5</button>
                </div>
