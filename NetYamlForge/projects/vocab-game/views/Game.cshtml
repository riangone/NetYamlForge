        class PlayScene extends Phaser.Scene {
            constructor() {
                super({ key: 'PlayScene' });
                this.score = 0;
                this.lives = 3;
                this.combo = 0;
                this.maxCombo = 0;
                this.correctCount = 0;
                this.incorrectCount = 0;
                this.currentDifficulty = 1;
                this.activeMeteors = [];
                this.spawnTimer = null;
                this.currentQuestion = null;
            }

            init(data) {
                if (data && data.startDifficulty) {
                    this.currentDifficulty = data.startDifficulty;
                } else {
                    this.currentDifficulty = selectedDifficulty;
                }
            }

            setDifficulty(diff) {
                this.currentDifficulty = diff;
                if (this.currentQuestion) {
                    // 若在局中切换了难度，重新生成一个匹配难度的气泡
                    this.destroyAllMeteors();
                    this.spawnMeteor();
                }
            }

            create() {
                this.score = 0;
                this.lives = 3;
                this.combo = 0;
                this.maxCombo = 0;
                this.correctCount = 0;
                this.incorrectCount = 0;
                this.activeMeteors = [];
                this.optionContainers = [];

                // sync difficulty badge in sidebar
                document.querySelectorAll("#difficulty-selectors button").forEach(b => {
                    b.classList.toggle("active", parseInt(b.getAttribute("data-difficulty")) === this.currentDifficulty);
                });

                this.updateLiveStats();

                this.deadlineGraphics = this.add.graphics();
                this.deadlineLabel = this.add.text(15, 0, 'DANGER ZONE', {
                    fontFamily: 'Outfit, sans-serif',
                    fontSize: '11px',
                    fontWeight: '800',
                    color: '#f43f5e'
                }).setAlpha(0.6);
                this._redrawDeadline();

                // 右上角重新开始按钮
                this.restartBtnBg = this.add.graphics();
                this.restartBtnText = this.add.text(0, 0, '↺ 重新开始', {
                    fontFamily: 'Plus Jakarta Sans, sans-serif',
                    fontSize: '12px',
                    fontWeight: '600',
                    color: '#94a3b8'
                }).setOrigin(0.5);
                this.restartZone = this.add.zone(0, 0, 110, 28).setInteractive({ useHandCursor: true });
                this.restartZone.on('pointerover', () => this._drawRestartBtn(true));
                this.restartZone.on('pointerout',  () => this._drawRestartBtn(false));
                this.restartZone.on('pointerdown', () => {
                    this.destroyAllMeteors();
                    this.scene.start('PlayScene');
                });
                this._drawRestartBtn(false);

                this.createOptionButtons();
                this.spawnMeteor();

                this.input.keyboard.on('keydown', (event) => {
                    const key = event.key;
                    if (['1', '2', '3', '4'].includes(key)) {
                        this.selectOption(parseInt(key) - 1);
                    }
                });

                this.scale.on('resize', this.onResize, this);
                this.events.once('shutdown', () => this.scale.off('resize', this.onResize, this));
            }

            _redrawDeadline() {
                const width = this.scale.width, height = this.scale.height;
                this.deadlineY = height - 120;
                this.deadlineGraphics.clear();
                this.deadlineGraphics.lineStyle(2, 0xf43f5e, 0.4);
                this.deadlineGraphics.beginPath();
                this.deadlineGraphics.moveTo(0, this.deadlineY);
                this.deadlineGraphics.lineTo(width, this.deadlineY);
                this.deadlineGraphics.strokePath();
                this.deadlineLabel.setPosition(15, this.deadlineY + 5);
                if (this.restartBtnBg) this._drawRestartBtn(false);
            }

            _drawRestartBtn(hover) {
                const w = this.scale.width;
                const bx = w - 64, by = 20;
                this.restartBtnBg.clear();
                this.restartBtnBg.fillStyle(hover ? 0x334155 : 0x1e293b, hover ? 0.9 : 0.75);
                this.restartBtnBg.lineStyle(1, hover ? 0x6366f1 : 0x475569, 0.8);
                this.restartBtnBg.fillRoundedRect(bx - 55, by - 14, 110, 28, 6);
                this.restartBtnBg.strokeRoundedRect(bx - 55, by - 14, 110, 28, 6);
                this.restartBtnText.setPosition(bx, by);
                this.restartBtnText.setColor(hover ? '#ffffff' : '#94a3b8');
                this.restartZone.setPosition(bx, by);
            }

            onResize(gameSize) {
                this._redrawDeadline();
                this.optionContainers.forEach(c => c.destroy());
                this.createOptionButtons();
                if (this.currentQuestion) {
                    this.optionTexts.forEach((t, i) => {
                        t.setText(this.currentQuestion.options[i] ? this.currentQuestion.options[i].meaning : '—');
                    });
                }
            }

            createOptionButtons() {
                const width = this.scale.width;
                const height = this.scale.height;
                const portrait = height > width * 1.1;
                const buttonWidth = portrait ? Math.min(width - 20, 360) : 360;
                const buttonHeight = 44;
                const gap = portrait ? 8 : 16;

                this.optionButtons = [];
                this.optionTexts = [];
                this.optionContainers = [];

                let positions;
                if (portrait) {
                    const totalH = 4 * buttonHeight + 3 * gap;
                    const startY = height - totalH - 8;
                    positions = [0, 1, 2, 3].map(i => ({
                        x: width / 2,
                        y: startY + i * (buttonHeight + gap) + buttonHeight / 2
                    }));
                } else {
                    const startY = height - 90;
                    positions = [
                        { x: width / 2 - buttonWidth / 2 - gap / 2, y: startY },
                        { x: width / 2 + buttonWidth / 2 + gap / 2, y: startY },
                        { x: width / 2 - buttonWidth / 2 - gap / 2, y: startY + buttonHeight + gap / 2 },
                        { x: width / 2 + buttonWidth / 2 + gap / 2, y: startY + buttonHeight + gap / 2 }
                    ];
                }

                const buttonColors = [0x6366f1, 0xec4899, 0x10b981, 0xf59e0b];

                positions.forEach((pos, index) => {
                    const btnG = this.add.graphics();
                    btnG.fillStyle(buttonColors[index], 0.2);
                    btnG.lineStyle(1.5, buttonColors[index], 0.6);
                    btnG.fillRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, 8);
                    btnG.strokeRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, 8);

                    const container = this.add.container(pos.x, pos.y);
                    container.add(btnG);

                    const numText = this.add.text(-buttonWidth / 2 + 15, -1, `${index + 1}.`, {
                        fontFamily: 'Outfit, sans-serif',
                        fontSize: '15px',
                        fontWeight: 'bold',
                        color: '#94a3b8'
                    }).setOrigin(0, 0.5);

                    const labelText = this.add.text(0, -1, '选项加载中...', {
                        fontFamily: 'Plus Jakarta Sans, sans-serif',
                        fontSize: '14px',
                        fontWeight: '600',
                        color: '#f1f5f9'
                    }).setOrigin(0.5);

                    container.add(numText);
                    container.add(labelText);

                    labelText.setInteractive(new Phaser.Geom.Rectangle(-buttonWidth/2, -buttonHeight/2, buttonWidth, buttonHeight), Phaser.Geom.Rectangle.Contains);
                    
                    labelText.on('pointerover', () => {
                        btnG.clear();
                        btnG.fillStyle(buttonColors[index], 0.35);
                        btnG.lineStyle(2, buttonColors[index], 0.9);
                        btnG.fillRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, 8);
                        btnG.strokeRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, 8);
                    });

                    labelText.on('pointerout', () => {
                        btnG.clear();
                        btnG.fillStyle(buttonColors[index], 0.2);
                        btnG.lineStyle(1.5, buttonColors[index], 0.6);
                        btnG.fillRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, 8);
                        btnG.strokeRoundedRect(-buttonWidth / 2, -buttonHeight / 2, buttonWidth, buttonHeight, 8);
                    });

                    labelText.on('pointerdown', () => {
                        this.selectOption(index);
                    });

                    this.optionButtons.push(btnG);
                    this.optionTexts.push(labelText);
                    this.optionContainers.push(container);
                });
            }

            destroyAllMeteors() {
                this.activeMeteors.forEach(m => {
                    m.container.destroy();
                });
                this.activeMeteors = [];
                if (this.spawnTimer) {
                    clearTimeout(this.spawnTimer);
                }
            }

            spawnMeteor() {
                if (this.lives <= 0) return;

                // 筛选当前难度对应的词库单词
                let filteredPool = wordsData.filter(w => w.difficulty === this.currentDifficulty);
                if (filteredPool.length === 0) {
                    // 容错：如果该难度下没有配置单词，则使用所有单词
                    filteredPool = wordsData;
                }

                if (filteredPool.length === 0) {
                    // 全局零数据容错
                    this.add.text(this.scale.width/2, this.scale.height/2 - 50, '数据库词库为空，请先在“词库管理”添加单词。', {
                        fontSize: '16px', color: '#ff6b6b', align: 'center'
                    }).setOrigin(0.5);
                    return;
                }

                // 随机抽取一个单词
                const questionWord = Phaser.Utils.Array.GetRandom(filteredPool);
                
                // 挑选混淆选项：从所有单词里随机选3个不同的，加上正确答案构成4个选项
                const decoyPool = wordsData.filter(w => w.id !== questionWord.id);
                Phaser.Utils.Array.Shuffle(decoyPool);
                
                const options = [questionWord];
                for (let i = 0; i < Math.min(3, decoyPool.length); i++) {
                    options.push(decoyPool[i]);
                }
                
                // 打乱选项顺序
                Phaser.Utils.Array.Shuffle(options);

                const correctIndex = options.findIndex(o => o.id === questionWord.id);

                this.currentQuestion = {
                    word: questionWord,
                    options: options,
                    correctIndex: correctIndex
                };

                // 更新下方的 4 个选项按钮文本
                this.optionTexts.forEach((textSprite, i) => {
                    if (options[i]) {
                        textSprite.setText(options[i].meaning);
                    } else {
                        textSprite.setText('—');
                    }
                });

                // 创建陨石容器
                const x = Phaser.Math.Between(100, this.scale.width - 100);
                const y = -40;

                const meteorImg = this.add.image(0, 0, 'meteor');
                const wordText = this.add.text(0, -3, questionWord.word, {
                    fontFamily: 'Outfit, Plus Jakarta Sans, sans-serif',
                    fontSize: '16px',
                    fontWeight: '800',
                    color: '#ffffff'
                }).setOrigin(0.5).setShadow(0, 0, 8, '#6366f1', true);

                const container = this.add.container(x, y);
                container.add(meteorImg);
                container.add(wordText);

                // 根据难度调节下坠速度
                const speed = 0.65 + (this.currentDifficulty * 0.18);

                this.activeMeteors.push({
                    container: container,
                    word: questionWord,
                    speed: speed
                });
            }

            selectOption(index) {
                if (!this.currentQuestion) return;

                const isCorrect = (index === this.currentQuestion.correctIndex);
                const wordId = this.currentQuestion.word.id;

                const activeMeteor = this.activeMeteors[0];

                if (isCorrect) {
                    sound.playCorrect();
                    this.score += 100 + (this.combo * 10);
                    this.combo++;
                    this.correctCount++;
                    if (this.combo > this.maxCombo) {
                        this.maxCombo = this.combo;
                    }

                    // 爆炸粒子特效
                    if (activeMeteor) {
                        this.triggerExplosion(activeMeteor.container.x, activeMeteor.container.y);
                        activeMeteor.container.destroy();
                        this.activeMeteors.shift();
                    }

                    // 触发同步上报数据库学习记录
                    syncLearningRecord(wordId, true);

                    this.flashBackground(0x10b981, 0.1); // 浅绿色闪烁提示正确
                } else {
                    sound.playIncorrect();
                    this.lives--;
                    this.combo = 0;
                    this.incorrectCount++;

                    // 陨石坠毁粒子特效
                    if (activeMeteor) {
                        this.triggerCrash(activeMeteor.container.x, activeMeteor.container.y);
                        activeMeteor.container.destroy();
                        this.activeMeteors.shift();
                    }

                    // 触发同步上报数据库学习记录
                    syncLearningRecord(wordId, false);

                    this.flashBackground(0xf43f5e, 0.25); // 红色闪烁提示错误
                }

                this.updateLiveStats();

                if (this.lives <= 0) {
                    this.gameOver();
                } else {
                    // 延迟 800ms 后掉落下一颗单词陨石
                    this.spawnTimer = setTimeout(() => {
                        this.spawnMeteor();
                    }, 800);
                }
            }

            triggerExplosion(x, y) {
                const emitter = this.add.particles(x, y, 'glow_particle', {
                    speed: { min: 80, max: 200 },
                    scale: { start: 0.8, end: 0 },
                    blendMode: 'ADD',
                    lifespan: 600,
                    gravityY: 100,
                    quantity: 20
                });
                this.time.delayedCall(600, () => {
                    emitter.destroy();
                });
            }

            triggerCrash(x, y) {
                const emitter = this.add.particles(x, y, 'glow_particle', {
                    speed: { min: 50, max: 150 },
                    scale: { start: 0.7, end: 0 },
                    tint: 0xf43f5e,
                    lifespan: 700,
                    quantity: 15
                });
                this.time.delayedCall(700, () => {
                    emitter.destroy();
                });
            }

            flashBackground(color, alpha) {
                const flash = this.add.graphics();
                flash.fillStyle(color, alpha);
                flash.fillRect(0, 0, this.scale.width, this.scale.height);
                this.tweens.add({
                    targets: flash,
                    alpha: 0,
                    duration: 250,
                    onComplete: () => flash.destroy()
                });
            }

            updateLiveStats() {
                document.getElementById("live-score").textContent = this.score;
                document.getElementById("live-combo").textContent = this.combo;
                document.getElementById("live-max-combo").textContent = this.maxCombo;
                document.getElementById("live-correct").textContent = this.correctCount;
                document.getElementById("live-incorrect").textContent = this.incorrectCount;
            }

            update(time, delta) {
                // 陨石位移及边界检测
                for (let i = this.activeMeteors.length - 1; i >= 0; i--) {
                    const m = this.activeMeteors[i];
                    m.container.y += m.speed;

                    // 触底判定
                    if (m.container.y >= this.deadlineY) {
                        sound.playIncorrect();
                        this.lives--;
                        this.combo = 0;
                        this.incorrectCount++;
                        this.flashBackground(0xf43f5e, 0.3);

                        // 上报错误记录
                        syncLearningRecord(m.word.id, false);

                        this.triggerCrash(m.container.x, m.container.y);
                        m.container.destroy();
                        this.activeMeteors.splice(i, 1);

                        this.updateLiveStats();

                        if (this.lives <= 0) {
                            this.gameOver();
                        } else {
                            this.spawnTimer = setTimeout(() => {
                                this.spawnMeteor();
                            }, 800);
                        }
                    }
                }
            }

            gameOver() {
                this.destroyAllMeteors();
                const finalStats = {
                    score: this.score,
                    correct: this.correctCount,
                    incorrect: this.incorrectCount,
                    maxCombo: this.maxCombo,
                    difficulty: this.currentDifficulty
                };
                this.time.delayedCall(500, () => {
                    this.scene.start('GameOverScene', finalStats);
                });
            }
        }

        class GameOverScene extends Phaser.Scene {
