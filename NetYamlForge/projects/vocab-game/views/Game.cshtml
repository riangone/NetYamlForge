@using Dapper
@using System.Data
@using System.Text.Json
@inject IDbConnection Db
@{
    var username = User.Identity?.Name ?? "admin";
    IEnumerable<dynamic> words = Array.Empty<dynamic>();
    IEnumerable<dynamic> records = Array.Empty<dynamic>();
    try
    {
        words = await Db.QueryAsync<dynamic>("SELECT id, word, phonetic, meaning, difficulty, example, example_meaning FROM vocab_words");
        records = await Db.QueryAsync<dynamic>("SELECT id, word_id, status, test_count, correct_count FROM learning_records WHERE user_name = @User", new { User = username });
    }
    catch (Exception)
    {
        // 容错：防止初次启动时由于异步自动建表有微小延迟导致页面报错
    }
    IEnumerable<dynamic> topScores = Array.Empty<dynamic>();
    try
    {
        topScores = await Db.QueryAsync<dynamic>("SELECT user_name, score, correct, incorrect, max_combo, difficulty, played_at FROM high_scores ORDER BY score DESC LIMIT 10");
    }
    catch (Exception) { }
    var wordsJson = JsonSerializer.Serialize(words);
    var recordsJson = JsonSerializer.Serialize(records);
    var topScoresJson = JsonSerializer.Serialize(topScores);
}

@Html.AntiForgeryToken()

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">

<style>
    .vocab-game-container {
        font-family: 'Plus Jakarta Sans', 'Outfit', sans-serif;
        background: radial-gradient(circle at 10% 20%, #1e1b4b 0%, #0f172a 100%);
        min-height: 85vh;
        color: #f8fafc;
        border-radius: 1.5rem;
        padding: 2rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
        position: relative;
        overflow: hidden;
    }

    .vocab-game-container::before {
        content: "";
        position: absolute;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, transparent 70%);
        top: -50px;
        right: -50px;
        z-index: 0;
        pointer-events: none;
    }

    .vocab-game-container::after {
        content: "";
        position: absolute;
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(236, 72, 153, 0.1) 0%, transparent 70%);
        bottom: -150px;
        left: -150px;
        z-index: 0;
        pointer-events: none;
    }

    .glass-card {
        background: rgba(30, 41, 59, 0.45);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
        border-radius: 1rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .glass-card:hover {
        border-color: rgba(99, 102, 241, 0.3);
        box-shadow: 0 12px 40px 0 rgba(99, 102, 241, 0.15);
    }

    .neon-text-indigo {
        text-shadow: 0 0 10px rgba(99, 102, 241, 0.5), 0 0 20px rgba(99, 102, 241, 0.3);
    }

    .neon-text-pink {
        text-shadow: 0 0 10px rgba(236, 72, 153, 0.5), 0 0 20px rgba(236, 72, 153, 0.3);
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.03);
        border-radius: 10px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(99, 102, 241, 0.3);
        border-radius: 10px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(99, 102, 241, 0.5);
    }

    .difficulty-badge {
        transition: all 0.2s ease;
    }

    .difficulty-badge.active {
        background-color: #6366f1 !important;
        color: #ffffff !important;
        box-shadow: 0 0 12px rgba(99, 102, 241, 0.6);
        transform: scale(1.05);
    }

    #phaser-game-canvas {
        border-radius: 0.75rem;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    }

    #game-wrapper {
        position: relative;
        width: 100%;
    }

    #game-container {
        width: 100%;
        aspect-ratio: 8 / 5;  /* normal view keeps 8:5; fullscreen overrides via fs-mode */
    }

    #fullscreen-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 20;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid rgba(99, 102, 241, 0.5);
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(6px);
        color: #a5b4fc;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
        line-height: 1;
    }

    #fullscreen-btn:hover {
        background: rgba(99, 102, 241, 0.4);
        border-color: rgba(99, 102, 241, 0.9);
        color: #ffffff;
    }

    /* Fake fullscreen — 跨浏览器通用，含 iOS Safari */
    #game-wrapper.fs-mode {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw !important;
        height: 100dvh !important;
        background: #0c1020;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    #game-wrapper.fs-mode #game-container {
        width: 100vw;
        height: 100dvh;
        aspect-ratio: unset;
    }

    /* 桌面端原生全屏兜底 */
    :fullscreen #game-wrapper,
    :-webkit-full-screen #game-wrapper {
        width: 100vw;
        height: 100vh;
        background: #0c1020;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    :fullscreen #game-container,
    :-webkit-full-screen #game-container {
        width: 100vw;
        height: 100vh;
        aspect-ratio: unset;
    }
</style>

<div class="vocab-game-container relative z-10">
    <div class="flex flex-col lg:flex-row gap-6">
        <!-- 左侧配置与统计栏 -->
        <div class="w-full lg:w-1/4 flex flex-col gap-6 relative z-10">
