    const linkAiBtn = document.getElementById('linkAiBtn');
    const linkAiInput = document.getElementById('responderAiIdInput');
    const linkAiStatus = document.getElementById('linkAiStatus');
    linkAiBtn?.addEventListener('click', async () => {
        const aiId = (linkAiInput.value || '').trim();
        if (!aiId) { linkAiStatus.textContent = 'AI ID を入力してください。'; return; }
        linkAiBtn.disabled = true;
        try {
            const res = await fetch('@linkAiUrl', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ aiId })
            });
            const data = await res.json();
            if (!res.ok) {
                linkAiStatus.textContent = data.error || 'エラーが発生しました。';
            } else if (data.note) {
                // 自分自身のAI IDを連携しようとした等、局所的なガードに引っかかったケース
                linkAiStatus.textContent = data.note;
            } else if (data.linkedLocally) {
                // 同一インスタンス内で相手の ai_identity が解決できた → AI同士の自動交渉パネルを出すため再読み込み
                linkAiStatus.textContent = `🤖🤝🤖 ${data.responderDisplayName || data.aiId} の AI と連携しました。交渉パネルを表示します…`;
                setTimeout(() => location.reload(), 900);
            } else {
                linkAiStatus.textContent = '連携済み（この ID は同じサーバー内には見つかりませんでした）。将来、離れたサーバーの AI 同士でも自動でやり取りできるようになります。';
            }
