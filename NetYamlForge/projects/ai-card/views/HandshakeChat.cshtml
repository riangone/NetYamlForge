    // ── 名刺を画像として保存（外部ライブラリ不要、canvas で自前描画） ──
    const saveCardBtn = document.getElementById('saveCardBtn');
    saveCardBtn?.addEventListener('click', async () => {
        saveCardBtn.disabled = true;
        try {
            await downloadCardImage();
        } catch (e) {
            alert('画像の生成に失敗しました。');
        } finally {
            saveCardBtn.disabled = false;
        }
    });

    function loadImage(src) {
        return new Promise((resolve, reject) => {
            const img = new Image();
            img.crossOrigin = 'anonymous'; // QR 画像を canvas に描いた後 toDataURL() するために CORS 許可が必要
            img.onload = () => resolve(img);
            img.onerror = reject;
            img.src = src;
        });
    }

    function wrapText(ctx, text, x, y, maxWidth, lineHeight) {
        const words = text.split('');
        let line = '';
        let curY = y;
        for (const ch of words) {
            const test = line + ch;
            if (ctx.measureText(test).width > maxWidth && line) {
                ctx.fillText(line, x, curY);
                line = ch;
                curY += lineHeight;
            } else {
                line = test;
            }
        }
        if (line) ctx.fillText(line, x, curY);
        return curY + lineHeight;
    }

    async function downloadCardImage() {
        // スマホで撮った/保存した名刺画像は縦持ちで見返すことが多いため、縦長を既定にする。
        // 比率は横長版（1050×600 ≒ 1.75:1）を単純に 90°回転させた 600×1050（≒ 1:1.75、
        // 実物名刺 91mm×55mm を縦持ちにした場合と同じ比率）を採用し、「実物と比率が合わない」
        // 問題が再発しないようにする。
        const W = 600, H = 1050;
        const canvas = document.createElement('canvas');
        canvas.width = W; canvas.height = H;
        const ctx = canvas.getContext('2d');

        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, W, H);
        ctx.strokeStyle = '#e5e7eb';
        ctx.lineWidth = 2;
        ctx.strokeRect(1, 1, W - 2, H - 2);

        const margin = 48;
        const contentWidth = W - margin * 2;

        // ── アバター（CJK 対応フォントを明示し、文字化け/豆腐表示を防ぐ） ──
        const cx = W / 2, cy = margin + 55, r = 55;
        ctx.fillStyle = '#eef2ff';
        ctx.beginPath();
        ctx.roundRect(cx - r, cy - r, r * 2, r * 2, 20);
        ctx.fill();
        ctx.fillStyle = '#4f46e5';
        ctx.font = `700 44px ${CJK_FONT_STACK}`;
        ctx.textBaseline = 'middle';
        ctx.textAlign = 'center';
        ctx.fillText(@Json.Serialize(initial), cx, cy + 4);

        // ── 名前 / AI ID / 所属（縦持ちはアバター下に中央揃えで積む） ──
        let y = cy + r + 44;
        ctx.textBaseline = 'alphabetic';
        ctx.fillStyle = '#1e293b';
        ctx.font = `800 30px ${CJK_FONT_STACK}`;
        ctx.fillText(@Json.Serialize(Model.InitiatorName), cx, y);
        y += 30;
        ctx.fillStyle = '#4f46e5';
        ctx.font = "400 17px ui-monospace, monospace";
        ctx.fillText(@Json.Serialize(Model.InitiatorAiId), cx, y);
        y += 26;

        const orgLine = @Json.Serialize(string.Join(" ・ ", new[] { Model.InitiatorOrg, Model.InitiatorRole }.Where(s => !string.IsNullOrEmpty(s))));
        if (orgLine) {
            ctx.fillStyle = '#475569';
            ctx.font = `400 15px ${CJK_FONT_STACK}`;
            ctx.fillText(orgLine, cx, y);
            y += 26;
        }

        // ── 区切り線 ──
        y += 12;
        ctx.strokeStyle = '#e5e7eb';
        ctx.beginPath(); ctx.moveTo(margin, y); ctx.lineTo(W - margin, y); ctx.stroke();
        y += 34;

        // ── QR コード + URL（スキャンした人がその場で自分の AI エージェントと会話を始められる入口） ──
        // 縦持ちは横幅が限られるため、QR はテキストの下に大きめに中央配置する。
        const qrSize = 220;
        const qrX = cx - qrSize / 2;
        const qrY = y;
        ctx.strokeStyle = '#e5e7eb';
        ctx.lineWidth = 1;
        ctx.strokeRect(qrX - 1, qrY - 1, qrSize + 2, qrSize + 2);
        if (initiatorQrUrl) {
            try {
                const qrPixels = qrSize * 2; // Retina 表示でも滲まないよう高解像度で取得
                const qrImgSrc = 'https://api.qrserver.com/v1/create-qr-code/?size=' + qrPixels + 'x' + qrPixels
                    + '&margin=8&data=' + encodeURIComponent(initiatorQrUrl);
                const qrImg = await loadImage(qrImgSrc);
                ctx.drawImage(qrImg, qrX, qrY, qrSize, qrSize);
            } catch (e) {
                // QR 画像の取得に失敗しても名刺自体は保存できるようにする
                ctx.fillStyle = '#94a3b8';
                ctx.font = `400 12px ${CJK_FONT_STACK}`;
                ctx.textAlign = 'center';
                ctx.fillText('QR 取得失敗', qrX + qrSize / 2, qrY + qrSize / 2);
            }
            ctx.fillStyle = '#64748b';
            ctx.font = `400 11px ${CJK_FONT_STACK}`;
            ctx.textAlign = 'center';
            wrapText(ctx, initiatorQrUrl.replace(/^https?:\/\//, ''), qrX + qrSize / 2, qrY + qrSize + 20, qrSize + 24, 14);
        }
        y = qrY + qrSize + 46;

        const bottomLimit = H - 90;
        ctx.textAlign = 'left';

        // ── 専門分野タグ ──
        const expertise = @Json.Serialize(Model.InitiatorExpertise);
        if (expertise.length && y < bottomLimit) {
            ctx.fillStyle = '#6366f1';
            ctx.font = `700 14px ${CJK_FONT_STACK}`;
            ctx.fillText('専門分野', margin, y);
            y += 26;
            let x = margin;
            ctx.font = `400 14px ${CJK_FONT_STACK}`;
            for (const tag of expertise) {
                const w = ctx.measureText(tag).width + 26;
                if (x + w > margin + contentWidth) { x = margin; y += 38; }
                if (y > bottomLimit) break;
                ctx.fillStyle = '#eef2ff';
                ctx.beginPath();
                ctx.roundRect(x, y - 22, w, 30, 99);
                ctx.fill();
                ctx.fillStyle = '#4338ca';
                ctx.fillText(tag, x + 13, y);
                x += w + 8;
            }
            y += 46;
        }

        // ── 関心・ゴール（収まる分だけ表示） ──
        const goals = @Json.Serialize(Model.InitiatorGoals);
        if (goals.length && y < bottomLimit) {
            ctx.fillStyle = '#6366f1';
            ctx.font = `700 14px ${CJK_FONT_STACK}`;
            ctx.fillText('関心・ゴール', margin, y);
            y += 24;
            ctx.fillStyle = '#475569';
            ctx.font = `400 14px ${CJK_FONT_STACK}`;
            for (const g of goals) {
                if (y > bottomLimit) break;
                y = wrapText(ctx, '・' + g, margin, y, contentWidth, 20) + 4;
            }
        }

        // ── フッター ──
        ctx.fillStyle = '#f8fafc';
        ctx.fillRect(0, H - 56, W, 56);
        ctx.fillStyle = '#64748b';
        ctx.font = `600 13px ${CJK_FONT_STACK}`;
        ctx.textAlign = 'center';
        ctx.fillText('AI Handshake Protocol (AHP) — digital business card', W / 2, H - 22);

        const url = canvas.toDataURL('image/png');
        const a = document.createElement('a');
        a.href = url;
        a.download = (@Json.Serialize(Model.InitiatorName) || 'ai-card') + '-card.png';
        document.body.appendChild(a);
        a.click();
        a.remove();
    }
</script>
</body>
</html>
