    // ── 相手がまだ ai:// を持っていない場合、その場で仮の AI 名刺を発行する ──
    // 「同じインスタンス内に相手の ai_identity が要る」という前提を、正式登録という重い壁なしで
    // その場で満たす入口。owner_type='guest' として作成されるため、正式な身元より情報が少なく
    // 信頼度が低いことは提案カード側（responderIsGuest）で別途明示する。
    const guestAiBtn = document.getElementById('guestAiBtn');
    const guestNameInput = document.getElementById('guestNameInput');
    const guestGoalInput = document.getElementById('guestGoalInput');
    const guestAiStatus = document.getElementById('guestAiStatus');
    guestAiBtn?.addEventListener('click', async () => {
        guestAiBtn.disabled = true;
        guestAiStatus.textContent = '作成しています…';
