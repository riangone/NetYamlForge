    idCheckInput?.addEventListener('input', () => {
        const raw = idCheckInput.value.trim();
        clearTimeout(idCheckTimer);
        if (!raw) {
            idCheckResult.textContent = '';
            idCheckResult.className = 'id-check-result';
            mirrorCard.style.display = 'none';
