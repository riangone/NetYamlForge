@using NetYamlForge.Localization
@using System.Text.Json
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    var currentProject = Context.GetRouteValue("project")?.ToString() ?? "diary-companion";
    
    var detailRow = Model.TryGetValue("diary_detail", out var detailSection)
        ? detailSection.Rows.FirstOrDefault()
        : null;

    bool isEdit = detailRow != null;
    var id = isEdit ? detailRow["Id"]?.ToString() : "";
    var title = isEdit ? detailRow.TryGetValue("Title", out var t) ? t?.ToString() ?? "" : "" : "";
    var content = isEdit ? detailRow.TryGetValue("Content", out var cn) ? cn?.ToString() ?? "" : "" : "";
    var weather = isEdit ? detailRow.TryGetValue("Weather", out var w) ? w?.ToString() ?? "" : "" : "";
    var mood = isEdit ? detailRow.TryGetValue("MoodBefore", out var m) ? m?.ToString() ?? "" : "" : "";
    var location = isEdit ? detailRow.TryGetValue("Location", out var l) ? l?.ToString() ?? "" : "" : "";

    ViewData["Title"] = isEdit ? "编辑我的日记" : "记录我的心情";
    var cancelUrl = Url.Action("Index", "Page", new { project = currentProject, pageName = "HomePage" });

    // 心情列表和 Emoji
    var moodList = new[] {
        new { Name = "喜悦", Emoji = "🌸", Desc = "开心美好" },
        new { Name = "平静", Emoji = "🍃", Desc = "波澜不惊" },
        new { Name = "焦虑", Emoji = "🌪️", Desc = "有些烦躁" },
        new { Name = "忧郁", Emoji = "🌧️", Desc = "有点难过" },
        new { Name = "愤怒", Emoji = "⚡", Desc = "怒火中烧" },
        new { Name = "疲惫", Emoji = "💤", Desc = "身心俱疲" }
    };

    // 天气列表和 Emoji
    var weatherList = new[] {
        new { Name = "晴朗", Emoji = "☀️" },
        new { Name = "多云", Emoji = "⛅" },
        new { Name = "阴天", Emoji = "☁️" },
        new { Name = "雨天", Emoji = "🌧️" },
        new { Name = "雪天", Emoji = "❄️" },
        new { Name = "微风", Emoji = "🌬️" }
    };
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }
    .emoji-btn {
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .emoji-btn.active {
        transform: scale(1.15);
        border-color: #6366f1 !important;
        background-color: #f5f3ff !important;
        box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.15);
    }
    .input-focus-effect:focus {
        border-color: #6366f1 !important;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
    }
    .animate-spin-slow {
        animation: spin 3s linear infinite;
    }
    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
</style>

<div class="max-w-3xl mx-auto px-4 py-8">
    
    <!-- Navigation Back Link -->
    <div class="mb-6">
        <a href="@cancelUrl" class="inline-flex items-center gap-1.5 text-xs text-gray-500 hover:text-indigo-600 font-semibold transition-all">
            <span>⬅️</span> 返回日记列表
        </a>
    </div>

    <!-- Form Main Panel -->
    <div class="card glass-card border border-purple-100 shadow-xl rounded-3xl overflow-hidden">
        
        <!-- Header banner -->
        <div class="p-6 md:p-8 bg-gradient-to-r from-indigo-50 via-purple-50 to-pink-50 border-b border-purple-100 flex items-center justify-between">
            <div class="space-y-1.5">
                <span class="text-2xl">✍️</span>
                <h2 class="text-2xl font-extrabold text-gray-800">@(isEdit ? "重温旧日思绪" : "写下今日篇章")</h2>
                <p class="text-xs text-gray-500">
                    @(isEdit ? "随时可以完善和更改你的记录，AI 伴侣将为你重新解读心情。" : "在这里倾诉吧，没人知道你是谁，只有 AI 默默陪伴你。")
                </p>
            </div>
            <div class="text-3xl opacity-30 select-none">✏️</div>
        </div>

        <form id="diary-form" class="p-6 md:p-8 space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" id="diary-id" value="@id" />
            <input type="hidden" id="MoodBefore" name="MoodBefore" value="@mood" />
            <input type="hidden" id="Weather" name="Weather" value="@weather" />

            <!-- Title Input -->
            <div class="form-control w-full space-y-1.5">
                <label class="label p-0">
                    <span class="label-text font-bold text-gray-700">日记标题</span>
                </label>
                <input type="text" id="Title" name="Title" value="@title" placeholder="今天发生了什么有趣的事？" class="input input-bordered w-full rounded-xl input-focus-effect" required />
                <span id="err-Title" class="text-xs text-rose-500 hidden"></span>
            </div>

            <!-- Row: Weather & Location -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Location Input -->
                <div class="form-control space-y-1.5">
                    <label class="label p-0">
                        <span class="label-text font-bold text-gray-700">写日记的地点</span>
                    </label>
                    <div class="relative flex items-center">
                        <input type="text" id="Location" name="Location" value="@location" placeholder="你在哪里写下这篇日记？(可选)" class="input input-bordered w-full rounded-xl pr-28 input-focus-effect" />
                        <button type="button" id="geo-btn" onclick="getGeolocation()" class="absolute right-2 btn btn-xs btn-primary bg-indigo-600 hover:bg-indigo-700 border-none rounded-lg text-white font-semibold">
                            📍 自动获取
                        </button>
                    </div>
                </div>

                <!-- Weather Cards Selection -->
                <div class="form-control space-y-1.5">
                    <label class="label p-0">
                        <span class="label-text font-bold text-gray-700">今日天气</span>
                    </label>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var wItem in weatherList)
                        {
                            <button type="button" onclick="selectWeather('@wItem.Name')" id="weather-btn-@wItem.Name" class="weather-option btn btn-sm btn-outline border-gray-200 hover:bg-indigo-50 hover:border-indigo-300 rounded-lg flex items-center gap-1 text-xs">
                                <span>@wItem.Emoji</span>
                                <span>@wItem.Name</span>
                            </button>
                        }
                    </div>
                    <span id="err-Weather" class="text-xs text-rose-500 hidden"></span>
                </div>
            </div>

            <!-- Mood Selection Grid -->
            <div class="form-control space-y-2">
                <label class="label p-0">
                    <span class="label-text font-bold text-gray-700">记录前心情</span>
                </label>
                <div class="grid grid-cols-3 md:grid-cols-6 gap-3">
                    @foreach (var mItem in moodList)
                    {
                        <button type="button" onclick="selectMood('@mItem.Name')" id="mood-btn-@mItem.Name" class="mood-option emoji-btn flex flex-col items-center justify-center p-3 border border-gray-200 rounded-2xl bg-white hover:bg-indigo-50/50 hover:border-indigo-300">
                            <span class="text-2xl mb-1 filter drop-shadow-sm">@mItem.Emoji</span>
                            <span class="text-xs font-bold text-gray-700">@mItem.Name</span>
                            <span class="text-[9px] text-gray-400">@mItem.Desc</span>
                        </button>
                    }
                </div>
                <span id="err-MoodBefore" class="text-xs text-rose-500 hidden"></span>
            </div>

            <!-- Content Input -->
            <div class="form-control w-full space-y-1.5">
                <label class="label p-0">
                    <span class="label-text font-bold text-gray-700">日记内容</span>
                </label>
                <textarea id="Content" name="Content" rows="8" placeholder="写下你的心情、所思所想..." class="textarea textarea-bordered w-full rounded-2xl min-h-[200px] input-focus-effect leading-relaxed" required>@content</textarea>
                <span id="err-Content" class="text-xs text-rose-500 hidden"></span>
            </div>

            <!-- Form Actions -->
            <div class="pt-4 flex items-center justify-end gap-3 border-t border-gray-100">
                <a href="@cancelUrl" class="btn btn-sm btn-ghost rounded-xl px-4 text-gray-500">取消</a>
                <button type="submit" id="submit-btn" class="btn btn-sm btn-primary bg-indigo-600 hover:bg-indigo-700 border-none px-6 rounded-xl text-white shadow-md shadow-indigo-100 flex items-center gap-2">
                    <span>💾</span> 保存日记
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ===== Loading Mask (AI analysis) ===== -->
<div id="loading-overlay" class="fixed inset-0 bg-gray-900/40 backdrop-blur-md flex items-center justify-center z-50 hidden">
    <div class="card glass bg-white/90 p-8 rounded-3xl max-w-sm text-center shadow-2xl space-y-4 border border-white">
        <div class="flex justify-center">
            <span class="text-5xl animate-spin-slow">🧠</span>
        </div>
        <div class="space-y-1.5">
            <h4 class="font-extrabold text-gray-800 text-base">心灵对话中...</h4>
            <p class="text-xs text-gray-500 leading-relaxed">
                AI 伴侣正在认真阅读你的日记，感知你此时的心情，并为你撰写暖心的寄语……请稍候。
            </p>
        </div>
        <div class="w-full bg-gray-100 h-1.5 rounded-full overflow-hidden">
            <div class="bg-indigo-600 h-full animate-pulse" style="width: 100%"></div>
        </div>
    </div>
</div>

<script>
    // 页面初始化：高亮已有选值
    window.addEventListener('DOMContentLoaded', () => {
        const currentMood = document.getElementById('MoodBefore').value;
        if (currentMood) selectMood(currentMood);

        const currentWeather = document.getElementById('Weather').value;
        if (currentWeather) selectWeather(currentWeather);
    });

    function selectMood(moodName) {
        document.getElementById('MoodBefore').value = moodName;
        // 清除所有高亮
        document.querySelectorAll('.mood-option').forEach(el => el.classList.remove('active'));
        // 激活当前
        const btn = document.getElementById(`mood-btn-${moodName}`);
        if (btn) btn.classList.add('active');
        clearError('MoodBefore');
    }

    function selectWeather(weatherName) {
        document.getElementById('Weather').value = weatherName;
        // 清除所有高亮
        document.querySelectorAll('.weather-option').forEach(el => {
            el.classList.remove('btn-primary', 'text-white', 'border-indigo-600');
            el.classList.add('btn-outline', 'border-gray-200');
        });
        // 激活当前
        const btn = document.getElementById(`weather-btn-${weatherName}`);
        if (btn) {
            btn.classList.add('btn-primary', 'text-white', 'border-indigo-600');
            btn.classList.remove('btn-outline', 'border-gray-200');
        }
        clearError('Weather');
    }

    function clearError(field) {
        const errEl = document.getElementById(`err-${field}`);
        if (errEl) {
            errEl.innerText = '';
            errEl.classList.add('hidden');
        }
    }

    function showError(field, msg) {
        const errEl = document.getElementById(`err-${field}`);
        if (errEl) {
            errEl.innerText = msg;
            errEl.classList.remove('hidden');
        }
    }

    // Geolocation 获取地理位置
    async function getGeolocation() {
        if (!navigator.geolocation) {
            alert("您的浏览器不支持获取地理位置。");
            return;
        }
        const btn = document.getElementById("geo-btn");
        const input = document.getElementById("Location");
        const originalText = btn.innerHTML;
        btn.innerHTML = "⏳ 获取中...";
        btn.disabled = true;
        
        navigator.geolocation.getCurrentPosition(
            async (position) => {
                const lat = position.coords.latitude;
                const lon = position.coords.longitude;
                try {
                    const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&accept-language=zh`, {
                        headers: {
                            'User-Agent': 'NetYamlForge-DiaryCompanion'
                        }
                    });
                    if (response.ok) {
                        const data = await response.json();
                        const addr = data.display_name || data.address.city || data.address.town || data.address.suburb || "未知地点";
                        const parts = addr.split(',');
                        // 取核心段落
                        input.value = parts[0] || addr;
                    } else {
                        input.value = `${lat.toFixed(4)}, ${lon.toFixed(4)}`;
                    }
                } catch (e) {
                    input.value = `${lat.toFixed(4)}, ${lon.toFixed(4)}`;
                }
                btn.innerHTML = originalText;
                btn.disabled = false;
            },
            (err) => {
                alert("无法自动获取位置，请手动录入。");
                btn.innerHTML = originalText;
                btn.disabled = false;
            },
            { timeout: 8000 }
        );
    }

    // 表单提交 AJAX 处理
    document.getElementById('diary-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // 简单客户端检验
        let valid = true;
        const title = document.getElementById('Title').value.trim();
        const content = document.getElementById('Content').value.trim();
        const mood = document.getElementById('MoodBefore').value;
        const weather = document.getElementById('Weather').value;
        const id = document.getElementById('diary-id').value;

        if (!title) { showError('Title', '请写个日记标题吧'); valid = false; }
        if (!content) { showError('Content', '请记录你的日记内容'); valid = false; }
        if (!mood) { showError('MoodBefore', '请选择你当前的心情'); valid = false; }
        if (!weather) { showError('Weather', '请选择今天的天气'); valid = false; }

        if (!valid) return;

        // 显示 Loading 蒙版
        const overlay = document.getElementById('loading-overlay');
        overlay.classList.remove('hidden');

        // 构建请求 Body
        const bodyData = {
            Title: title,
            Content: content,
            MoodBefore: mood,
            Weather: weather,
            Location: document.getElementById('Location').value.trim()
        };

        const isEditMode = !!id;
        const url = isEditMode
            ? `/api/${window.NetYamlForgeConfig.currentProject}/diary_entry/${id}`
            : `/api/${window.NetYamlForgeConfig.currentProject}/diary_entry`;
        const method = isEditMode ? 'PUT' : 'POST';

        try {
            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify(bodyData)
            });

            if (response.ok) {
                // 保存成功，跳转回日记首页
                window.location.href = '@cancelUrl';
            } else {
                overlay.classList.add('hidden');
                const result = await response.json();
                if (result.errors) {
                    // 表单字段检验错误
                    for (const [key, msg] of Object.entries(result.errors)) {
                        showError(key, msg);
                    }
                    alert("保存失败，请检查表单中填错的字段。");
                } else {
                    alert(`保存出错: ${result.error || '未知原因'}`);
                }
            }
        } catch (error) {
            overlay.classList.add('hidden');
            console.error('Submit error:', error);
            alert("发生网络错误，请稍后再试");
        }
    });
</script>
