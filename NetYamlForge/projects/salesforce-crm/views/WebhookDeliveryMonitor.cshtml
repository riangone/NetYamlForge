@using NetYamlForge.Models
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    Layout = ViewBag.LayoutPath ?? "_Layout";

    string T(string key, string fallback) => I18nText.ResolveByKey(key) ?? fallback;

    ViewData["Title"] = T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.title", "Webhook Delivery Monitor");
    var events = Model.TryGetValue("webhook_events", out var e) ? e.Rows.ToList() : new List<Dictionary<string, object>>();
    var endpoints = Model.TryGetValue("endpoint_reliability", out var p) ? p.Rows.ToList() : new List<Dictionary<string, object>>();
}

<div class="space-y-6">
    <section class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm">
        <h1 class="text-2xl font-bold">@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.title", "Webhook Delivery Monitor")</h1>
        <p class="mt-1 text-sm opacity-70">@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.description", "Delivery timeline for webhook events with retry analysis and endpoint reliability metrics.")</p>
    </section>

    <section class="rounded-2xl border border-base-300 bg-base-100 p-4 shadow-sm">
        <h2 class="text-lg font-semibold">@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.endpoint_reliability.title", "Endpoint Reliability")</h2>
        <div class="mt-3 overflow-x-auto">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.endpoint_reliability.columns.Endpoint", "Endpoint")</th>
                        <th class="text-right">@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.endpoint_reliability.columns.EventCount", "Events")</th>
                        <th class="text-right">@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.endpoint_reliability.columns.FailedCount", "Failed")</th>
                        <th class="text-right">@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.endpoint_reliability.columns.RetryCount", "Retries")</th>
                        <th class="text-right">@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.endpoint_reliability.columns.SuccessRate", "Success Rate")</th>
                        <th>@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.endpoint_reliability.columns.LastEventAt", "Last Event")</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in endpoints)
                {
                    <tr>
                        <td>@(row.TryGetValue("Endpoint", out var c0) ? c0 : "")</td>
                        <td class="text-right">@(row.TryGetValue("EventCount", out var c1) ? c1 : "")</td>
                        <td class="text-right">@(row.TryGetValue("FailedCount", out var c2) ? c2 : "")</td>
                        <td class="text-right">@(row.TryGetValue("RetryCount", out var c3) ? c3 : "")</td>
                        <td class="text-right">@(row.TryGetValue("SuccessRate", out var c4) ? c4 : "")%</td>
                        <td>@(row.TryGetValue("LastEventAt", out var c5) ? c5 : "")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="rounded-2xl border border-base-300 bg-base-100 p-4 shadow-sm">
        <h2 class="text-lg font-semibold">@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.webhook_events.title", "Webhook Events")</h2>
        <div class="mt-3 overflow-x-auto">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.webhook_events.columns.EventId", "Event ID")</th>
                        <th>@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.webhook_events.columns.Domain", "Domain")</th>
                        <th>@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.webhook_events.columns.Action", "Action")</th>
                        <th>@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.webhook_events.columns.DeliveryStatus", "Delivery")</th>
                        <th class="text-right">@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.webhook_events.columns.RetryCount", "Retries")</th>
                        <th>@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.sections.webhook_events.columns.CreatedAt", "Created At")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!events.Any())
                    {
                        <tr><td colspan="6" class="py-6 text-center text-base-content/50">@T("projects.salesforce-crm.pages.WebhookDeliveryMonitor.empty", "No webhook events.")</td></tr>
                    }
                    else
                    {
                        foreach (var row in events)
                        {
                            var status = row.TryGetValue("DeliveryStatus", out var s) ? s?.ToString() ?? "" : "";
                            <tr>
                                <td>@(row.TryGetValue("EventId", out var c0) ? c0 : "")</td>
                                <td>@(row.TryGetValue("Domain", out var c1) ? c1 : "")</td>
                                <td>@(row.TryGetValue("Action", out var c2) ? c2 : "")</td>
                                <td>
                                    <span class="badge @(status == "Failed" ? "badge-error" : status == "Retrying" ? "badge-warning" : status == "Delivered" ? "badge-success" : "badge-info")">@status</span>
                                </td>
                                <td class="text-right">@(row.TryGetValue("RetryCount", out var c3) ? c3 : "")</td>
                                <td>@(row.TryGetValue("CreatedAt", out var c4) ? c4 : "")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
