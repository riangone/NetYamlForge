@using NetYamlForge.Models
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    Layout = ViewBag.LayoutPath ?? "_Layout";

    var currentProject = ViewData["Project"] as string ?? "salesforce-crm";
    var isAdmin = (ViewData["IsAdmin"] as bool?) ?? User.IsInRole("Admin");
    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Unknown";
    var roleName = isAdmin ? "Admin" : "User";
    var snapshotRows = Model.TryGetValue("workload_snapshot", out var snapshotSection)
        ? snapshotSection.Rows.ToList()
        : new List<Dictionary<string, object>>();
    var snapshot = snapshotRows.FirstOrDefault() ?? new Dictionary<string, object>();
    var userRows = Model.TryGetValue("user_directory", out var usersSection)
        ? usersSection.Rows.ToList()
        : new List<Dictionary<string, object>>();

    string Cell(Dictionary<string, object> row, string key)
        => row.TryGetValue(key, out var v) ? (v?.ToString() ?? "-") : "-";
}

<div class="space-y-6">
    <section class="rounded-box border border-base-300 bg-base-100 p-6">
        <p class="text-xs uppercase tracking-wide text-base-content/60">CRM Role Landing</p>
        <h1 class="mt-2 text-2xl font-bold">Operation Workbench</h1>
        <p class="mt-2 text-sm text-base-content/70">ログイン中ユーザー: <span class="font-semibold">@displayName</span> / 権限: <span class="badge badge-primary">@roleName</span></p>
        <p class="mt-2 text-sm text-base-content/70">入力開始点と実行画面を役割別にまとめています。迷った場合は「Step 1」から順に進めてください。</p>
    </section>

    <section class="grid grid-cols-1 gap-4 md:grid-cols-4">
        <div class="stat rounded-box border border-base-300 bg-base-100">
            <div class="stat-title">Open Deals</div>
            <div class="stat-value text-primary">@Cell(snapshot, "OpenDeals")</div>
        </div>
        <div class="stat rounded-box border border-base-300 bg-base-100">
            <div class="stat-title">Delayed Deals</div>
            <div class="stat-value text-warning">@Cell(snapshot, "DelayedDeals")</div>
        </div>
        <div class="stat rounded-box border border-base-300 bg-base-100">
            <div class="stat-title">Active Cases</div>
            <div class="stat-value text-error">@Cell(snapshot, "ActiveCases")</div>
        </div>
        <div class="stat rounded-box border border-base-300 bg-base-100">
            <div class="stat-title">Active Accounts</div>
            <div class="stat-value text-success">@Cell(snapshot, "ActiveAccounts")</div>
        </div>
    </section>

    <section class="rounded-box border border-primary/30 bg-primary/5 p-5">
        <h2 class="text-lg font-semibold">Start Here: 実データ入力の開始点</h2>
        <p class="mt-1 text-sm text-base-content/70">このプロジェクトは分析ページが多いため、初回入力は次の 3 手順が起点です。</p>
        <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-3">
            <article class="rounded-box border border-base-300 bg-base-100 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Step 1</p>
                <h3 class="mt-1 text-base font-semibold">顧客マスタを登録</h3>
                <p class="mt-1 text-sm text-base-content/70">取引先を先に作成します。</p>
                <div class="mt-3 flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-primary" href="/@(currentProject)/DynamicEntity/CreatePage?entity=customer&returnUrl=%2F@(currentProject)%2FPage%2FOperationWorkbench">顧客を新規作成</a>
                    <a class="btn btn-sm btn-outline" href="/@(currentProject)/DynamicEntity/Index?entity=customer">顧客一覧</a>
                </div>
            </article>
            <article class="rounded-box border border-base-300 bg-base-100 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Step 2</p>
                <h3 class="mt-1 text-base font-semibold">受注ヘッダを登録</h3>
                <p class="mt-1 text-sm text-base-content/70">顧客に紐づく案件/受注を作成します。</p>
                <div class="mt-3 flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-primary" href="/@(currentProject)/DynamicEntity/CreatePage?entity=order&returnUrl=%2F@(currentProject)%2FPage%2FOperationWorkbench">受注を新規作成</a>
                    <a class="btn btn-sm btn-outline" href="/@(currentProject)/DynamicEntity/Index?entity=order">受注一覧</a>
                </div>
            </article>
            <article class="rounded-box border border-base-300 bg-base-100 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Step 3</p>
                <h3 class="mt-1 text-base font-semibold">受注明細を追加</h3>
                <p class="mt-1 text-sm text-base-content/70">商品行を追加して金額を確定します。</p>
                <div class="mt-3 flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-primary" href="/@(currentProject)/DynamicEntity/CreatePage?entity=orderdetail&returnUrl=%2F@(currentProject)%2FPage%2FOperationWorkbench">明細を新規作成</a>
                    <a class="btn btn-sm btn-outline" href="/@(currentProject)/DynamicEntity/Index?entity=orderdetail">明細一覧</a>
                </div>
            </article>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-4 xl:grid-cols-3">
        <article class="rounded-box border border-base-300 bg-base-100 p-5">
            <h2 class="text-lg font-semibold">A. 営業運用</h2>
            <p class="mt-1 text-sm text-base-content/70">新規入力済みデータの優先順位付けと商談進行。</p>
            <div class="mt-4 flex flex-wrap gap-2">
                <a class="btn btn-sm btn-primary" href="/@(currentProject)/Page/LeadInbox">Lead Inbox</a>
                <a class="btn btn-sm btn-outline" href="/@(currentProject)/Page/LeadDetail360">Lead Detail 360</a>
                <a class="btn btn-sm btn-outline" href="/@(currentProject)/Page/OpportunityWorkspace">Opportunity Workspace</a>
            </div>
        </article>
        <article class="rounded-box border border-base-300 bg-base-100 p-5">
            <h2 class="text-lg font-semibold">B. 受注実行</h2>
            <p class="mt-1 text-sm text-base-content/70">作成済み受注の見積・契約・出荷状況を管理。</p>
            <div class="mt-4 flex flex-wrap gap-2">
                <a class="btn btn-sm btn-primary" href="/@(currentProject)/Page/QuoteBuilder">Quote Builder</a>
                <a class="btn btn-sm btn-outline" href="/@(currentProject)/Page/OrderManagement">Order Management</a>
                <a class="btn btn-sm btn-outline" href="/@(currentProject)/Page/ContractCenter">Contract Center</a>
            </div>
        </article>
        <article class="rounded-box border border-base-300 bg-base-100 p-5">
            <h2 class="text-lg font-semibold">C. サービス復旧</h2>
            <p class="mt-1 text-sm text-base-content/70">遅延/障害案件の対応と SLA 回復。</p>
            <div class="mt-4 flex flex-wrap gap-2">
                <a class="btn btn-sm btn-primary" href="/@(currentProject)/Page/CaseQueue">Case Queue</a>
                <a class="btn btn-sm btn-outline" href="/@(currentProject)/Page/CaseDetail">Case Detail</a>
                <a class="btn btn-sm btn-outline" href="/@(currentProject)/Page/SlaMonitor">SLA Monitor</a>
            </div>
        </article>
    </section>

    <section class="rounded-box border border-base-300 bg-base-100 p-5">
        <h2 class="text-lg font-semibold">Permission Matrix</h2>
        <div class="mt-3 overflow-x-auto">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Operation</th>
                        <th>User</th>
                        <th>Admin</th>
                        <th>Execution Page</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>Lead/Customer follow-up</td><td>Yes</td><td>Yes</td><td><a class="link" href="/@(currentProject)/Page/LeadInbox">Lead Inbox</a></td></tr>
                    <tr><td>Case status update</td><td>Yes</td><td>Yes</td><td><a class="link" href="/@(currentProject)/Page/CaseQueue">Case Queue</a></td></tr>
                    <tr><td>SLA escalation/resolve</td><td>Yes</td><td>Yes</td><td><a class="link" href="/@(currentProject)/Page/SlaMonitor">SLA Monitor</a></td></tr>
                    <tr><td>Approval decision</td><td>No</td><td>Yes</td><td><a class="link" href="/@(currentProject)/Page/ApprovalInbox">Approval Inbox</a></td></tr>
                    <tr><td>User/Role management</td><td>No</td><td>Yes</td><td><a class="link" href="/@(currentProject)/Page/UserRoleProfile">User Role Profile</a></td></tr>
                    <tr><td>Audit/Integration governance</td><td>No</td><td>Yes</td><td><a class="link" href="/@(currentProject)/Page/AuditTrail">Audit Trail</a></td></tr>
                </tbody>
            </table>
        </div>
    </section>

    @if (isAdmin)
    {
        <section class="rounded-box border border-base-300 bg-base-100 p-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <h2 class="text-lg font-semibold">Admin Governance</h2>
                <div class="flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-primary" href="/@(currentProject)/Page/ApprovalInbox">Approval Inbox</a>
                    <a class="btn btn-sm btn-outline" href="/@(currentProject)/Page/UserRoleProfile">User Role Profile</a>
                    <a class="btn btn-sm btn-outline" href="/@(currentProject)/Page/RoleAccessMatrix">Role Access Matrix</a>
                    <a class="btn btn-sm btn-outline" href="/@(currentProject)/Page/AuditTrail">Audit Trail</a>
                </div>
            </div>
            <div class="mt-3 overflow-x-auto">
                <table class="table table-zebra table-sm">
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>User Name</th>
                            <th>Display Name</th>
                            <th>Role</th>
                            <th>State</th>
                            <th>Locale</th>
                            <th>Last Login</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!userRows.Any())
                        {
                            <tr><td colspan="7" class="text-center text-base-content/60">No users found</td></tr>
                        }
                        else
                        {
                            @foreach (var row in userRows)
                            {
                                <tr>
                                    <td>@Cell(row, "UserId")</td>
                                    <td>@Cell(row, "UserName")</td>
                                    <td>@Cell(row, "DisplayName")</td>
                                    <td>@Cell(row, "Role")</td>
                                    <td>@Cell(row, "State")</td>
                                    <td>@Cell(row, "Locale")</td>
                                    <td>@Cell(row, "LastLoginAt")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
        <section class="rounded-box border border-base-300 bg-base-100 p-5">
            <h2 class="text-lg font-semibold">Your Next Actions</h2>
            <p class="mt-1 text-sm text-base-content/70">管理者ガバナンス画面は非表示です。まずは上部の Step 1〜3 で入力し、その後に実行系画面へ進んでください。</p>
            <div class="mt-4 flex flex-wrap gap-2">
                <a class="btn btn-sm btn-primary" href="/@(currentProject)/Page/LeadInbox">Lead Inbox</a>
                <a class="btn btn-sm btn-primary" href="/@(currentProject)/Page/ActivityConsole">Activity Console</a>
                <a class="btn btn-sm btn-primary" href="/@(currentProject)/Page/CaseQueue">Case Queue</a>
            </div>
        </section>
    }
</div>
