@using NetYamlForge.Models
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    Layout = ViewBag.LayoutPath ?? "_Layout";

    string T(string key, string fallback) => I18nText.ResolveByKey(key) ?? fallback;

    ViewData["Title"] = T("projects.salesforce-crm.pages.AttributionDashboard.title", "Attribution Dashboard");

    var summaryRows = Model.TryGetValue("attribution_summary", out var summaryData)
        ? summaryData.Rows.ToList()
        : new List<Dictionary<string, object>>();
    var dealRows = Model.TryGetValue("attribution_deals", out var dealData)
        ? dealData.Rows.ToList()
        : new List<Dictionary<string, object>>();
}

<div class="space-y-6">
    <section class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm">
        <h1 class="text-2xl font-bold">@T("projects.salesforce-crm.pages.AttributionDashboard.title", "Attribution Dashboard")</h1>
        <p class="mt-1 text-sm opacity-70">@T("projects.salesforce-crm.pages.AttributionDashboard.description", "Source-to-revenue attribution view for marketing contribution across won, open, and at-risk opportunities.")</p>
    </section>

    <section class="rounded-2xl border border-base-300 bg-base-100 p-4 shadow-sm">
        <h2 class="text-lg font-semibold">@T("projects.salesforce-crm.pages.AttributionDashboard.sections.attribution_summary.title", "Attribution Summary")</h2>
        <div class="mt-3 grid gap-3 md:grid-cols-3">
            @foreach (var row in summaryRows)
            {
                var channel = row.TryGetValue("Channel", out var c0) ? c0?.ToString() ?? "" : "";
                var revenue = row.TryGetValue("Revenue", out var c1) ? c1?.ToString() ?? "0" : "0";
                var dealCount = row.TryGetValue("DealCount", out var c2) ? c2?.ToString() ?? "0" : "0";
                var won = row.TryGetValue("AttributedWon", out var c3) ? c3?.ToString() ?? "0" : "0";
                <article class="rounded-xl border border-base-300 bg-base-200 p-4">
                    <div class="text-xs uppercase opacity-60">@channel</div>
                    <div class="mt-1 text-xl font-semibold">@revenue</div>
                    <div class="mt-1 text-sm opacity-70">Deals: @dealCount | Won: @won</div>
                </article>
            }
        </div>
    </section>

    <section class="rounded-2xl border border-base-300 bg-base-100 p-4 shadow-sm">
        <h2 class="text-lg font-semibold">@T("projects.salesforce-crm.pages.AttributionDashboard.sections.attribution_deals.title", "Attributed Deals")</h2>
        <div class="mt-3 overflow-x-auto">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>@T("projects.salesforce-crm.pages.AttributionDashboard.sections.attribution_deals.columns.OpportunityId", "Opportunity ID")</th>
                        <th>@T("projects.salesforce-crm.pages.AttributionDashboard.sections.attribution_deals.columns.Account", "Account")</th>
                        <th>@T("projects.salesforce-crm.pages.AttributionDashboard.sections.attribution_deals.columns.Region", "Region")</th>
                        <th>@T("projects.salesforce-crm.pages.AttributionDashboard.sections.attribution_deals.columns.Stage", "Stage")</th>
                        <th>@T("projects.salesforce-crm.pages.AttributionDashboard.sections.attribution_deals.columns.CreatedDate", "Created Date")</th>
                        <th class="text-right">@T("projects.salesforce-crm.pages.AttributionDashboard.sections.attribution_deals.columns.Amount", "Amount")</th>
                        <th>@T("projects.salesforce-crm.pages.AttributionDashboard.sections.attribution_deals.columns.AttributedSource", "Attributed Source")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!dealRows.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-6 text-center text-base-content/50">@T("projects.salesforce-crm.pages.AttributionDashboard.empty", "No attributed deals.")</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in dealRows)
                        {
                            <tr>
                                <td>@(row.TryGetValue("OpportunityId", out var c0) ? c0 : "")</td>
                                <td>@(row.TryGetValue("Account", out var c1) ? c1 : "")</td>
                                <td>@(row.TryGetValue("Region", out var c2) ? c2 : "")</td>
                                <td>@(row.TryGetValue("Stage", out var c3) ? c3 : "")</td>
                                <td>@(row.TryGetValue("CreatedDate", out var c4) ? c4 : "")</td>
                                <td class="text-right">@(row.TryGetValue("Amount", out var c5) ? c5 : "")</td>
                                <td>@(row.TryGetValue("AttributedSource", out var c6) ? c6 : "")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
