@using NetYamlForge.Models
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    Layout = ViewBag.LayoutPath ?? "_Layout";

    string T(string key, string fallback) => I18nText.ResolveByKey(key) ?? fallback;

    var currentProject = ViewData["Project"] as string ?? "salesforce-crm";
    var pageName = ViewData["PageName"] as string ?? "CaseDetail";
    ViewData["Title"] = T("projects.salesforce-crm.pages.CaseDetail.title", "Case Detail");

    var detailRows = Model.TryGetValue("case_detail", out var detailData)
        ? detailData.Rows.ToList()
        : new List<Dictionary<string, object>>();
    var activityRows = Model.TryGetValue("case_activity", out var activityData)
        ? activityData.Rows.ToList()
        : new List<Dictionary<string, object>>();

    var criticalCount = detailRows.Count(r => (r.TryGetValue("Severity", out var sv) ? sv?.ToString() : "") == "Critical");
    var delayedCount = detailRows.Count(r => (r.TryGetValue("CaseStatus", out var st) ? st?.ToString() : "") == "Delayed");
}

<div class="space-y-6">
    <section class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm">
        <h1 class="text-2xl font-bold">@T("projects.salesforce-crm.pages.CaseDetail.title", "Case Detail")</h1>
        <p class="mt-1 text-sm opacity-70">@T("projects.salesforce-crm.pages.CaseDetail.description", "Unified case detail with SLA risk, ownership, and latest operational events.")</p>
    </section>

    <section class="grid grid-cols-1 gap-3 md:grid-cols-3">
        <article class="rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm">
            <div class="text-xs opacity-60">@T("projects.salesforce-crm.pages.CaseDetail.cards.total", "Total Cases")</div>
            <div class="mt-1 text-2xl font-semibold">@detailRows.Count</div>
        </article>
        <article class="rounded-xl border border-warning/40 bg-warning/5 p-4 shadow-sm">
            <div class="text-xs opacity-70">@T("projects.salesforce-crm.pages.CaseDetail.cards.delayed", "Delayed Cases")</div>
            <div class="mt-1 text-2xl font-semibold">@delayedCount</div>
        </article>
        <article class="rounded-xl border border-error/40 bg-error/5 p-4 shadow-sm">
            <div class="text-xs opacity-70">@T("projects.salesforce-crm.pages.CaseDetail.cards.critical", "Critical Cases")</div>
            <div class="mt-1 text-2xl font-semibold">@criticalCount</div>
        </article>
    </section>

    <section class="rounded-2xl border border-base-300 bg-base-100 p-4 shadow-sm">
        <h2 class="mb-3 text-lg font-semibold">@T("projects.salesforce-crm.pages.CaseDetail.sections.case_detail.title", "Case Detail")</h2>
        <div class="overflow-x-auto">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.sections.case_detail.columns.CaseId", "Case ID")</th>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.sections.case_detail.columns.Account", "Account")</th>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.sections.case_detail.columns.CaseStatus", "Status")</th>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.sections.case_detail.columns.OwnerName", "Owner")</th>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.sections.case_detail.columns.Severity", "Severity")</th>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.sections.case_detail.columns.OpenDays", "Open Days")</th>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.actions", "Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!detailRows.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-6 text-center text-base-content/50">@T("projects.salesforce-crm.pages.CaseDetail.empty", "No cases found.")</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in detailRows)
                        {
                            var caseId = row.TryGetValue("CaseId", out var c0) ? c0?.ToString() ?? "" : "";
                            var account = row.TryGetValue("Account", out var c1) ? c1?.ToString() ?? "" : "";
                            var status = row.TryGetValue("CaseStatus", out var c2) ? c2?.ToString() ?? "" : "";
                            var owner = row.TryGetValue("OwnerName", out var c3) ? c3?.ToString() ?? "" : "";
                            var severity = row.TryGetValue("Severity", out var c4) ? c4?.ToString() ?? "" : "";
                            var openDays = row.TryGetValue("OpenDays", out var c5) ? c5?.ToString() ?? "0" : "0";

                            <tr id="case-detail-@caseId">
                                <td>@caseId</td>
                                <td>@account</td>
                                <td>@status</td>
                                <td>@owner</td>
                                <td><span class="badge @(severity == "Critical" ? "badge-error" : severity == "High" ? "badge-warning" : "badge-info")">@severity</span></td>
                                <td>@openDays</td>
                                <td>
                                    <div class="flex flex-wrap gap-1">
                                        <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/case_detail/update-row" hx-target="#case-detail-@caseId" hx-swap="outerHTML" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="rowId" value="@caseId" />
                                            <input type="hidden" name="field" value="Status" />
                                            <input type="hidden" name="value" value="Open" />
                                            <button type="submit" class="btn btn-xs btn-outline">@T("projects.salesforce-crm.pages.CaseDetail.action.open", "Open")</button>
                                        </form>
                                        <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/case_detail/update-row" hx-target="#case-detail-@caseId" hx-swap="outerHTML" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="rowId" value="@caseId" />
                                            <input type="hidden" name="field" value="Status" />
                                            <input type="hidden" name="value" value="Delayed" />
                                            <button type="submit" class="btn btn-xs btn-warning">@T("projects.salesforce-crm.pages.CaseDetail.action.escalate", "Escalate")</button>
                                        </form>
                                        <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/case_detail/update-row" hx-target="#case-detail-@caseId" hx-swap="outerHTML" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="rowId" value="@caseId" />
                                            <input type="hidden" name="field" value="Status" />
                                            <input type="hidden" name="value" value="Shipped" />
                                            <button type="submit" class="btn btn-xs btn-success">@T("projects.salesforce-crm.pages.CaseDetail.action.resolve", "Resolve")</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="rounded-2xl border border-base-300 bg-base-100 p-4 shadow-sm">
        <h2 class="mb-3 text-lg font-semibold">@T("projects.salesforce-crm.pages.CaseDetail.sections.case_activity.title", "Case Activity")</h2>
        <div class="overflow-x-auto">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.sections.case_activity.columns.Id", "Event ID")</th>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.sections.case_activity.columns.UserName", "User")</th>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.sections.case_activity.columns.Action", "Action")</th>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.sections.case_activity.columns.Detail", "Detail")</th>
                        <th>@T("projects.salesforce-crm.pages.CaseDetail.sections.case_activity.columns.CreatedAt", "Created At")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!activityRows.Any())
                    {
                        <tr><td colspan="5" class="py-6 text-center text-base-content/50">@T("projects.salesforce-crm.pages.CaseDetail.activity.empty", "No activity records.")</td></tr>
                    }
                    else
                    {
                        foreach (var row in activityRows)
                        {
                            <tr>
                                <td>@(row.TryGetValue("Id", out var v0) ? v0?.ToString() ?? "" : "")</td>
                                <td>@(row.TryGetValue("UserName", out var v1) ? v1?.ToString() ?? "" : "")</td>
                                <td>@(row.TryGetValue("Action", out var v2) ? v2?.ToString() ?? "" : "")</td>
                                <td class="max-w-[32rem] truncate">@(row.TryGetValue("Detail", out var v3) ? v3?.ToString() ?? "" : "")</td>
                                <td>@(row.TryGetValue("CreatedAt", out var v4) ? v4?.ToString() ?? "" : "")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
