@using NetYamlForge.Models
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    Layout = ViewBag.LayoutPath ?? "_Layout";

    string T(string key, string fallback) => I18nText.ResolveByKey(key) ?? fallback;

    var currentProject = ViewData["Project"] as string ?? "salesforce-crm";
    var pageName = ViewData["PageName"] as string ?? "UserRoleProfile";
    var isAdmin = (ViewData["IsAdmin"] as bool?) ?? User.IsInRole("Admin");
    ViewData["Title"] = T("projects.salesforce-crm.pages.UserRoleProfile.title", "User Role Profile");

    var users = Model.TryGetValue("user_directory", out var userData)
        ? userData.Rows.ToList()
        : new List<Dictionary<string, object>>();
    var activities = Model.TryGetValue("user_activity", out var actData)
        ? actData.Rows.ToList()
        : new List<Dictionary<string, object>>();

    var activeUsers = users.Count(r => (r.TryGetValue("UserState", out var st) ? st?.ToString() : "") == "Active");
    var adminUsers = users.Count(r => (r.TryGetValue("Role", out var rl) ? rl?.ToString() : "") == "Admin");
}

<div class="space-y-6">
    <section class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm">
        <h1 class="text-2xl font-bold">@T("projects.salesforce-crm.pages.UserRoleProfile.title", "User Role Profile")</h1>
        <p class="mt-1 text-sm opacity-70">@T("projects.salesforce-crm.pages.UserRoleProfile.description", "Identity, role, and profile operations with language settings and recent access activity.")</p>
    </section>

    <section class="grid grid-cols-1 gap-3 md:grid-cols-3">
        <article class="rounded-xl border border-base-300 bg-base-100 p-4 shadow-sm">
            <div class="text-xs opacity-60">@T("projects.salesforce-crm.pages.UserRoleProfile.cards.total", "Total Users")</div>
            <div class="mt-1 text-2xl font-semibold">@users.Count</div>
        </article>
        <article class="rounded-xl border border-success/40 bg-success/5 p-4 shadow-sm">
            <div class="text-xs opacity-70">@T("projects.salesforce-crm.pages.UserRoleProfile.cards.active", "Active Users")</div>
            <div class="mt-1 text-2xl font-semibold">@activeUsers</div>
        </article>
        <article class="rounded-xl border border-info/40 bg-info/5 p-4 shadow-sm">
            <div class="text-xs opacity-70">@T("projects.salesforce-crm.pages.UserRoleProfile.cards.admin", "Admin Users")</div>
            <div class="mt-1 text-2xl font-semibold">@adminUsers</div>
        </article>
    </section>

    <section class="rounded-2xl border border-base-300 bg-base-100 p-4 shadow-sm">
        <h2 class="mb-3 text-lg font-semibold">@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_directory.title", "User Directory")</h2>
        <div class="overflow-x-auto">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_directory.columns.UserId", "User ID")</th>
                        <th>@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_directory.columns.UserName", "User Name")</th>
                        <th>@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_directory.columns.DisplayName", "Display Name")</th>
                        <th>@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_directory.columns.Role", "Role")</th>
                        <th>@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_directory.columns.UserState", "State")</th>
                        <th>@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_directory.columns.Locale", "Locale")</th>
                        <th>@T("projects.salesforce-crm.pages.UserRoleProfile.actions", "Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!users.Any())
                    {
                        <tr><td colspan="7" class="py-6 text-center text-base-content/50">@T("projects.salesforce-crm.pages.UserRoleProfile.empty", "No users found.")</td></tr>
                    }
                    else
                    {
                        foreach (var row in users)
                        {
                            var userId = row.TryGetValue("UserId", out var v0) ? v0?.ToString() ?? "" : "";
                            var userName = row.TryGetValue("UserName", out var v1) ? v1?.ToString() ?? "" : "";
                            var displayName = row.TryGetValue("DisplayName", out var v2) ? v2?.ToString() ?? "" : "";
                            var role = row.TryGetValue("Role", out var v3) ? v3?.ToString() ?? "" : "";
                            var state = row.TryGetValue("UserState", out var v4) ? v4?.ToString() ?? "" : "";
                            var locale = row.TryGetValue("Locale", out var v5) ? v5?.ToString() ?? "" : "";

                            var nextIsAdmin = role == "Admin" ? "0" : "1";
                            var nextIsActive = state == "Active" ? "0" : "1";

                            <tr id="user-@userId">
                                <td>@userId</td>
                                <td>@userName</td>
                                <td>@displayName</td>
                                <td><span class="badge @(role == "Admin" ? "badge-info" : "badge-ghost")">@role</span></td>
                                <td><span class="badge @(state == "Active" ? "badge-success" : "badge-error")">@state</span></td>
                                <td>@locale</td>
                                <td>
                                    @if (isAdmin)
                                    {
                                        <div class="flex flex-wrap gap-1">
                                            <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/user_directory/update-row" hx-target="#user-@userId" hx-swap="outerHTML" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="rowId" value="@userId" />
                                                <input type="hidden" name="field" value="IsActive" />
                                                <input type="hidden" name="value" value="@nextIsActive" />
                                                <button type="submit" class="btn btn-xs btn-outline">@(state == "Active" ? T("projects.salesforce-crm.pages.UserRoleProfile.action.disable", "Disable") : T("projects.salesforce-crm.pages.UserRoleProfile.action.enable", "Enable"))</button>
                                            </form>
                                            <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/user_directory/update-row" hx-target="#user-@userId" hx-swap="outerHTML" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="rowId" value="@userId" />
                                                <input type="hidden" name="field" value="IsAdmin" />
                                                <input type="hidden" name="value" value="@nextIsAdmin" />
                                                <button type="submit" class="btn btn-xs btn-info">@(role == "Admin" ? T("projects.salesforce-crm.pages.UserRoleProfile.action.removeAdmin", "Remove Admin") : T("projects.salesforce-crm.pages.UserRoleProfile.action.grantAdmin", "Grant Admin"))</button>
                                            </form>
                                            <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/user_directory/update-row" hx-target="#user-@userId" hx-swap="outerHTML" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="rowId" value="@userId" />
                                                <input type="hidden" name="field" value="PreferredLanguage" />
                                                <input type="hidden" name="value" value="ko-KR" />
                                                <button type="submit" class="btn btn-xs btn-success">@T("projects.salesforce-crm.pages.UserRoleProfile.action.setKorean", "Set Korean")</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-base-content/60">@T("projects.salesforce-crm.pages.UserRoleProfile.readOnly", "Read-only")</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="rounded-2xl border border-base-300 bg-base-100 p-4 shadow-sm">
        <h2 class="mb-3 text-lg font-semibold">@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_activity.title", "User Activity Snapshot")</h2>
        <div class="overflow-x-auto">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_activity.columns.UserName", "User")</th>
                        <th>@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_activity.columns.EventCount", "Events")</th>
                        <th>@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_activity.columns.LastEventAt", "Last Event")</th>
                        <th>@T("projects.salesforce-crm.pages.UserRoleProfile.sections.user_activity.columns.LoginEvents", "Login Events")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!activities.Any())
                    {
                        <tr><td colspan="4" class="py-6 text-center text-base-content/50">@T("projects.salesforce-crm.pages.UserRoleProfile.activity.empty", "No user activity records.")</td></tr>
                    }
                    else
                    {
                        foreach (var row in activities)
                        {
                            <tr>
                                <td>@(row.TryGetValue("UserName", out var a0) ? a0?.ToString() ?? "" : "")</td>
                                <td>@(row.TryGetValue("EventCount", out var a1) ? a1?.ToString() ?? "0" : "0")</td>
                                <td>@(row.TryGetValue("LastEventAt", out var a2) ? a2?.ToString() ?? "" : "")</td>
                                <td>@(row.TryGetValue("LoginEvents", out var a3) ? a3?.ToString() ?? "0" : "0")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
