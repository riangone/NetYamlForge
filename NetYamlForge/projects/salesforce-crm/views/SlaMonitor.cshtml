@using NetYamlForge.Models
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    Layout = ViewBag.LayoutPath ?? "_Layout";

    string T(string key, string fallback) => I18nText.ResolveByKey(key) ?? fallback;

    var currentProject = ViewData["Project"] as string ?? "salesforce-crm";
    var pageName = ViewData["PageName"] as string ?? "SlaMonitor";
    ViewData["Title"] = T("projects.salesforce-crm.pages.SlaMonitor.title", "SLA Monitor");

    var rows = Model.TryGetValue("sla_watchlist", out var data)
        ? data.Rows.ToList()
        : new List<Dictionary<string, object>>();
}

<div class="space-y-6">
    <section class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm">
        <h1 class="text-2xl font-bold">@T("projects.salesforce-crm.pages.SlaMonitor.title", "SLA Monitor")</h1>
        <p class="mt-1 text-sm opacity-70">@T("projects.salesforce-crm.pages.SlaMonitor.description", "SLA breach watchlist and response timeline across open and delayed customer commitments.")</p>
    </section>

    <section class="rounded-2xl border border-base-300 bg-base-100 p-4 shadow-sm">
        <div class="overflow-x-auto">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>@T("projects.salesforce-crm.pages.SlaMonitor.sections.sla_watchlist.columns.SlaId", "SLA ID")</th>
                        <th>@T("projects.salesforce-crm.pages.SlaMonitor.sections.sla_watchlist.columns.Account", "Account")</th>
                        <th>@T("projects.salesforce-crm.pages.SlaMonitor.sections.sla_watchlist.columns.Status", "Status")</th>
                        <th>@T("projects.salesforce-crm.pages.SlaMonitor.sections.sla_watchlist.columns.DelayDays", "Delay Days")</th>
                        <th>@T("projects.salesforce-crm.pages.SlaMonitor.sections.sla_watchlist.columns.SlaState", "SLA State")</th>
                        <th>@T("projects.salesforce-crm.pages.SlaMonitor.sections.sla_watchlist.columns.ActionHint", "Action Hint")</th>
                        <th>@T("projects.salesforce-crm.pages.SlaMonitor.actions", "Actions")</th>
                    </tr>
                </thead>
                <tbody>
                @if (!rows.Any())
                {
                    <tr><td colspan="7" class="py-6 text-center text-base-content/50">@T("projects.salesforce-crm.pages.SlaMonitor.empty", "No SLA alerts.")</td></tr>
                }
                else
                {
                    foreach (var row in rows)
                    {
                        var id = row.TryGetValue("SlaId", out var c0) ? c0?.ToString() ?? "" : "";
                        var account = row.TryGetValue("Account", out var c1) ? c1?.ToString() ?? "" : "";
                        var status = row.TryGetValue("Status", out var c2) ? c2?.ToString() ?? "" : "";
                        var delayDays = row.TryGetValue("DelayDays", out var c3) ? c3?.ToString() ?? "0" : "0";
                        var state = row.TryGetValue("SlaState", out var c4) ? c4?.ToString() ?? "" : "";
                        var hint = row.TryGetValue("ActionHint", out var c5) ? c5?.ToString() ?? "" : "";

                        <tr id="sla-@id">
                            <td>@id</td>
                            <td>@account</td>
                            <td>@status</td>
                            <td>@delayDays</td>
                            <td>
                                <span class="badge @(state == "Breach" ? "badge-error" : state == "AtRisk" ? "badge-warning" : state == "Warning" ? "badge-info" : "badge-success")">@state</span>
                            </td>
                            <td>@hint</td>
                            <td>
                                <div class="flex flex-wrap gap-1">
                                    <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/sla_watchlist/update-row"
                                          hx-target="#sla-@id"
                                          hx-swap="outerHTML"
                                          class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rowId" value="@id" />
                                        <input type="hidden" name="field" value="Status" />
                                        <input type="hidden" name="value" value="Delayed" />
                                        <button type="submit" class="btn btn-xs btn-warning">@T("projects.salesforce-crm.pages.SlaMonitor.action.escalate", "Escalate")</button>
                                    </form>
                                    <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/sla_watchlist/update-row"
                                          hx-target="#sla-@id"
                                          hx-swap="outerHTML"
                                          class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rowId" value="@id" />
                                        <input type="hidden" name="field" value="Status" />
                                        <input type="hidden" name="value" value="Shipped" />
                                        <button type="submit" class="btn btn-xs btn-success">@T("projects.salesforce-crm.pages.SlaMonitor.action.resolve", "Resolve")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
