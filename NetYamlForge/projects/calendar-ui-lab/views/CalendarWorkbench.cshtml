@using System.Text.Json
@using NetYamlForge.Models
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    var pageDef = ViewData["PageDef"] as PageDefinition;
    var cfg = pageDef?.CalendarUi ?? new CalendarUiDefinition();
    var projectCalendar = ViewData["ProjectCalendar"] as ProjectCalendarConfig;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Calendar Workbench";
    var pageDescription = pageDef?.Description ?? "Responsive calendar UI";
    var configJson = JsonSerializer.Serialize(cfg, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
    var projectConfigJson = JsonSerializer.Serialize(projectCalendar ?? new ProjectCalendarConfig(), new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
}


<div class="mx-auto w-full max-w-[1600px] space-y-5" id="calendar-workbench" data-config='@Html.Raw(configJson)' data-project-config='@Html.Raw(projectConfigJson)'>
    <section class="rounded-2xl border border-slate-200 bg-white px-4 py-4 shadow-sm sm:px-5">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="space-y-1">
                <h1 class="text-2xl font-semibold tracking-tight text-slate-800">@pageTitle</h1>
                <p class="text-sm leading-6 text-slate-500">@pageDescription</p>
            </div>
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-[auto_auto_auto] sm:items-center">
                <button class="btn btn-sm btn-outline border-slate-300 bg-white text-slate-700 hover:bg-slate-50" type="button" id="btn-prev-month">← Prev</button>
                <input class="input input-bordered input-sm border-slate-300 bg-white text-slate-700" type="month" id="month-picker" />
                <button class="btn btn-sm btn-outline border-slate-300 bg-white text-slate-700 hover:bg-slate-50" type="button" id="btn-next-month">Next →</button>
            </div>
        </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm sm:px-5">
        <div class="calendar-legend flex flex-wrap items-center gap-2.5 text-xs text-slate-600">
            <span class="badge badge-sm border-0 bg-rose-500/10 text-rose-700">JP</span><span>Japan official holidays</span>
            <span class="badge badge-sm border-0 bg-sky-500/10 text-sky-700">3P</span><span>Third-party holidays</span>
            <span class="badge badge-sm border-0 bg-emerald-500/10 text-emerald-700">CUS</span><span>Custom holidays</span>
            <span class="badge badge-sm border-0 bg-amber-500/10 text-amber-700">农历</span><span>Chinese lunar date</span>
            <span class="badge badge-sm border-slate-300 bg-white text-slate-600" id="jp-source-badge">JP source: -</span>
        </div>
    </section>

    <div id="fc-calendar" class="calendar-shell rounded-2xl border border-slate-200 bg-white p-3 shadow-sm sm:p-4"></div>
    <div class="toast toast-top toast-end z-50 hidden" id="calendar-toast">
        <div class="alert alert-warning shadow-lg text-sm" id="calendar-toast-message"></div>
    </div>
</div>

@section Styles {
<style>
  #calendar-workbench {
    --cal-border: #e2e8f0;
    --cal-muted: #64748b;
    --cal-title: #0f172a;
    --cal-bg: #ffffff;
    --cal-weekend: #fafafa;
    --cal-today: #eff6ff;
  }

  #calendar-workbench .calendar-shell .fc {
    font-family: "Segoe UI", "Noto Sans JP", "PingFang SC", "Hiragino Kaku Gothic ProN", sans-serif;
    color: var(--cal-title);
  }

  #calendar-workbench .fc .fc-multimonth {
    border-color: var(--cal-border);
    border-radius: 12px;
    overflow: hidden;
  }

  #calendar-workbench .fc .fc-multimonth-title {
    padding: 10px 12px;
    font-size: 0.93rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    background: #f8fafc;
    border-bottom: 1px solid var(--cal-border);
  }

  #calendar-workbench .fc .fc-daygrid-day-number {
    font-size: 0.8rem;
    color: #334155;
    padding: 4px 6px;
  }

  #calendar-workbench .fc .fc-day-sat,
  #calendar-workbench .fc .fc-day-sun {
    background: var(--cal-weekend);
  }

  #calendar-workbench .fc .fc-day-today {
    background: var(--cal-today) !important;
  }

  #calendar-workbench .fc .fc-event {
    border: 0;
    border-radius: 6px;
    font-size: 0.72rem;
    line-height: 1.2;
    padding: 2px 4px;
    box-shadow: none;
  }

  #calendar-workbench .fc .fc-col-header-cell-cushion {
    color: var(--cal-muted);
    font-weight: 600;
    font-size: 0.76rem;
    padding: 8px 4px;
  }

  #calendar-workbench .fc .fc-daygrid-day-frame {
    min-height: 5.2rem;
  }

  #calendar-workbench .calendar-legend > span:nth-child(2n) {
    margin-right: 0.4rem;
  }

  @@media (max-width: 767px) {
    #calendar-workbench .fc .fc-multimonth-title {
      font-size: 0.88rem;
    }

    #calendar-workbench .fc .fc-daygrid-day-frame {
      min-height: 4.6rem;
    }
  }
</style>
}

@section Scripts {
<script src="/lib/fullcalendar/index.global.min.js"></script>
<script>
(() => {
  const root = document.getElementById("calendar-workbench");
  if (!root) return;

  const cfg = JSON.parse(root.dataset.config || "{}");
  const projectCfg = JSON.parse(root.dataset.projectConfig || "{}");
  const calendarEl = document.getElementById("fc-calendar");
  const picker = document.getElementById("month-picker");
  const btnPrev = document.getElementById("btn-prev-month");
  const btnNext = document.getElementById("btn-next-month");
  const sourceBadge = document.getElementById("jp-source-badge");
  const toast = document.getElementById("calendar-toast");
  const toastMessage = document.getElementById("calendar-toast-message");
  const projectJapanCfg = projectCfg?.japanHoliday || {};

  const mobileCount = Math.max(1, Number(cfg.mobileMonthCount || 1));
  const desktopMin = Math.max(1, Number(cfg.desktopMinMonthCount || 2));
  const desktopMax = Math.max(desktopMin, Number(cfg.desktopMaxMonthCount || 6));
  const showJapan = cfg.showJapanHolidays !== false;
  const showLunar = cfg.showChineseLunar !== false;
  const customHolidays = Array.isArray(cfg.customHolidays) ? cfg.customHolidays : [];
  const thirdPartyHolidays = Array.isArray(cfg.thirdPartyHolidays) ? cfg.thirdPartyHolidays : [];
  const japanProvider = String(cfg.japanHolidayProvider ?? projectJapanCfg.provider ?? "hybrid").toLowerCase();
  const japanApiUrlTemplate = String(cfg.japanHolidayApiUrlTemplate ?? projectJapanCfg.apiUrlTemplate ?? "https://date.nager.at/api/v3/PublicHolidays/{year}/JP");
  const japanApiTimeoutMs = Math.max(1500, Number(cfg.japanHolidayApiTimeoutMs ?? projectJapanCfg.apiTimeoutMs ?? 4000));
  const japanApiCache = new Map();

  const state = {
    year: new Date().getFullYear(),
    month: new Date().getMonth(),
    panelCount: 0,
    calendar: null,
    jpSourceState: "none",
    toastShown: false
  };

  function pad2(n) { return String(n).padStart(2, "0"); }
  function isoDate(y, m, d) { return `${y}-${pad2(m + 1)}-${pad2(d)}`; }

  function showToast(message) {
    if (!toast || !toastMessage || !message) return;
    toastMessage.textContent = message;
    toast.classList.remove("hidden");
    setTimeout(() => toast.classList.add("hidden"), 4200);
  }

  function mergeSource(next) {
    if (!next) return;
    if (state.jpSourceState === "none") {
      state.jpSourceState = next;
      return;
    }
    if (state.jpSourceState !== next) {
      state.jpSourceState = "mixed";
    }
  }

  function updateSourceBadge() {
    if (!sourceBadge) return;
    const text = state.jpSourceState === "api" ? "API"
      : state.jpSourceState === "builtin" ? "Builtin"
      : state.jpSourceState === "mixed" ? "Mixed"
      : "-";
    sourceBadge.textContent = `JP source: ${text}`;
  }

  function monthPanelCount() {
    if (window.innerWidth < 768) return mobileCount;
    const estimated = Math.floor((window.innerWidth - 72) / 340);
    return Math.max(desktopMin, Math.min(desktopMax, estimated));
  }

  function nthWeekdayOfMonth(year, month, weekday, nth) {
    const first = new Date(year, month, 1);
    const diff = (weekday - first.getDay() + 7) % 7;
    return new Date(year, month, 1 + diff + (nth - 1) * 7);
  }

  function vernalEquinoxDay(year) {
    return Math.floor(20.8431 + 0.242194 * (year - 1980) - Math.floor((year - 1980) / 4));
  }

  function autumnEquinoxDay(year) {
    return Math.floor(23.2488 + 0.242194 * (year - 1980) - Math.floor((year - 1980) / 4));
  }

  function getJapanHolidayMapBuiltin(year) {
    const map = new Map();
    const add = (m, d, name) => map.set(isoDate(year, m, d), name);

    add(0, 1, "元日");
    add(1, 11, "建国記念の日");
    if (year >= 2020) add(1, 23, "天皇誕生日");
    add(2, Math.max(1, Math.min(31, vernalEquinoxDay(year))), "春分の日");
    add(3, 29, "昭和の日");
    add(4, 3, "憲法記念日");
    add(4, 4, "みどりの日");
    add(4, 5, "こどもの日");
    if (year >= 2016) add(7, 11, "山の日");
    add(8, Math.max(1, Math.min(30, autumnEquinoxDay(year))), "秋分の日");
    add(10, 3, "文化の日");
    add(10, 23, "勤労感謝の日");

    const comingOfAge = nthWeekdayOfMonth(year, 0, 1, 2);
    map.set(isoDate(year, 0, comingOfAge.getDate()), "成人の日");
    const marine = nthWeekdayOfMonth(year, 6, 1, 3);
    map.set(isoDate(year, 6, marine.getDate()), "海の日");
    const respect = nthWeekdayOfMonth(year, 8, 1, 3);
    map.set(isoDate(year, 8, respect.getDate()), "敬老の日");
    const sports = nthWeekdayOfMonth(year, 9, 1, 2);
    map.set(isoDate(year, 9, sports.getDate()), "スポーツの日");

    const originalKeys = Array.from(map.keys()).sort();
    for (const key of originalKeys) {
      const dt = new Date(`${key}T00:00:00`);
      if (dt.getDay() !== 0) continue;
      const sub = new Date(dt);
      do {
        sub.setDate(sub.getDate() + 1);
      } while (map.has(isoDate(sub.getFullYear(), sub.getMonth(), sub.getDate())));
      map.set(isoDate(sub.getFullYear(), sub.getMonth(), sub.getDate()), "振替休日");
    }

    const sorted = Array.from(map.keys()).sort();
    for (let i = 0; i < sorted.length - 1; i++) {
      const a = new Date(`${sorted[i]}T00:00:00`);
      const b = new Date(`${sorted[i + 1]}T00:00:00`);
      const diff = Math.round((b - a) / 86400000);
      if (diff === 2) {
        const middle = new Date(a);
        middle.setDate(a.getDate() + 1);
        const mk = isoDate(middle.getFullYear(), middle.getMonth(), middle.getDate());
        if (!map.has(mk)) map.set(mk, "国民の休日");
      }
    }

    return map;
  }

  function buildJapanApiUrl(year) {
    return japanApiUrlTemplate.replace("{year}", String(year));
  }

  async function fetchJapanHolidayMapFromApi(year) {
    if (japanApiCache.has(year)) {
      return japanApiCache.get(year);
    }

    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), japanApiTimeoutMs);
    try {
      const res = await fetch(buildJapanApiUrl(year), {
        signal: controller.signal,
        cache: "no-store"
      });
      if (!res.ok) throw new Error(`holiday api status=${res.status}`);
      const rows = await res.json();
      const map = new Map();
      if (Array.isArray(rows)) {
        for (const row of rows) {
          const date = row?.date;
          const name = row?.localName || row?.name || "Holiday";
          if (typeof date === "string" && typeof name === "string") {
            map.set(date, name);
          }
        }
      }
      japanApiCache.set(year, map);
      return map;
    } finally {
      clearTimeout(timer);
    }
  }

  async function getJapanHolidayMap(year) {
    if (japanProvider === "builtin") {
      mergeSource("builtin");
      return getJapanHolidayMapBuiltin(year);
    }

    if (japanProvider === "api") {
      try {
        const map = await fetchJapanHolidayMapFromApi(year);
        mergeSource("api");
        return map;
      } catch {
        if (!state.toastShown) {
          showToast("Japan holiday API failed. No JP holidays loaded in API mode.");
          state.toastShown = true;
        }
        return new Map();
      }
    }

    try {
      const fromApi = await fetchJapanHolidayMapFromApi(year);
      if (fromApi.size > 0) {
        mergeSource("api");
        return fromApi;
      }
    } catch {
      if (!state.toastShown) {
        showToast("Japan holiday API unavailable. Falling back to built-in rules.");
        state.toastShown = true;
      }
    }
    mergeSource("builtin");
    return getJapanHolidayMapBuiltin(year);
  }

  async function getHolidayEvents(yearStart, yearEnd) {
    const events = [];

    if (showJapan) {
      for (let y = yearStart; y <= yearEnd; y++) {
        const jp = await getJapanHolidayMap(y);
        for (const [date, name] of jp.entries()) {
          events.push({
            title: `[JP] ${name}`,
            start: date,
            allDay: true,
            backgroundColor: "#ef4444",
            borderColor: "#ef4444"
          });
        }
      }
    }

    for (const h of thirdPartyHolidays) {
      if (!h?.date || !h?.name) continue;
      const tag = (h.source || "3P").toUpperCase().slice(0, 3);
      events.push({
        title: `[${tag}] ${h.name}`,
        start: h.date,
        allDay: true,
        backgroundColor: "#0ea5e9",
        borderColor: "#0ea5e9"
      });
    }

    for (const h of customHolidays) {
      if (!h?.date || !h?.name) continue;
      const tag = (h.source || "CUS").toUpperCase().slice(0, 3);
      events.push({
        title: `[${tag}] ${h.name}`,
        start: h.date,
        allDay: true,
        backgroundColor: "#22c55e",
        borderColor: "#22c55e"
      });
    }

    return events;
  }

  function getLunarLabel(date) {
    if (!showLunar) return "";
    try {
      return new Intl.DateTimeFormat("zh-Hans-u-ca-chinese", {
        month: "short",
        day: "numeric"
      }).format(date);
    } catch {
      return "";
    }
  }

  function firstOfCurrentState() {
    return `${state.year}-${pad2(state.month + 1)}-01`;
  }

  function syncPickerFromCalendar() {
    if (!state.calendar) return;
    const d = state.calendar.getDate();
    picker.value = `${d.getFullYear()}-${pad2(d.getMonth() + 1)}`;
  }

  async function buildCalendar() {
    const panelCount = monthPanelCount();
    state.panelCount = panelCount;

    const endRef = new Date(state.year, state.month + panelCount - 1, 1);
    state.jpSourceState = "none";
    const events = await getHolidayEvents(state.year, endRef.getFullYear());
    updateSourceBadge();

    if (state.calendar) {
      state.calendar.destroy();
      state.calendar = null;
    }

    state.calendar = new FullCalendar.Calendar(calendarEl, {
      initialView: "multiMonthYear",
      initialDate: firstOfCurrentState(),
      locale: "ja",
      headerToolbar: false,
      height: "auto",
      dayMaxEventRows: 2,
      eventDisplay: "block",
      views: {
        multiMonthYear: {
          type: "multiMonthYear",
          duration: { months: panelCount },
          multiMonthMaxColumns: panelCount
        }
      },
      events,
      datesSet: (info) => {
        state.year = info.start.getFullYear();
        state.month = info.start.getMonth();
        syncPickerFromCalendar();
      },
      dayCellDidMount: (arg) => {
        const lunar = getLunarLabel(arg.date);
        if (!lunar) return;
        const el = document.createElement("div");
        el.className = "text-[10px] opacity-70 mt-0.5";
        el.textContent = `农历 ${lunar}`;
        arg.el.querySelector(".fc-daygrid-day-frame")?.appendChild(el);
      }
    });

    state.calendar.render();
    syncPickerFromCalendar();
  }

  picker.addEventListener("change", () => {
    if (!picker.value || !state.calendar) return;
    const [y, m] = picker.value.split("-").map(Number);
    if (!y || !m) return;
    state.year = y;
    state.month = m - 1;
    void buildCalendar();
  });

  btnPrev.addEventListener("click", () => {
    if (!state.calendar) return;
    state.calendar.incrementDate({ months: -1 });
  });

  btnNext.addEventListener("click", () => {
    if (!state.calendar) return;
    state.calendar.incrementDate({ months: 1 });
  });

  let resizeTimer;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      const nextCount = monthPanelCount();
      if (nextCount !== state.panelCount) {
        void buildCalendar();
      }
    }, 120);
  });

  void buildCalendar();
})();
</script>
}
