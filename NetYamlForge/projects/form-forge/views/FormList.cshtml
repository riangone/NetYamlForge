@model NetYamlForge.Projects.FormForge.FfFormListViewModel
@{
    ViewData["Title"] = "My Forms — FormForge";
    Layout = "_Layout";
    var project = Model.ProjectName;
    string BuilderUrl(string id) => Url.Content($"~/{project}/FormForge/Builder/{id}");
    string ResultsUrl(string id) => Url.Content($"~/{project}/FormForge/Results/{id}");
    string FillUrl(string id)    => Url.Content($"~/{project}/FormForge/Fill/{id}");
}

<div class="max-w-5xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold flex items-center gap-2">
                <span>📋</span> My Forms
            </h1>
            <p class="text-sm opacity-60 mt-1">Create and manage your forms</p>
        </div>
        <form method="post" action="~/@project/FormForge/Create">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                New Form
            </button>
        </form>
    </div>

    @if (!Model.Forms.Any())
    {
        <!-- Empty state -->
        <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body items-center text-center py-16">
                <div class="text-6xl mb-4">📝</div>
                <h2 class="card-title">No forms yet</h2>
                <p class="opacity-60">Create your first form to start collecting responses.</p>
                <form method="post" action="~/@project/FormForge/Create" class="mt-4">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Create a form</button>
                </form>
            </div>
        </div>
    }
    else
    {
        <!-- Forms grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var form in Model.Forms)
            {
                <div class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow">
                    <div class="h-2 rounded-t-2xl" style="background:@form.ThemeColor"></div>
                    <div class="card-body p-4 gap-2">
                        <h3 class="font-semibold text-base leading-snug">@form.Title</h3>
                        @if (!string.IsNullOrEmpty(form.Description))
                        {
                            <p class="text-sm opacity-60 line-clamp-2">@form.Description</p>
                        }
                        <div class="flex items-center gap-2 mt-1">
                            <span class="badge @(form.IsPublished ? "badge-success" : "badge-ghost") badge-sm">
                                @(form.IsPublished ? "Live" : "Draft")
                            </span>
                            <span class="text-xs opacity-50">@form.ResponseCount @(form.ResponseCount == 1 ? "response" : "responses")</span>
                        </div>
                        <div class="card-actions justify-between items-center mt-2 pt-2 border-t border-base-200">
                            <div class="flex gap-2">
                                <a href="@BuilderUrl(form.Id)" class="btn btn-xs btn-ghost">Edit</a>
                                <a href="@ResultsUrl(form.Id)" class="btn btn-xs btn-ghost">Results</a>
                                @if (form.IsPublished)
                                {
                                    <a href="@FillUrl(form.Id)" target="_blank" class="btn btn-xs btn-primary">Open ↗</a>
                                }
                            </div>
                            <form method="post" action="~/@project/FormForge/Delete" onsubmit="return confirm('Delete this form and all responses?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@form.Id" />
                                <button type="submit" class="btn btn-xs btn-ghost text-error">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
