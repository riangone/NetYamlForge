@model NetYamlForge.Projects.FormForge.FfFormListViewModel
@{
    ViewData["Title"] = "My Forms — FormForge";
    Layout = "_Layout";
    var project = Model.ProjectName;
    string BuilderUrl(string id) => Url.Content($"~/{project}/FormForge/Builder/{id}");
    string ResultsUrl(string id) => Url.Content($"~/{project}/FormForge/Results/{id}");
    string FillUrl(string id)    => Url.Content($"~/{project}/FormForge/Fill/{id}");
}

<div class="max-w-5xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold flex items-center gap-2">
                <span>📋</span> My Forms
            </h1>
            <p class="text-sm opacity-60 mt-1">Create and manage your forms</p>
        </div>
        <form method="post" action="~/@project/FormForge/Create">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary gap-2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                New Form
            </button>
        </form>
    </div>

    @if (!Model.Forms.Any())
    {
        <!-- Empty state -->
        <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body items-center text-center py-16">
                <div class="text-6xl mb-4">📝</div>
                <h2 class="card-title">No forms yet</h2>
                <p class="opacity-60">Create your first form to start collecting responses.</p>
                <form method="post" action="~/@project/FormForge/Create" class="mt-4">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Create a form</button>
                </form>
            </div>
        </div>
    }
    else
    {
        <!-- Forms grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var form in Model.Forms)
            {
                <div class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
                    <div class="h-2.5 w-full" style="background:@form.ThemeColor"></div>
                    <div class="card-body p-5 gap-3">
                        <div>
                            <h3 class="font-bold text-lg leading-snug text-base-content hover:text-primary transition-colors">@form.Title</h3>
                            @if (!string.IsNullOrEmpty(form.Description))
                            {
                                <p class="text-sm opacity-70 mt-1 line-clamp-2 leading-relaxed">@form.Description</p>
                            }
                        </div>
                        <div class="flex items-center gap-2.5 mt-1">
                            <span class="badge @(form.IsPublished ? "badge-success text-white" : "badge-ghost") badge-sm font-semibold px-2.5 py-2">
                                @(form.IsPublished ? "Live" : "Draft")
                            </span>
                            <span class="text-xs opacity-60 flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                                @form.ResponseCount @(form.ResponseCount == 1 ? "response" : "responses")
                            </span>
                        </div>
                        <div class="card-actions flex-col sm:flex-row justify-between items-stretch sm:items-center mt-3 pt-3 border-t border-base-200 gap-3">
                            <div class="flex flex-wrap gap-2">
                                <a href="@BuilderUrl(form.Id)" class="btn btn-xs sm:btn-sm btn-ghost btn-outline flex-1 sm:flex-none">Edit</a>
                                <a href="@ResultsUrl(form.Id)" class="btn btn-xs sm:btn-sm btn-ghost btn-outline flex-1 sm:flex-none">Results</a>
                                @if (form.IsPublished)
                                {
                                    <a href="@FillUrl(form.Id)" target="_blank" class="btn btn-xs sm:btn-sm btn-primary flex-1 sm:flex-none">Open ↗</a>
                                }
                            </div>
                            <form method="post" action="~/@project/FormForge/Delete" onsubmit="return confirm('Delete this form and all responses?')" class="w-full sm:w-auto">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@form.Id" />
                                <button type="submit" class="btn btn-xs sm:btn-sm btn-ghost text-error hover:bg-error/10 w-full sm:w-auto">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
