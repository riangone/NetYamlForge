@using NetYamlForge.Models
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    var pageName = (string)ViewData["PageName"]!;
    var currentProject = ViewData["Project"] as string ?? "";

    ViewData["Title"] = "审批页面";
    ViewData["ActivePage"] = "Page";

    var pendingLeave = Model.TryGetValue("pending_leave", out var leaveData) ? leaveData.Item1.ToList() : new();
    var pendingOvertime = Model.TryGetValue("pending_overtime", out var overtimeData) ? overtimeData.Item1.ToList() : new();
    var recentApproved = Model.TryGetValue("recent_approved", out var recentData) ? recentData.Item1.ToList() : new();
}

<div class="container mx-auto px-4 py-8 space-y-8">
    <div class="space-y-2">
        <h1 class="text-2xl font-bold text-gray-800">审批中心</h1>
        <p class="text-sm text-gray-500">集中处理请假与加班审批任务。</p>
        <div class="flex flex-wrap gap-2 pt-1">
            <span id="badge-pending-leave" class="badge badge-warning badge-outline">待审批请假 @pendingLeave.Count</span>
            <span id="badge-pending-overtime" class="badge badge-info badge-outline">待审批加班 @pendingOvertime.Count</span>
        </div>
    </div>

    <section class="space-y-3">
        <h2 class="text-lg font-semibold text-gray-800">待审批请假</h2>
        @if (!pendingLeave.Any())
        {
            <div class="rounded-lg border border-gray-200 bg-white p-5 text-sm text-gray-500">当前无待审批请假。</div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var row in pendingLeave)
                {
                    var id = row.TryGetValue("LeaveRequestId", out var c0) ? c0?.ToString() ?? "" : "";
                    var employeeNo = row.TryGetValue("EmployeeNo", out var c1) ? c1?.ToString() ?? "" : "";
                    var employeeName = row.TryGetValue("EmployeeName", out var c2) ? c2?.ToString() ?? "" : "";
                    var department = row.TryGetValue("DepartmentName", out var c3) ? c3?.ToString() ?? "" : "";
                    var leaveType = row.TryGetValue("LeaveType", out var c4) ? c4?.ToString() ?? "" : "";
                    var startDate = row.TryGetValue("StartDate", out var c5) ? c5?.ToString() ?? "" : "";
                    var endDate = row.TryGetValue("EndDate", out var c6) ? c6?.ToString() ?? "" : "";
                    var days = row.TryGetValue("Days", out var c7) ? c7?.ToString() ?? "" : "";
                    var reason = row.TryGetValue("Reason", out var c8) ? c8?.ToString() ?? "" : "";

                    <article id="leave-@id" class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div class="space-y-1">
                                <div class="text-sm text-gray-500">申请ID #@id</div>
                                <div class="font-semibold text-gray-800">@employeeName (@employeeNo)</div>
                                <div class="text-sm text-gray-600">部门: @department | 类型: @leaveType | 天数: @days</div>
                                <div class="text-sm text-gray-600">区间: @startDate ~ @endDate</div>
                                <div class="text-sm text-gray-500">事由: @reason</div>
                            </div>
                            <div class="flex gap-2">
                                <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/pending_leave/update-row"
                                      hx-target="#leave-@id"
                                      hx-swap="outerHTML"
                                      class="inline"
                                      data-queue-kind="leave">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rowId" value="@id" />
                                    <input type="hidden" name="field" value="Status" />
                                    <input type="hidden" name="value" value="approved" />
                                    <button type="submit" class="btn btn-success btn-sm text-white">同意</button>
                                </form>
                                <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/pending_leave/update-row"
                                      hx-target="#leave-@id"
                                      hx-swap="outerHTML"
                                      hx-confirm="确定要驳回该请假申请吗？"
                                      class="inline"
                                      data-queue-kind="leave">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rowId" value="@id" />
                                    <input type="hidden" name="field" value="Status" />
                                    <input type="hidden" name="value" value="rejected" />
                                    <button type="submit" class="btn btn-outline btn-error btn-sm">驳回</button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="space-y-3">
        <h2 class="text-lg font-semibold text-gray-800">待审批加班</h2>
        @if (!pendingOvertime.Any())
        {
            <div class="rounded-lg border border-gray-200 bg-white p-5 text-sm text-gray-500">当前无待审批加班。</div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var row in pendingOvertime)
                {
                    var id = row.TryGetValue("OvertimeRequestId", out var c0) ? c0?.ToString() ?? "" : "";
                    var employeeNo = row.TryGetValue("EmployeeNo", out var c1) ? c1?.ToString() ?? "" : "";
                    var employeeName = row.TryGetValue("EmployeeName", out var c2) ? c2?.ToString() ?? "" : "";
                    var department = row.TryGetValue("DepartmentName", out var c3) ? c3?.ToString() ?? "" : "";
                    var workDate = row.TryGetValue("WorkDate", out var c4) ? c4?.ToString() ?? "" : "";
                    var startTime = row.TryGetValue("StartTime", out var c5) ? c5?.ToString() ?? "" : "";
                    var endTime = row.TryGetValue("EndTime", out var c6) ? c6?.ToString() ?? "" : "";
                    var hours = row.TryGetValue("Hours", out var c7) ? c7?.ToString() ?? "" : "";
                    var reason = row.TryGetValue("Reason", out var c8) ? c8?.ToString() ?? "" : "";

                    <article id="overtime-@id" class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div class="space-y-1">
                                <div class="text-sm text-gray-500">申请ID #@id</div>
                                <div class="font-semibold text-gray-800">@employeeName (@employeeNo)</div>
                                <div class="text-sm text-gray-600">部门: @department | 工时: @hours 小时</div>
                                <div class="text-sm text-gray-600">日期: @workDate | 时段: @startTime ~ @endTime</div>
                                <div class="text-sm text-gray-500">事由: @reason</div>
                            </div>
                            <div class="flex gap-2">
                                <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/pending_overtime/update-row"
                                      hx-target="#overtime-@id"
                                      hx-swap="outerHTML"
                                      class="inline"
                                      data-queue-kind="overtime">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rowId" value="@id" />
                                    <input type="hidden" name="field" value="Status" />
                                    <input type="hidden" name="value" value="approved" />
                                    <button type="submit" class="btn btn-success btn-sm text-white">同意</button>
                                </form>
                                <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/pending_overtime/update-row"
                                      hx-target="#overtime-@id"
                                      hx-swap="outerHTML"
                                      hx-confirm="确定要驳回该加班申请吗？"
                                      class="inline"
                                      data-queue-kind="overtime">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rowId" value="@id" />
                                    <input type="hidden" name="field" value="Status" />
                                    <input type="hidden" name="value" value="rejected" />
                                    <button type="submit" class="btn btn-outline btn-error btn-sm">驳回</button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="space-y-3">
        <h2 class="text-lg font-semibold text-gray-800">最近审批记录</h2>
        <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>类型</th>
                        <th>工号</th>
                        <th>姓名</th>
                        <th>日期</th>
                        <th>状态</th>
                        <th>审批人</th>
                        <th>审批时间</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!recentApproved.Any())
                    {
                        <tr><td colspan="7" class="text-center text-gray-400 py-6">暂无审批记录。</td></tr>
                    }
                    else
                    {
                        @foreach (var row in recentApproved)
                        {
                            var reqType = row.TryGetValue("RequestType", out var c1) ? c1?.ToString() ?? "" : "";
                            var employeeNo = row.TryGetValue("EmployeeNo", out var c2) ? c2?.ToString() ?? "" : "";
                            var employeeName = row.TryGetValue("EmployeeName", out var c3) ? c3?.ToString() ?? "" : "";
                            var dateRef = row.TryGetValue("DateRef", out var c4) ? c4?.ToString() ?? "" : "";
                            var status = row.TryGetValue("Status", out var c5) ? c5?.ToString() ?? "" : "";
                            var approver = row.TryGetValue("Approver", out var c6) ? c6?.ToString() ?? "" : "";
                            var approvedAt = row.TryGetValue("ApprovedAt", out var c7) ? c7?.ToString() ?? "" : "";
                            <tr>
                                <td>@reqType</td>
                                <td>@employeeNo</td>
                                <td>@employeeName</td>
                                <td>@dateRef</td>
                                <td>@status</td>
                                <td>@approver</td>
                                <td>@approvedAt</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
<script>
(() => {
  function decrementBadge(id, prefix) {
    const el = document.getElementById(id);
    if (!el) return;
    const text = el.textContent || "";
    const n = Number((text.match(/(\d+)/) || [])[1] || "0");
    const next = Math.max(0, n - 1);
    el.textContent = `${prefix} ${next}`;
  }

  document.body.addEventListener("htmx:afterRequest", (evt) => {
    if (!evt.detail.successful) return;
    const form = evt.detail.elt;
    if (!(form instanceof HTMLFormElement)) return;
    const kind = form.dataset.queueKind;
    if (kind === "leave") {
      decrementBadge("badge-pending-leave", "待审批请假");
    } else if (kind === "overtime") {
      decrementBadge("badge-pending-overtime", "待审批加班");
    }
  });
})();
</script>
}
