@using NetYamlForge.Models
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    var currentProject = ViewData["Project"] as string ?? "todo-app";
    var pageDef = ViewData["PageDef"] as PageDefinition;
    ViewData["Title"] = pageDef?.Title ?? "待办工作台 (Todo Workspace)";
    ViewData["ActivePage"] = "Page";

    if (ViewBag.LayoutPath != null)
    {
        Layout = ViewBag.LayoutPath;
    }

    var statsRows = Model.TryGetValue("todo_stats", out var sd) ? sd.Rows.ToList() : new();
    var todoRows = Model.TryGetValue("active_todos", out var td) ? td.Rows.ToList() : new();

    string GetStat(string label)
    {
        var item = statsRows.FirstOrDefault(r => r.TryGetValue("label", out var l) && l?.ToString() == label);
        return item != null && item.TryGetValue("value", out var v) ? v?.ToString() ?? "0" : "0";
    }

    var totalCountStr = GetStat("全部待办");
    var pendingCountStr = GetStat("待处理任务");
    var completedCountStr = GetStat("已完成待办");
    var highPriorityCountStr = GetStat("高优待办");
    var todayDueCountStr = GetStat("今日截止");

    int.TryParse(totalCountStr, out var totalCount);
    int.TryParse(pendingCountStr, out var pendingCount);
    int.TryParse(completedCountStr, out var completedCount);
    int.TryParse(highPriorityCountStr, out var highPriorityCount);
    int.TryParse(todayDueCountStr, out var todayDueCount);

    var completionRate = totalCount > 0 ? (int)Math.Round((double)completedCount / totalCount * 100) : 0;
    var todayDateStr = DateTime.UtcNow.ToString("yyyy-MM-dd");
}

<div class="container mx-auto px-3 sm:px-4 lg:px-6 2xl:max-w-7xl 3xl:max-w-[1600px] py-4 sm:py-8">
    <!-- 顶部工作台横幅 -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-6 border-b border-base-300 gap-4">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-2">
                <span>🎯</span>
                <span>目标与任务驱动中心</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight flex items-center gap-2.5 sm:gap-3 flex-wrap">
                <span class="p-1.5 sm:p-2 rounded-2xl bg-primary text-primary-content shadow-lg text-xl sm:text-2xl">📝</span>
                <span>待办工作台</span>
                <span class="badge badge-primary badge-outline text-xs uppercase tracking-wider font-semibold">Todo Workspace</span>
            </h1>
            <p class="text-xs sm:text-sm opacity-70 mt-1 leading-relaxed">
                清晰规划每一天，专注高效执行每一项业务与技术目标。
            </p>
        </div>
        <div class="flex items-center gap-2 self-start sm:self-auto flex-wrap">
            <a href="@Url.Content($"~/{currentProject}/DynamicEntity/Index?entity=todo")" 
               class="btn btn-xs sm:btn-sm btn-outline gap-1.5 shadow-sm hover:border-primary safe-touch-btn">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span>运维管理 (全量 CRUD)</span>
            </a>
            <a href="@Url.Content($"~/{currentProject}/Dashboard")" 
               class="btn btn-xs sm:btn-sm btn-ghost gap-1.5 safe-touch-btn">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                <span>数据看板</span>
            </a>
        </div>
    </div>

    <!-- 统计指标与进度条卡片 -->
    <div class="card bg-base-100 shadow-md border border-base-200 mb-6 sm:mb-8 overflow-hidden">
        <div class="card-body p-3.5 sm:p-6">
            <!-- 四大关键统计指标 -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-4 mb-4 sm:mb-6">
                <div class="flex items-center gap-2.5 sm:gap-3.5 p-2.5 sm:p-3 rounded-2xl bg-base-200/50 border border-base-300/40">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-info/15 text-info flex items-center justify-center text-lg sm:text-xl font-bold shrink-0">
                        📋
                    </div>
                    <div>
                        <div class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider opacity-60">全部待办</div>
                        <div class="text-xl sm:text-2xl font-black mt-0.5">@totalCount</div>
                    </div>
                </div>

                <div class="flex items-center gap-2.5 sm:gap-3.5 p-2.5 sm:p-3 rounded-2xl bg-base-200/50 border border-base-300/40">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-warning/15 text-warning flex items-center justify-center text-lg sm:text-xl font-bold shrink-0">
                        ⏳
                    </div>
                    <div>
                        <div class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider opacity-60">待处理</div>
                        <div class="text-xl sm:text-2xl font-black mt-0.5 text-warning">@pendingCount</div>
                    </div>
                </div>

                <div class="flex items-center gap-2.5 sm:gap-3.5 p-2.5 sm:p-3 rounded-2xl bg-base-200/50 border border-base-300/40">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-error/15 text-error flex items-center justify-center text-lg sm:text-xl font-bold shrink-0">
                        🔥
                    </div>
                    <div>
                        <div class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider opacity-60">紧急高优</div>
                        <div class="text-xl sm:text-2xl font-black mt-0.5 text-error">@highPriorityCount</div>
                    </div>
                </div>

                <div class="flex items-center gap-2.5 sm:gap-3.5 p-2.5 sm:p-3 rounded-2xl bg-base-200/50 border border-base-300/40">
                    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-success/15 text-success flex items-center justify-center text-lg sm:text-xl font-bold shrink-0">
                        ✅
                    </div>
                    <div>
                        <div class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider opacity-60">已达成</div>
                        <div class="text-xl sm:text-2xl font-black mt-0.5 text-success">@completedCount</div>
                    </div>
                </div>
            </div>

            <!-- 完成率进度条 -->
            <div class="pt-3 sm:pt-4 border-t border-base-200/80">
                <div class="flex items-center justify-between text-xs mb-2">
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-xs sm:text-sm">整体完成度</span>
                        <span class="badge badge-sm @(completionRate >= 80 ? "badge-success" : (completionRate >= 40 ? "badge-info" : "badge-warning")) font-mono font-bold">
                            @completionRate%
                        </span>
                    </div>
                    <span class="opacity-60 text-[11px] sm:text-xs">
                        已完成 @completedCount / @totalCount 项任务
                    </span>
                </div>
                <div class="w-full bg-base-200 rounded-full h-2.5 sm:h-3 overflow-hidden p-0.5">
                    <div class="bg-gradient-to-r from-primary to-success h-full rounded-full transition-all duration-500 ease-out" 
                         style="width: @(Math.Max(3, completionRate))%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 极速创建待办事项 -->
    <div class="card bg-base-100 shadow-md border border-base-200 mb-6 sm:mb-8 overflow-hidden">
        <div class="card-body p-4 sm:p-6">
            <h2 class="text-sm sm:text-base font-bold flex items-center gap-2 mb-2 sm:mb-3">
                <span class="w-6 h-6 rounded-full bg-primary text-primary-content flex items-center justify-center text-sm font-black">＋</span>
                <span>快速添加新待办</span>
            </h2>
            <form method="post" action="@Url.Content($"~/{currentProject}/DynamicEntity/Create?entity=todo")" class="space-y-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Url.Content($"~/{currentProject}/Page/HomePage")" />
                <input type="hidden" name="is_completed" value="0" />
                
                <div class="flex flex-col lg:flex-row gap-2.5 sm:gap-3">
                    <div class="flex-1">
                        <input type="text" name="title" required placeholder="输入待办任务标题... (按 Enter 即可快速添加)" 
                               class="input input-bordered w-full focus:input-primary shadow-inner text-sm" />
                    </div>
                    <div class="grid grid-cols-2 sm:flex sm:flex-row gap-2">
                        <div class="w-full sm:w-36 lg:w-40">
                            <select name="priority" class="select select-bordered w-full text-xs sm:text-sm">
                                <option value="medium">⚡ 中优先级</option>
                                <option value="high">🔥 高优先级</option>
                                <option value="low">💤 低优先级</option>
                            </select>
                        </div>
                        <div class="w-full sm:w-40 lg:w-44">
                            <input type="date" name="due_date" value="@todayDateStr" class="input input-bordered w-full text-xs sm:text-sm" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary px-5 shadow-md gap-2 font-bold shrink-0 safe-touch-btn">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        <span>添加待办</span>
                    </button>
                </div>

                <!-- 选填备注与描述折叠 -->
                <details class="text-xs opacity-80 group">
                    <summary class="cursor-pointer hover:text-primary transition-colors flex items-center gap-1 font-medium">
                        <span>📝 添加详细任务备注/执行指南 (选填)</span>
                    </summary>
                    <div class="mt-2">
                        <textarea name="description" rows="2" placeholder="在此输入详细待办描述、验收标准或参考文档链接..." 
                                  class="textarea textarea-bordered w-full focus:textarea-primary text-xs sm:text-sm"></textarea>
                    </div>
                </details>
            </form>
        </div>
    </div>

    <!-- 过滤器与搜索栏 (移动端单行流畅横滑，大屏自适应) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
        <div class="tabs tabs-boxed bg-base-200/80 p-1 rounded-2xl flex-nowrap overflow-x-auto no-scrollbar touch-pan-x shrink-0 max-w-full">
            <button class="tab tab-active tab-sm sm:tab-md todo-filter-btn rounded-xl font-medium shrink-0 whitespace-nowrap" data-filter="all" onclick="filterTodos('all')">
                全部 (@todoRows.Count)
            </button>
            <button class="tab tab-sm sm:tab-md todo-filter-btn rounded-xl font-medium shrink-0 whitespace-nowrap" data-filter="pending" onclick="filterTodos('pending')">
                ⏳ 待处理 (@pendingCount)
            </button>
            <button class="tab tab-sm sm:tab-md todo-filter-btn rounded-xl font-medium shrink-0 whitespace-nowrap" data-filter="high" onclick="filterTodos('high')">
                🔥 高优 (@highPriorityCount)
            </button>
            <button class="tab tab-sm sm:tab-md todo-filter-btn rounded-xl font-medium shrink-0 whitespace-nowrap" data-filter="today" onclick="filterTodos('today')">
                📅 今日截止 (@todayDueCount)
            </button>
            <button class="tab tab-sm sm:tab-md todo-filter-btn rounded-xl font-medium shrink-0 whitespace-nowrap" data-filter="completed" onclick="filterTodos('completed')">
                ✅ 已完成 (@completedCount)
            </button>
        </div>

        <div class="relative w-full sm:w-64 shrink-0">
            <input type="text" id="todoSearchInput" oninput="searchTodos()" placeholder="检索待办标题或描述..." 
                   class="input input-sm input-bordered w-full pl-9 focus:input-primary rounded-xl" />
            <svg class="w-4 h-4 absolute left-3 top-2 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>
    </div>

    <!-- 待办清单卡片流 -->
    <div class="space-y-3" id="todoListContainer">
        @if (todoRows.Count == 0)
        {
            <div class="card bg-base-100 border border-dashed border-base-300 py-16 text-center shadow-sm rounded-3xl">
                <div class="text-5xl mb-3">🎉</div>
                <div class="font-bold text-xl">太棒了，当前没有任何待办事项！</div>
                <p class="text-sm opacity-60 mt-1.5">点击上方快速添加框，开始梳理今日计划吧。</p>
            </div>
        }
        else
        {
            @foreach (var row in todoRows)
            {
                var id = row.TryGetValue("id", out var idVal) ? idVal?.ToString() ?? "0" : "0";
                var title = row.TryGetValue("title", out var titleVal) ? titleVal?.ToString() ?? "" : "";
                var desc = row.TryGetValue("description", out var descVal) ? descVal?.ToString() ?? "" : "";
                var priority = row.TryGetValue("priority", out var prioVal) ? prioVal?.ToString()?.ToLowerInvariant() ?? "medium" : "medium";
                var dueDateRaw = row.TryGetValue("due_date", out var dateVal) ? dateVal?.ToString() ?? "" : "";
                
                var dueDateStr = "";
                var isOverdue = false;
                var isDueToday = false;
                if (DateTime.TryParse(dueDateRaw, out var dt))
                {
                    dueDateStr = dt.ToString("yyyy-MM-dd");
                    var today = DateTime.UtcNow.Date;
                    if (dt.Date < today)
                    {
                        isOverdue = true;
                    }
                    else if (dt.Date == today)
                    {
                        isDueToday = true;
                    }
                }

                var isCompleted = false;
                if (row.TryGetValue("is_completed", out var compVal))
                {
                    isCompleted = compVal switch
                    {
                        bool b => b,
                        int i => i == 1,
                        long l => l == 1,
                        string s => s == "1" || s.Equals("true", StringComparison.OrdinalIgnoreCase),
                        _ => false
                    };
                }

                <div class="card bg-base-100 shadow-sm border border-base-200 hover:border-primary/40 hover:shadow-md transition-all rounded-2xl todo-item group"
                     data-id="@id"
                     data-completed="@(isCompleted ? "true" : "false")"
                     data-priority="@priority"
                     data-duetoday="@(isDueToday ? "true" : "false")"
                     data-title="@title.ToLowerInvariant()"
                     data-desc="@desc.ToLowerInvariant()">
                    <div class="card-body p-3.5 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <!-- 完成勾选与主信息 -->
                        <div class="flex items-start sm:items-center gap-3 flex-1 min-w-0">
                            <!-- 状态切换表单 (增大触控靶点) -->
                            <form method="post" action="@Url.Content($"~/{currentProject}/DynamicEntity/InvokeAction")" class="shrink-0 mt-0.5 sm:mt-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="entity" value="todo" />
                                <input type="hidden" name="actionKey" value="todo_toggle_complete" />
                                <input type="hidden" name="id" value="@id" />
                                <input type="hidden" name="returnUrl" value="@Url.Content($"~/{currentProject}/Page/HomePage")" />
                                <button type="submit" class="btn btn-circle btn-sm @(isCompleted ? "btn-success" : "btn-outline border-base-300 hover:border-primary") safe-touch-btn transition-transform active:scale-90" 
                                        title="@(isCompleted ? "标为未完成" : "标为已完成")">
                                    @if (isCompleted)
                                    {
                                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                                    }
                                    else
                                    {
                                        <div class="w-3.5 h-3.5 rounded-full border border-base-content/40 group-hover:border-primary"></div>
                                    }
                                </button>
                            </form>

                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap mb-1">
                                    <span class="font-bold text-sm sm:text-base tracking-tight @(isCompleted ? "line-through opacity-50 text-base-content/70" : "text-base-content")">
                                        @title
                                    </span>

                                    <!-- 优先级徽章 -->
                                    @if (priority == "high")
                                    {
                                        <span class="badge badge-error badge-sm text-[11px] font-bold gap-1 shadow-sm">🔥 高优</span>
                                    }
                                    else if (priority == "medium")
                                    {
                                        <span class="badge badge-warning badge-sm text-[11px] font-medium gap-1">⚡ 中等</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-ghost badge-sm text-[11px] opacity-70">💤 低优</span>
                                    }

                                    <!-- 到期健康度状态 -->
                                    @if (!isCompleted && isOverdue)
                                    {
                                        <span class="badge badge-error badge-outline badge-sm text-[11px] font-mono font-semibold">⚠️ 逾期</span>
                                    }
                                    else if (!isCompleted && isDueToday)
                                    {
                                        <span class="badge badge-warning badge-outline badge-sm text-[11px] font-semibold">⏳ 今日截止</span>
                                    }

                                    @if (isCompleted)
                                    {
                                        <span class="badge badge-success badge-sm text-[11px] text-white font-medium">已完成</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(desc))
                                {
                                    <p class="text-xs opacity-65 leading-relaxed line-clamp-2 @(isCompleted ? "line-through opacity-40" : "")">
                                        @desc
                                    </p>
                                }
                            </div>
                        </div>

                        <!-- 截止时间与操作区 (竖屏下单手优化布局，大屏右对齐) -->
                        <div class="flex items-center justify-between sm:justify-end gap-2.5 pt-2 sm:pt-0 border-t sm:border-t-0 border-base-200/60 shrink-0 w-full sm:w-auto">
                            @if (!string.IsNullOrWhiteSpace(dueDateStr))
                            {
                                <div class="text-[11px] sm:text-xs flex items-center gap-1.5 font-mono px-2.5 py-1 rounded-lg bg-base-200/60 @(isOverdue && !isCompleted ? "text-error font-bold" : "opacity-75")">
                                    <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    <span>@dueDateStr</span>
                                </div>
                            }

                            <!-- 编辑与删除动作 -->
                            <div class="flex items-center gap-1 ml-auto sm:ml-0">
                                <a href="@Url.Content($"~/{currentProject}/DynamicEntity/Edit?entity=todo&id={id}&returnUrl={Url.Content($"~/{currentProject}/Page/HomePage")}")" 
                                   class="btn btn-ghost btn-xs btn-square hover:bg-base-200 safe-touch-btn" title="编辑待办详情">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                </a>
                                <form method="post" action="@Url.Content($"~/{currentProject}/DynamicEntity/Delete")" onsubmit="return confirm('确定要删除这项待办吗？');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="entity" value="todo" />
                                    <input type="hidden" name="id" value="@id" />
                                    <input type="hidden" name="returnUrl" value="@Url.Content($"~/{currentProject}/Page/HomePage")" />
                                    <button type="submit" class="btn btn-ghost btn-xs btn-square text-error hover:bg-error/10 safe-touch-btn" title="删除待办">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- 筛选无结果空状态 -->
    <div id="noMatchCard" class="card bg-base-100 border border-dashed border-base-300 py-12 text-center hidden mt-4 rounded-3xl">
        <div class="text-3xl mb-2">🔍</div>
        <div class="font-bold text-base">未找到符合条件的待办事项</div>
        <p class="text-xs opacity-50 mt-1">请尝试清除搜索关键词或切换上方的筛选分类。</p>
    </div>
</div>

<script>
    let currentFilter = 'all';

    function filterTodos(filter) {
        currentFilter = filter;
        document.querySelectorAll('.todo-filter-btn').forEach(btn => {
            if (btn.dataset.filter === filter) {
                btn.classList.add('tab-active');
            } else {
                btn.classList.remove('tab-active');
            }
        });
        applyFilters();
    }

    function searchTodos() {
        applyFilters();
    }

    function applyFilters() {
        const query = (document.getElementById('todoSearchInput')?.value || '').trim().toLowerCase();
        const items = document.querySelectorAll('.todo-item');
        let visibleCount = 0;

        items.forEach(item => {
            const isCompleted = item.dataset.completed === 'true';
            const priority = item.dataset.priority;
            const isDueToday = item.dataset.duetoday === 'true';
            const title = item.dataset.title;
            const desc = item.dataset.desc;

            let matchesFilter = true;
            if (currentFilter === 'pending') {
                matchesFilter = !isCompleted;
            } else if (currentFilter === 'completed') {
                matchesFilter = isCompleted;
            } else if (currentFilter === 'high') {
                matchesFilter = (priority === 'high' && !isCompleted);
            } else if (currentFilter === 'today') {
                matchesFilter = (isDueToday && !isCompleted);
            }

            let matchesSearch = true;
            if (query) {
                matchesSearch = title.includes(query) || desc.includes(query);
            }

            if (matchesFilter && matchesSearch) {
                item.style.display = 'block';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        const noMatch = document.getElementById('noMatchCard');
        if (noMatch) {
            noMatch.style.display = (visibleCount === 0 && items.length > 0) ? 'block' : 'none';
        }
    }
</script>
