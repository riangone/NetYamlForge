@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    Layout = ViewBag.LayoutPath as string ?? "~/projects/blog/views/_Layout.cshtml";

    var project = Context.GetRouteValue("project")?.ToString() ?? "blog";

    var postRows     = Model.ContainsKey("post")       ? Model["post"].Rows.ToList()       : new();
    var tagRows      = Model.ContainsKey("post_tags")  ? Model["post_tags"].Rows.ToList()  : new();
    var commentRows  = Model.ContainsKey("comments")   ? Model["comments"].Rows.ToList()   : new();
    var relatedRows  = Model.ContainsKey("related")    ? Model["related"].Rows.ToList()    : new();

    var post = postRows.FirstOrDefault();

    var title         = post?.GetValueOrDefault("Title")?.ToString() ?? "";
    var content       = post?.GetValueOrDefault("Content")?.ToString() ?? "";
    var summary       = post?.GetValueOrDefault("Summary")?.ToString() ?? "";
    var coverImage    = post?.GetValueOrDefault("CoverImage")?.ToString();
    var categoryName  = post?.GetValueOrDefault("CategoryName")?.ToString() ?? "";
    var categoryColor = post?.GetValueOrDefault("CategoryColor")?.ToString() ?? "#6366f1";
    var authorName    = post?.GetValueOrDefault("AuthorName")?.ToString() ?? "";
    var postId        = post?.GetValueOrDefault("Id");
    var viewCount     = post?.GetValueOrDefault("ViewCount")?.ToString() ?? "0";

    string FormatDate(object? val)
    {
        if (val is null) return "";
        if (DateTime.TryParse(val.ToString(), out var dt))
            return dt.ToString("D");
        return val.ToString() ?? "";
    }
    var pubDate = post is not null ? FormatDate(post.GetValueOrDefault("PublishedAt")) : "";

    ViewData["Title"] = title;

    var commentSuccess = TempData["CommentSuccess"]?.ToString();
    var commentError   = TempData["CommentError"]?.ToString();
    var blogHomeUrl    = $"/blog";
    string TagFilter(object? id) => $"/blog?tagId={id}";
    string CategoryFilter(object? id) => $"/blog?categoryId={id}";
}

@section Head {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark-dimmed.min.css">
    <style>
        /* 极致美化代码块 */
        .prose-blog pre {
            position: relative;
            background: #1e1e1e !important;
            padding: 2.75rem 1.25rem 1.25rem 1.25rem !important;
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3), 0 4px 6px -4px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.05);
            margin: 1.5rem 0;
            overflow-x: auto;
        }

        /* Mac 风格的三色圆点控制按钮 */
        .prose-blog pre::before {
            content: "";
            position: absolute;
            top: 1rem;
            left: 1.25rem;
            width: 0.625rem;
            height: 0.625rem;
            border-radius: 50%;
            background: #ff5f56;
            box-shadow: 1.25rem 0 0 #ffbd2e, 2.5rem 0 0 #27c93f;
            opacity: 0.8;
        }

        /* 右上角语言标识 */
        .prose-blog pre[data-lang]::after {
            content: attr(data-lang);
            position: absolute;
            top: 0.75rem;
            right: 1.25rem;
            font-size: 0.75rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.4);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .prose-blog code {
            font-family: 'Fira Code', 'Cascadia Code', Consolas, Monaco, 'Andale Mono', 'Ubuntu Mono', monospace !important;
        }

        .prose-blog :not(pre) > code {
            background: oklch(var(--b3));
            color: oklch(var(--bc) / 0.9);
            padding: 0.15rem 0.4rem;
            border-radius: 0.375rem;
            font-size: 0.875rem;
            font-weight: 500;
            border: 1px solid oklch(var(--b3) / 0.5);
        }

        .prose-blog pre code {
            background: transparent !important;
            padding: 0 !important;
            color: #adbac7 !important;
            display: block;
            line-height: 1.5;
        }

        /* 美化 Mermaid 渲染的容器 */
        .mermaid {
            background: #1e1e1e !important;
            padding: 1.5rem;
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3), 0 4px 6px -4px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.05);
            margin: 1.5rem 0;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: auto;
        }
        .mermaid svg {
            max-width: 100% !important;
            height: auto !important;
        }

        /* 针对 YAML 代码高亮的颜色微调 */
        .hljs-attr {
            color: #79c0ff !important; /* YAML 键 */
        }
        .hljs-string {
            color: #a5d6ff !important; /* YAML 值 */
        }
        .hljs-number, .hljs-literal {
            color: #ff938a !important; /* 数字与布尔值 */
        }
        .hljs-bullet {
            color: #ff7b72 !important; /* YAML 列表符号 */
        }
        .hljs-meta {
            color: #8b949e !important;
        }
    </style>
}

@if (post is null)
{
    <div class="max-w-3xl mx-auto px-4 py-24 text-center text-base-content/40">
        <p class="text-5xl mb-4">📭</p>
        <h1 class="text-2xl font-bold mb-2">@L["PostNotFound"]</h1>
        <p class="mb-6 text-sm">@L["PostNotFoundDetail"]</p>
        <a href="@blogHomeUrl" class="btn btn-primary btn-sm rounded-full">@L["BackToBlog"]</a>
    </div>
}
else
{
    <!-- 面包屑导航 -->
    <div class="max-w-4xl mx-auto px-4 pt-8">
        <nav class="text-sm breadcrumbs">
            <ul>
                <li><a href="@blogHomeUrl" class="text-primary hover:underline">@L["Blog"]</a></li>
                @if (!string.IsNullOrEmpty(categoryName))
                {
                    <li class="text-base-content/50">@categoryName</li>
                }
                <li class="text-base-content/70 truncate max-w-xs">@title</li>
            </ul>
        </nav>
    </div>

    <!-- 文章正文 -->
    <article class="max-w-4xl mx-auto px-4 pb-12">

        <!-- 文章头部 -->
        <header class="mb-8 mt-4">
            <div class="flex items-center gap-2 mb-4 flex-wrap">
                @if (!string.IsNullOrEmpty(categoryName))
                {
                    <a href="@CategoryFilter(post?.GetValueOrDefault("CategoryId"))" class="badge text-white font-medium hover:opacity-80 transition-opacity"
                          style="background-color: @categoryColor">@categoryName</a>
                }
                @foreach (var tag in tagRows)
                {
                    <a href="@TagFilter(tag.GetValueOrDefault("Id"))" class="badge badge-outline badge-sm hover:badge-primary transition-colors">@(tag.GetValueOrDefault("Name")?.ToString() ?? "")</a>
                }
            </div>

            <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-4 text-base-content">
                @title
            </h1>

            @if (!string.IsNullOrEmpty(summary))
            {
                <p class="text-lg text-base-content/60 leading-relaxed mb-4">@summary</p>
            }

            <div class="flex items-center gap-4 text-sm text-base-content/50 pb-6 border-b border-base-200">
                <span class="flex items-center gap-1.5">
                    <span class="avatar avatar-xs placeholder">
                        <div class="bg-primary/10 text-primary rounded-full w-7 h-7 flex items-center justify-center text-xs font-bold">
                            @(authorName.Length > 0 ? authorName[0].ToString() : "A")
                        </div>
                    </span>
                    <span class="font-medium text-base-content">@authorName</span>
                </span>
                <span class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    @pubDate
                </span>
                <span class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    @viewCount @L["Views"]
                </span>
                <span class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                    @commentRows.Count @L["Comments"]
                </span>
            </div>
        </header>

        <!-- 封面图片 -->
        @if (!string.IsNullOrEmpty(coverImage))
        {
            <div class="mb-8 rounded-xl overflow-hidden shadow">
                <img src="@coverImage" alt="@title" class="w-full object-cover max-h-96" />
            </div>
        }

        <!-- 渲染后的 Markdown -->
        <div id="post-content" class="prose-blog min-h-32">
            <div id="post-raw" class="hidden">@content</div>
        </div>

        <!-- 底部 -->
        <div class="mt-10 pt-6 border-t border-base-200 flex items-center justify-between flex-wrap gap-3">
            <a href="@blogHomeUrl" class="btn btn-ghost btn-sm gap-1">
                @L["BackToBlogList"]
            </a>
            <div class="flex gap-2">
                @foreach (var tag in tagRows)
                {
                    <a href="@TagFilter(tag.GetValueOrDefault("Id"))" class="badge badge-outline hover:badge-primary transition-colors">@(tag.GetValueOrDefault("Name")?.ToString() ?? "")</a>
                }
            </div>
        </div>
    </article>

    <!-- 相关文章 -->
    @if (relatedRows.Any())
    {
        <section class="max-w-4xl mx-auto px-4 mb-12">
            <h2 class="text-lg font-bold mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                @L["RelatedPosts"]
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                @foreach (var related in relatedRows)
                {
                    var rId     = related.GetValueOrDefault("Id");
                    var rTitle  = related.GetValueOrDefault("Title")?.ToString() ?? "";
                    var rAuthor = related.GetValueOrDefault("AuthorName")?.ToString() ?? "";
                    var rDate   = FormatDate(related.GetValueOrDefault("PublishedAt"));
                    <a href="/@project/Page/PostDetail?id=@rId"
                       class="card bg-base-100 border border-base-200 hover:shadow-md hover:border-primary/30 transition-all duration-200 p-4">
                        <p class="font-semibold text-sm hover:text-primary leading-snug line-clamp-2">@rTitle</p>
                        <p class="text-xs text-base-content/50 mt-2">@rAuthor · @rDate</p>
                    </a>
                }
            </div>
        </section>
    }

    <!-- 评论区 -->
    <section id="comments" class="max-w-4xl mx-auto px-4 mb-16">
        <div class="divider"></div>
        <h2 class="text-lg font-bold mb-6 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            @string.Format(L["CommentsCount"], commentRows.Count)
        </h2>

        <!-- 评论列表 -->
        @if (commentRows.Any())
        {
            <div class="space-y-4 mb-8">
                @foreach (var comment in commentRows)
                {
                    var cAuthor  = comment.GetValueOrDefault("AuthorName")?.ToString() ?? L["AnonymousUser"].Value;
                    var cContent = comment.GetValueOrDefault("Content")?.ToString() ?? "";
                    var cDate    = FormatDate(comment.GetValueOrDefault("CreatedAt"));
                    <div class="flex gap-3">
                        <div class="avatar placeholder shrink-0">
                            <div class="bg-neutral/10 text-neutral rounded-full w-9 h-9 flex items-center justify-center text-sm font-bold">
                                @(cAuthor.Length > 0 ? cAuthor[0].ToString() : "?")
                            </div>
                        </div>
                        <div class="flex-1 bg-base-200 rounded-2xl rounded-tl-none px-4 py-3">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="font-semibold text-sm">@cAuthor</span>
                                <span class="text-xs text-base-content/40">@cDate</span>
                            </div>
                            <p class="text-sm text-base-content/80 whitespace-pre-wrap">@cContent</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-sm text-base-content/40 mb-8 text-center py-6">@L["NoCommentsYet"]</p>
        }

        <!-- 评论表单 -->
        <div class="card bg-base-100 border border-base-200 shadow-sm">
            <div class="card-body p-6">
                <h3 class="font-bold text-base mb-4">@L["PostComment"]</h3>

                @if (!string.IsNullOrEmpty(commentSuccess))
                {
                    <div class="alert alert-success mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>@commentSuccess</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(commentError))
                {
                    <div class="alert alert-error mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>@commentError</span>
                    </div>
                }

                <form method="post" action="/@project/BlogPublic/SubmitComment" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="postId" value="@postId" />

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium">@L["Nickname"] <span class="text-base-content/40 text-xs">@L["OptionalNickname"]</span></span>
                            </label>
                            <input type="text" name="authorName" maxlength="100"
                                   placeholder="@L["YourName"]"
                                   class="input input-bordered input-sm w-full" />
                        </div>
                        <div class="form-control">
                            <label class="label">
                                <span class="label-text font-medium">@L["Email"] <span class="text-base-content/40 text-xs">@L["OptionalNotPublic"]</span></span>
                            </label>
                            <input type="email" name="authorEmail" maxlength="200"
                                   placeholder="mail@example.com"
                                   class="input input-bordered input-sm w-full" />
                        </div>
                    </div>

                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-medium">@L["Content"] <span class="text-error">*</span></span>
                        </label>
                        <textarea name="content" required maxlength="2000" rows="4"
                                  placeholder="@L["WriteYourComment"]"
                                  class="textarea textarea-bordered w-full text-sm"></textarea>
                        <label class="label">
                            <span class="label-text-alt text-base-content/40">@L["CommentReviewNotice"]</span>
                        </label>
                    </div>

                    <div class="flex justify-end">
                        <button type="submit" class="btn btn-primary btn-sm rounded-full gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                            </svg>
                            @L["SubmitComment"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/yaml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mermaid/10.9.0/mermaid.min.js"></script>
<script>
    // Markdown レンダリング
    (function () {
        const rawEl = document.getElementById('post-raw');
        const contentEl = document.getElementById('post-content');
        if (!rawEl || !contentEl || typeof marked === 'undefined') return;

        // 1. 预处理：自动检测并修复可能缺失 ```yaml 围栏的 yaml/yml 文本块
        let lines = (rawEl.textContent || '').split('\n');
        let inFixingYaml = false;
        let yamlLines = [];
        let newLines = [];
        
        for (let i = 0; i < lines.length; i++) {
            let line = lines[i];
            let trimmed = line.trim();
            if (!inFixingYaml && (trimmed === 'yaml' || trimmed === 'yml')) {
                // 检查下一行是否是 YAML 格式行（首行缩进、包含冒号或以注释 # 开头）
                if (i + 1 < lines.length && (lines[i+1].trim().startsWith('#') || lines[i+1].includes(':'))) {
                    inFixingYaml = true;
                    yamlLines = [];
                    continue;
                }
            }
            
            if (inFixingYaml) {
                // 判断 YAML 段落结束：遇到不属于 YAML 特征且不为空的行（非缩进、非空、非注释、且不含冒号）
                let isYamlLine = trimmed.startsWith('#') || trimmed.includes(':') || line.startsWith(' ') || line.startsWith('\t') || trimmed === '';
                if (!isYamlLine) {
                    newLines.push('```yaml');
                    newLines.push(...yamlLines);
                    newLines.push('```');
                    newLines.push(line);
                    inFixingYaml = false;
                } else {
                    yamlLines.push(line);
                }
            } else {
                newLines.push(line);
            }
        }
        if (inFixingYaml) {
            newLines.push('```yaml');
            newLines.push(...yamlLines);
            newLines.push('```');
        }
        let processedText = newLines.join('\n');

        // 2. 解析 Markdown
        marked.setOptions({ breaks: true, gfm: true });
        contentEl.innerHTML = marked.parse(processedText);

        // 3. 处理 mermaid 元素 (将 pre > code.language-mermaid 转换为 div.mermaid 以脱离代码框的容器样式)
        document.querySelectorAll('#post-content pre code.language-mermaid').forEach((el) => {
            const preEl = el.parentNode;
            if (preEl && preEl.tagName === 'PRE') {
                const mermaidDiv = document.createElement('div');
                mermaidDiv.className = 'mermaid';
                mermaidDiv.textContent = el.textContent.trim();
                preEl.parentNode.replaceChild(mermaidDiv, preEl);
            }
        });

        // 4. 处理普通代码块的语法高亮与语言标签设置
        document.querySelectorAll('#post-content pre code').forEach((el) => {
            let lang = 'code';
            const classes = el.className.split(' ');
            for (const cls of classes) {
                if (cls.startsWith('language-')) {
                    lang = cls.replace('language-', '');
                    break;
                }
            }

            // 兼容 yml 和 yaml 的类名
            if (lang === 'yml') {
                el.classList.remove('language-yml');
                el.classList.add('language-yaml');
            }
            
            const preEl = el.parentNode;
            if (preEl && preEl.tagName === 'PRE') {
                preEl.setAttribute('data-lang', lang === 'yml' ? 'yaml' : lang);
            }

            if (typeof hljs !== 'undefined') {
                hljs.highlightElement(el);
            }
        });

        // 5. 初始化并触发 mermaid 渲染
        if (typeof mermaid !== 'undefined') {
            let mermaidTheme = 'default';
            const currentTheme = document.documentElement.getAttribute('data-theme') || '';
            const darkThemes = ['dark', 'synthwave', 'halloween', 'forest', 'luxury', 'dracula', 'business', 'night', 'coffee', 'dim', 'sunset'];
            if (darkThemes.includes(currentTheme)) {
                mermaidTheme = 'dark';
            }
            
            mermaid.initialize({
                startOnLoad: false,
                theme: mermaidTheme,
                securityLevel: 'loose',
                themeVariables: {
                    background: '#1e1e1e'
                }
            });
            mermaid.run();
        }
    })();

    // 记录阅读量
    (function () {
        const postId = '@postId';
        if (postId) {
            fetch(`/@project/BlogPublic/IncrementViewCount`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `postId=${postId}`
            }).catch(e => console.error('Failed to increment view count', e));
        }
    })();
</script>
}
