@using NetYamlForge.Models
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject NetYamlForge.Services.ProjectScope ProjectScope
@inject NetYamlForge.Services.IEntityMetadataProvider EntityMetadataProvider
@{
    var afTokens = Antiforgery.GetAndStoreTokens(Context);
    var currentProject = Context.GetRouteValue("project")?.ToString() ?? "blog";
    var blogHomeUrl = $"/{currentProject}";
    var adminUrl = $"/{currentProject}/Dashboard";
    var loginUrl = $"/{currentProject}/TenantAccount/Login?returnUrl={Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)}";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isAdminUser = User?.IsInRole("Admin") ?? false;
    var pathBase = Url.Content("~/").TrimEnd('/');

    // サイドバー表示判定（ログイン時のみ表示）
    var showSidebar = isAuthenticated;

    // ナビゲーション設定
    var projectLayout = ProjectScope?.Current?.Layout;
    var navConfig = projectLayout?.Navigation;
    
    // エンティティ定義（管理者は全表示、一般は公開のみ）
    var allEntities = EntityMetadataProvider.GetAll()
        .Where(pair => isAdminUser || pair.Value.IsPublic)
        .OrderBy(pair => pair.Value.GetDisplayName(), StringComparer.OrdinalIgnoreCase)
        .ToList();
    
    var entityDefinitions = navConfig != null && navConfig.Entities.Count > 0
        ? allEntities.Where(pair => navConfig.Entities.Contains(pair.Key, StringComparer.OrdinalIgnoreCase))
            .OrderBy(pair => navConfig.Entities.IndexOf(pair.Key))
            .ToList()
        : allEntities;
}
<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — Blog" : "Blog")</title>
    <meta name="csrf-token-header" content="@afTokens.HeaderName" />
    <meta name="csrf-token" content="@afTokens.RequestToken" />
    <link href="@Url.Content("~/lib/daisyui/daisyui.min.css")" rel="stylesheet" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/NetYamlForge.styles.css")" asp-append-version="true" />
    <script src="@Url.Content("~/lib/tailwindcss/browser.min.js")"></script>
    <script src="@Url.Content("~/lib/htmx/htmx.min.js")"></script>
    <script src="@Url.Content("~/lib/marked/marked.min.js")"></script>
    <script src="@Url.Content("~/js/site.js")" asp-append-version="true"></script>
    <style>
        .prose-blog { font-size: 1rem; line-height: 1.75; }
        .prose-blog h1 { font-size: 1.875rem; font-weight: 700; margin: 2rem 0 1rem; }
        .prose-blog h2 { font-size: 1.5rem; font-weight: 700; margin: 1.5rem 0 0.75rem; border-bottom: 1px solid oklch(var(--b3)); padding-bottom: 0.25rem; }
        .prose-blog h3 { font-size: 1.25rem; font-weight: 600; margin: 1.25rem 0 0.5rem; }
        .prose-blog p  { margin-bottom: 1rem; }
        .prose-blog ul { list-style: disc; list-style-position: inside; margin-bottom: 1rem; }
        .prose-blog ol { list-style: decimal; list-style-position: inside; margin-bottom: 1rem; }
        .prose-blog li { margin-bottom: 0.25rem; }
        .prose-blog blockquote { border-left: 4px solid oklch(var(--p)); padding-left: 1rem; font-style: italic; opacity: 0.75; margin: 1rem 0; }
        .prose-blog pre { background: oklch(var(--b3)); border-radius: 0.5rem; padding: 1rem; overflow-x: auto; margin: 1rem 0; font-size: 0.875rem; }
        .prose-blog code { background: oklch(var(--b3)); padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875rem; font-family: monospace; }
        .prose-blog pre code { background: transparent; padding: 0; }
        .prose-blog a { color: oklch(var(--p)); text-decoration: underline; }
        .prose-blog img { border-radius: 0.5rem; max-width: 100%; margin: 1rem 0; }
        .prose-blog table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
        .prose-blog th, .prose-blog td { border: 1px solid oklch(var(--b3)); padding: 0.5rem 0.75rem; }
        .prose-blog th { font-weight: 700; background: oklch(var(--b2)); }
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    </style>
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="min-h-screen bg-base-100 flex flex-col">

    <div class="drawer">
        <input id="app-sidebar" type="checkbox" class="drawer-toggle" />

        <div class="drawer-content flex flex-col min-h-screen">
            <!-- ナビゲーションバー -->
            <header class="navbar bg-base-100 border-b border-base-200 sticky top-0 z-40 shadow-sm">
                <div class="navbar-start">
                    @if (showSidebar)
                    {
                        <label for="app-sidebar" class="btn btn-ghost btn-square">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        </label>
                    }
                    <a href="@blogHomeUrl" class="flex items-center gap-2 text-xl font-bold text-primary hover:opacity-80 transition-opacity">
                        <span class="text-2xl">📝</span>
                        <span>Blog</span>
                    </a>
                </div>
                <div class="navbar-center hidden md:flex">
                    <nav class="flex gap-1">
                        <a href="@blogHomeUrl" class="btn btn-ghost btn-sm rounded-full">ホーム</a>
                    </nav>
                </div>
                <div class="navbar-end gap-2">
                    @if (isAuthenticated)
                    {
                        <a href="@adminUrl" class="btn btn-ghost btn-sm hidden md:inline-flex gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            管理
                        </a>
                        <form method="post" action="/@currentProject/TenantAccount/Logout" class="inline">
                            <input type="hidden" name="__RequestVerificationToken" value="@afTokens.RequestToken" />
                            <button type="submit" class="btn btn-ghost btn-sm">ログアウト</button>
                        </form>
                    }
                    else
                    {
                        <a href="@loginUrl" class="btn btn-primary btn-sm rounded-full">ログイン</a>
                    }
                </div>
            </header>

            <!-- メインコンテンツ -->
            <main class="flex-1">
                @RenderBody()
            </main>

            <!-- フッター -->
            <footer class="footer footer-center p-8 bg-base-200 text-base-content/60 mt-16 border-t border-base-300">
                <div class="space-y-1">
                    <p class="font-semibold text-base-content">📝 Blog</p>
                    <p class="text-sm">NetYamlForge で構築されたブログシステム</p>
                </div>
                <div class="flex gap-4 text-sm">
                    <a href="@blogHomeUrl" class="link link-hover">ホーム</a>
                    @if (!isAuthenticated)
                    {
                        <a href="@loginUrl" class="link link-hover">管理者ログイン</a>
                    }
                </div>
            </footer>
        </div>

        @if (showSidebar)
        {
            <div class="drawer-side z-50">
                <label for="app-sidebar" aria-label="close sidebar" class="drawer-overlay"></label>
                <aside class="bg-base-100 w-72 min-h-full border-r border-base-300">
                    <div class="p-4 border-b border-base-300 flex items-center justify-between">
                        <div>
                            <div class="text-sm opacity-70">Navigation</div>
                            <div class="font-semibold">@currentProject</div>
                        </div>
                        <label for="app-sidebar" class="btn btn-ghost btn-sm btn-square" aria-label="close menu">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </label>
                    </div>

                    <ul class="menu p-3 gap-1 w-full">
                        @if (navConfig?.Items != null)
                        {
                            <li class="menu-title mt-1"><span>Menu</span></li>
                            foreach (var item in navConfig.Items)
                            {
                                if (item.AdminOnly && !isAdminUser) continue;
                                var url = string.IsNullOrEmpty(item.Url) 
                                    ? Url.Action(item.Action ?? "Index", item.Controller, new { project = currentProject })
                                    : (item.Url.StartsWith('/') ? pathBase + item.Url : item.Url);
                                <li><a href="@url">@item.Label</a></li>
                            }
                        }

                        @{
                            var allPages = ProjectScope?.Current?.PageMetadata?.GetAll();
                        }
                        @if (allPages != null && allPages.Count > 0)
                        {
                            <li class="menu-title mt-1"><span>Pages</span></li>
                            @foreach (var page in allPages)
                            {
                                if (!page.Value.ShowInSidebar) continue;
                                var pageUrl = string.IsNullOrEmpty(pathBase)
                                    ? $"/{currentProject}/Page/{page.Key}"
                                    : $"{pathBase}/{currentProject}/Page/{page.Key}";
                                <li>
                                    <a href="@pageUrl">@(page.Value.Title)</a>
                                </li>
                            }
                        }

                        @if (entityDefinitions.Count > 0)
                        {
                            <li class="menu-title mt-1"><span>Entities</span></li>
                            @foreach (var definition in entityDefinitions)
                            {
                                <li>
                                    <a asp-controller="DynamicEntity"
                                       asp-action="Index"
                                       asp-route-project="@currentProject"
                                       asp-route-entity="@definition.Key">@definition.Value.GetDisplayName()</a>
                                </li>
                            }
                        }
                    </ul>
                </aside>
            </div>
        }
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
