@using NetYamlForge.Models
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    // プロジェクト固有のレイアウトを設定
    if (ViewBag.LayoutPath != null)
    {
        Layout = ViewBag.LayoutPath;
    }
    
    var pageDef = (PageDefinition)ViewData["PageDef"]!;
    var currentProject = ViewData["Project"] as string ?? "";
    var pageName = ViewData["PageName"] as string ?? "BlogList";

    ViewData["Title"] = (pageDef.Title ?? "Blog") + " - Blog CMS";
    ViewData["ActivePage"] = "Page";

    var postsData = Model.TryGetValue("posts", out var pd) ? pd : (Enumerable.Empty<Dictionary<string, object>>(), 0);
    var posts = postsData.Item1.ToList();
    var total = postsData.Item2;

    var titleFilter = Context.Request.Query["posts_title"].FirstOrDefault() ?? "";
}

<div class="container mx-auto px-4 py-8">
    @* ヘッダー *@
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">@(pageDef.Title ?? "Blog")</h1>
        @if (!string.IsNullOrEmpty(pageDef.Description))
        {
            <p class="text-gray-500">@pageDef.Description</p>
        }
    </div>

    @* タイトル検索フォーム *@
    <form method="get" class="mb-6 flex gap-2 max-w-md">
        <input type="text" name="posts_title" value="@titleFilter"
               placeholder="タイトルで検索..."
               class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" />
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700 transition">
            <i class="fas fa-search mr-1"></i>検索
        </button>
        @if (!string.IsNullOrEmpty(titleFilter))
        {
            <a href="/@Uri.EscapeDataString(currentProject)/Page/@pageName"
               class="px-4 py-2 bg-gray-100 text-gray-600 text-sm rounded-lg hover:bg-gray-200 transition">
                クリア
            </a>
        }
    </form>

    @* 記事グリッド *@
    @if (posts.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var row in posts)
            {
                var postId = row.TryGetValue("post_id", out var pid) ? pid?.ToString() ?? "" : "";
                var postTitle = row.TryGetValue("title", out var t) ? t?.ToString() ?? "" : "";
                var postExcerpt = row.TryGetValue("excerpt", out var ex) ? ex?.ToString() ?? "" : "";
                var postAuthor = row.TryGetValue("author", out var au) ? au?.ToString() ?? "" : "";
                var postDate = row.TryGetValue("published_at", out var dt) ? dt?.ToString() ?? "" : "";
                var catName = row.TryGetValue("category_name", out var cn) ? cn?.ToString() ?? "" : "";
                var catColor = row.TryGetValue("category_color", out var cc) ? cc?.ToString() ?? "#6366f1" : "#6366f1";
                var viewCount = row.TryGetValue("view_count", out var vc) ? vc?.ToString() ?? "0" : "0";

                <div class="bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col">
                    <div class="p-5 flex flex-col flex-1">
                        @if (!string.IsNullOrEmpty(catName))
                        {
                            <span class="inline-block text-xs font-semibold px-2 py-1 rounded-full text-white mb-3"
                                  style="background-color: @catColor; width: fit-content;">@catName</span>
                        }
                        <h3 class="text-lg font-bold text-gray-900 mb-2 leading-snug">@postTitle</h3>
                        @if (!string.IsNullOrEmpty(postExcerpt))
                        {
                            <p class="text-sm text-gray-500 mb-4 flex-1 line-clamp-3">@postExcerpt</p>
                        }
                        else
                        {
                            <div class="flex-1"></div>
                        }
                        <div class="flex items-center justify-between text-xs text-gray-400 mt-3 pt-3 border-t border-gray-50">
                            <span class="flex items-center gap-1">
                                <i class="fas fa-user-circle"></i> @postAuthor
                            </span>
                            <span class="flex items-center gap-1">
                                <i class="fas fa-calendar-alt"></i>
                                @(postDate.Length > 10 ? postDate.Substring(0, 10) : postDate)
                            </span>
                            <span class="flex items-center gap-1">
                                <i class="fas fa-eye"></i> @viewCount
                            </span>
                        </div>
                    </div>
                    <a href="/@Uri.EscapeDataString(currentProject)/Page/BlogDetail?posts_post_id=@Uri.EscapeDataString(postId)"
                       class="block bg-blue-50 hover:bg-blue-100 text-blue-600 text-sm font-medium text-center py-2 transition-colors">
                        続きを読む <i class="fas fa-arrow-right ml-1"></i>
                    </a>
                </div>
            }
        </div>
        <div class="mt-6 text-sm text-gray-500 text-right">全 @total 件</div>
    }
    else
    {
        <div class="text-center py-16 text-gray-400">
            <i class="fas fa-newspaper text-5xl mb-4"></i>
            <p class="text-lg">
                @if (!string.IsNullOrEmpty(titleFilter))
                {
                    <span>「@titleFilter」に一致する記事がありません</span>
                }
                else
                {
                    <span>記事がありません</span>
                }
            </p>
        </div>
    }
</div>
