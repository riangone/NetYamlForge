@using NetYamlForge.Models
@model Dictionary<string, (IEnumerable<Dictionary<string, object>> Rows, int Total)>
@{
    // プロジェクト固有のレイアウトを設定
    if (ViewBag.LayoutPath != null)
    {
        Layout = ViewBag.LayoutPath;
    }
    
    var pageDef = (PageDefinition)ViewData["PageDef"]!;
    var pageName = (string)ViewData["PageName"]!;
    var currentProject = ViewData["Project"] as string ?? "";

    ViewData["Title"] = "記事公開管理 - Blog CMS";
    ViewData["ActivePage"] = "Page";

    var drafts   = Model.TryGetValue("drafts",    out var dd) ? dd.Item1.ToList() : new();
    var published = Model.TryGetValue("published", out var pd) ? pd.Item1.ToList() : new();
    var archived  = Model.TryGetValue("archived",  out var ad) ? ad.Item1.ToList() : new();
}

<div class="container mx-auto px-4 py-8">

    @* ヘッダー *@
    <div class="mb-8">
        <a href="/@Uri.EscapeDataString(currentProject)/Dashboard"
           class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1 mb-2">
            <i class="fas fa-arrow-left"></i> ダッシュボードへ
        </a>
        <h1 class="text-2xl font-bold text-gray-800 flex items-center gap-3">
            <i class="fas fa-newspaper text-blue-500"></i>
            記事公開管理
        </h1>
    </div>

    @* サマリーバッジ *@
    <div class="flex gap-4 mb-8 flex-wrap">
        <span class="px-4 py-2 bg-yellow-50 border border-yellow-200 text-yellow-700 rounded-full text-sm font-medium">
            <i class="fas fa-edit mr-1"></i> 下書き @drafts.Count 件
        </span>
        <span class="px-4 py-2 bg-green-50 border border-green-200 text-green-700 rounded-full text-sm font-medium">
            <i class="fas fa-globe mr-1"></i> 公開中 @published.Count 件
        </span>
        <span class="px-4 py-2 bg-gray-100 border border-gray-200 text-gray-600 rounded-full text-sm font-medium">
            <i class="fas fa-archive mr-1"></i> アーカイブ @archived.Count 件
        </span>
    </div>

    @* ─── 下書き ─── *@
    <section class="mb-10">
        <h2 class="text-lg font-bold text-gray-700 mb-3 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-yellow-400 inline-block"></span>
            下書き
        </h2>
        @if (!drafts.Any())
        {
            <p class="text-gray-400 text-sm py-4 px-4 bg-gray-50 rounded-lg">下書き記事はありません</p>
        }
        else
        {
            <div class="space-y-2" id="drafts-list">
                @foreach (var post in drafts)
                {
                    var pid = post.TryGetValue("post_id", out var p1) ? p1?.ToString() ?? "" : "";
                    var title = post.TryGetValue("title", out var p2) ? p2?.ToString() ?? "" : "";
                    var author = post.TryGetValue("author", out var p3) ? p3?.ToString() ?? "" : "";
                    var updated = post.TryGetValue("updated_at", out var p4) ? p4?.ToString() ?? "" : "";

                    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 flex items-center justify-between gap-4 shadow-sm" id="post-@pid">
                        <div class="flex-1 min-w-0">
                            <p class="font-semibold text-gray-800 truncate">@title</p>
                            <p class="text-xs text-gray-400 mt-0.5">
                                <i class="fas fa-user mr-1"></i>@author
                                <span class="mx-2">·</span>
                                <i class="fas fa-clock mr-1"></i>@(updated.Length > 10 ? updated.Substring(0, 10) : updated)
                            </p>
                        </div>
                        <div class="flex gap-2 flex-shrink-0">
                            @* 公開する *@
                            <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/drafts/update-row"
                                  hx-target="#post-@pid"
                                  hx-swap="outerHTML"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rowId" value="@pid" />
                                <input type="hidden" name="field" value="status" />
                                <input type="hidden" name="value" value="published" />
                                <button type="submit"
                                        class="px-3 py-1.5 bg-green-600 hover:bg-green-700 text-white text-xs font-medium rounded-lg transition flex items-center gap-1.5">
                                    <i class="fas fa-globe"></i> 公開する
                                </button>
                            </form>
                            @* 編集 *@
                            <a href="/@Uri.EscapeDataString(currentProject)/DynamicEntity/Edit/@Uri.EscapeDataString(pid)?entity=post"
                               class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-600 text-xs font-medium rounded-lg transition flex items-center gap-1.5">
                                <i class="fas fa-pen"></i> 編集
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @* ─── 公開中 ─── *@
    <section class="mb-10">
        <h2 class="text-lg font-bold text-gray-700 mb-3 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
            公開中
        </h2>
        @if (!published.Any())
        {
            <p class="text-gray-400 text-sm py-4 px-4 bg-gray-50 rounded-lg">公開中の記事はありません</p>
        }
        else
        {
            <div class="space-y-2" id="published-list">
                @foreach (var post in published)
                {
                    var pid = post.TryGetValue("post_id", out var p1) ? p1?.ToString() ?? "" : "";
                    var title = post.TryGetValue("title", out var p2) ? p2?.ToString() ?? "" : "";
                    var author = post.TryGetValue("author", out var p3) ? p3?.ToString() ?? "" : "";
                    var pubAt = post.TryGetValue("published_at", out var p4) ? p4?.ToString() ?? "" : "";
                    var views = post.TryGetValue("view_count", out var p5) ? p5?.ToString() ?? "0" : "0";

                    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 flex items-center justify-between gap-4 shadow-sm" id="post-@pid">
                        <div class="flex-1 min-w-0">
                            <p class="font-semibold text-gray-800 truncate">@title</p>
                            <p class="text-xs text-gray-400 mt-0.5">
                                <i class="fas fa-user mr-1"></i>@author
                                <span class="mx-2">·</span>
                                <i class="fas fa-calendar mr-1"></i>@(pubAt.Length > 10 ? pubAt.Substring(0, 10) : pubAt)
                                <span class="mx-2">·</span>
                                <i class="fas fa-eye mr-1"></i>@views 回
                            </p>
                        </div>
                        <div class="flex gap-2 flex-shrink-0">
                            @* 下書きに戻す *@
                            <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/published/update-row"
                                  hx-target="#post-@pid"
                                  hx-swap="outerHTML"
                                  hx-confirm="下書きに戻しますか？"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rowId" value="@pid" />
                                <input type="hidden" name="field" value="status" />
                                <input type="hidden" name="value" value="draft" />
                                <button type="submit"
                                        class="px-3 py-1.5 bg-yellow-100 hover:bg-yellow-200 text-yellow-700 text-xs font-medium rounded-lg transition flex items-center gap-1.5">
                                    <i class="fas fa-undo"></i> 下書きへ
                                </button>
                            </form>
                            @* アーカイブ *@
                            <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/published/update-row"
                                  hx-target="#post-@pid"
                                  hx-swap="outerHTML"
                                  hx-confirm="アーカイブしますか？"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rowId" value="@pid" />
                                <input type="hidden" name="field" value="status" />
                                <input type="hidden" name="value" value="archived" />
                                <button type="submit"
                                        class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-600 text-xs font-medium rounded-lg transition flex items-center gap-1.5">
                                    <i class="fas fa-archive"></i> アーカイブ
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @* ─── アーカイブ ─── *@
    <section>
        <h2 class="text-lg font-bold text-gray-700 mb-3 flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-gray-400 inline-block"></span>
            アーカイブ
        </h2>
        @if (!archived.Any())
        {
            <p class="text-gray-400 text-sm py-4 px-4 bg-gray-50 rounded-lg">アーカイブ記事はありません</p>
        }
        else
        {
            <div class="space-y-2" id="archived-list">
                @foreach (var post in archived)
                {
                    var pid = post.TryGetValue("post_id", out var p1) ? p1?.ToString() ?? "" : "";
                    var title = post.TryGetValue("title", out var p2) ? p2?.ToString() ?? "" : "";
                    var author = post.TryGetValue("author", out var p3) ? p3?.ToString() ?? "" : "";
                    var updated = post.TryGetValue("updated_at", out var p4) ? p4?.ToString() ?? "" : "";

                    <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 flex items-center justify-between gap-4 shadow-sm opacity-70" id="post-@pid">
                        <div class="flex-1 min-w-0">
                            <p class="font-semibold text-gray-600 truncate">@title</p>
                            <p class="text-xs text-gray-400 mt-0.5">
                                <i class="fas fa-user mr-1"></i>@author
                                <span class="mx-2">·</span>
                                <i class="fas fa-clock mr-1"></i>@(updated.Length > 10 ? updated.Substring(0, 10) : updated)
                            </p>
                        </div>
                        <div class="flex gap-2 flex-shrink-0">
                            @* 再公開 *@
                            <form hx-post="/@Uri.EscapeDataString(currentProject)/Page/@pageName/section/archived/update-row"
                                  hx-target="#post-@pid"
                                  hx-swap="outerHTML"
                                  class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rowId" value="@pid" />
                                <input type="hidden" name="field" value="status" />
                                <input type="hidden" name="value" value="published" />
                                <button type="submit"
                                        class="px-3 py-1.5 bg-green-100 hover:bg-green-200 text-green-700 text-xs font-medium rounded-lg transition flex items-center gap-1.5">
                                    <i class="fas fa-globe"></i> 再公開
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

</div>
