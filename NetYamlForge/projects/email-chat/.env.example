# Email Server Configuration
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=AI Assistant
SMTP_FROM_ADDRESS=your_email@gmail.com

# AI Configuration
# Set USE_GEMINI_CLI=true to use the local 'gemini' CLI tool instead of API calls
USE_GEMINI_CLI=true
# AI_MODEL=gemini-2.0-flash # Recommended for speed
# AI_MODEL=gemini-1.5-pro # Recommended for quality
AI_MODEL= # Leave empty to use Gemini CLI default (recommended)
AI_SYSTEM_PROMPT="You are a helpful AI assistant. Please reply to the following email professionally and concisely."

# API Configuration (Only used if USE_GEMINI_CLI=false)
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_API_KEY=sk-your-openai-api-key

# Optional: Only reply to emails from this specific sender address
TARGET_SENDER_EMAIL=user@example.com

# ── Invoice Email Processor settings ───────────────────────────
# 請求メール処理ジョブ (invoice_email_processor) 固有の設定
# 件名にこれらのキーワードが含まれるメールを請求処理ジョブ専用とする（カンマ区切り）
# ai_chat_poll はこれらのメールをスキップし、invoice_email_processor のみが処理する
INVOICE_SUBJECT_KEYWORDS=請求,invoice,Invoice,ご請求
