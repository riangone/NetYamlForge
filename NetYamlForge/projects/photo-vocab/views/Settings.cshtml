@using NetYamlForge.Localization
@using System.Text.Encodings.Web
@{
    var currentProject = Context.GetRouteValue("project")?.ToString() ?? "photo-vocab";

    string T(string key, string fallback) => I18nText.ResolveByKey(key) ?? fallback;

    ViewData["Title"] = T("projects.photo-vocab.views.settings.title", "看图背单词 — 系统设置");
    var cancelUrl = Url.Action("Index", "Page", new { project = currentProject, pageName = "HomePage" });
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }
    .settings-toggle:checked {
        background-color: #0891b2 !important;
        border-color: #0891b2 !important;
    }
    .animate-fade-in {
        animation: fadeIn 0.4s ease-out forwards;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="max-w-3xl mx-auto px-4 py-8 animate-fade-in">
    <!-- Navigation Back Link -->
    <div class="mb-6">
        <a href="@cancelUrl" class="inline-flex items-center gap-1.5 text-xs text-gray-500 hover:text-cyan-600 font-semibold transition-all">
            <span>⬅️</span> @T("projects.photo-vocab.views.settings.back", "返回图片墙")
        </a>
    </div>

    <!-- Main Panel -->
    <div class="card glass-card border border-cyan-100 shadow-xl rounded-3xl overflow-hidden">
        <!-- Header banner -->
        <div class="p-6 md:p-8 bg-gradient-to-r from-blue-50 via-cyan-50 to-teal-50 border-b border-cyan-100 flex items-center justify-between">
            <div class="space-y-1.5">
                <span class="text-2xl">⚙️</span>
                <h2 class="text-2xl font-extrabold text-gray-800">@T("projects.photo-vocab.views.settings.title", "系统偏好设置")</h2>
                <p class="text-xs text-gray-500">
                    @T("projects.photo-vocab.views.settings.desc", "个性化配置你的看图背单词学习体验。")
                </p>
            </div>
            <div class="text-3xl opacity-30 select-none">🛠️</div>
        </div>

        <div class="p-6 md:p-8 space-y-6">
            <!-- Settings Form -->
            <div class="space-y-6">
                <!-- Hide Header -->
                <div class="flex items-center justify-between p-4 bg-white/50 rounded-2xl border border-gray-100">
                    <div class="space-y-1 pr-4">
                        <h4 class="font-bold text-sm text-gray-800">@T("projects.photo-vocab.views.settings.hide_header_title", "隐藏 Header 导航栏")</h4>
                        <p class="text-xs text-gray-500">@T("projects.photo-vocab.views.settings.hide_header_desc", "默认隐藏顶部的系统全局导航栏，使页面更加沉浸、无干扰。")</p>
                    </div>
                    <input type="checkbox" id="pref-hide-header" class="toggle toggle-primary settings-toggle" />
                </div>

                <!-- Full Screen Mode -->
                <div class="flex items-center justify-between p-4 bg-white/50 rounded-2xl border border-gray-100">
                    <div class="space-y-1 pr-4">
                        <h4 class="font-bold text-sm text-gray-800">@T("projects.photo-vocab.views.settings.immersion_title", "沉浸式全屏展示")</h4>
                        <p class="text-xs text-gray-500">@T("projects.photo-vocab.views.settings.immersion_desc", "自动去除主内容容器的默认边距，完全拉伸占满整个屏幕。")</p>
                    </div>
                    <input type="checkbox" id="pref-hide-sidebar" class="toggle toggle-primary settings-toggle" />
                </div>

                <!-- Show Floating Menu -->
                <div class="flex items-center justify-between p-4 bg-white/50 rounded-2xl border border-gray-100">
                    <div class="space-y-1 pr-4">
                        <h4 class="font-bold text-sm text-gray-800">@T("projects.photo-vocab.views.settings.show_menu_title", "显示悬浮菜单按钮")</h4>
                        <p class="text-xs text-gray-500">@T("projects.photo-vocab.views.settings.show_menu_desc", "在屏幕右下角显示半透明的悬浮按钮，用于快速打开侧边栏。")</p>
                    </div>
                    <input type="checkbox" id="pref-show-menu" class="toggle toggle-primary settings-toggle" />
                </div>

                <!-- Quiz Round Size -->
                <div class="flex items-center justify-between p-4 bg-white/50 rounded-2xl border border-gray-100">
                    <div class="space-y-1 pr-4">
                        <h4 class="font-bold text-sm text-gray-800">@T("projects.photo-vocab.views.settings.round_size_title", "每轮挑战题数")</h4>
                        <p class="text-xs text-gray-500">@T("projects.photo-vocab.views.settings.round_size_desc", "设置每轮单词挑战包含的题目数量。")</p>
                    </div>
                    <select id="pref-round-size" class="select select-bordered select-sm rounded-xl max-w-xs text-xs font-semibold text-gray-700 bg-white">
                        <option value="5">5 @T("projects.photo-vocab.views.settings.questions_unit", "题")</option>
                        <option value="10" selected>10 @T("projects.photo-vocab.views.settings.questions_unit", "题")</option>
                        <option value="15">15 @T("projects.photo-vocab.views.settings.questions_unit", "题")</option>
                        <option value="20">20 @T("projects.photo-vocab.views.settings.questions_unit", "题")</option>
                        <option value="0">@T("projects.photo-vocab.views.settings.unlimited", "不限（经典模式）")</option>
                    </select>
                </div>

                <!-- Quiz Language -->
                <div class="flex items-center justify-between p-4 bg-white/50 rounded-2xl border border-gray-100">
                    <div class="space-y-1 pr-4">
                        <h4 class="font-bold text-sm text-gray-800">@T("projects.photo-vocab.views.settings.quiz_lang_title", "🎯 默认挑战语言")</h4>
                        <p class="text-xs text-gray-500">@T("projects.photo-vocab.views.settings.quiz_lang_desc", "进入单词挑战时的默认目标语言。")</p>
                    </div>
                    <select id="pref-quiz-language" class="select select-bordered select-sm rounded-xl max-w-xs text-xs font-semibold text-gray-700 bg-white">
                        <option value="en-US">🇺🇸 English</option>
                        <option value="zh-CN">🇨🇳 中文</option>
                        <option value="ja-JP">🇯🇵 日本語</option>
                        <option value="ko-KR">🇰🇷 한국어</option>
                    </select>
                </div>

                <!-- UI Display Language -->
                <div class="flex items-center justify-between p-4 bg-white/50 rounded-2xl border border-gray-100">
                    <div class="space-y-1 pr-4">
                        <h4 class="font-bold text-sm text-gray-800">@T("projects.photo-vocab.views.settings.ui_lang_title", "🌐 界面显示语言")</h4>
                        <p class="text-xs text-gray-500">@T("projects.photo-vocab.views.settings.ui_lang_desc", "设置应用界面的显示语言（支持中文、英文、日语、韩语）。")</p>
                    </div>
                    <select id="pref-ui-language" class="select select-bordered select-sm rounded-xl max-w-xs text-xs font-semibold text-gray-700 bg-white">
                        <option value="zh-CN">🇨🇳 简体中文</option>
                        <option value="en-US">🇺🇸 English</option>
                        <option value="ja-JP">🇯🇵 日本語</option>
                        <option value="ko-KR">🇰🇷 한국어</option>
                    </select>
                </div>
            </div>

            <!-- Shortcut Tips -->
            <div class="p-5 rounded-2xl bg-gradient-to-br from-blue-50 to-cyan-50 border border-blue-100/50 space-y-3">
                <h4 class="font-bold text-xs text-cyan-800 uppercase tracking-wider flex items-center gap-1.5">
                    @T("projects.photo-vocab.views.settings.shortcuts_title", "⌨️ 快捷键支持 (非输入框聚焦时有效)")
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs text-gray-600">
                    <div class="flex items-center gap-2 p-2 bg-white/80 rounded-xl border border-cyan-50">
                        <kbd class="kbd kbd-sm bg-gray-100 border border-gray-200 shadow-sm text-gray-700">M</kbd>
                        <span>@T("projects.photo-vocab.views.settings.shortcut_m", "打开 / 关闭侧边栏")</span>
                    </div>
                    <div class="flex items-center gap-2 p-2 bg-white/80 rounded-xl border border-cyan-50">
                        <kbd class="kbd kbd-sm bg-gray-100 border border-gray-200 shadow-sm text-gray-700">S</kbd>
                        <span>@T("projects.photo-vocab.views.settings.shortcut_s", "进入系统设置页面")</span>
                    </div>
                    <div class="flex items-center gap-2 p-2 bg-white/80 rounded-xl border border-cyan-50">
                        <kbd class="kbd kbd-sm bg-gray-100 border border-gray-200 shadow-sm text-gray-700">H</kbd>
                        <span>@T("projects.photo-vocab.views.settings.shortcut_h", "回到首页图片墙")</span>
                    </div>
                </div>
                <p class="text-[10px] text-cyan-500 italic">
                    @T("projects.photo-vocab.views.settings.shortcut_hint", "* 即使您完全隐藏了 Header、侧边栏和悬浮菜单，仍然可以通过键盘快捷键轻松呼出或返回。")
                </p>
            </div>

            <!-- Toast / Success feedback -->
            <div id="toast-success" class="alert alert-success bg-emerald-50 border-emerald-200 text-emerald-800 text-xs rounded-xl hidden flex items-center gap-2 transition-all">
                <span>✅</span> <span>@T("projects.photo-vocab.views.settings.save_success", "偏好设置已成功保存并立即生效！")</span>
            </div>

            <!-- Form Actions -->
            <div class="pt-4 flex items-center justify-end gap-3 border-t border-gray-100">
                <a href="@cancelUrl" class="btn btn-sm btn-ghost rounded-xl px-4 text-gray-500">@T("projects.photo-vocab.views.settings.cancel", "取消")</a>
                <button onclick="savePreferences()" class="btn btn-sm btn-primary bg-cyan-600 hover:bg-cyan-700 border-none px-6 rounded-xl text-white shadow-md shadow-cyan-100 flex items-center gap-2">
                    <span>💾</span> @T("projects.photo-vocab.views.settings.save_btn", "保存并应用")
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    const CURRENT_UI_LANGUAGE = '@System.Globalization.CultureInfo.CurrentUICulture.Name';

    function setUiLanguageCookie(lang) {
        const value = `c=${lang}|uic=${lang}`;
        const expires = new Date();
        expires.setTime(expires.getTime() + (365*24*60*60*1000));
        document.cookie = `.AspNetCore.Culture=${encodeURIComponent(value)};expires=${expires.toUTCString()};path=/`;
    }

    document.addEventListener('DOMContentLoaded', () => {
        let prefs = {};
        try {
            const saved = localStorage.getItem('pv_preferences');
            if (saved) prefs = JSON.parse(saved);
        } catch (e) {}

        const hideHeader = document.getElementById('pref-hide-header');
        const hideSidebar = document.getElementById('pref-hide-sidebar');
        const showMenu = document.getElementById('pref-show-menu');
        const roundSize = document.getElementById('pref-round-size');
        const quizLang = document.getElementById('pref-quiz-language');
        const uiLang = document.getElementById('pref-ui-language');

        if (hideHeader) hideHeader.checked = prefs.hideHeader !== false;
        if (hideSidebar) hideSidebar.checked = prefs.hideSidebar !== false;
        if (showMenu) showMenu.checked = prefs.showMenu !== false;
        if (roundSize) roundSize.value = prefs.roundSize || '10';
        if (quizLang) quizLang.value = prefs.quizLanguage || 'en-US';

        if (uiLang) {
            let matchedLang = CURRENT_UI_LANGUAGE || 'zh-CN';
            if (matchedLang === 'zh') matchedLang = 'zh-CN';
            else if (matchedLang === 'en') matchedLang = 'en-US';
            else if (matchedLang === 'ja') matchedLang = 'ja-JP';
            else if (matchedLang === 'ko') matchedLang = 'ko-KR';
            uiLang.value = matchedLang;
        }
    });

    function savePreferences() {
        const prefs = {
            hideHeader: document.getElementById('pref-hide-header').checked,
            hideSidebar: document.getElementById('pref-hide-sidebar').checked,
            showMenu: document.getElementById('pref-show-menu').checked,
            roundSize: document.getElementById('pref-round-size').value,
            quizLanguage: document.getElementById('pref-quiz-language').value
        };

        try {
            localStorage.setItem('pv_preferences', JSON.stringify(prefs));

            // Apply header/sidebar visibility
            const docEl = document.documentElement;
            docEl.classList.toggle('pref-hide-header', prefs.hideHeader === false);
            docEl.classList.toggle('pref-hide-sidebar', prefs.hideSidebar === false);

            // Apply floating menu visibility
            const floatingGroup = document.getElementById('pv-floating-group');
            if (floatingGroup) {
                if (prefs.showMenu) {
                    floatingGroup.classList.remove('hidden');
                    floatingGroup.classList.add('flex');
                } else {
                    floatingGroup.classList.remove('flex');
                    floatingGroup.classList.add('hidden');
                }
            }

            const uiLang = document.getElementById('pref-ui-language').value;
            const form = document.getElementById('settings-lang-form');
            if (form) {
                document.getElementById('settings-lang-culture').value = uiLang;
                form.submit();
            } else {
                setUiLanguageCookie(uiLang);
                const toast = document.getElementById('toast-success');
                if (toast) toast.classList.remove('hidden');
                setTimeout(() => {
                    if (toast) toast.classList.add('hidden');
                    window.location.href = '@cancelUrl';
                }, 1000);
            }
        } catch (e) {
            alert('@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.photo-vocab.views.settings.unknown_error", "保存设置失败，浏览器可能禁用了 LocalStorage。")))');
        }
    }
</script>

<form id="settings-lang-form" asp-controller="Localization" asp-action="SetLanguage" method="post" class="hidden">
    <input type="hidden" name="culture" id="settings-lang-culture" />
    <input type="hidden" name="returnUrl" value="@cancelUrl" />
</form>
