# Email Server Configuration
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_USER=mailmind.agent@gmail.com
IMAP_PASSWORD=kosw syjw vjeg osyl

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=mailmind.agent@gmail.com
SMTP_PASSWORD=kosw syjw vjeg osyl
SMTP_FROM_NAME=AI Assistant
SMTP_FROM_ADDRESS=mailmind.agent@gmail.com

# AI Configuration
# Set USE_GEMINI_CLI=true to use the local 'gemini' CLI tool instead of API calls
USE_GEMINI_CLI=true
# AI_MODEL: 空白または "auto" を設定すると Gemini CLI がデフォルトモデルを自動選択します
# gemini-2.5-flash は動作確認済み。gemini-2.0-flash / gemini-1.5-flash は無効。
AI_MODEL=gemini-2.5-flash
AI_SYSTEM_PROMPT="You are a helpful AI assistant. Please reply to the following email professionally and concisely. If the email is in Chinese, reply in Chinese."

# API Configuration (Only used if USE_GEMINI_CLI=false)
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_API_KEY=sk-your-openai-api-key

# Optional: Only reply to emails from this specific sender address
TARGET_SENDER_EMAIL=oneriang.2026@gmail.com,taiji@gosei-jp.com,oneriang@gmail.com

# 件名にこれらのキーワードが含まれるメールは invoice_email_processor が処理し、
# ai_chat_poll はスキップします（カンマ区切り）
INVOICE_SUBJECT_KEYWORDS=請求,invoice,Invoice,ご請求
