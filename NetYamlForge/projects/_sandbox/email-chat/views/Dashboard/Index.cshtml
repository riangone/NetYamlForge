@* email-chat プロジェクト専用ダッシュボード *@
@model NetYamlForge.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "AI Email Chat";
    var project = "email-chat";
}

<div class="space-y-8">

    @* ── Hero ── *@
    <div class="rounded-2xl bg-gradient-to-br from-violet-500/10 via-base-200 to-cyan-400/10 border border-base-300 px-8 py-10">
        <p class="text-xs font-semibold tracking-widest text-primary uppercase mb-2">AI-Powered</p>
        <h1 class="text-3xl font-bold text-base-content mb-2">AI Email Chat</h1>
        <p class="text-base-content/60 max-w-xl">
            受信メールを自動解析し、請求書情報を AI で抽出・DB 保存・PDF 生成・返信送信まで全自動で処理します。
        </p>

        <div class="flex flex-wrap gap-3 mt-6">
            <a href="/@project/DynamicEntity/Index?entity=gosei_invoice"
               class="btn btn-primary btn-sm gap-2 no-underline">
                <span>📄</span> 請求書一覧
            </a>
            <a href="/@project/DynamicEntity/Index?entity=gosei_client"
               class="btn btn-outline btn-sm gap-2 no-underline">
                <span>🏢</span> 取引先管理
            </a>
            <a href="/@project/DynamicEntity/Index?entity=gosei_invoice_item"
               class="btn btn-outline btn-sm gap-2 no-underline">
                <span>📝</span> 請求明細
            </a>
        </div>
    </div>

    @* ── Workflow Pipeline ── *@
    <div>
        <h2 class="text-lg font-semibold text-base-content mb-4">⚡ 自動処理フロー</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">

            <div class="card bg-base-100 border border-base-300 shadow-sm text-center">
                <div class="card-body py-5 px-3">
                    <div class="text-3xl mb-2">📬</div>
                    <div class="text-xs font-semibold text-base-content">① 受信</div>
                    <div class="text-xs text-base-content/50 mt-1">IMAP ポーリング</div>
                </div>
            </div>

            <div class="card bg-base-100 border border-base-300 shadow-sm text-center">
                <div class="card-body py-5 px-3">
                    <div class="text-3xl mb-2">🤖</div>
                    <div class="text-xs font-semibold text-base-content">② AI 解析</div>
                    <div class="text-xs text-base-content/50 mt-1">Antigravity CLI</div>
                </div>
            </div>

            <div class="card bg-base-100 border border-base-300 shadow-sm text-center">
                <div class="card-body py-5 px-3">
                    <div class="text-3xl mb-2">📋</div>
                    <div class="text-xs font-semibold text-base-content">③ 抽出</div>
                    <div class="text-xs text-base-content/50 mt-1">JSON → エンティティ</div>
                </div>
            </div>

            <div class="card bg-base-100 border border-base-300 shadow-sm text-center">
                <div class="card-body py-5 px-3">
                    <div class="text-3xl mb-2">💾</div>
                    <div class="text-xs font-semibold text-base-content">④ DB 保存</div>
                    <div class="text-xs text-base-content/50 mt-1">SQLite</div>
                </div>
            </div>

            <div class="card bg-base-100 border border-base-300 shadow-sm text-center">
                <div class="card-body py-5 px-3">
                    <div class="text-3xl mb-2">🧾</div>
                    <div class="text-xs font-semibold text-base-content">⑤ PDF 生成</div>
                    <div class="text-xs text-base-content/50 mt-1">gosei-invoice テンプレ</div>
                </div>
            </div>

            <div class="card bg-primary/5 border border-primary/30 shadow-sm text-center">
                <div class="card-body py-5 px-3">
                    <div class="text-3xl mb-2">✉️</div>
                    <div class="text-xs font-semibold text-primary">⑥ 返信送信</div>
                    <div class="text-xs text-base-content/50 mt-1">SMTP 自動返信</div>
                </div>
            </div>

        </div>
    </div>

    @* ── Batch Jobs Status ── *@
    <div>
        <h2 class="text-lg font-semibold text-base-content mb-4">🔧 バックグラウンドジョブ</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

            <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="card-body py-5 px-6">
                    <div class="flex items-start gap-4">
                        <div class="text-3xl">🧾</div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="font-semibold text-base-content">Invoice Email Processor</span>
                                <span class="badge badge-success badge-sm">有効</span>
                            </div>
                            <p class="text-sm text-base-content/60 mt-1">
                                請求メールを 5 分ごとに受信し、AI 抽出・保存・PDF 生成・返信を自動実行します。
                            </p>
                            <div class="text-xs text-base-content/40 mt-2 font-mono">cron: */5 * * * *</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 border border-base-300 shadow-sm opacity-60">
                <div class="card-body py-5 px-6">
                    <div class="flex items-start gap-4">
                        <div class="text-3xl">💬</div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="font-semibold text-base-content">Poll Inbox and AI Reply</span>
                                <span class="badge badge-ghost badge-sm">無効</span>
                            </div>
                            <p class="text-sm text-base-content/60 mt-1">
                                受信トレイを 1 分ごとにポーリングし、AI が自動返信します。
                            </p>
                            <div class="text-xs text-base-content/40 mt-2 font-mono">cron: * * * * *</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    @* ── Quick Access ── *@
    <div>
        <h2 class="text-lg font-semibold text-base-content mb-4">📂 クイックアクセス</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

            <a href="/@project/DynamicEntity/Index?entity=gosei_invoice"
               class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md hover:border-primary/40 transition-all no-underline">
                <div class="card-body py-5 px-6 flex flex-row items-center gap-4">
                    <div class="text-3xl w-12 text-center">📄</div>
                    <div>
                        <div class="font-semibold text-base-content">請求書</div>
                        <div class="text-sm text-base-content/60">発行・管理・PDF 出力</div>
                    </div>
                </div>
            </a>

            <a href="/@project/DynamicEntity/Index?entity=gosei_client"
               class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md hover:border-primary/40 transition-all no-underline">
                <div class="card-body py-5 px-6 flex flex-row items-center gap-4">
                    <div class="text-3xl w-12 text-center">🏢</div>
                    <div>
                        <div class="font-semibold text-base-content">取引先</div>
                        <div class="text-sm text-base-content/60">顧客情報の登録・編集</div>
                    </div>
                </div>
            </a>

            <a href="/@project/DynamicEntity/Index?entity=gosei_invoice_item"
               class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md hover:border-primary/40 transition-all no-underline">
                <div class="card-body py-5 px-6 flex flex-row items-center gap-4">
                    <div class="text-3xl w-12 text-center">📝</div>
                    <div>
                        <div class="font-semibold text-base-content">請求明細</div>
                        <div class="text-sm text-base-content/60">明細行の確認・修正</div>
                    </div>
                </div>
            </a>

        </div>
    </div>

</div>
