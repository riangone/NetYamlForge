@* ファイル概要: 全画面共通レイアウト（ヘッダー・サイドメニュー・共通スクリプト）です。
   このビューは画面表示と操作導線を担当します。
   データバインディング名や hx-* 属性を変更する場合は、コントローラ側との整合を必ず確認してください。 *@

@using NetYamlForge.Localization
@using NetYamlForge.Models
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject NetYamlForge.Services.IEntityMetadataProvider EntityMetadataProvider
@inject NetYamlForge.Services.ProjectScope ProjectScope
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var afTokens = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-theme="@(ProjectScope?.Current?.Layout?.Theme ?? "corporate")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NetYamlForge</title>
    <meta name="csrf-token-header" content="@afTokens.HeaderName" />
    <meta name="csrf-token" content="@afTokens.RequestToken" />
    <script>
        window.NetYamlForgeConfig = {
            pathBase: '@Url.Content("~/").TrimEnd('/')',
            currentProject: '@Context.GetRouteValue("project")?.ToString()'
        };
    </script>
    <script type="importmap"></script>
    <link href="@Url.Content("~/lib/daisyui/daisyui.min.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.Content("~/lib/tailwindcss/browser.min.js")"></script>
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/NetYamlForge.styles.css")" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
</head>
<body class="min-h-screen bg-base-200" data-user-authenticated="@(User.Identity?.IsAuthenticated ?? false ? "true" : "false")">
@functions {
    private sealed class NavSection
    {
        public string? Title { get; }
        public List<ProjectNavigationItemConfig> Items { get; } = new();
        public NavSection(string? title) => Title = title;
    }
}

@{
    var showSidebar = User.Identity?.IsAuthenticated ?? false;
    var isAdminUser = User?.IsInRole("Admin") ?? false;
        
        // プロジェクト固有のレイアウト設定
        var projectLayout = ProjectScope?.Current?.Layout;
        var navConfig = projectLayout?.Navigation;
        var headerConfig = projectLayout?.Header;
        
        // エンティティ定義の取得（プロジェクト固有のフィルター適用）
        var allEntities = EntityMetadataProvider.GetAll()
            .Where(pair => isAdminUser || pair.Value.IsPublic)
            .OrderBy(pair => pair.Value.GetDisplayName(), StringComparer.OrdinalIgnoreCase)
            .ToList();
        
        // ナビゲーション設定がある場合はフィルタリング
        var entityDefinitions = navConfig != null && navConfig.Entities.Count > 0
            ? allEntities.Where(pair => navConfig.Entities.Contains(pair.Key, StringComparer.OrdinalIgnoreCase))
                .OrderBy(pair => navConfig.Entities.IndexOf(pair.Key))
                .ToList()
            : allEntities;
        
        // プロジェクト名を取得（{project} ルートパラメータから）
        var currentProject = Context.GetRouteValue("project")?.ToString() ?? "";
        var pathBase = Url.Content("~/").TrimEnd('/');
        
        // ヘッダータイトル（プロジェクト固有の設定を使用）
        var headerTitle = headerConfig?.Title ?? "NetYamlForge";
    }
    <div class="drawer">
        <input id="app-sidebar" type="checkbox" class="drawer-toggle" />

        <div class="drawer-content flex flex-col min-h-screen">
            <header class="navbar bg-base-100 border-b border-base-300 px-3 lg:px-6">
                @if (showSidebar)
                {
                    <div class="flex-none">
                        <label for="app-sidebar" class="btn btn-ghost btn-square">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        </label>
                    </div>
                }

                <div class="flex-1">
                    <a class="btn btn-ghost text-xl"
                       asp-controller="Home"
                       asp-action="Project"
                       asp-route-project="@currentProject">@headerTitle</a>
                </div>

                <div class="flex-none gap-2">
                    <div class="dropdown dropdown-end">
                        <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
                            <div class="w-10 rounded-full bg-base-300 text-base-content grid place-items-center font-semibold">
                                @if (User?.Identity?.IsAuthenticated ?? false)
                                {
                                    @((User?.Identity?.Name ?? "U").Substring(0, 1).ToUpperInvariant())
                                }
                                else
                                {
                                    @("G")
                                }
                            </div>
                        </div>
                        <ul tabindex="0" class="menu menu-sm dropdown-content bg-base-100 rounded-box z-[1] mt-3 w-64 p-2 shadow">
                            @if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                <li class="menu-title">
                                    <span>@L["Hello"], @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name)</span>
                                </li>
                            }
                            <li class="menu-title"><span>@L["Language"]</span></li>
                            <li>
                                <div class="flex gap-2 px-2 py-1">
                                    <form asp-controller="Localization" asp-action="SetLanguage" method="post">
                                        <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase)@Context.Request.Path@Context.Request.QueryString" />
                                        <input type="hidden" name="culture" value="en-US" />
                                        <button type="submit" class="btn btn-ghost btn-sm btn-circle @(System.Globalization.CultureInfo.CurrentUICulture.Name == "en-US" ? "btn-active" : "")" title="English">🇺🇸</button>
                                    </form>
                                    <form asp-controller="Localization" asp-action="SetLanguage" method="post">
                                        <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase)@Context.Request.Path@Context.Request.QueryString" />
                                        <input type="hidden" name="culture" value="zh-CN" />
                                        <button type="submit" class="btn btn-ghost btn-sm btn-circle @(System.Globalization.CultureInfo.CurrentUICulture.Name == "zh-CN" ? "btn-active" : "")" title="中文">🇨🇳</button>
                                    </form>
                                    <form asp-controller="Localization" asp-action="SetLanguage" method="post">
                                        <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase)@Context.Request.Path@Context.Request.QueryString" />
                                        <input type="hidden" name="culture" value="ja-JP" />
                                        <button type="submit" class="btn btn-ghost btn-sm btn-circle @(System.Globalization.CultureInfo.CurrentUICulture.Name == "ja-JP" ? "btn-active" : "")" title="日本語">🇯🇵</button>
                                    </form>
                                    <form asp-controller="Localization" asp-action="SetLanguage" method="post">
                                        <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase)@Context.Request.Path@Context.Request.QueryString" />
                                        <input type="hidden" name="culture" value="ko-KR" />
                                        <button type="submit" class="btn btn-ghost btn-sm btn-circle @(System.Globalization.CultureInfo.CurrentUICulture.Name == "ko-KR" ? "btn-active" : "")" title="한국어">🇰🇷</button>
                                    </form>
                                </div>
                            </li>

                            @if (User?.Identity?.IsAuthenticated ?? false)
                            {
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a asp-controller="Users"
                                           asp-action="Index"
                                           asp-route-project="@currentProject">@L["Users"]</a></li>
                                    <li>
                                        <button type="button"
                                                class="text-left w-full text-error font-semibold"
                                                onclick="document.getElementById('restart-confirm-modal').showModal()">
                                            ⟳ システム再起動
                                        </button>
                                    </li>
                                }
                                <li>
                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          asp-route-project="@currentProject"
                                          method="post">
                                        <button type="submit" class="text-left w-full">@L["Logout"]</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li><a asp-controller="Account"
                                       asp-action="Login"
                                       asp-route-project="@currentProject">@L["Login"]</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </header>

            <main class="p-4 lg:p-6">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success shadow-lg mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-error shadow-lg mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }
                @RenderBody()
            </main>
        </div>

        @if (showSidebar)
        {
            <div class="drawer-side z-40">
                <label for="app-sidebar" aria-label="close sidebar" class="drawer-overlay"></label>
                <aside class="bg-base-100 w-72 min-h-full border-r border-base-300">
                    <div class="p-4 border-b border-base-300 flex items-center justify-between">
                        <div>
                            <div class="text-sm opacity-70">Navigation</div>
                            <div class="font-semibold">@(string.IsNullOrEmpty(currentProject) ? "Definitions" : currentProject)</div>
                        </div>
                        <label for="app-sidebar" class="btn btn-ghost btn-sm btn-square" aria-label="close menu">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </label>
                    </div>

                    <ul class="menu p-3 gap-1 w-full">
                        @{
                        var isDashboard = string.Equals(
                            Context.Request.RouteValues["controller"]?.ToString(),
                            "Dashboard",
                            StringComparison.OrdinalIgnoreCase);
                            
                            // ダッシュボードリンクの表示制御
                        var showDashboard = navConfig?.ShowDashboard ?? true;
                        var navSections = new List<NavSection>();
                        if (navConfig?.Items != null && navConfig.Items.Count > 0)
                        {
                            foreach (var item in navConfig.Items)
                            {
                                var showItem = !item.AdminOnly || isAdminUser;
                                if (!showItem) continue;
                                // ロールが指定されている場合、非管理者はいずれかのロールを持つ必要がある
                                if (!isAdminUser && item.Roles.Count > 0 && !item.Roles.Any(r => User?.IsInRole(r) == true)) continue;
                                var sectionName = string.IsNullOrWhiteSpace(item.Section) ? null : item.Section!.Trim();
                                var section = navSections.FirstOrDefault(s => string.Equals(s.Title, sectionName, StringComparison.Ordinal));
                                if (section == null)
                                {
                                    section = new NavSection(sectionName);
                                    navSections.Add(section);
                                }
                                section.Items.Add(item);
                            }
                        }
                        }
                        
                        @if (showDashboard)
                        {
                            <li>
                                <a class="@(isDashboard ? "active" : "")"
                                   asp-controller="Dashboard"
                                   asp-action="Index"
                                   asp-route-project="@currentProject">Dashboard</a>
                            </li>
                        }
                        
                        @* カスタムナビゲーション項目 *@
                        @if (navSections.Count > 0)
                        {
                            foreach (var section in navSections)
                            {
                                if (!string.IsNullOrEmpty(section.Title))
                                {
                                    <li class="menu-title mt-1"><span>@(section.Title)</span></li>
                                }
                                foreach (var item in section.Items)
                                {
                                    var itemLabel = I18nText.Resolve(item.LabelI18n, item.Label, item.LabelKey);
                                    @if (!string.IsNullOrEmpty(item.Url))
                                    {
                                        var url = item.Url.StartsWith('/') ? pathBase + item.Url : item.Url;
                                        <li>
                                            <a href="@url">@itemLabel</a>
                                        </li>
                                    }
                                    else if (!string.IsNullOrEmpty(item.Controller))
                                    {
                                        <li>
                                            <a asp-controller="@item.Controller"
                                               asp-action="@(item.Action ?? "Index")"
                                               asp-route-project="@currentProject">@itemLabel</a>
                                        </li>
                                    }
                                }
                            }
                        }
                        
                        @{
                            var allPages = ProjectScope?.Current?.PageMetadata?.GetAll();
                        }
                        @if ((navConfig?.ShowPages ?? true) && allPages != null && allPages.Count > 0)
                        {
                            <li class="menu-title mt-1"><span>Pages</span></li>
                            @foreach (var page in allPages)
                            {
                                if (!page.Value.ShowInSidebar) continue;
                                if (!isAdminUser && !page.Value.IsPublic) continue;
                                var pageUrl = string.IsNullOrEmpty(pathBase)
                                    ? $"/{currentProject}/Page/{page.Key}"
                                    : $"{pathBase}/{currentProject}/Page/{page.Key}";
                                var isPageActive = string.Equals(
                                    Context.Request.RouteValues["controller"]?.ToString(),
                                    "Page",
                                    StringComparison.OrdinalIgnoreCase) &&
                                    string.Equals(
                                        Context.Request.RouteValues["pageName"]?.ToString(),
                                        page.Key,
                                        StringComparison.OrdinalIgnoreCase);
                                <li>
                                    <a href="@(pageUrl)" class="@(isPageActive ? "active" : "")">@(page.Value.Title)</a>
                                </li>
                            }
                        }

                        @if ((navConfig?.ShowEntities ?? true) && entityDefinitions.Count > 0)
                        {
                            <li class="menu-title mt-1"><span>Entities</span></li>
                            @foreach (var definition in entityDefinitions)
                            {
                                var isActive = string.Equals(
                                    Context.Request.RouteValues["controller"]?.ToString(),
                                    "DynamicEntity",
                                    StringComparison.OrdinalIgnoreCase) &&
                                    string.Equals(
                                        Context.Request.Query["entity"],
                                        definition.Key,
                                        StringComparison.OrdinalIgnoreCase);
                                var isDefinitionPage = isActive &&
                                    string.Equals(
                                        Context.Request.RouteValues["action"]?.ToString(),
                                        "Definition",
                                        StringComparison.OrdinalIgnoreCase);

                                @if (isAdminUser)
                                {
                                    <li>
                                        <details @(isActive ? "open" : "")>
                                            <summary class="@(isActive && !isDefinitionPage ? "active" : "")">
                                                @definition.Value.GetDisplayName()
                                                <span class="badge badge-sm @(definition.Value.IsPublic ? "badge-success" : "badge-ghost") ml-auto">
                                                    @(definition.Value.IsPublic ? "Pub" : "Priv")
                                                </span>
                                            </summary>
                                            <ul>
                                                <li>
                                                    <a class="@(isActive && !isDefinitionPage ? "active" : "")"
                                                       asp-controller="DynamicEntity"
                                                       asp-action="Index"
                                                       asp-route-project="@currentProject"
                                                       asp-route-entity="@definition.Key">List</a>
                                                </li>
                                                <li>
                                                    <a class="@(isDefinitionPage ? "active" : "")"
                                                       asp-controller="DynamicEntity"
                                                       asp-action="Definition"
                                                       asp-route-project="@currentProject"
                                                       asp-route-entity="@definition.Key">Definition</a>
                                                </li>
                                            </ul>
                                        </details>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="@(isActive ? "active" : "")"
                                           asp-controller="DynamicEntity"
                                           asp-action="Index"
                                           asp-route-project="@currentProject"
                                           asp-route-entity="@definition.Key">@definition.Value.GetDisplayName()</a>
                                    </li>
                                }
                            }
                        }
                        @if (isAdminUser)
                        {
                            <li class="menu-title mt-2"><span>Admin</span></li>
                            <li>
                                <a asp-controller="BatchJob"
                                   asp-action="Index"
                                   asp-route-project="@currentProject"
                                   class="@(string.Equals(Context.Request.RouteValues["controller"]?.ToString(), "BatchJob", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    Batch Jobs
                                </a>
                            </li>
                            <li>
                                <a asp-controller="DynamicEntity"
                                   asp-action="AllDefinitions"
                                   asp-route-project="@currentProject"
                                   class="@(string.Equals(Context.Request.RouteValues["action"]?.ToString(), "AllDefinitions", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    Schema
                                </a>
                            </li>
                            <li>
                                <a asp-controller="DynamicEntity"
                                   asp-action="ConfigDiagnostics"
                                   asp-route-project="@currentProject"
                                   class="@(string.Equals(Context.Request.RouteValues["action"]?.ToString(), "ConfigDiagnostics", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    Config
                                </a>
                            </li>
                            <li><a asp-controller="Users"
                                   asp-action="Index"
                                   asp-route-project="@currentProject">@L["Users"]</a></li>
                        }
                    </ul>
                </aside>
            </div>
        }
    </div>

    @* CRUD 確認ダイアログモーダル（全ページ共通） *@
    <dialog id="crud-confirm-modal" class="modal">
        <div class="modal-box max-w-sm">
            <h3 class="font-bold text-lg mb-4" id="crud-confirm-msg">確認</h3>
            <div class="flex gap-3 justify-end">
                <button id="crud-confirm-ok" class="btn btn-primary btn-sm">OK</button>
                <button id="crud-confirm-cancel" class="btn btn-ghost btn-sm">キャンセル</button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    @* システム再起動確認モーダル（管理者専用） *@
    @if (isAdminUser)
    {
        <dialog id="restart-confirm-modal" class="modal">
            <div class="modal-box max-w-sm">
                <h3 class="font-bold text-lg mb-2 text-error">システム再起動</h3>
                <p class="mb-4 text-sm">アプリケーションを再起動します。<br>処理中のリクエストは中断されます。続行しますか？</p>
                <div class="flex gap-3 justify-end">
                    <form id="restart-form"
                          asp-controller="Admin"
                          asp-action="Restart"
                          asp-route-project="@currentProject"
                          method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-error btn-sm">再起動する</button>
                    </form>
                    <button type="button" class="btn btn-ghost btn-sm"
                            onclick="document.getElementById('restart-confirm-modal').close()">キャンセル</button>
                </div>
            </div>
            <form method="dialog" class="modal-backdrop">
                <button>close</button>
            </form>
        </dialog>
    }

    @* エンティティ選択ピッカーモーダル（全ページ共通） *@
    <dialog id="entity-picker-modal" class="modal">
        <div class="modal-box max-w-3xl">
            <div class="flex items-center justify-between mb-3">
                <h3 id="entity-picker-title" class="font-bold text-lg">Select</h3>
                <form method="dialog">
                    <button class="btn btn-ghost btn-sm btn-circle">✕</button>
                </form>
            </div>
            <div class="mb-3">
                <input type="text" id="entity-picker-search"
                       class="input input-bordered w-full"
                       placeholder="Search..."
                       oninput="entityPickerSearch(this.value)" />
            </div>
            <div id="entity-picker-content" class="min-h-32"></div>
            @if (true)
            {
                @* 複数選択モード時の確定ボタン（単一選択では非表示） *@
                <div id="entity-picker-multi-footer" class="mt-3 hidden">
                    <form method="dialog">
                        <button class="btn btn-primary btn-sm">Done</button>
                    </form>
                </div>
            }
        </div>
        <form method="dialog" class="modal-backdrop">
            <button>close</button>
        </form>
    </dialog>

    @* AI アシスタントサイドバー *@
    @if (User?.Identity?.IsAuthenticated ?? false)
    {
        <button onclick="toggleAiSidebar()" class="fixed bottom-6 right-6 btn btn-circle btn-primary shadow-lg z-[100] hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
            <div class="absolute -top-1 -right-1 w-3 h-3 bg-secondary rounded-full border-2 border-base-100 animate-pulse"></div>
        </button>

        <div id="ai-sidebar" class="fixed top-0 right-0 w-80 md:w-96 h-full bg-base-100 shadow-2xl z-[110] transform translate-x-full transition-transform duration-300 ease-in-out border-l border-base-300 flex flex-col">
            <div class="p-4 border-b border-base-300 flex justify-between items-center bg-primary text-primary-content">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-primary-content text-primary grid place-items-center font-bold">H</div>
                    <div>
                        <h3 class="font-bold text-sm leading-tight">Hyperion</h3>
                        <div class="text-[10px] opacity-70">AI Assistant</div>
                    </div>
                </div>
                <button onclick="toggleAiSidebar()" class="btn btn-ghost btn-sm btn-circle">✕</button>
            </div>
            
            <div id="ai-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-2 bg-base-200/30 scroll-smooth">
                <div class="chat chat-start mb-4">
                    <div class="chat-image avatar">
                        <div class="w-10 rounded-full bg-base-300 grid place-items-center font-bold text-primary">H</div>
                    </div>
                    <div class="chat-header opacity-50 text-xs mb-1">Hyperion</div>
                    <div class="chat-bubble chat-bubble-primary text-sm shadow-sm">
                        こんにちは！AI アシスタントの Hyperion です。@if(!string.IsNullOrEmpty(currentProject)){ <span>プロジェクト「@currentProject」</span> } に関するご質問や、システムの操作についてお手伝いします。
                    </div>
                </div>
            </div>

            <div class="p-4 border-t border-base-300 bg-base-100">
                <form hx-post="@(Url.Content("~/" + (string.IsNullOrEmpty(currentProject) ? "default" : currentProject) + "/AiAssistant/Chat"))" 
                      hx-target="#ai-chat-messages" 
                      hx-swap="beforeend" 
                      hx-on::before-request="appendUserMessage(this.message.value)"
                      hx-on::after-request="this.reset(); setTimeout(scrollToAiBottom, 100)"
                      class="relative">
                    <div class="join w-full shadow-sm">
                        <input name="message" class="input input-bordered join-item w-full text-sm focus:outline-none focus:border-primary" placeholder="メッセージを入力..." required />
                        <button type="submit" class="btn btn-primary join-item">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                            </svg>
                        </button>
                    </div>
                </form>
                <div class="mt-2 text-[10px] text-center opacity-40">AI は不正確な回答を生成することがあります。</div>
            </div>
        </div>

        <script>
            function toggleAiSidebar() {
                const sidebar = document.getElementById('ai-sidebar');
                sidebar.classList.toggle('translate-x-full');
                if (!sidebar.classList.contains('translate-x-full')) {
                    setTimeout(scrollToAiBottom, 300);
                }
            }

            function scrollToAiBottom() {
                const chat = document.getElementById('ai-chat-messages');
                chat.scrollTop = chat.scrollHeight;
            }

            function appendUserMessage(msg) {
                if (!msg) return;
                const chat = document.getElementById('ai-chat-messages');
                const div = document.createElement('div');
                div.className = 'chat chat-end mb-4';
                const time = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                div.innerHTML = `
                    <div class="chat-image avatar">
                        <div class="w-10 rounded-full bg-base-300 grid place-items-center font-bold">U</div>
                    </div>
                    <div class="chat-header opacity-50 text-xs mb-1">You <time class="text-xs opacity-50 ml-1">${time}</time></div>
                    <div class="chat-bubble chat-bubble-neutral text-sm shadow-sm">${msg.replace(/\n/g, '<br/>')}</div>
                `;
                chat.appendChild(div);
                scrollToAiBottom();

                // ローディング表示を追加
                const loadingDiv = document.createElement('div');
                loadingDiv.id = 'ai-loading-indicator';
                loadingDiv.className = 'chat chat-start mb-4';
                loadingDiv.innerHTML = `
                    <div class="chat-image avatar">
                        <div class="w-10 rounded-full bg-base-300 grid place-items-center font-bold text-primary">H</div>
                    </div>
                    <div class="chat-bubble chat-bubble-primary opacity-70 flex items-center gap-1 py-3">
                        <span class="loading loading-dots loading-xs"></span>
                    </div>
                `;
                chat.appendChild(loadingDiv);
                scrollToAiBottom();
            }

            document.body.addEventListener('htmx:afterOnLoad', function(evt) {
                if (evt.detail.target.id === 'ai-chat-messages') {
                    const loading = document.getElementById('ai-loading-indicator');
                    if (loading) loading.remove();
                    scrollToAiBottom();
                }
            });
        </script>
    }

    <script src="@Url.Content("~/lib/htmx/htmx.min.js")"></script>

    <script src="@Url.Content("~/js/site.js")" asp-append-version="true"></script>
    <script>
        // ===== CRUD 確認ダイアログ =====
        var _confirmCallback = null;

        /**
         * DaisyUI のカスタム確認ダイアログを表示します。
         * @@param {string} msg    確認メッセージ
         * @@param {function} onOk OK ボタン押下時のコールバック
         */
        function showConfirmDialog(msg, onOk) {
            _confirmCallback = onOk;
            var msgEl = document.getElementById('crud-confirm-msg');
            if (msgEl) msgEl.textContent = msg;
            var dlg = document.getElementById('crud-confirm-modal');
            if (dlg) dlg.showModal();
        }

        document.addEventListener('DOMContentLoaded', function () {
            var okBtn = document.getElementById('crud-confirm-ok');
            var cancelBtn = document.getElementById('crud-confirm-cancel');

            if (okBtn) {
                okBtn.addEventListener('click', function () {
                    document.getElementById('crud-confirm-modal').close();
                    if (_confirmCallback) {
                        var cb = _confirmCallback;
                        _confirmCallback = null;
                        cb();
                    }
                });
            }

            if (cancelBtn) {
                cancelBtn.addEventListener('click', function () {
                    document.getElementById('crud-confirm-modal').close();
                    _confirmCallback = null;
                });
            }
        });

        /**
         * HTMX の hx-confirm 属性をカスタム DaisyUI ダイアログで処理します。
         * Delete ボタンや hx-confirm 付きフォームで使用されます。
         * evt.detail.issueRequest(true) を呼ぶことで確認後にリクエストを発行します。
         */
        document.body.addEventListener('htmx:confirm', function (evt) {
            var msg = evt.detail.question;
            if (!msg) {
                // hx-confirm="" の場合は確認なしでリクエストを発行
                evt.preventDefault();
                evt.detail.issueRequest(true);
                return;
            }
            evt.preventDefault();
            showConfirmDialog(msg, function () {
                evt.detail.issueRequest(true);
            });
        });

        /**
         * ページモード（通常 POST フォーム）の submit イベントを監視し、
         * data-confirm-msg 属性がある場合に確認ダイアログを挟みます。
         * HTMX フォームは hx-confirm + htmx:confirm で処理されるため、
         * data-confirm-msg を持つ非 HTMX フォームのみが対象です。
         */
        document.addEventListener('submit', function (evt) {
            var form = evt.target;
            var msg = form && form.dataset ? form.dataset.confirmMsg : '';
            if (!msg || msg.length === 0) return;  // 確認不要

            if (form.dataset.skipConfirm === '1') {
                delete form.dataset.skipConfirm;
                return;
            }

            evt.preventDefault();
            showConfirmDialog(msg, function () {
                form.dataset.skipConfirm = '1';
                if (typeof form.requestSubmit === 'function') {
                    form.requestSubmit();
                } else {
                    form.submit();
                }
            });
        }, true /* capture */);
    </script>
    <script>
        // エンティティ選択ピッカー共通ロジック
        var _pickerConfig = null;
        var _pickerSearchTimer = null;
        // ピッカーの API ベース URL（プロジェクトルートを含む）
        var _pickerBaseUrl = '@Url.Content("~/" + currentProject + "/DynamicEntity/PickerList")';

        // ピッカーを開く（Browse ボタンの onclick から呼ばれる）
        function openEntityPicker(btn) {
            var fieldName = btn.dataset.pickerField;
            var entity    = btn.dataset.pickerEntity;
            var displayCol= btn.dataset.pickerDisplayCol || 'Id';
            var query     = btn.dataset.pickerQuery || '';
            var multi     = btn.dataset.pickerMulti === 'true';

            _pickerConfig = {
                fieldName: fieldName,
                entity: entity,
                displayCol: displayCol,
                query: query,
                multi: multi,
                sourceButton: btn
            };

            var title = document.getElementById('entity-picker-title');
            if (title) title.textContent = 'Select ' + entity;

            var footer = document.getElementById('entity-picker-multi-footer');
            if (footer) footer.classList.toggle('hidden', !multi);

            var searchEl = document.getElementById('entity-picker-search');
            if (searchEl) searchEl.value = '';

            loadPickerContent('', 1);
            document.getElementById('entity-picker-modal').showModal();
        }

        // ピッカーコンテンツを HTMX で読み込む
        function loadPickerContent(search, page) {
            if (!_pickerConfig) return;
            page = page || 1;
            var cfg = _pickerConfig;
            var url = _pickerBaseUrl
                + '?entity=' + encodeURIComponent(cfg.entity)
                + '&targetField=' + encodeURIComponent(cfg.fieldName)
                + '&displayColumn=' + encodeURIComponent(cfg.displayCol)
                + '&displayColumns=' + encodeURIComponent(cfg.displayCol)
                + '&query=' + encodeURIComponent(cfg.query || '')
                + '&multi=' + (cfg.multi ? 'true' : 'false')
                + '&search=' + encodeURIComponent(search || '')
                + '&page=' + page;
            htmx.ajax('GET', url, { target: '#entity-picker-content', swap: 'innerHTML' });
        }

        // 検索入力のデバウンス
        function entityPickerSearch(value) {
            clearTimeout(_pickerSearchTimer);
            _pickerSearchTimer = setTimeout(function () {
                loadPickerContent(value, 1);
            }, 300);
        }

        // ピッカーページング
        function loadPickerPage(page) {
            var searchEl = document.getElementById('entity-picker-search');
            var search = searchEl ? searchEl.value : '';
            loadPickerContent(search, page);
        }

        // テーブル行クリック時の選択処理
        function pickerSelectFromRow(row) {
            if (!_pickerConfig) return;
            var id    = row.dataset.pickerId;
            var label = row.dataset.pickerLabel;
            var cfg   = _pickerConfig;
            var container = resolvePickerContainer(cfg.sourceButton);

            if (cfg.multi) {
                // 複数選択: チップを追加（重複は無視）
                var hidden = findPickerElement(container, 'picker-value-' + cfg.fieldName);
                if (!hidden) return;
                var vals = hidden.value ? hidden.value.split(',').filter(function(v) { return v !== ''; }) : [];
                if (vals.indexOf(id) !== -1) return; // 既選択済み
                vals.push(id);
                hidden.value = vals.join(',');

                var chips = findPickerElement(container, 'picker-chips-' + cfg.fieldName);
                if (chips) {
                    var chip = document.createElement('div');
                    chip.className = 'badge badge-neutral gap-1';
                    chip.dataset.id = id;
                    chip.innerHTML = label
                        + ' <button type="button" onclick="removePickerChip(\''
                        + cfg.fieldName + '\',\'' + id.replace(/'/g, "\\'") + '\',this.parentElement)">✕</button>';
                    chips.appendChild(chip);
                }
                // 複数選択モードではモーダルを閉じない
            } else {
                // 単一選択: 値とラベルをセットしてモーダルを閉じる
                var hidden2 = findPickerElement(container, 'picker-value-' + cfg.fieldName);
                var display = findPickerElement(container, 'picker-display-' + cfg.fieldName);
                if (hidden2) hidden2.value = id;
                if (display) {
                    if (display.tagName === 'INPUT') {
                        display.value = label;
                    } else {
                        display.textContent = label;
                    }
                }
                document.getElementById('entity-picker-modal').close();
            }
        }

        function resolvePickerContainer(sourceEl) {
            if (!sourceEl || typeof sourceEl.closest !== 'function') return null;
            return sourceEl.closest('[data-picker-container]');
        }

        function findPickerElement(container, id) {
            var selector = '[id="' + id + '"]';
            if (container) {
                var scoped = container.querySelector(selector);
                if (scoped) return scoped;
            }
            return document.querySelector(selector);
        }

        // ピッカーチップを削除する
        function removePickerChip(fieldName, id, chipEl) {
            var container = resolvePickerContainer(chipEl);
            var hidden = findPickerElement(container, 'picker-value-' + fieldName);
            if (hidden) {
                var vals = hidden.value.split(',').filter(function(v) { return v !== id && v !== ''; });
                hidden.value = vals.join(',');
            }
            if (chipEl) chipEl.remove();
        }

        // 単一ピッカー値をクリア（フォーム用）
        function clearPickerValue(fieldName, sourceEl) {
            var container = resolvePickerContainer(sourceEl);
            var hidden = findPickerElement(container, 'picker-value-' + fieldName);
            var display = findPickerElement(container, 'picker-display-' + fieldName);
            if (hidden) hidden.value = '';
            if (display) {
                if (display.tagName === 'INPUT') {
                    display.value = '';
                } else {
                    display.textContent = '(All)';
                }
            }
        }

        // フィルター用ピッカー値クリア
        function clearPickerFilterValue(fieldName, sourceEl) {
            var container = resolvePickerContainer(sourceEl);
            var hidden = findPickerElement(container, 'picker-value-' + fieldName);
            var display = findPickerElement(container, 'picker-display-' + fieldName);
            var chips = findPickerElement(container, 'picker-chips-' + fieldName);
            if (hidden) hidden.value = '';
            if (display) {
                if (display.tagName === 'INPUT') {
                    display.value = '';
                } else {
                    display.textContent = '(All)';
                }
            }
            if (chips) chips.innerHTML = '';
        }

        // checkbox-group: 複数選択フォームの値を更新
        function toggleCheckboxGroup(fieldName, checkbox) {
            var hidden = document.getElementById('checkbox-group-value-' + fieldName);
            if (!hidden) return;
            var checkboxes = document.querySelectorAll('input[type=checkbox][name=' + fieldName + ']');
            var values = [];
            checkboxes.forEach(function(cb) {
                if (cb.checked) values.push(cb.value);
            });
            hidden.value = values.join(',');
        }

        // switch-group: 複数選択フォームの値を更新
        function toggleSwitchGroup(fieldName, toggle) {
            var hidden = document.getElementById('switch-group-value-' + fieldName);
            if (!hidden) return;
            var toggles = document.querySelectorAll('input[type=checkbox][name=' + fieldName + ']');
            var values = [];
            toggles.forEach(function(t) {
                if (t.checked) values.push(t.value);
            });
            hidden.value = values.join(',');
        }
    </script>
    <script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>
    <script>
        // EasyMDE 初期化
        function initEasyMDE(elementId) {
            const el = document.getElementById(elementId);
            if (!el) return;
            const editor = new EasyMDE({
                element: el,
                spellChecker: false,
                autosave: {
                    enabled: true,
                    uniqueId: elementId,
                    delay: 1000,
                },
                placeholder: "Markdown で入力してください...",
                status: ["lines", "words", "cursor"],
                renderingConfig: {
                    singleLineBreaks: false,
                    codeSyntaxHighlighting: true,
                },
            });
            // フォーム送信前に textarea に同期
            editor.codemirror.on("change", () => {
                el.value = editor.value();
            });
            return editor;
        }
    </script>

    <!-- 全局 Toast 容器 -->
    <div class="toast toast-end toast-bottom z-[9999]" id="global-toast-container"></div>

    <script>
        // 全局 Toast 提示函数
        function showToast(message, type, duration) {
            type = type || 'success';
            duration = duration || 4000;
            var container = document.getElementById('global-toast-container');
            if (!container) return;

            var alertDiv = document.createElement('div');
            var alertClass = 'alert shadow-lg flex items-center gap-2';
            var iconSvg = '';

            if (type === 'success') {
                alertClass += ' alert-success text-success-content';
                iconSvg = '<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
            } else if (type === 'error') {
                alertClass += ' alert-error text-error-content';
                iconSvg = '<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
            } else if (type === 'warning') {
                alertClass += ' alert-warning text-warning-content';
                iconSvg = '<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>';
            } else {
                alertClass += ' alert-info text-info-content';
                iconSvg = '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>';
            }

            alertDiv.className = alertClass;
            alertDiv.innerHTML = iconSvg + '<span>' + message + '</span>';
            container.appendChild(alertDiv);

            setTimeout(function() {
                alertDiv.style.opacity = '0';
                alertDiv.style.transition = 'opacity 0.5s ease';
                setTimeout(function() {
                    alertDiv.remove();
                }, 500);
            }, duration);
        }

        // 全局监听 HTMX 响应与发送错误
        document.body.addEventListener('htmx:responseError', function (evt) {
            var errorMsg = evt.detail.xhr.responseText || '操作执行失败，请检查输入或重试。';
            // 如果返回内容包含 HTML，则提取纯文本或显示通用错误
            if (errorMsg.indexOf('<html') >= 0 || errorMsg.indexOf('<!DOCTYPE') >= 0) {
                errorMsg = '服务器处理请求时发生内部错误。';
            }
            showToast(errorMsg, 'error');
        });

        document.body.addEventListener('htmx:sendError', function (evt) {
            showToast('网络连接失败，请检查您的网络。', 'error');
        });

        // HX-Trigger: {"show-toast":{"message":"...","type":"success"}} 的全局处理
        document.body.addEventListener('show-toast', function (evt) {
            var msg  = evt.detail && evt.detail.message ? evt.detail.message : '';
            var type = evt.detail && evt.detail.type    ? evt.detail.type    : 'info';
            if (msg) showToast(msg, type);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
