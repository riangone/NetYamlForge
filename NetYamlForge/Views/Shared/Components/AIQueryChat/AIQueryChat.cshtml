@* AI 自然语言查询聊天组件 *@
@* 使用方式：@await Component.InvokeAsync("AIQueryChat", new { project = "project-name" }) *@

@{
    var projectName = ViewData["Project"]?.ToString() ?? Context.GetRouteValue("project")?.ToString() ?? "";
}

<div id="ai-query-chat-container" class="ai-query-chat-container" data-project="@projectName">
    @* 聊天消息列表 *@
    <div id="ai-query-messages" class="ai-query-messages">
        <div class="ai-query-welcome-message">
            <h4>🤖 AI 自然语言查询助手</h4>
            <p>请输入您想查询的内容，例如：</p>
            <ul class="ai-query-suggestions">
                <li>"显示上个月销售额前 10 的产品"</li>
                <li>"找出库存低于 5 的商品"</li>
                <li>"展示本季度的订单"</li>
            </ul>
        </div>
    </div>

    @* 思考状态指示器 *@
    <div id="ai-query-thinking" class="ai-query-thinking hidden">
        <div class="ai-query-thinking-spinner"></div>
        <span>AI 正在思考...</span>
    </div>

    @* 输入区域 *@
    <div class="ai-query-input-area">
        <textarea 
            id="ai-query-input" 
            class="form-control" 
            placeholder="输入查询内容... (Shift+Enter 换行)"
            rows="2"></textarea>
        <button id="ai-query-send-btn" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
            </svg>
            发送
        </button>
    </div>

    @* 解析结果预览 *@
    <div id="ai-query-preview" class="ai-query-preview hidden">
        <div class="ai-query-preview-header">
            <span>解析结果</span>
            <button id="ai-query-preview-close" class="btn btn-sm btn-ghost">×</button>
        </div>
        <pre id="ai-query-preview-content"></pre>
    </div>
</div>
