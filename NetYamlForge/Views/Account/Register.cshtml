@* ファイル概要：一般ユーザー登録フォーム画面です。
   このビューは画面表示と操作導線を担当します。 *@

@using NetYamlForge.Localization
@using Microsoft.Extensions.Localization
@model NetYamlForge.Models.Auth.RegisterViewModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Register"];
}

<div class="max-w-md mx-auto card bg-base-100 shadow">
    <div class="card-body">
        <h1 class="card-title">@L["Register"]</h1>
        <form method="post" class="space-y-3">
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div>
                <label class="label"><span class="label-text">@L["UserName"]</span></label>
                <input asp-for="UserName" class="input input-bordered w-full" placeholder="3-50 文字" />
                <span asp-validation-for="UserName" class="text-error text-sm"></span>
            </div>
            
            <div>
                <label class="label"><span class="label-text">@L["Password"]</span></label>
                <input asp-for="Password" class="input input-bordered w-full" placeholder="6 文字以上" />
                <span asp-validation-for="Password" class="text-error text-sm"></span>
            </div>
            
            <div>
                <label class="label"><span class="label-text">@L["ConfirmPassword"]</span></label>
                <input asp-for="ConfirmPassword" class="input input-bordered w-full" />
                <span asp-validation-for="ConfirmPassword" class="text-error text-sm"></span>
            </div>
            
            <div>
                <label class="label"><span class="label-text">@L["DisplayName"]</span></label>
                <input asp-for="DisplayName" class="input input-bordered w-full" />
                <span asp-validation-for="DisplayName" class="text-error text-sm"></span>
            </div>
            
            <div>
                <label class="label"><span class="label-text">@L["Email"]</span></label>
                <input asp-for="Email" class="input input-bordered w-full" />
                <span asp-validation-for="Email" class="text-error text-sm"></span>
            </div>
            
            <div>
                <label class="label"><span class="label-text">@L["Phone"]</span></label>
                <input asp-for="Phone" class="input input-bordered w-full" />
                <span asp-validation-for="Phone" class="text-error text-sm"></span>
            </div>
            
            <div asp-validation-summary="ModelOnly" class="text-error text-sm"></div>
            
            <button type="submit" class="btn btn-primary btn-sm w-full">@L["Register"]</button>
        </form>
        
        <div class="divider"></div>

        <div class="text-center text-sm">
            <span>既にアカウントをお持ちですか？</span>
            <a asp-action="Login" asp-route-project="@Context.GetRouteValue("project")" class="link link-primary">ログイン</a>
        </div>
    </div>
</div>
