@model NetYamlForge.Models.AI.AISettingsViewModel
@{
    ViewData["Title"] = "AI プロバイダー設定";
}

<div class="p-4 md:p-6 max-w-5xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2h-2"/>
        </svg>
        <h1 class="text-2xl font-bold">AI プロバイダー設定</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error mb-4">
            <span>@TempData["Error"]</span>
        </div>
    }

    @* 現在のデフォルト表示 *@
    <div class="card bg-base-100 shadow mb-6">
        <div class="card-body py-4">
            <div class="flex items-center gap-3">
                <span class="text-sm text-base-content/60">現在のデフォルト AI：</span>
                <span class="badge badge-primary badge-lg font-mono">@Model.DefaultTool</span>
                <span class="text-xs text-base-content/40">（ai-user-settings.json で上書き可）</span>
            </div>
        </div>
    </div>

    @* プロバイダーカード一覧 *@
    <h2 class="text-lg font-semibold mb-3">プロバイダー一覧</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
        @foreach (var kv in Model.Tools.OrderBy(t => t.Key))
        {
            var tool = kv.Value;
            var isDefault = string.Equals(kv.Key, Model.DefaultTool, StringComparison.OrdinalIgnoreCase);
            var statusColor = tool.Installed && tool.Authenticated ? "success"
                            : tool.Installed ? "warning"
                            : "error";
            var statusText  = tool.Installed && tool.Authenticated ? "使用可"
                            : tool.Installed ? "未認証"
                            : "未インストール";

            <div class="card bg-base-100 shadow @(isDefault ? "ring-2 ring-primary" : "")">
                <div class="card-body p-4">
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            <h3 class="font-bold text-base">@(tool.DisplayName ?? kv.Key)</h3>
                            <span class="text-xs font-mono text-base-content/50">@kv.Key</span>
                        </div>
                        @if (isDefault)
                        {
                            <span class="badge badge-primary badge-sm shrink-0">デフォルト</span>
                        }
                    </div>

                    <div class="flex items-center gap-2 mt-2">
                        <span class="badge badge-@statusColor badge-sm">@statusText</span>
                        @if (!string.IsNullOrEmpty(tool.Version))
                        {
                            <span class="text-xs text-base-content/40">v@tool.Version</span>
                        }
                    </div>

                    @if (tool.Capabilities.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1 mt-2">
                            @foreach (var cap in tool.Capabilities.Take(3))
                            {
                                <span class="badge badge-ghost badge-xs">@cap</span>
                            }
                        </div>
                    }

                    <div class="card-actions mt-3">
                        @if (!isDefault)
                        {
                            <form method="post" asp-action="SetDefaultTool" asp-controller="AISettings">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="toolName" value="@kv.Key" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline btn-primary"
                                        @(tool.Installed ? "" : "disabled")
                                        title="@(!tool.Installed ? "インストールされていません" : "")">
                                    デフォルトに設定
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="btn btn-sm btn-primary btn-disabled cursor-default">現在のデフォルト</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @* AI 窓口チャット プロバイダー設定 *@
    <h2 class="text-lg font-semibold mb-3">AI 窓口チャット設定</h2>
    <div class="card bg-base-100 shadow mb-8">
        <div class="card-body">
            <p class="text-sm text-base-content/60 mb-4">
                顧客向けチャット窓口で使用する AI プロバイダーを設定します。
                選択したプロバイダーが最優先で使用されます（インストール・認証済みの場合）。
            </p>
            <div class="flex items-center gap-2 mb-4">
                <span class="text-sm text-base-content/60">現在の優先順序：</span>
                @foreach (var (p, i) in Model.WindowProviderPriority.Select((p, i) => (p, i)))
                {
                    <span class="badge @(i == 0 ? "badge-primary" : "badge-ghost") badge-sm font-mono">
                        @(i + 1). @p
                    </span>
                }
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                @foreach (var kv in Model.Tools.OrderBy(t => t.Key))
                {
                    var tool = kv.Value;
                    var isPrimary = Model.WindowProviderPriority.Count > 0 &&
                                    string.Equals(Model.WindowProviderPriority[0], kv.Key, StringComparison.OrdinalIgnoreCase);
                    <form method="post" asp-action="SetWindowProvider" asp-controller="AISettings">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="primaryProvider" value="@kv.Key" />
                        <button type="submit"
                                class="btn btn-sm w-full @(isPrimary ? "btn-primary" : "btn-outline") @(!tool.Installed ? "btn-disabled" : "")"
                                @(!tool.Installed ? "disabled" : "")
                                title="@(!tool.Installed ? "未インストール" : isPrimary ? "現在のプライマリ" : "プライマリに設定")">
                            @if (isPrimary)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                </svg>
                            }
                            @(tool.DisplayName ?? kv.Key)
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    @* 設定ガイド *@
    <div class="collapse collapse-arrow bg-base-100 shadow">
        <input type="checkbox" />
        <div class="collapse-title font-semibold">各プロバイダーの設定方法</div>
        <div class="collapse-content">
            <div class="overflow-x-auto">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>プロバイダー</th>
                            <th>認証方法</th>
                            <th>環境変数 / 設定キー</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="font-mono">claude</td>
                            <td>CLI ログイン または API キー</td>
                            <td class="font-mono text-xs">ANTHROPIC_API_KEY<br>AICli:Claude:ApiKey</td>
                        </tr>
                        <tr>
                            <td class="font-mono">qwen</td>
                            <td>API キー</td>
                            <td class="font-mono text-xs">DASHSCOPE_API_KEY<br>AICli:QwenCode:ApiKey</td>
                        </tr>
                        <tr>
                            <td class="font-mono">codex</td>
                            <td>OpenAI API キー</td>
                            <td class="font-mono text-xs">OPENAI_API_KEY<br>AICli:Codex:ApiKey</td>
                        </tr>
                        <tr>
                            <td class="font-mono">gemini</td>
                            <td>Google API キー</td>
                            <td class="font-mono text-xs">GOOGLE_API_KEY<br>AICli:Gemini:ApiKey</td>
                        </tr>
                        <tr>
                            <td class="font-mono">ollama</td>
                            <td>不要（ローカル）</td>
                            <td class="font-mono text-xs">AICli:Ollama:BaseUrl<br>（デフォルト: localhost:11434）</td>
                        </tr>
                        <tr>
                            <td class="font-mono">lmstudio</td>
                            <td>不要（ローカル）</td>
                            <td class="font-mono text-xs">AICli:LmStudio:BaseUrl<br>（デフォルト: localhost:1234）</td>
                        </tr>
                        <tr>
                            <td class="font-mono">copilot</td>
                            <td>GitHub Copilot トークン</td>
                            <td class="font-mono text-xs">GITHUB_COPILOT_TOKEN<br>AICli:Copilot:Token</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="text-xs text-base-content/50 mt-3">
                設定は <code>appsettings.json</code> または <code>ai-user-settings.json</code>（自動生成）で管理されます。
                API キーを変更した場合はアプリケーションの再起動が必要です。
            </p>
        </div>
    </div>
</div>
