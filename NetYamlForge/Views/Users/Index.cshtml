@* ファイル概要: ユーザー一覧管理画面です。
   このビューは画面表示と操作導線を担当します。
   データバインディング名や hx-* 属性を変更する場合は、コントローラ側との整合を必ず確認してください。 *@

@model IReadOnlyList<NetYamlForge.Models.Auth.AppUser>
@{
    ViewData["Title"] = "Users";
}

<div class="space-y-4">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success shadow-lg">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@TempData["Message"]</span>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error shadow-lg">
            <div>
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@TempData["Error"]</span>
            </div>
        </div>
    }

    <div class="flex justify-between items-center">
        <h1 class="text-2xl font-bold">Users</h1>
        <div class="flex gap-2">
            <form asp-action="SyncJpcsUsers" method="post">
                <button type="submit" class="btn btn-secondary btn-sm">Sync JPCS Users</button>
            </form>
            <a class="btn btn-primary btn-sm" asp-action="Create">New User</a>
        </div>
    </div>

    <div class="card bg-base-100 shadow">
        <div class="card-body">
            <div class="overflow-x-auto">
                <table class="table table-zebra w-full">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>UserName</th>
                            <th>DisplayName</th>
                            <th>Language</th>
                            <th>Project</th>
                            <th>Admin</th>
                            <th>Active</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td>@u.Id</td>
                                <td>@u.UserName</td>
                                <td>@u.DisplayName</td>
                                <td>@u.PreferredLanguage</td>
                                <td>@(u.OwningProject ?? "global")</td>
                                <td>@u.IsAdmin</td>
                                <td>@u.IsActive</td>
                                <td><a class="btn btn-xs btn-outline" asp-action="Edit" asp-route-id="@u.Id">Edit</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
