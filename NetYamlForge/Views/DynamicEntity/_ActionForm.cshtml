@* カスタムアクション入力フォームのモーダルパーシャル。
   inputs が空のアクションでもこのパーシャルを描画し、確認のみ行います。 *@

@model NetYamlForge.Controllers.ActionFormViewModel
@using NetYamlForge.Models
@{
    var hasInputs = Model.ActionDef.Inputs != null && Model.ActionDef.Inputs.Count > 0;
    var hasFileInput = Model.ActionDef.Inputs?.Any(i => i.Type == "file") ?? false;
    var invokeAction = Model.RecordId == null ? "InvokeHeaderAction" : "InvokeAction";
    var invokeUrl = Url.Action(invokeAction, "DynamicEntity", new
    {
        entity = Model.Entity,
        actionKey = Model.Action,
        id = Model.RecordId
    });
}

<div class="p-4 space-y-4">
    <h3 class="text-lg font-bold">@Model.ActionDef.Label</h3>

    @if (!string.IsNullOrWhiteSpace(Model.ActionDef.Confirm))
    {
        <p class="text-sm text-base-content/70">@Model.ActionDef.Confirm</p>
    }

    @* ファイル入力に対応するため常に multipart/form-data でエンコードする *@
    <form hx-post="@invokeUrl"
          hx-target="#list-container"
          hx-swap="innerHTML"
          hx-encoding="multipart/form-data"
          hx-disabled-elt="#action-submit-btn, #action-cancel-btn"
          hx-on::before-request="document.getElementById('action-submit-spinner').classList.remove('hidden');"
          hx-on::after-request="if(event.detail.successful){ document.getElementById('entity-form-modal').close(); showToast('操作已成功提交！AI 正在后台分析中。', 'success'); } else { document.getElementById('action-submit-spinner').classList.add('hidden'); var err = (event.detail.xhr && event.detail.xhr.responseText) ? event.detail.xhr.responseText : '请求处理失败。'; showToast(err, 'error'); }">
        @Html.AntiForgeryToken()

        @if (hasInputs)
        {
            <div class="space-y-3">
                @foreach (var input in Model.ActionDef.Inputs!)
                {
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text">@(input.Label ?? input.Name)@(input.Required ? " *" : "")</span>
                        </label>
                        @if (input.Type == "file")
                        {
                            @* ファイルアップロード入力 *@
                            var accept = string.IsNullOrWhiteSpace(input.AllowedExtensions) ? "" : input.AllowedExtensions;
                            var maxMb = input.MaxSizeBytes.HasValue
                                ? $"最大 {input.MaxSizeBytes.Value / 1024 / 1024} MB"
                                : "最大 10 MB";
                            <input type="file"
                                   name="@input.Name"
                                   class="file-input file-input-bordered file-input-sm w-full"
                                   accept="@accept"
                                   @(input.Required ? "required" : "")
                                   @(input.Multiple ? "multiple" : "") />
                            <span class="label-text-alt text-base-content/50 mt-1">
                                @if (!string.IsNullOrWhiteSpace(accept)) { <text>@accept &nbsp;|&nbsp;</text> }
                                @maxMb
                            </span>
                        }
                        else if (input.Options != null && input.Options.Count > 0)
                        {
                            <select name="@input.Name" class="select select-bordered select-sm" @(input.Required ? "required" : "")>
                                <option value="">-- 選択 --</option>
                                @foreach (var opt in input.Options)
                                {
                                    <option value="@opt">@opt</option>
                                }
                            </select>
                        }
                        else if (input.Type == "textarea")
                        {
                            <textarea name="@input.Name" class="textarea textarea-bordered textarea-sm" rows="3" @(input.Required ? "required" : "")></textarea>
                        }
                        else
                        {
                            <input type="@(input.Type == "date" ? "date" : input.Type == "number" ? "number" : "text")"
                                   name="@input.Name"
                                   class="input input-bordered input-sm"
                                   @(input.Required ? "required" : "") />
                        }
                    </div>
                }
            </div>
        }

        <div class="flex justify-end gap-2 pt-2">
            <button type="button" class="btn btn-sm btn-ghost" id="action-cancel-btn"
                    onclick="document.getElementById('entity-form-modal').close()">
                キャンセル
            </button>
            <button type="submit" class="btn btn-sm btn-primary flex items-center gap-1" id="action-submit-btn">
                <span class="loading loading-spinner loading-xs hidden" id="action-submit-spinner"></span>
                <span id="action-submit-text">実行</span>
            </button>
        </div>
    </form>
</div>
