@model UserHomeViewModel
@{
    ViewData["Title"] = "我的主页";
    var user = Model.User;
    var projects = Model.Projects;
    var stats = Model.Stats;
    var userTypeLabel = stats.UserType switch
    {
        "employee" => "内部员工",
        "customer" => "客户",
        "third_party" => "第三方",
        _ => "未知"
    };
}

<div class="space-y-8 max-w-7xl mx-auto">
    @* ===== 用户欢迎卡片 ===== *@
    <section class="relative overflow-hidden rounded-2xl border border-base-300 bg-base-100">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-secondary/5 opacity-60"></div>
        <div class="relative p-6 md:p-8">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                <div class="flex items-center gap-4">
                    @* 头像 *@
                    <div class="avatar">
                        <div class="w-16 h-16 rounded-full bg-primary text-primary-content flex items-center justify-center text-2xl font-bold">
                            @(string.IsNullOrEmpty(user.DisplayName) ? "U" : user.DisplayName.First().ToString().ToUpper())
                        </div>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold">@user.DisplayName</h1>
                        <p class="text-sm text-base-content/60">@user.UserName · @userTypeLabel</p>
                        @if (stats.IsAdmin)
                        {
                            <span class="badge badge-primary badge-sm mt-1">管理员</span>
                        }
                    </div>
                </div>
                <div class="flex flex-col items-end gap-2">
                    <div class="text-sm text-base-content/60">可访问项目数</div>
                    <div class="text-3xl font-bold text-primary">@stats.TotalProjects</div>
                </div>
            </div>
        </div>
    </section>

    @* ===== 统计概览 ===== *@
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body p-4">
                <div class="text-sm font-medium text-base-content/60">项目总数</div>
                <div class="text-2xl font-bold text-primary">@stats.TotalProjects</div>
            </div>
        </div>
        <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body p-4">
                <div class="text-sm font-medium text-base-content/60">用户类型</div>
                <div class="text-lg font-semibold">@userTypeLabel</div>
            </div>
        </div>
        <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body p-4">
                <div class="text-sm font-medium text-base-content/60">默认项目</div>
                <div class="text-lg font-semibold truncate" title="@Model.DefaultProject">@(Model.DefaultProject ?? "未设置")</div>
            </div>
        </div>
        <div class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body p-4">
                <div class="text-sm font-medium text-base-content/60">角色</div>
                <div class="text-lg font-semibold">@(stats.IsAdmin ? "管理员" : "普通用户")</div>
            </div>
        </div>
    </section>

    @* ===== 可访问项目列表 ===== *@
    <section>
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold">我的项目</h2>
            <a asp-controller="TenantAccount" asp-action="SelectProject" class="btn btn-ghost btn-sm">查看全部</a>
        </div>

        @if (projects.Count == 0)
        {
            <div class="alert alert-warning">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span>您目前没有可访问的项目，请联系管理员分配权限。</span>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var project in projects)
                {
                    var isDefault = project.Name == Model.DefaultProject;
                    <div class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow @(isDefault ? "border-primary" : "")">
                        <div class="card-body p-5">
                            <div class="flex items-start justify-between">
                                <div>
                                    <h3 class="card-title text-lg">
                                        @project.DisplayName
                                        @if (isDefault)
                                        {
                                            <span class="badge badge-primary badge-sm">默认</span>
                                        }
                                    </h3>
                                    <p class="text-sm text-base-content/60">@project.Name</p>
                                </div>
                                @if (!string.IsNullOrEmpty(project.DefaultRole))
                                {
                                    <span class="badge badge-ghost badge-sm">@project.DefaultRole</span>
                                }
                            </div>
                            <div class="card-actions justify-end mt-3 gap-2">
                                <form asp-controller="UserHome" asp-action="SwitchProject" method="post" class="inline">
                                    <input type="hidden" name="projectName" value="@project.Name" />
                                    <button type="submit" class="btn btn-primary btn-sm">进入项目</button>
                                </form>
                                @if (!isDefault)
                                {
                                    <form asp-controller="UserHome" asp-action="SetDefaultProject" method="post" class="inline">
                                        <input type="hidden" name="projectName" value="@project.Name" />
                                        <button type="submit" class="btn btn-ghost btn-sm" title="设为默认项目">设为默认</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @* ===== 快速操作 ===== *@
    @if (Model.QuickActions.Count > 0)
    {
        <section>
            <h2 class="text-xl font-bold mb-4">快速操作</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                @foreach (var action in Model.QuickActions)
                {
                    <a href="@action.Url" class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow">
                        <div class="card-body p-4 text-center">
                            <div class="mx-auto mb-2 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    @switch (action.Icon)
                                    {
                                        case "task":
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                                            break;
                                        case "file":
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                            break;
                                        case "bell":
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                                            break;
                                        case "settings":
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            break;
                                        default:
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            break;
                                    }
                                </svg>
                            </div>
                            <div class="font-medium">@action.Label</div>
                            <p class="text-xs text-base-content/60 mt-1">@action.Description</p>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    @* ===== 最近访问 (占位) ===== *@
    @if (Model.RecentProjects.Count > 0)
    {
        <section>
            <h2 class="text-xl font-bold mb-4">最近访问</h2>
            <div class="flex flex-wrap gap-2">
                @foreach (var project in Model.RecentProjects)
                {
                    <a href="@Url.Content($"~/{project}/Dashboard")" class="badge badge-lg badge-outline hover:badge-primary">@project</a>
                }
            </div>
        </section>
    }
</div>
