@model IEnumerable<ConversationMessage>
@{
    ViewData["Title"] = "会話詳細";
    Layout = "_Layout";
    var project = ViewBag.Project as string ?? "auto-dealer-demo";
    var conversationId = ViewBag.ConversationId as string ?? "";
    var handover = ViewBag.Handover as OperatorHandoverDetail;
}

<div class="container-fluid py-3">
    <div class="d-flex align-items-center mb-3 gap-2">
        <a href="/@project/OperatorChat" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h4 mb-0">
            <i class="bi bi-chat-dots text-primary me-2"></i>
            会話詳細
        </h1>
        <small class="text-muted ms-2">@conversationId</small>
    </div>

    <div class="row g-3">
        <!-- 会話エリア -->
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-chat-square-text me-1"></i> 会話履歴</span>
                    <button class="btn btn-sm btn-outline-secondary"
                            hx-get="/@project/OperatorChat/Messages/@conversationId"
                            hx-target="#message-list"
                            hx-swap="innerHTML"
                            hx-indicator="#loading">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
                <div class="card-body overflow-auto" style="height:420px; background:#f8f9fa">
                    <div id="message-list"
                         hx-get="/@project/OperatorChat/Messages/@conversationId"
                         hx-trigger="load, every 15s"
                         hx-swap="innerHTML">
                        @await Html.PartialAsync("_Messages", Model)
                    </div>
                    <div id="loading" class="htmx-indicator text-center py-2">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    </div>
                </div>
                <div class="card-footer">
                    <form method="post"
                          action="/@project/OperatorChat/Reply/@conversationId"
                          hx-post="/@project/OperatorChat/Reply/@conversationId"
                          hx-target="#message-list"
                          hx-swap="innerHTML"
                          hx-on::after-request="this.reset()">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <textarea name="message" class="form-control" rows="2"
                                      placeholder="返信メッセージを入力してください..."
                                      required></textarea>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- サイドパネル -->
        <div class="col-lg-4">
            @if (handover != null)
            {
                var priorityBadge = handover.Priority switch {
                    "urgent" => "bg-danger",
                    "high"   => "bg-warning text-dark",
                    "medium" => "bg-info text-dark",
                    _        => "bg-secondary"
                };
                var reasonLabel = handover.Reason switch {
                    "complaint"          => "クレーム",
                    "human_agent"        => "有人対応希望",
                    "high_value_deal"    => "大型商談",
                    "negative_sentiment" => "ネガティブ感情",
                    _                    => handover.Reason
                };

                <!-- エスカレーション情報 -->
                <div class="card mb-3">
                    <div class="card-header bg-warning bg-opacity-25">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                        エスカレーション情報
                    </div>
                    <div class="card-body small">
                        <dl class="row mb-0">
                            <dt class="col-5">理由</dt>
                            <dd class="col-7">@reasonLabel</dd>
                            <dt class="col-5">優先度</dt>
                            <dd class="col-7"><span class="badge @priorityBadge">@handover.Priority</span></dd>
                            <dt class="col-5">受付時刻</dt>
                            <dd class="col-7">@handover.EscalatedAt</dd>
                            @if (!string.IsNullOrEmpty(handover.AssignedToUserId))
                            {
                                <dt class="col-5">担当者</dt>
                                <dd class="col-7">@handover.AssignedToUserId</dd>
                            }
                        </dl>
                        @if (!string.IsNullOrEmpty(handover.Notes))
                        {
                            <hr class="my-2">
                            <p class="text-muted mb-0">@handover.Notes</p>
                        }
                    </div>
                </div>

                <!-- 顧客情報 -->
                @if (!string.IsNullOrEmpty(handover.CustomerName))
                {
                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="bi bi-person me-2"></i>顧客情報
                        </div>
                        <div class="card-body small">
                            <dl class="row mb-0">
                                <dt class="col-5">氏名</dt>
                                <dd class="col-7">@handover.CustomerName</dd>
                                @if (!string.IsNullOrEmpty(handover.CustomerTier))
                                {
                                    <dt class="col-5">ランク</dt>
                                    <dd class="col-7"><span class="badge bg-warning text-dark">@handover.CustomerTier</span></dd>
                                }
                                @if (!string.IsNullOrEmpty(handover.CustomerPhone))
                                {
                                    <dt class="col-5">電話</dt>
                                    <dd class="col-7">@handover.CustomerPhone</dd>
                                }
                                @if (!string.IsNullOrEmpty(handover.CustomerEmail))
                                {
                                    <dt class="col-5">メール</dt>
                                    <dd class="col-7 text-truncate">@handover.CustomerEmail</dd>
                                }
                            </dl>
                        </div>
                    </div>
                }

                <!-- アクション -->
                <div class="card">
                    <div class="card-header">
                        <i class="bi bi-gear me-2"></i>アクション
                    </div>
                    <div class="card-body">
                        @if (handover.Status == "pending")
                        {
                            <form method="post" action="/@project/OperatorChat/Accept/@handover.HandoverId" class="mb-2">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-hand-index me-1"></i> このケースを引き受ける
                                </button>
                            </form>
                        }
                        <form method="post" action="/@project/OperatorChat/Resolve/@conversationId">
                            @Html.AntiForgeryToken()
                            <div class="mb-2">
                                <textarea name="resolutionNotes" class="form-control form-control-sm"
                                          rows="3" placeholder="解決メモ（任意）"></textarea>
                            </div>
                            <button type="submit" class="btn btn-outline-primary w-100"
                                    onclick="return confirm('対応完了にしますか？')">
                                <i class="bi bi-check-circle me-1"></i> 対応完了
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center text-muted py-4">
                        <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                        エスカレーション情報はありません
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
<style>
    .chat-customer .message-content {
        background: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 0 12px 12px 12px;
        padding: 10px 14px;
    }
    .chat-ai .message-content {
        background: #e8f4fd;
        border-radius: 12px 0 12px 12px;
        padding: 10px 14px;
    }
    .chat-agent .message-content {
        background: #d4edda;
        border-radius: 12px 0 12px 12px;
        padding: 10px 14px;
    }
    .avatar-sm {
        width: 32px;
        height: 32px;
        font-size: 0.85rem;
    }
    #message-list { scroll-behavior: smooth; }
</style>
}

@section Scripts {
<script>
    // メッセージ一覧を最下部にスクロール
    function scrollToBottom() {
        const el = document.querySelector('.card-body.overflow-auto');
        if (el) el.scrollTop = el.scrollHeight;
    }
    document.addEventListener('htmx:afterSwap', scrollToBottom);
    scrollToBottom();
</script>
}
