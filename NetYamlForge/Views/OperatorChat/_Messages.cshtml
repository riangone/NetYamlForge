@model IEnumerable<ConversationMessage>
@{
    var project = ViewBag.Project as string ?? "auto-dealer-demo";
    var conversationId = ViewBag.ConversationId as string ?? "";
}

@foreach (var msg in Model)
{
    var isCustomer = msg.Sender == "customer";
    var isAgent = msg.Sender == "agent";
    var isAi = msg.Sender == "ai";

    var bubbleClass = isCustomer ? "chat-customer" : (isAgent ? "chat-agent" : "chat-ai");
    var senderLabel = isCustomer ? "顧客" : (isAgent ? "オペレーター" : "AI");
    var senderIcon = isCustomer ? "bi-person-fill" : (isAgent ? "bi-headset" : "bi-robot");
    var senderColor = isCustomer ? "text-secondary" : (isAgent ? "text-success" : "text-primary");

    <div class="message-row @(isCustomer ? "justify-content-start" : "justify-content-end") d-flex mb-3">
        @if (isCustomer)
        {
            <div class="me-2 flex-shrink-0">
                <div class="avatar-sm bg-secondary rounded-circle d-flex align-items-center justify-content-center text-white">
                    <i class="bi @senderIcon"></i>
                </div>
            </div>
        }
        <div class="message-bubble @bubbleClass" style="max-width:70%">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <small class="fw-bold @senderColor">
                    <i class="bi @senderIcon me-1"></i>@senderLabel
                </small>
                <small class="text-muted ms-3">@msg.Timestamp</small>
            </div>
            <div class="message-content">@msg.Content</div>
            @if (!string.IsNullOrEmpty(msg.Intent))
            {
                <div class="mt-1">
                    <small class="badge bg-light text-dark border">@msg.Intent</small>
                </div>
            }
        </div>
        @if (!isCustomer)
        {
            <div class="ms-2 flex-shrink-0">
                <div class="avatar-sm @(isAgent ? "bg-success" : "bg-primary") rounded-circle d-flex align-items-center justify-content-center text-white">
                    <i class="bi @senderIcon"></i>
                </div>
            </div>
        }
    </div>
}
