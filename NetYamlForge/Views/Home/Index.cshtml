@model NetYamlForge.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
    var projects = Model.Projects ?? Array.Empty<NetYamlForge.Services.ProjectInfo>();
    var config = Model.Config ?? new NetYamlForge.Models.HomePageConfig();
    var hero = config.Hero ?? new NetYamlForge.Models.HomeHeroConfig();
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;
    string T(string? key, string fallback) => NetYamlForge.Models.I18nText.Resolve(null, fallback, key);

    var currentProjectRoute = Context.GetRouteValue("project")?.ToString();
    var isSubProjectHome = !string.IsNullOrEmpty(currentProjectRoute) 
        && !string.Equals(currentProjectRoute, "home", StringComparison.OrdinalIgnoreCase);
}

<div class="space-y-8">
    @* ===== Hero ===== *@
    <section class="relative overflow-hidden rounded-2xl border border-base-300 bg-base-100">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-secondary/5 opacity-60"></div>
        <div class="relative p-8 md:p-12">
            <div class="max-w-3xl space-y-4">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-200 border border-base-300 text-sm font-medium">
                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                    @T(hero.EyebrowKey, hero.Eyebrow)
                </div>
                <h1 class="text-4xl md:text-5xl font-bold leading-tight tracking-tight">
                    @T(hero.TitleKey, hero.Title)
                </h1>
                <p class="text-base text-base-content/70 max-w-xl leading-relaxed">
                    @T(hero.DescriptionKey, hero.Description)
                </p>
                @if (hero.Highlights != null && hero.Highlights.Count > 0)
                {
                    <div class="flex flex-wrap gap-2 pt-1 pb-1">
                        @foreach (var highlight in hero.Highlights)
                        {
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-base-200 border border-base-300 text-xs font-semibold text-base-content/80">
                                <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
                                @highlight
                            </span>
                        }
                    </div>
                }
                <div class="flex flex-wrap gap-3 pt-2">
                    <a class="btn btn-primary" href="@hero.PrimaryActionUrl">
                        @T(hero.PrimaryActionLabelKey, hero.PrimaryActionLabel)
                    </a>
                    <a class="btn btn-ghost" href="@hero.SecondaryActionUrl">
                        @T(hero.SecondaryActionLabelKey, hero.SecondaryActionLabel)
                    </a>
                </div>
            </div>
        </div>
    </section>

    @* ===== Metrics ===== *@
    @if (config.Metrics.Count > 0)
    {
        <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            @foreach (var metric in config.Metrics)
            {
                var tone = string.IsNullOrWhiteSpace(metric.Tone) ? "text-primary" : metric.Tone;
                <div class="card bg-base-100 border border-base-300 shadow-sm">
                    <div class="card-body p-5">
                        <div class="text-sm font-medium text-base-content/60 mb-1">@T(metric.LabelKey, metric.Label)</div>
                        <div class="text-3xl font-bold @tone">@metric.Value</div>
                        @if (!string.IsNullOrWhiteSpace(metric.Trend))
                        {
                            <div class="text-xs text-base-content/50 mt-1">@T(metric.TrendKey, metric.Trend)</div>
                        }
                    </div>
                </div>
            }
        </section>
    }

    @* ===== Capabilities ===== *@
    @if (config.Capabilities.Count > 0)
    {
        <section class="space-y-4">
            <h2 class="text-2xl font-bold">@T(config.CapabilitiesSectionTitleKey, config.CapabilitiesSectionTitle)</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                @foreach (var cap in config.Capabilities)
                {
                    <div class="card bg-base-100 border border-base-300 shadow-sm">
                        <div class="card-body p-5">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-2xl">@cap.Icon</span>
                                @if (!string.IsNullOrWhiteSpace(cap.Badge))
                                {
                                    <span class="badge badge-primary badge-sm">@T(cap.BadgeKey, cap.Badge)</span>
                                }
                            </div>
                            <h3 class="font-bold">@T(cap.TitleKey, cap.Title)</h3>
                            <p class="text-sm text-base-content/60 mt-1">@T(cap.DescriptionKey, cap.Description)</p>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @* ===== Solutions ===== *@
    @if (config.Solutions.Count > 0)
    {
        <section class="space-y-4">
            <h2 class="text-2xl font-bold">@T(config.SolutionsSectionTitleKey, config.SolutionsSectionTitle)</h2>
            <div class="overflow-x-auto rounded-xl border border-base-300 bg-base-100">
                <table class="table table-zebra w-full">
                    <thead>
                        <tr class="bg-base-200/50">
                            <th>Solution</th>
                            <th>Target Audience</th>
                            <th>Summary</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sol in config.Solutions)
                        {
                            <tr>
                                <td class="font-bold">@T(sol.NameKey, sol.Name)</td>
                                <td class="text-sm">@T(sol.AudienceKey, sol.Audience)</td>
                                <td class="text-sm opacity-70">@T(sol.SummaryKey, sol.Summary)</td>
                                <td><span class="badge badge-ghost badge-sm">@T(sol.StatusKey, sol.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (!isSubProjectHome)
    {
        @* ===== Projects ===== *@
        <section id="products" class="space-y-4">
            <div>
                <h2 class="text-2xl font-bold">@T(config.ProjectsSectionTitleKey, config.ProjectsSectionTitle)</h2>
                <p class="text-base-content/60 mt-0.5 text-sm">@T(config.ProjectsSectionLeadKey, config.ProjectsSectionLead)</p>
            </div>

            @if (projects.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                    @foreach (var project in projects)
                    {
                        var profile = config.ProjectProfiles.TryGetValue(project.Name, out var matched)
                            ? matched
                            : config.DefaultProjectProfile;
                        var profileTags = (profile.TagKeys != null && profile.TagKeys.Count > 0)
                            ? profile.TagKeys.Select((k, i) =>
                            {
                                var fallback = i < profile.Tags.Count ? profile.Tags[i] : k;
                                return T(k, fallback);
                            }).ToList()
                            : profile.Tags.ToList();
                        <article class="group card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow duration-200">
                            <div class="card-body">
                                <div class="flex items-start gap-3">
                                    <div class="p-2.5 rounded-xl bg-base-200 border border-base-300 text-2xl">
                                        @profile.Icon
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h3 class="card-title text-lg font-semibold truncate">@project.DisplayName</h3>
                                        <div class="text-xs text-base-content/50 font-mono">@project.Name</div>
                                    </div>
                                </div>
                                <p class="text-sm text-base-content/70 line-clamp-2">@T(profile.TaglineKey, profile.Tagline)</p>
                                <div class="flex flex-wrap gap-1.5">
                                    <span class="px-2 py-1 rounded-md bg-primary/10 border border-primary/20 text-xs font-medium text-primary">
                                        @project.DatabaseType.ToUpperInvariant()
                                    </span>
                                    @foreach (var tag in profileTags)
                                    {
                                        <span class="px-2 py-1 rounded-md bg-base-200 border border-base-300 text-xs font-medium">@tag</span>
                                    }
                                </div>
                                <div class="pt-2 mt-1 border-t border-base-200">
                                    <a asp-controller="Home" asp-action="Project" asp-route-project="@project.Name"
                                       class="btn btn-primary btn-sm w-full gap-2">
                                        @T(config.OpenWorkspaceLabelKey, config.OpenWorkspaceLabel)
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <span>@T(config.EmptyProjectsMessageKey, config.EmptyProjectsMessage)</span>
                </div>
            }
        </section>
    }

    @* ===== Quick Actions ===== *@
    @if (config.QuickActions.Count > 0)
    {
        <section class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-lg mb-2">@T(config.QuickActionsSectionTitleKey, config.QuickActionsSectionTitle)</h2>
                <div class="flex flex-wrap gap-2">
                    @foreach (var action in config.QuickActions)
                    {
                        if (action.AdminOnly && !isAdmin) { continue; }
                        if (action.UserOnly && (!isAuthenticated || isAdmin)) { continue; }
                        var styleClass = string.IsNullOrWhiteSpace(action.Style) ? "btn-ghost" : action.Style;
                        <a class="btn btn-sm gap-2 @styleClass" href="@action.Url">
                            @if (!string.IsNullOrWhiteSpace(action.Icon))
                            {
                                <span class="text-lg">@action.Icon</span>
                            }
                            @T(action.LabelKey, action.Label)
                        </a>
                    }
                </div>
            </div>
        </section>
    }
</div>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
