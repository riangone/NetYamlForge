@model NetYamlForge.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
    var projects = Model.Projects ?? Array.Empty<NetYamlForge.Services.ProjectInfo>();
    var config = Model.Config ?? new NetYamlForge.Models.HomePageConfig();
    var hero = config.Hero ?? new NetYamlForge.Models.HomeHeroConfig();
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User?.IsInRole("Admin") ?? false;
    string T(string? key, string fallback) => NetYamlForge.Models.I18nText.Resolve(null, fallback, key);
    var heroHighlights = (hero.HighlightKeys != null && hero.HighlightKeys.Count > 0)
        ? hero.HighlightKeys.Select((k, i) =>
        {
            var fallback = i < hero.Highlights.Count ? hero.Highlights[i] : k;
            return T(k, fallback);
        }).ToList()
        : hero.Highlights.ToList();
}

<div class="space-y-8">
    <section class="rounded-box text-base-content overflow-hidden border border-base-300 bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-base-100 via-base-200 to-base-300">
        <div class="p-8 md:p-12">
            <div class="max-w-4xl space-y-5">
                <div class="badge badge-outline badge-lg">@T(hero.EyebrowKey, hero.Eyebrow)</div>
                <h1 class="text-4xl md:text-5xl font-black leading-tight">@T(hero.TitleKey, hero.Title)</h1>
                <p class="text-lg opacity-80 max-w-3xl">@T(hero.DescriptionKey, hero.Description)</p>
                @if (heroHighlights.Count > 0)
                {
                    <div class="flex flex-wrap gap-2">
                        @foreach (var item in heroHighlights)
                        {
                            <span class="badge badge-neutral">@item</span>
                        }
                    </div>
                }
                <div class="flex flex-wrap gap-3 pt-2">
                    <a class="btn btn-primary btn-sm" href="@hero.PrimaryActionUrl">@T(hero.PrimaryActionLabelKey, hero.PrimaryActionLabel)</a>
                    <a class="btn btn-outline btn-sm" href="@hero.SecondaryActionUrl">@T(hero.SecondaryActionLabelKey, hero.SecondaryActionLabel)</a>
                </div>
            </div>
        </div>
    </section>

    @if (config.Metrics.Count > 0)
    {
        <section class="stats stats-vertical lg:stats-horizontal shadow w-full border border-base-300 bg-base-100">
            @foreach (var metric in config.Metrics)
            {
                var tone = string.IsNullOrWhiteSpace(metric.Tone) ? "text-primary" : metric.Tone;
                <div class="stat">
                    <div class="stat-title">@T(metric.LabelKey, metric.Label)</div>
                    <div class="stat-value @tone">@metric.Value</div>
                    @if (!string.IsNullOrWhiteSpace(metric.Trend))
                    {
                        <div class="stat-desc">@T(metric.TrendKey, metric.Trend)</div>
                    }
                </div>
            }
        </section>
    }

    <section class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="xl:col-span-2">
            <div class="card bg-base-100 border border-base-300 shadow-sm">
                <div class="card-body">
                    <h2 class="card-title text-2xl">@T(config.CapabilitiesSectionTitleKey, config.CapabilitiesSectionTitle)</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
                        @foreach (var capability in config.Capabilities)
                        {
                            <div class="rounded-box border border-base-300 p-4 bg-base-200/50">
                                <div class="flex items-center gap-2 mb-2">
                                    <span class="text-2xl">@capability.Icon</span>
                                    <div class="font-bold">@T(capability.TitleKey, capability.Title)</div>
                                    @if (!string.IsNullOrWhiteSpace(capability.Badge))
                                    {
                                        <span class="badge badge-outline ml-auto">@T(capability.BadgeKey, capability.Badge)</span>
                                    }
                                </div>
                                <p class="text-sm opacity-80">@T(capability.DescriptionKey, capability.Description)</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="xl:col-span-1">
            <div class="card bg-base-100 border border-base-300 shadow-sm h-full">
                <div class="card-body">
                    <h2 class="card-title text-2xl">@T(config.SolutionsSectionTitleKey, config.SolutionsSectionTitle)</h2>
                    <div class="space-y-3">
                        @foreach (var solution in config.Solutions)
                        {
                            <div class="rounded-box border border-base-300 p-3">
                                <div class="flex items-center gap-2">
                                    <div class="font-semibold">@T(solution.NameKey, solution.Name)</div>
                                    <span class="badge badge-ghost ml-auto">@T(solution.StatusKey, solution.Status)</span>
                                </div>
                                <div class="text-xs opacity-60 mt-1">@T(solution.AudienceKey, solution.Audience)</div>
                                <p class="text-sm mt-2">@T(solution.SummaryKey, solution.Summary)</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="products" class="space-y-3">
        <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
                <h2 class="text-2xl font-bold">@T(config.ProjectsSectionTitleKey, config.ProjectsSectionTitle)</h2>
                <p class="opacity-70">@T(config.ProjectsSectionLeadKey, config.ProjectsSectionLead)</p>
            </div>
        </div>

        @if (projects.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                @foreach (var project in projects)
                {
                    var profile = config.ProjectProfiles.TryGetValue(project.Name, out var matched)
                        ? matched
                        : config.DefaultProjectProfile;
                    var profileTags = (profile.TagKeys != null && profile.TagKeys.Count > 0)
                        ? profile.TagKeys.Select((k, i) =>
                        {
                            var fallback = i < profile.Tags.Count ? profile.Tags[i] : k;
                            return T(k, fallback);
                        }).ToList()
                        : profile.Tags.ToList();
                    <article class="card bg-base-100 border border-base-300 shadow-sm">
                        <div class="card-body">
                            <div class="flex items-center gap-3">
                                <span class="text-3xl">@profile.Icon</span>
                                <div>
                                    <h3 class="card-title text-lg">@project.DisplayName</h3>
                                    <div class="text-xs opacity-60">@project.Name</div>
                                </div>
                            </div>
                            <p class="text-sm opacity-80">@T(profile.TaglineKey, profile.Tagline)</p>
                            <div class="flex flex-wrap gap-2">
                                <span class="badge badge-primary badge-outline">@project.DatabaseType.ToUpperInvariant()</span>
                                @foreach (var tag in profileTags)
                                {
                                    <span class="badge badge-ghost">@tag</span>
                                }
                            </div>
                            <div class="card-actions justify-end mt-3">
                                <a asp-controller="Home" asp-action="Project" asp-route-project="@project.Name" class="btn btn-primary btn-sm">@T(config.OpenWorkspaceLabelKey, config.OpenWorkspaceLabel)</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <span>@T(config.EmptyProjectsMessageKey, config.EmptyProjectsMessage)</span>
            </div>
        }
    </section>

    @if (config.QuickActions.Count > 0)
    {
        <section class="card bg-base-100 border border-base-300 shadow-sm">
            <div class="card-body">
                <h2 class="card-title text-2xl">@T(config.QuickActionsSectionTitleKey, config.QuickActionsSectionTitle)</h2>
                <div class="flex flex-wrap gap-3 mt-2">
                    @foreach (var action in config.QuickActions)
                    {
                        if (action.AdminOnly && !isAdmin) { continue; }
                        if (action.UserOnly && (!isAuthenticated || isAdmin)) { continue; }
                        var styleClass = string.IsNullOrWhiteSpace(action.Style) ? "btn-outline" : action.Style;
                        <a class="btn btn-sm @styleClass" href="@action.Url">
                            @if (!string.IsNullOrWhiteSpace(action.Icon))
                            {
                                <span>@action.Icon</span>
                            }
                            @T(action.LabelKey, action.Label)
                        </a>
                    }
                </div>
            </div>
        </section>
    }
</div>
