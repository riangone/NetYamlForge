@using NetYamlForge.Models
@using NetYamlForge.Services
@inject WorkflowGuideService WorkflowGuideSvc
@inject Microsoft.Extensions.Localization.IStringLocalizer<NetYamlForge.Localization.SharedResource> L
@model SectionRenderModel
@{
    var sec = Model.Sec;
    var userRoles = (ViewData["UserRoles"] as List<string>) ?? new();
    var userName = User.Identity?.Name ?? "";
    var project = Model.Project ?? "";

    var wfData = await WorkflowGuideSvc.BuildWorkflowDataAsync(userRoles, userName);

    string TUrl(string url)
    {
        var r = url.Replace("{project}", project);
        if (r.StartsWith("/"))
        {
            var pathBase = Context.Request.PathBase.Value?.TrimEnd('/') ?? "";
            return pathBase + r;
        }
        return r;
    }
}

@functions {
    string StepBadgeClass(WorkflowStepStatus s)
    {
        return s switch
        {
            WorkflowStepStatus.NotStarted => "bg-gray-100 text-gray-500",
            WorkflowStepStatus.InProgress => "bg-blue-100 text-blue-700",
            WorkflowStepStatus.Completed => "bg-green-100 text-green-700",
            WorkflowStepStatus.Current => "bg-indigo-100 text-indigo-700 ring-2 ring-indigo-300",
            _ => "bg-gray-100 text-gray-500"
        };
    }
    string StepIconBgClass(WorkflowStepStatus s)
    {
        return s switch
        {
            WorkflowStepStatus.NotStarted => "bg-gray-200",
            WorkflowStepStatus.InProgress => "bg-blue-200",
            WorkflowStepStatus.Completed => "bg-green-200",
            WorkflowStepStatus.Current => "bg-indigo-200 ring-2 ring-indigo-400",
            _ => "bg-gray-200"
        };
    }
    string StatusLabel(WorkflowStepStatus s)
    {
        return s switch
        {
            WorkflowStepStatus.NotStarted => L["Not Started"],
            WorkflowStepStatus.InProgress => L["In Progress"],
            WorkflowStepStatus.Completed => L["Completed"],
            WorkflowStepStatus.Current => "▶ 当前步骤",
            _ => ""
        };
    }
    string RoleDisplay(string role)
    {
        return role switch
        {
            "employee" => L["Employee"],
            "contract_manager" => L["Contract Manager"],
            "accountant" => L["Accountant"],
            "purchaser" => L["Purchaser"],
            "approver" => L["Approver"],
            "admin" => L["Admin"],
            "finance" => L["Finance Manager"],
            "manager" => L["Manager"],
            _ => role
        };
    }
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <h2 class="text-lg font-semibold text-gray-700 mb-4">@sec.Title</h2>
}

<div class="space-y-8">
    @foreach (var flow in wfData.Flows)
    {
        <div class="card bg-base-100 shadow-md border border-base-200">
            <div class="card-body p-5">
                <div class="flex items-center gap-3 mb-4">
                    <span class="text-3xl">@flow.Icon</span>
                    <div>
                        <h3 class="text-lg font-bold text-gray-800">@flow.Title</h3>
                        <p class="text-sm text-gray-500">@flow.Description</p>
                    </div>
                </div>

                <div class="relative">
                    @foreach (var step in flow.Steps)
                    {
                        var isResponsible = step.IsResponsible;
                        var iconBg = StepIconBgClass(step.Status);

                        <div class="flex gap-4 pb-6 relative @(step == flow.Steps.Last() ? "pb-0" : "")">
                            <div class="flex flex-col items-center">
                                <div class="w-10 h-10 rounded-full @iconBg flex items-center justify-center text-lg font-bold shrink-0 @(step.Status == WorkflowStepStatus.Current ? "shadow-lg" : "")">
                                    @if (step.Status == WorkflowStepStatus.Completed)
                                    {
                                        <span class="text-green-600">✓</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-600">@step.StepNo</span>
                                    }
                                </div>
                                @if (step != flow.Steps.Last())
                                {
                                    <div class="w-0.5 flex-1 bg-gray-200 mt-1"></div>
                                }
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex items-center flex-wrap gap-2 mb-1">
                                    <span class="font-semibold text-gray-800 text-sm">@step.Title</span>
                                    <span class="text-xs px-2 py-0.5 rounded-full font-medium @StepBadgeClass(step.Status)">
                                        @StatusLabel(step.Status)
                                    </span>
                                    @if (isResponsible && step.Status != WorkflowStepStatus.Completed)
                                    {
                                        <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 font-medium">
                                            您负责
                                        </span>
                                    }
                                </div>

                                <p class="text-xs text-gray-500 mb-2 leading-relaxed">@step.Description</p>

                                <div class="flex flex-wrap items-center gap-3">
                                    <div class="flex items-center gap-1.5">
                                        @foreach (var role in step.ResponsibleRoles)
                                        {
                                            var isUserRole = userRoles.Contains(role, StringComparer.OrdinalIgnoreCase);
                                            <span class="text-xs px-1.5 py-0.5 rounded @(isUserRole ? "bg-primary/10 text-primary font-medium" : "bg-gray-100 text-gray-500")">
                                                @RoleDisplay(role)
                                            </span>
                                        }
                                    </div>

                                    <div class="flex items-center gap-1.5 text-xs text-gray-400">
                                        @if (step.DraftCount > 0)
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-orange-50 text-orange-600 border border-orange-200" title="草稿">
                                                📝 @step.DraftCount
                                            </span>
                                        }
                                        @if (step.InProgressCount > 0)
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-blue-50 text-blue-600 border border-blue-200" title="进行中">
                                                🔄 @step.InProgressCount
                                            </span>
                                        }
                                        @if (step.CompletedCount > 0)
                                        {
                                            <span class="px-1.5 py-0.5 rounded bg-green-50 text-green-600 border border-green-200" title="已完成">
                                                ✅ @step.CompletedCount
                                            </span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrEmpty(step.TargetUrl))
                                    {
                                        <a href="@TUrl(step.TargetUrl)"
                                           class="text-xs btn btn-ghost btn-xs text-primary hover:bg-primary/10 gap-1">
                                            打开 →
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!wfData.Flows.Any())
    {
        <div class="text-center text-gray-400 py-8">无法加载业务流程数据。</div>
    }
</div>
