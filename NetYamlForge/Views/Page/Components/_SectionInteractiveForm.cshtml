@using NetYamlForge.Models
@using System.Text.Json
@using System.Text.Encodings.Web
@using NetYamlForge.Localization
@model NetYamlForge.Models.SectionRenderModel
@{
    var sec = Model.Sec;
    var rows = Model.Rows;
    var currentProject = Model.Project;

    // Helper to resolve localization
    string T(string key, string fallback) => I18nText.ResolveByKey(key) ?? fallback;

    // Helper to convert PascalCase to camelCase
    string ToCamelCase(string? input) {
        if (string.IsNullOrEmpty(input)) return "";
        return char.ToLower(input[0]) + input.Substring(1);
    }

    // Helper to convert PascalCase to snake_case for API route resolution
    string ToSnakeCase(string? input) {
        if (string.IsNullOrEmpty(input)) return "";
        return string.Concat(input.Select((x, i) => i > 0 && char.IsUpper(x) ? "_" + x.ToString() : x.ToString())).ToLower();
    }

    // Helper to find column keys case-insensitively
    string? FindKey(Dictionary<string, object> row, params string[] possibleKeys) {
        foreach (var pk in possibleKeys) {
            var found = row.Keys.FirstOrDefault(k => k.Equals(pk, StringComparison.OrdinalIgnoreCase));
            if (found != null) return found;
        }
        return null;
    }

    var rawEntity = sec.TargetTable ?? sec.Source ?? sec.Id;
    var apiEntity = ToSnakeCase(rawEntity);

    var detailRow = rows.FirstOrDefault();
    bool isEdit = detailRow != null;
    var idKey = isEdit ? (rows.First().Keys.FirstOrDefault(k => k.Equals("Id", StringComparison.OrdinalIgnoreCase)) ?? "Id") : "Id";
    var id = isEdit ? detailRow![idKey]?.ToString() : "";

    var cancelUrl = Url.Action("Index", "Page", new { project = currentProject, pageName = "HomePage" });

    // Fields to render in form
    var fieldNames = sec.GetFormFields(isEdit ? "edit" : "create");

    // フォームの見出し/説明。プロジェクト側が forms.create/edit.title(Key) を設定していれば
    // それを使い、未設定時のみ既定（diary-companion 由来）のフォールバック文言を使う。
    // これにより既存プロジェクト（diary-companion）の表示は変わらず、他プロジェクトは
    // 自分のセクション定義で上書きできる。
    var activeFormGroup = sec.Forms != null && sec.Forms.TryGetValue(isEdit ? "edit" : "create", out var fg) ? fg : null;
    var headerTitleOverride = activeFormGroup?.GetTitle();
    var headerDescOverride = activeFormGroup?.GetDescription();
    var headerTitle = headerTitleOverride
        ?? (isEdit ? T("projects.diary-companion.views.form.edit_title", "重温与编辑记录") : T("projects.diary-companion.views.form.create_title", "创建全新篇章"));
    var headerDesc = headerTitleOverride != null
        ? headerDescOverride
        : (isEdit ? T("projects.diary-companion.views.form.edit_desc", "随时可以完善和更改你的记录，系统将为您重新进行智能解读。") : T("projects.diary-companion.views.form.create_desc", "在这里倾诉吧，写下你最真实的一天。"));

    // Mood list & emojis
    var moodList = new[] {
        new { Name = "喜悦", Emoji = "🌸", Desc = "开心美好" },
        new { Name = "平静", Emoji = "🍃", Desc = "波澜不惊" },
        new { Name = "轻松", Emoji = "🍹", Desc = "闲适惬意" },
        new { Name = "期待", Emoji = "🌟", Desc = "满怀希望" },
        new { Name = "狂喜", Emoji = "🎉", Desc = "兴奋雀跃" },
        new { Name = "欣慰", Emoji = "🥰", Desc = "温暖贴心" },
        new { Name = "专注", Emoji = "🎯", Desc = "聚精会神" },
        new { Name = "治愈", Emoji = "🍀", Desc = "温暖放松" },
        new { Name = "焦虑", Emoji = "🌪️", Desc = "有些烦躁" },
        new { Name = "忧郁", Emoji = "🌧️", Desc = "有点难过" },
        new { Name = "愤怒", Emoji = "⚡", Desc = "怒火中烧" },
        new { Name = "疲惫", Emoji = "💤", Desc = "身心俱疲" },
        new { Name = "委屈", Emoji = "🥺", Desc = "楚楚可怜" },
        new { Name = "迷茫", Emoji = "🌀", Desc = "不知所措" }
    };

    // Weather list & emojis
    var weatherList = new[] {
        new { Name = "晴朗", Emoji = "☀️" },
        new { Name = "多云", Emoji = "⛅" },
        new { Name = "阴天", Emoji = "☁️" },
        new { Name = "雨天", Emoji = "🌧️" },
        new { Name = "雪天", Emoji = "❄️" },
        new { Name = "微风", Emoji = "🌬️" }
    };
}

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
    }
    .emoji-btn {
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .emoji-btn.active {
        transform: scale(1.15);
        border-color: #6366f1 !important;
        background-color: #f5f3ff !important;
        box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.15);
    }
    .input-focus-effect:focus {
        border-color: #6366f1 !important;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
    }
    .animate-spin-slow {
        animation: spin 3s linear infinite;
    }
    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    @@keyframes zoomIn {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
    .animate-zoom-in {
        animation: zoomIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>

<div class="card glass-card border border-purple-100 shadow-xl rounded-3xl overflow-hidden">
    <!-- Header banner -->
    <div class="p-6 md:p-8 bg-gradient-to-r from-indigo-50 via-purple-50 to-pink-50 border-b border-purple-100 flex items-center justify-between">
        <div class="space-y-1.5">
            <span class="text-2xl">✍️</span>
            <h2 class="text-2xl font-extrabold text-gray-800">@headerTitle</h2>
            @if (!string.IsNullOrWhiteSpace(headerDesc))
            {
                <p class="text-xs text-gray-500">@headerDesc</p>
            }
        </div>
        <div class="flex items-center gap-3">
            <a href="@cancelUrl" class="btn btn-sm bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 shadow-sm rounded-xl flex items-center gap-1.5 transition-all hover:scale-105 font-bold">
                <span>🔙</span> @T("Back to List", "Back to List")
            </a>
            <div class="text-3xl opacity-30 select-none hidden md:block">✏️</div>
        </div>
    </div>

    <form id="interactive-form-@(sec.Id)" class="p-6 md:p-8 space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" id="form-entity-id-@(sec.Id)" value="@id" />

        @foreach (var fieldName in fieldNames)
        {
            var fieldDef = sec.GetFieldDef(fieldName);
            // ページの fieldDefs 側で labelKey/labelI18n を明示指定していればそれを優先する
            // （ページ固有の文言でエンティティ既定ラベルを上書き可能にする）。
            // 未指定時は従来どおりエンティティ単位の既定キーにフォールバックする（既存プロジェクト互換）。
            var hasFieldLevelLabelOverride = !string.IsNullOrWhiteSpace(fieldDef.LabelKey) || (fieldDef.LabelI18n != null && fieldDef.LabelI18n.Count > 0);
            var entityLabelKey = $"projects.{currentProject}.entity.{apiEntity}.fields.{ToCamelCase(fieldName)}";
            var label = hasFieldLevelLabelOverride
                ? fieldDef.GetLabel(fieldDef.Label ?? fieldName)
                : T(entityLabelKey, fieldDef.Label ?? fieldName);
            var isRequired = fieldDef.Required;
            string? foundKey = isEdit && detailRow != null ? detailRow.Keys.FirstOrDefault(k => k.Equals(fieldName, StringComparison.OrdinalIgnoreCase)) : null;
            var rowValue = isEdit && detailRow != null && foundKey != null && detailRow.TryGetValue(foundKey, out var val) ? val?.ToString() ?? "" : "";

            // 1. MoodBefore / Mood -> Custom Emoji Select
            if (fieldName.Equals("MoodBefore", StringComparison.OrdinalIgnoreCase) || fieldName.Equals("Mood", StringComparison.OrdinalIgnoreCase))
            {
                <input type="hidden" id="field-@(fieldName)-@(sec.Id)" name="@fieldName" value="@rowValue" />
                <div class="form-control space-y-2">
                    <label class="label p-0">
                        <span class="label-text font-bold text-gray-700">@label @(isRequired ? "*" : "")</span>
                    </label>
                    <div class="grid grid-cols-4 md:grid-cols-7 gap-3">
                        @foreach (var mItem in moodList)
                        {
                            <button type="button" onclick="selectMood_@(sec.Id)('@mItem.Name')" id="mood-btn-@(sec.Id)-@mItem.Name" class="mood-option-@(sec.Id) emoji-btn flex flex-col items-center justify-center p-3 border border-gray-200 rounded-2xl bg-white hover:bg-indigo-50/50 hover:border-indigo-300">
                                <span class="text-2xl mb-1 filter drop-shadow-sm">@mItem.Emoji</span>
                                <span class="text-xs font-bold text-gray-700">@T($"projects.diary-companion.moods.{mItem.Name}.name", mItem.Name)</span>
                                <span class="text-[9px] text-gray-400">@T($"projects.diary-companion.moods.{mItem.Name}.desc", mItem.Desc)</span>
                            </button>
                        }
                    </div>
                    <span id="err-@(fieldName)-@(sec.Id)" class="text-xs text-rose-500 hidden"></span>
                </div>
            }
            // 2. Weather -> Weather Selection Buttons
            else if (fieldName.Equals("Weather", StringComparison.OrdinalIgnoreCase))
            {
                <input type="hidden" id="field-@(fieldName)-@(sec.Id)" name="@fieldName" value="@rowValue" />
                <div class="form-control space-y-1.5">
                    <label class="label p-0">
                        <span class="label-text font-bold text-gray-700">@label @(isRequired ? "*" : "")</span>
                    </label>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var wItem in weatherList)
                        {
                            <button type="button" onclick="selectWeather_@(sec.Id)('@wItem.Name')" id="weather-btn-@(sec.Id)-@wItem.Name" class="weather-option-@(sec.Id) btn btn-sm btn-outline border-gray-200 hover:bg-indigo-50 hover:border-indigo-300 rounded-lg flex items-center gap-1 text-xs">
                                <span>@wItem.Emoji</span>
                                <span>@T($"projects.diary-companion.weathers.{wItem.Name}.name", wItem.Name)</span>
                            </button>
                        }
                    </div>
                    <span id="err-@(fieldName)-@(sec.Id)" class="text-xs text-rose-500 hidden"></span>
                </div>
            }
            // 3. Location -> Location Input with auto-detect geolocation button
            else if (fieldName.Equals("Location", StringComparison.OrdinalIgnoreCase) || fieldName.Equals("Place", StringComparison.OrdinalIgnoreCase))
            {
                <div class="form-control space-y-1.5">
                    <label class="label p-0">
                        <span class="label-text font-bold text-gray-700">@label @(isRequired ? "*" : "")</span>
                    </label>
                    <div class="relative flex items-center">
                        <input type="text" id="field-@(fieldName)-@(sec.Id)" name="@fieldName" value="@rowValue" placeholder="@T("projects.diary-companion.views.form.location_placeholder", "记录地点(可选)")" class="input input-bordered w-full rounded-xl pr-28 input-focus-effect" @(isRequired ? "required" : "") />
                        <button type="button" onclick="getGeolocation_@(sec.Id)('@fieldName', this)" class="absolute right-2 btn btn-xs btn-primary bg-indigo-600 hover:bg-indigo-700 border-none rounded-lg text-white font-semibold">
                            📍 @T("projects.diary-companion.views.form.geolocation_btn", "自动获取")
                        </button>
                    </div>
                    <span id="err-@(fieldName)-@(sec.Id)" class="text-xs text-rose-500 hidden"></span>
                </div>
            }
            // 3.5 ImageBase64 -> Single Image Upload & Compression
            else if (fieldName.Equals("ImageBase64", StringComparison.OrdinalIgnoreCase))
            {
                <input type="hidden" id="field-@(fieldName)-@(sec.Id)" name="@fieldName" value="@rowValue" />
                <div class="form-control space-y-1.5">
                    <label class="label p-0">
                        <span class="label-text font-bold text-gray-700">@label @(isRequired ? "*" : "")</span>
                    </label>
                    <div class="flex items-center gap-4">
                        <div id="image-upload-zone-@(sec.Id)" class="w-full border-2 border-dashed border-indigo-200 hover:border-indigo-400 rounded-2xl p-4 bg-indigo-50/10 text-center cursor-pointer transition-all hover:bg-indigo-50/20 flex flex-col items-center justify-center min-h-[120px]" onclick="document.getElementById('file-uploader-@(sec.Id)').click()">
                            <div id="image-upload-prompt-@(sec.Id)" class="space-y-1">
                                <span class="text-2xl">📸</span>
                                <p class="text-xs font-bold text-gray-600">@T("projects.diary-companion.views.form.image_prompt", "点击或拖拽上传图片")</p>
                                <p class="text-[10px] text-gray-400">@T("projects.diary-companion.views.form.image_hint", "仅限单张，支持智能压缩并存入SQLite")</p>
                            </div>
                            <div id="image-preview-container-@(sec.Id)" class="hidden relative w-full flex flex-col items-center">
                                <img id="image-preview-@(sec.Id)" src="" class="max-h-40 rounded-xl shadow-md object-contain border border-gray-100 cursor-zoom-in hover:scale-[1.02] transition-transform duration-300" onclick="window.showLightbox_@(sec.Id)(this.src, document.getElementById('field-ImageLabel-@(sec.Id)')?.value || '')" />
                                <button type="button" onclick="clearSelectedImage_@(sec.Id)(event)" class="absolute -top-2 -right-2 btn btn-xs btn-circle btn-error bg-rose-500 hover:bg-rose-600 border-none text-white shadow-md">✕</button>
                            </div>
                        </div>
                        <input type="file" id="file-uploader-@(sec.Id)" accept="image/*" class="hidden" onchange="handleImageUpload_@(sec.Id)(this)" />
                    </div>
                    <span id="err-@(fieldName)-@(sec.Id)" class="text-xs text-rose-500 hidden"></span>
                </div>
            }
            // 4. Content / Description -> Textarea
            else if (fieldName.Equals("Content", StringComparison.OrdinalIgnoreCase) || fieldName.Equals("Description", StringComparison.OrdinalIgnoreCase) || fieldName.Equals("Body", StringComparison.OrdinalIgnoreCase) || fieldDef.Type == "textarea")
            {
                <div class="form-control w-full space-y-1.5">
                    <label class="label p-0">
                        <span class="label-text font-bold text-gray-700">@label @(isRequired ? "*" : "")</span>
                    </label>
                    <textarea id="field-@(fieldName)-@(sec.Id)" name="@fieldName" rows="8" placeholder="@T("projects.diary-companion.views.form.content_placeholder", "写下详细内容...")" class="textarea textarea-bordered w-full rounded-2xl min-h-[200px] input-focus-effect leading-relaxed" @(isRequired ? "required" : "")>@rowValue</textarea>
                    <span id="err-@(fieldName)-@(sec.Id)" class="text-xs text-rose-500 hidden"></span>
                </div>
            }
            // 5. Select / options -> <select>
            else if ((fieldDef.Type == "select" || (fieldDef.Options != null && fieldDef.Options.Any())))
            {
                <div class="form-control w-full space-y-1.5" id="container-field-@(fieldName)-@(sec.Id)">
                    <label class="label p-0">
                        <span class="label-text font-bold text-gray-700">@label @(isRequired ? "*" : "")</span>
                    </label>
                    <select id="field-@(fieldName)-@(sec.Id)" name="@fieldName" class="select select-bordered w-full rounded-xl input-focus-effect" @(isRequired ? "required" : "")>
                        @if (!isRequired)
                        {
                            <option value="">@T("projects.diary-companion.views.form.select_placeholder", "— 选择 —")</option>
                        }
                        @if (fieldDef.Options != null)
                        {
                            @foreach (var opt in fieldDef.Options)
                            {
                                <option value="@opt.Key" selected="@(rowValue == opt.Key ? "selected" : null)">@opt.Value</option>
                            }
                        }
                    </select>
                    <span id="err-@(fieldName)-@(sec.Id)" class="text-xs text-rose-500 hidden"></span>
                </div>
            }
            // 6. Default inputs
            else
            {
                var inputType = fieldDef.Type switch {
                    "number" => "number",
                    "date" => "date",
                    "datetime-local" => "datetime-local",
                    "email" => "email",
                    "password" => "password",
                    _ => "text"
                };

                <div class="form-control w-full space-y-1.5">
                    <label class="label p-0">
                        <span class="label-text font-bold text-gray-700">@label @(isRequired ? "*" : "")</span>
                    </label>
                    <input type="@inputType" id="field-@(fieldName)-@(sec.Id)" name="@fieldName" value="@rowValue" class="input input-bordered w-full rounded-xl input-focus-effect" @(isRequired ? "required" : "") />
                    <span id="err-@(fieldName)-@(sec.Id)" class="text-xs text-rose-500 hidden"></span>
                </div>
            }
        }

        @if (isEdit && detailRow != null)
        {
            var sentimentKey = FindKey(detailRow, "Sentiment", "sentiment") ?? "Sentiment";
            var sentiment = detailRow.TryGetValue(sentimentKey, out var sentVal) ? sentVal?.ToString() ?? "" : "";
            
            var aiRespKey = FindKey(detailRow, "AiResponse", "ai_response") ?? "AiResponse";
            var aiResp = detailRow.TryGetValue(aiRespKey, out var aiVal) ? aiVal?.ToString() ?? "" : "";
            
            if (!string.IsNullOrEmpty(sentiment) || !string.IsNullOrEmpty(aiResp))
            {
                var translatedSentiment = sentiment.Trim() switch {
                    "积极" or "Positive" or "ポジティブ" => T("projects.diary-companion.sentiment.positive", "充满阳光"),
                    "消极" or "Negative" or "ネガティブ" => T("projects.diary-companion.sentiment.negative", "雨过天晴"),
                    "平和" or "Neutral" or "ニュートラル" => T("projects.diary-companion.sentiment.neutral", "风平浪静"),
                    _ => sentiment
                };

                (string text, string badgeClass, string borderClass, string bgClass) = sentiment.Trim() switch {
                    "积极" or "Positive" or "ポジティブ" => (translatedSentiment, "bg-emerald-100 text-emerald-800 border-emerald-300", "border-emerald-200", "bg-emerald-50/50"),
                    "消极" or "Negative" or "ネガティブ" => (translatedSentiment, "bg-rose-100 text-rose-800 border-rose-300", "border-rose-200", "bg-rose-50/50"),
                    "平和" or "Neutral" or "ニュートラル" => (translatedSentiment, "bg-sky-100 text-sky-800 border-sky-300", "border-sky-200", "bg-sky-50/50"),
                    _ => (sentiment, "bg-gray-100 text-gray-800 border-gray-300", "border-gray-200", "bg-gray-50/50")
                };

                <div class="p-5 rounded-2xl border @borderClass @bgClass space-y-3 mt-2 mb-4 animate-fade-in">
                    <div class="flex items-center justify-between">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border @badgeClass">
                            ✨ @T("projects.diary-companion.views.list.ai_title", "AI 伴侣评估")：@text
                        </span>
                        <span class="text-xs text-gray-400">@T("projects.diary-companion.views.form.ai_message_author", "来自 AI 心灵伴侣")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(aiResp))
                    {
                        <p class="text-xs text-gray-600 italic leading-relaxed whitespace-pre-line bg-white/40 p-4 rounded-xl border border-white/60">
                            “@aiResp”
                        </p>
                    }
                </div>
            }
        }

        <!-- Form Actions -->
        <div class="pt-4 flex items-center justify-end gap-3 border-t border-gray-100">
            <a href="@cancelUrl" class="btn btn-sm btn-ghost rounded-xl px-4 text-gray-500 flex items-center gap-1">
                <span>↩️</span> @T("projects.diary-companion.views.form.back_to_list", "返回一览")
            </a>
            <button type="submit" class="btn btn-sm btn-primary bg-indigo-600 hover:bg-indigo-700 border-none px-6 rounded-xl text-white shadow-md shadow-indigo-100 flex items-center gap-2">
                <span>💾</span> @T("projects.diary-companion.views.form.save", "保存数据")
            </button>
        </div>
    </form>
</div>

<!-- ===== Loading Mask ===== -->
<div id="loading-overlay-@(sec.Id)" class="fixed inset-0 bg-gray-900/40 backdrop-blur-md flex items-center justify-center z-50 hidden">
    <div class="card glass bg-white/90 p-8 rounded-3xl max-w-sm text-center shadow-2xl space-y-4 border border-white">
        <div class="flex justify-center">
            <span class="text-5xl animate-spin-slow">✨</span>
        </div>
        <div class="space-y-1.5">
            <h4 class="font-extrabold text-gray-800 text-base" id="loading-title-@(sec.Id)">@T("projects.diary-companion.views.form.ai_thinking", "心灵对话中...")</h4>
            <p class="text-xs text-gray-500 leading-relaxed" id="loading-desc-@(sec.Id)">
                @T("projects.diary-companion.views.form.ai_thinking_desc", "AI 伴侣正在认真阅读你的日记，感知你此时的心情，并为你撰写暖心的寄语……请稍候。")
            </p>
        </div>
        <div class="w-full bg-gray-100 h-1.5 rounded-full overflow-hidden">
            <div class="bg-indigo-600 h-full animate-pulse" style="width: 100%"></div>
        </div>
    </div>
</div>

<!-- ===== Lightbox Modal ===== -->
<dialog id="lightbox_modal_@(sec.Id)" class="modal modal-middle bg-black/85 backdrop-blur-md cursor-zoom-out" onclick="this.close()">
    <div class="relative max-w-4xl max-h-[85vh] flex flex-col items-center justify-center p-4 cursor-default animate-zoom-in" onclick="event.stopPropagation()">
        <button onclick="document.getElementById('lightbox_modal_@(sec.Id)').close()" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2 text-white bg-black/40 hover:bg-black/60 border-none z-10">✕</button>
        <img id="lightbox_image_@(sec.Id)" src="" class="max-w-full max-h-[75vh] rounded-xl shadow-2xl object-contain border border-white/10" />
        <p id="lightbox_label_@(sec.Id)" class="text-xs text-gray-200 mt-3 font-medium bg-black/40 px-3 py-1.5 rounded-full backdrop-blur-sm hidden"></p>
    </div>
</dialog>

<script>
    (function() {
        const secId = "@sec.Id";
        const isEdit = @(isEdit ? "true" : "false");
        const entityId = "@id";
        const project = "@currentProject";
        const apiEntity = "@apiEntity";

        window.showLightbox_@(sec.Id) = function(src, label = '') {
            const lightbox = document.getElementById('lightbox_modal_@(sec.Id)');
            const img = document.getElementById('lightbox_image_@(sec.Id)');
            const lbl = document.getElementById('lightbox_label_@(sec.Id)');
            if (lightbox && img) {
                img.src = src;
                if (label && label.trim() !== '') {
                    lbl.innerText = label;
                    lbl.classList.remove('hidden');
                } else {
                    lbl.innerText = '';
                    lbl.classList.add('hidden');
                }
                lightbox.showModal();
            }
        }

        window.selectMood_@(sec.Id) = function(name) {
            // Update input fields
            const inputMoodBefore = document.getElementById(`field-MoodBefore-${secId}`);
            if (inputMoodBefore) inputMoodBefore.value = name;
            const inputMood = document.getElementById(`field-Mood-${secId}`);
            if (inputMood) inputMood.value = name;

            // Update UI styles
            document.querySelectorAll(`.mood-option-${secId}`).forEach(btn => btn.classList.remove('active'));
            const activeBtn = document.getElementById(`mood-btn-${secId}-${name}`);
            if (activeBtn) activeBtn.classList.add('active');
        }

        window.selectWeather_@(sec.Id) = function(name) {
            const inputWeather = document.getElementById(`field-Weather-${secId}`);
            if (inputWeather) inputWeather.value = name;

            document.querySelectorAll(`.weather-option-${secId}`).forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white', 'border-none');
                btn.classList.add('btn-outline', 'border-gray-200');
            });
            const activeBtn = document.getElementById(`weather-btn-${secId}-${name}`);
            if (activeBtn) {
                activeBtn.classList.remove('btn-outline', 'border-gray-200');
                activeBtn.classList.add('bg-indigo-600', 'text-white', 'border-none');
            }
        }

        function mapWmoCodeToWeatherName(code) {
            // WMO Weather interpretation codes (WW)
            if (code === 0) return "晴朗";
            if (code === 1 || code === 2) return "多云";
            if (code === 3 || code === 45 || code === 48) return "阴天";
            if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82) || code >= 95) return "雨天";
            if ((code >= 71 && code <= 77) || code === 85 || code === 86) return "雪天";
            return "多云";
        }

        window.getGeolocation_@(sec.Id) = function(fieldName, btnEl) {
            const btn = btnEl || document.querySelector(`#field-${fieldName}-${secId} ~ button`);
            const originalText = btn ? btn.innerHTML : '📍 ' + `@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.geolocation_btn", "自动获取")))`;
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '⚡ ' + `@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.geolocation_detecting", "定位中...")))`;
            }

            if (!navigator.geolocation) {
                alert('您的浏览器不支持 Geolocation 定位。');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
                return;
            }

            navigator.geolocation.getCurrentPosition(
                async (position) => {
                    const lat = position.coords.latitude;
                    const lon = position.coords.longitude;
                    
                    // Fetch weather in parallel
                    try {
                        const weatherResponse = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true`);
                        if (weatherResponse.ok) {
                            const weatherData = await weatherResponse.json();
                            const wmoCode = weatherData.current_weather?.weathercode;
                            if (typeof wmoCode === 'number') {
                                const mappedWeather = mapWmoCodeToWeatherName(wmoCode);
                                selectWeather_@(sec.Id)(mappedWeather);
                            }
                        }
                    } catch (we) {
                        console.error('Weather fetch error:', we);
                    }

                    try {
                        // Reverse geocoding using OSM Nominatim API (open / free)
                        const response = await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json&accept-language=zh-CN`, {
                            headers: { 'User-Agent': 'NetYamlForge-App' }
                        });
                        
                        if (response.ok) {
                            const data = await response.json();
                            const address = data.address;
                            // Compose a readable city/district address
                            const city = address.city || address.town || address.municipality || '';
                            const suburb = address.suburb || address.village || '';
                            const road = address.road || '';
                            let formatted = [city, suburb, road].filter(Boolean).join(' · ');
                            if (!formatted) {
                                formatted = data.display_name || `${lat.toFixed(4)}, ${lon.toFixed(4)}`;
                            }
                            
                            const locationInput = document.getElementById(`field-${fieldName}-${secId}`);
                            if (locationInput) {
                                locationInput.value = formatted;
                            }
                        } else {
                            throw new Error('Reverse geocoding error');
                        }
                    } catch (e) {
                        console.error(e);
                        // Fallback to coordinates
                        const locationInput = document.getElementById(`field-${fieldName}-${secId}`);
                        if (locationInput) {
                            locationInput.value = `${lat.toFixed(5)}, ${lon.toFixed(5)}`;
                        }
                    } finally {
                        if (btn) {
                            btn.disabled = false;
                            btn.innerHTML = originalText;
                        }
                    }
                },
                (error) => {
                    console.error('Geolocation error:', error);
                    alert('获取定位失败，请手动录入。');
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = originalText;
                    }
                },
                { timeout: 10000 }
            );
        }

        // Auto-detect location and weather on enter page if it is not edit mode and fields are empty
        if (!isEdit) {
            const locField = document.getElementById(`field-Location-${secId}`) || document.getElementById(`field-Place-${secId}`);
            if (locField && !locField.value) {
                const fieldName = locField.name;
                setTimeout(() => {
                    window.getGeolocation_@(sec.Id)(fieldName);
                }, 300);
            }
        }

        window.handleImageUpload_@(sec.Id) = function(input) {
            const file = input.files[0];
            if (!file) return;

            if (!file.type.startsWith('image/')) {
                alert('请选择有效的图片文件。');
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    let width = img.width;
                    let height = img.height;

                    const MAX_EDGE = 800;
                    if (width > MAX_EDGE || height > MAX_EDGE) {
                        if (width > height) {
                            height = Math.round((height * MAX_EDGE) / width);
                            width = MAX_EDGE;
                        } else {
                            width = Math.round((width * MAX_EDGE) / height);
                            height = MAX_EDGE;
                        }
                    }

                    canvas.width = width;
                    canvas.height = height;

                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, width, height);

                    const compressedBase64 = canvas.toDataURL('image/jpeg', 0.7);

                    const hiddenInput = document.getElementById(`field-ImageBase64-${secId}`);
                    if (hiddenInput) {
                        hiddenInput.value = compressedBase64;
                    }

                    const previewImg = document.getElementById(`image-preview-${secId}`);
                    const promptDiv = document.getElementById(`image-upload-prompt-${secId}`);
                    const previewContainer = document.getElementById(`image-preview-container-${secId}`);
                    const zoneDiv = document.getElementById(`image-upload-zone-${secId}`);

                    if (previewImg && promptDiv && previewContainer) {
                        previewImg.src = compressedBase64;
                        promptDiv.classList.add('hidden');
                        previewContainer.classList.remove('hidden');
                        if (zoneDiv) {
                            zoneDiv.classList.remove('border-dashed', 'bg-indigo-50/10');
                            zoneDiv.classList.add('border-solid', 'border-indigo-300', 'bg-indigo-50/5');
                        }
                    }
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        window.clearSelectedImage_@(sec.Id) = function(event) {
            if (event) {
                event.stopPropagation();
            }
            
            const hiddenInput = document.getElementById(`field-ImageBase64-${secId}`);
            if (hiddenInput) hiddenInput.value = '';
            
            const fileUploader = document.getElementById(`file-uploader-${secId}`);
            if (fileUploader) fileUploader.value = '';

            const labelInput = document.getElementById(`field-ImageLabel-${secId}`);
            if (labelInput) labelInput.value = '';

            const previewImg = document.getElementById(`image-preview-${secId}`);
            const promptDiv = document.getElementById(`image-upload-prompt-${secId}`);
            const previewContainer = document.getElementById(`image-preview-container-${secId}`);
            const zoneDiv = document.getElementById(`image-upload-zone-${secId}`);

            if (previewImg && promptDiv && previewContainer) {
                previewImg.src = '';
                promptDiv.classList.remove('hidden');
                previewContainer.classList.add('hidden');
                if (zoneDiv) {
                    zoneDiv.classList.add('border-dashed', 'bg-indigo-50/10');
                    zoneDiv.classList.remove('border-solid', 'border-indigo-300', 'bg-indigo-50/5');
                }
            }
        }

        const zoneDiv = document.getElementById(`image-upload-zone-${secId}`);
        if (zoneDiv) {
            zoneDiv.addEventListener('dragover', (e) => {
                e.preventDefault();
                zoneDiv.classList.add('border-indigo-400', 'bg-indigo-50/20');
            });
            zoneDiv.addEventListener('dragleave', () => {
                zoneDiv.classList.remove('border-indigo-400', 'bg-indigo-50/20');
            });
            zoneDiv.addEventListener('drop', (e) => {
                e.preventDefault();
                zoneDiv.classList.remove('border-indigo-400', 'bg-indigo-50/20');
                const file = e.dataTransfer.files[0];
                if (file) {
                    const uploader = document.getElementById(`file-uploader-${secId}`);
                    if (uploader) {
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(file);
                        uploader.files = dataTransfer.files;
                        window.handleImageUpload_@(sec.Id)(uploader);
                    }
                }
            });
        }

        // Initial setup for Mood/Weather options if values already exist
        const moodVal = document.getElementById(`field-MoodBefore-${secId}`)?.value || document.getElementById(`field-Mood-${secId}`)?.value;
        if (moodVal) {
            selectMood_@(sec.Id)(moodVal);
        }
        const weatherVal = document.getElementById(`field-Weather-${secId}`)?.value;
        if (weatherVal) {
            selectWeather_@(sec.Id)(weatherVal);
        }

        // Initial setup for AiLanguage field
        const aiLangField = document.getElementById(`field-AiLanguage-${secId}`);
        if (aiLangField) {
            if (!isEdit || !aiLangField.value) {
                try {
                    const saved = localStorage.getItem('diary_preferences');
                    if (saved) {
                        const prefs = JSON.parse(saved);
                        if (prefs && prefs.aiLanguage) {
                            aiLangField.value = prefs.aiLanguage;
                        }
                    }
                } catch (e) {
                    console.error('Error loading preferred AI language', e);
                }
            }
        }

        // Cascading logic for AI Provider and AI Model
        const aiProviderField = document.getElementById(`field-AiProvider-${secId}`);
        const aiModelField = document.getElementById(`field-AiModel-${secId}`);
        if (aiProviderField && aiModelField) {
            const providerModelMap = {
                'antigravity': [
                    { value: 'Gemini 3.5 Flash (Medium)', label: 'Gemini 3.5 Flash (Medium)' },
                    { value: 'Gemini 3.5 Flash (High)', label: 'Gemini 3.5 Flash (High)' },
                    { value: 'Gemini 3.5 Flash (Low)', label: 'Gemini 3.5 Flash (Low)' },
                    { value: 'Gemini 3.1 Pro (Low)', label: 'Gemini 3.1 Pro (Low)' },
                    { value: 'Gemini 3.1 Pro (High)', label: 'Gemini 3.1 Pro (High)' },
                    { value: 'Claude Sonnet 4.6 (Thinking)', label: 'Claude Sonnet 4.6 (Thinking)' },
                    { value: 'Claude Opus 4.6 (Thinking)', label: 'Claude Opus 4.6 (Thinking)' },
                    { value: 'GPT-OSS 120B (Medium)', label: 'GPT-OSS 120B (Medium)' }
                ],
                'claude': [
                    { value: 'claude-sonnet-4-6', label: 'Claude Sonnet 4.6' },
                    { value: 'claude-opus-4-8', label: 'Claude Opus 4.8' },
                    { value: 'claude-haiku-4-5-20251001', label: 'Claude Haiku 4.5' }
                ],
                'opencode': [
                    { value: 'opencode/deepseek-v4-flash-free', label: 'DeepSeek V4 Flash (Free)' },
                    { value: 'opencode/mimo-v2.5-free', label: 'MiMo v2.5 (Free)' },
                    { value: 'opencode/nemotron-3-ultra-free', label: 'Nemotron 3 Ultra (Free)' },
                    { value: 'opencode/north-mini-code-free', label: 'North Mini Code (Free)' },
                    { value: 'opencode/big-pickle', label: 'Big Pickle' }
                ]
            };

            const initialModelVal = aiModelField.value;

            function updateModels() {
                const selectedProvider = aiProviderField.value;
                const models = providerModelMap[selectedProvider] || [];
                
                // Clear existing options except placeholder
                aiModelField.innerHTML = '';
                
                const hasPlaceholder = @(sec.GetFieldDef("AiModel")?.Required == true ? "false" : "true");
                if (hasPlaceholder || !selectedProvider) {
                    const placeholderOpt = document.createElement('option');
                    placeholderOpt.value = '';
                    placeholderOpt.textContent = '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.select_placeholder", "— 选择 —")))';
                    aiModelField.appendChild(placeholderOpt);
                }

                models.forEach(model => {
                    const opt = document.createElement('option');
                    opt.value = model.value;
                    opt.textContent = model.label;
                    aiModelField.appendChild(opt);
                });

                // Restore selection or pick first available if not found
                if (models.some(m => m.value === aiModelField.dataset.pendingValue)) {
                    aiModelField.value = aiModelField.dataset.pendingValue;
                } else if (models.some(m => m.value === initialModelVal)) {
                    aiModelField.value = initialModelVal;
                } else {
                    if (models.length > 0 && !hasPlaceholder) {
                        aiModelField.value = models[0].value;
                    } else {
                        aiModelField.value = '';
                    }
                }
                aiModelField.removeAttribute('data-pending-value');
            }

            const aiLevelField = document.getElementById(`field-AiLevel-${secId}`);
            const aiLevelContainer = document.getElementById(`container-field-AiLevel-${secId}`);
            const initialLevelVal = aiLevelField ? aiLevelField.value : '';

            function updateAiLevel() {
                if (!aiLevelField) return;
                const selectedProvider = aiProviderField ? aiProviderField.value : '';
                const selectedModel = aiModelField ? aiModelField.value : '';
                
                // AI Level is only visible and relevant when provider is 'opencode'
                if (selectedProvider !== 'opencode') {
                    if (aiLevelContainer) {
                        aiLevelContainer.classList.add('hidden');
                    }
                    aiLevelField.value = '';
                    return;
                }
                
                // Show container if provider is 'opencode'
                if (aiLevelContainer) {
                    aiLevelContainer.classList.remove('hidden');
                }
                
                // Define level options for opencode models
                const modelLevelMap = {
                    'opencode/deepseek-v4-flash-free': [
                        { value: 'Low', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_low", "Low (低级/快速)")))' },
                        { value: 'Medium', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_medium", "Medium (中级/标准)")))' },
                        { value: 'High', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_high", "High (高级/深入)")))' },
                        { value: 'Max', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_max", "Max (最大化/最慢)")))' }
                    ],
                    'opencode/mimo-v2.5-free': [
                        { value: 'Low', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_low", "Low (低级/快速)")))' },
                        { value: 'Medium', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_medium", "Medium (中级/标准)")))' },
                        { value: 'High', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_high", "High (高级/深入)")))' }
                    ],
                    'opencode/nemotron-3-ultra-free': [
                        { value: 'Low', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_low", "Low (低级/快速)")))' },
                        { value: 'Medium', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_medium", "Medium (中级/标准)")))' },
                        { value: 'High', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_high", "High (高级/深入)")))' }
                    ],
                    'opencode/north-mini-code-free': [
                        { value: 'Low', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_low", "Low (低级/快速)")))' },
                        { value: 'Medium', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_medium", "Medium (中级/标准)")))' },
                        { value: 'High', label: '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.level_high", "High (高级/深入)")))' }
                    ]
                };
                
                const levels = modelLevelMap[selectedModel] || [];
                
                aiLevelField.innerHTML = '';
                
                // Add Select/Placeholder option if not required
                const hasPlaceholder = @(sec.GetFieldDef("AiLevel")?.Required == true ? "false" : "true");
                if (hasPlaceholder) {
                    const placeholderOpt = document.createElement('option');
                    placeholderOpt.value = '';
                    placeholderOpt.textContent = '@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.select_placeholder", "— 选择 —")))';
                    aiLevelField.appendChild(placeholderOpt);
                }
                
                if (levels.length === 0) {
                    // If the model doesn't support variants, hide the level container
                    if (aiLevelContainer) {
                        aiLevelContainer.classList.add('hidden');
                    }
                    aiLevelField.value = '';
                    return;
                }
                
                levels.forEach(level => {
                    const opt = document.createElement('option');
                    opt.value = level.value;
                    opt.textContent = level.label;
                    aiLevelField.appendChild(opt);
                });
                
                // Restore initial selection if valid
                if (levels.some(l => l.value === aiLevelField.dataset.pendingValue)) {
                    aiLevelField.value = aiLevelField.dataset.pendingValue;
                } else if (levels.some(l => l.value === initialLevelVal)) {
                    aiLevelField.value = initialLevelVal;
                } else {
                    if (levels.length > 0 && !hasPlaceholder) {
                        aiLevelField.value = levels[0].value;
                    } else {
                        aiLevelField.value = '';
                    }
                }
                aiLevelField.removeAttribute('data-pending-value');
            }

            if (initialModelVal) {
                aiModelField.dataset.pendingValue = initialModelVal;
            }
            if (initialLevelVal) {
                aiLevelField.dataset.pendingValue = initialLevelVal;
            }

            aiProviderField.addEventListener('change', function() {
                updateModels();
                updateAiLevel();
            });
            aiModelField.addEventListener('change', updateAiLevel);

            updateModels();
            updateAiLevel();
        }

        // Initial setup for ImageBase64 preview if it already has value
        const imageBase64Val = document.getElementById(`field-ImageBase64-${secId}`)?.value;
        if (imageBase64Val && imageBase64Val.trim() !== '') {
            const previewImg = document.getElementById(`image-preview-${secId}`);
            const promptDiv = document.getElementById(`image-upload-prompt-${secId}`);
            const previewContainer = document.getElementById(`image-preview-container-${secId}`);
            const zoneDiv = document.getElementById(`image-upload-zone-${secId}`);
            
            if (previewImg && promptDiv && previewContainer) {
                previewImg.src = imageBase64Val;
                promptDiv.classList.add('hidden');
                previewContainer.classList.remove('hidden');
                if (zoneDiv) {
                    zoneDiv.classList.remove('border-dashed', 'bg-indigo-50/10');
                    zoneDiv.classList.add('border-solid', 'border-indigo-300', 'bg-indigo-50/5');
                }
            }
        }

        // Handle AJAX submit
        const formEl = document.getElementById(`interactive-form-${secId}`);
        formEl.addEventListener('submit', async function(e) {
            e.preventDefault();

            // Clear previous errors
            document.querySelectorAll(`[id^="err-"]`).forEach(el => {
                el.classList.add('hidden');
                el.innerText = '';
            });

            // Gather inputs
            const payload = {};
            const formData = new FormData(formEl);
            formData.forEach((value, key) => {
                if (key !== '__RequestVerificationToken') {
                    payload[key] = value;
                }
            });

            // If it is diary subproject or has content and mood/weather, customize loading mask
            if (apiEntity === 'diary_entry' || apiEntity.includes('diary')) {
                document.getElementById(`loading-title-${secId}`).innerText = `@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.ai_thinking", "心灵对话中...")))`;
                document.getElementById(`loading-desc-${secId}`).innerText = `@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.ai_thinking_desc", "AI 伴侣正在认真阅读你的日记，感知你此时的心情，并为你撰写暖心的寄语……请稍候。")))`;
            } else {
                document.getElementById(`loading-title-${secId}`).innerText = `@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.saving", "正在提交数据...")))`;
                document.getElementById(`loading-desc-${secId}`).innerText = `@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.form.saving_desc", "系统正在保存记录，请稍后。")))`;
            }

            // Show loading
            document.getElementById(`loading-overlay-${secId}`).classList.remove('hidden');

            const pathBase = "@Context.Request.PathBase";
            const url = isEdit 
                ? `${pathBase}/api/${project}/${apiEntity}/${entityId}`
                : `${pathBase}/api/${project}/${apiEntity}`;
            
            const method = isEdit ? 'PUT' : 'POST';

            try {
                const response = await fetch(url, {
                    method: method,
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify(payload)
                });

                if (response.ok) {
                    // Redirect back to home
                    window.location.href = "@cancelUrl";
                } else {
                    const data = await response.json();
                    document.getElementById(`loading-overlay-${secId}`).classList.add('hidden');
                    
                    if (data.errors) {
                        // Validation errors from ApiEntityController
                        for (const key in data.errors) {
                            const errEl = document.getElementById(`err-${key}-${secId}`);
                            if (errEl) {
                                errEl.innerText = data.errors[key].join(', ');
                                errEl.classList.remove('hidden');
                            }
                        }
                    } else {
                        alert(data.error || `@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.list.unknown_error", "保存失败，请检查填写内容。")))`);
                    }
                }
            } catch (err) {
                console.error(err);
                document.getElementById(`loading-overlay-${secId}`).classList.add('hidden');
                alert(`@Html.Raw(JavaScriptEncoder.Default.Encode(T("projects.diary-companion.views.list.unknown_error", "保存失败，发生网络错误，请稍后重试。")))`);
            }
        });
    })();
</script>
