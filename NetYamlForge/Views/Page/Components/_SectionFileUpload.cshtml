@using NetYamlForge.Models
@model SectionRenderModel
@{
    var sec = Model.Sec;
    var rows = Model.Rows;
    var uploadUrl = sec.UploadUrl ?? "/api/upload";
    var maxFileSize = sec.MaxFileSize ?? 10485760; // 10MB
    var allowedTypes = sec.AllowedTypes ?? "*";
    var multiple = sec.Multiple ?? true;
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <h2 class="text-lg font-semibold text-gray-700 mb-3">@sec.Title</h2>
}

<div class="file-upload-container bg-base-100 rounded shadow p-6">
    <div class="upload-zone border-2 border-dashed border-base-300 rounded-lg p-8 text-center hover:border-primary transition-colors cursor-pointer"
         onclick="document.getElementById('file-input-@sec.Id').click()">
        <div class="flex flex-col items-center">
            <svg class="w-16 h-16 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
            <p class="text-lg font-medium mb-2">ファイルをドラッグ＆ドロップ</p>
            <p class="text-sm text-gray-500 mb-4">またはクリックして選択</p>
            <p class="text-xs text-gray-400">最大 @(maxFileSize / 1024 / 1024)MB • @allowedTypes</p>
        </div>
        <input type="file" id="file-input-@sec.Id" class="hidden" 
               @(multiple ? "multiple" : "") 
               accept="@allowedTypes"
               onchange="handleFileSelect(this, '@sec.Id')" />
    </div>
    
    @* アップロード済みファイル一覧 *@
    @if (rows.Any())
    {
        <div class="file-list mt-6">
            <h4 class="font-medium mb-3">アップロード済みファイル (@rows.Count)</h4>
            <div class="divide-y">
                @foreach (var row in rows)
                {
                    var fileName = row.TryGetValue("FileName", out var fn) ? fn?.ToString() ?? "" : "";
                    var fileSize = row.TryGetValue("FileSize", out var fs) ? Convert.ToDouble(fs) : 0;
                    var uploadDate = row.TryGetValue("UploadDate", out var ud) ? ud?.ToString() ?? "" : "";
                    var fileUrl = row.TryGetValue("FileUrl", out var fu) ? fu?.ToString() ?? "" : "";
                    
                    <div class="flex items-center justify-between py-3">
                        <div class="flex items-center gap-3">
                            <div class="file-icon text-2xl">
                                @{
                                    var ext = System.IO.Path.GetExtension(fileName).ToLower();
                                    var icon = ext switch
                                    {
                                        ".pdf" => "📕",
                                        ".doc" or ".docx" => "📘",
                                        ".xls" or ".xlsx" => "📗",
                                        ".ppt" or ".pptx" => "📙",
                                        ".jpg" or ".jpeg" or ".png" or ".gif" => "🖼️",
                                        ".zip" or ".rar" => "📦",
                                        _ => "📄"
                                    };
                                }
                                @icon
                            </div>
                            <div>
                                <div class="font-medium">@fileName</div>
                                <div class="text-xs text-gray-500">@(fileSize / 1024).ToString("N1") KB • @uploadDate</div>
                            </div>
                        </div>
                        <div class="flex gap-2">
                            @if (!string.IsNullOrEmpty(fileUrl))
                            {
                                <a href="@fileUrl" target="_blank" class="btn btn-ghost btn-sm">ダウンロード</a>
                            }
                            <button class="btn btn-ghost btn-sm text-error" onclick="deleteFile('@sec.Id', '@fileName')">削除</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<script>
    function handleFileSelect(input, containerId) {
        var files = input.files;
        if (!files.length) return;
        
        // 簡易アップロード処理（実際には API エンドポイントへ送信）
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            console.log('Selected file:', file.name, file.size);
            // 実際のアップロード処理は Controller 側で実装
        }
    }
    
    function deleteFile(containerId, fileName) {
        if (confirm(fileName + ' を削除しますか？')) {
            console.log('Delete file:', fileName);
            // 実際の削除処理は API エンドポイントへ送信
        }
    }
</script>
