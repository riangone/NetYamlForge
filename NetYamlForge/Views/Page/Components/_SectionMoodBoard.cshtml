@using NetYamlForge.Models
@model NetYamlForge.Models.SectionRenderModel
@{
    var sec = Model.Sec;
    var rows = Model.Rows;
    var currentProject = Model.Project;

    // Helper to resolve localization
    string T(string key, string fallback) => I18nText.ResolveByKey(key) ?? fallback;

    // Helper for Emojis based on category name
    string GetCategoryEmoji(string? name) => name?.Trim() switch {
        "喜悦" => "🌸",
        "平静" => "🍃",
        "轻松" => "🍹",
        "期待" => "🌟",
        "狂喜" => "🎉",
        "欣慰" => "🥰",
        "专注" => "🎯",
        "治愈" => "🍀",
        "焦虑" => "🌪️",
        "忧郁" => "🌧️",
        "愤怒" => "⚡",
        "疲惫" => "💤",
        "委屈" => "🥺",
        "迷茫" => "🌀",
        "晴朗" => "☀️",
        "多云" => "⛅",
        "阴天" => "☁️",
        "雨天" => "🌧️",
        "雪天" => "❄️",
        "微风" => "🌬️",
        _ => "📊"
    };

    // Determine the columns for category and count
    string categoryCol = "MoodBefore";
    string countCol = "count";

    if (rows.Any())
    {
        var firstRow = rows.First();
        // Fallback to actual keys in row if expected keys are not present
        if (!firstRow.ContainsKey(categoryCol))
        {
            categoryCol = firstRow.Keys.FirstOrDefault(k => !k.Equals("count", StringComparison.OrdinalIgnoreCase) && !k.Equals("id", StringComparison.OrdinalIgnoreCase)) ?? firstRow.Keys.First();
        }
        if (!firstRow.ContainsKey(countCol))
        {
            countCol = firstRow.Keys.FirstOrDefault(k => k.Equals("count", StringComparison.OrdinalIgnoreCase) || k.Equals("total", StringComparison.OrdinalIgnoreCase) || k.Equals("count(*)", StringComparison.OrdinalIgnoreCase)) ?? firstRow.Keys.Last();
        }
    }

    // Calculate sum of counts
    int totalCount = 0;
    foreach (var r in rows)
    {
        if (r.TryGetValue(countCol, out var val) && val != null)
        {
            if (int.TryParse(val.ToString(), out var parsedInt))
            {
                totalCount += parsedInt;
            }
        }
    }
}

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }
</style>

<div class="space-y-6">
    <!-- Mood/Category Stats Card -->
    <div class="card glass-panel border border-white/60 shadow-sm rounded-2xl p-6 space-y-4">
        <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider">
            @(string.IsNullOrEmpty(sec.Title) ? T("projects.diary-companion.views.moodboard.category_stats", "📊 类别统计看板") : sec.Title)
        </h3>
        
        @if (rows.Any())
        {
            <div class="space-y-3 pt-2">
                @foreach (var row in rows)
                {
                    var rawCat = row.TryGetValue(categoryCol, out var cat) ? cat?.ToString() ?? "未知" : "未知";
                    var catStr = rawCat == "未知" ? T("projects.diary-companion.views.moodboard.unknown", "未知") : T($"projects.diary-companion.moods.{rawCat}.name", T($"projects.diary-companion.weathers.{rawCat}.name", rawCat));
                    var countVal = 0;
                    if (row.TryGetValue(countCol, out var cv) && cv != null)
                    {
                        int.TryParse(cv.ToString(), out countVal);
                    }
                    var percentage = totalCount > 0 ? (double)countVal / totalCount * 100 : 0;

                    <div class="space-y-1">
                        <div class="flex items-center justify-between text-xs font-semibold text-gray-700">
                            <span class="flex items-center gap-1.5">
                                <span class="text-sm">@GetCategoryEmoji(rawCat)</span>
                                <span>@catStr</span>
                            </span>
                            <span class="text-gray-500">@Html.Raw(string.Format(T("projects.diary-companion.views.moodboard.entries_format", "{0} 笔"), countVal)) (@Math.Round(percentage, 0)%)</span>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-2 overflow-hidden">
                            <div class="bg-indigo-500 h-2 rounded-full transition-all duration-500" style="width: @percentage%"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-6 text-xs text-gray-400 space-y-1">
                <div>☁️</div>
                <div>@T("projects.diary-companion.views.moodboard.no_stats", "暂无统计数据，请先添加记录")</div>
            </div>
        }
    </div>

    <!-- Description / Helpful Tips Banner if set in YAML -->
    @if (!string.IsNullOrEmpty(sec.Description))
    {
        <div class="card bg-gradient-to-br from-indigo-500 to-purple-600 text-white rounded-2xl p-6 shadow-sm relative overflow-hidden">
            <div class="absolute -right-12 -bottom-12 w-32 h-32 bg-white/10 rounded-full blur-xl"></div>
            <div class="relative space-y-3">
                <div class="text-xl">💡</div>
                <h4 class="font-bold text-base">@T("projects.diary-companion.views.moodboard.tips", "温馨提示")</h4>
                <p class="text-xs text-indigo-100 leading-relaxed">
                    @sec.Description
                </p>
            </div>
        </div>
    }
</div>
