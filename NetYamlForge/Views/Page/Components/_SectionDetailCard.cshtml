@using NetYamlForge.Models
@model SectionRenderModel
@{
    var sec  = Model.Sec;
    var rows = Model.Rows;
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <h2 class="text-lg font-semibold text-gray-700 mb-3">@sec.Title</h2>
}
@foreach (var row in rows)
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-4">
        <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-4">
            @foreach (var col in sec.Columns.Keys)
            {
                var val = row.TryGetValue(col, out var v) ? v?.ToString() ?? "" : "";
                <div>
                    <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide">@col</dt>
                    <dd class="mt-1 text-sm text-gray-800 font-medium break-words">
                        @if (string.IsNullOrEmpty(val))
                        {
                            <span class="text-gray-300">—</span>
                        }
                        else
                        {
                            @val
                        }
                    </dd>
                </div>
            }
        </dl>
    </div>
}
@if (!rows.Any())
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center text-gray-400">
        No record found
    </div>
}
