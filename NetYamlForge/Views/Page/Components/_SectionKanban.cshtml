@using NetYamlForge.Models
@model SectionRenderModel
@{
    var sec = Model.Sec;
    var rows = Model.Rows;
    var groupBy = sec.GroupBy ?? (sec.GetColumnAt(0));
    var cardTitle = sec.CardTitle ?? (sec.GetColumnAt(1));
    var cardSub = sec.CardSubtitle;

    var canEdit = sec.Editable && !sec.ReadOnly && !string.IsNullOrEmpty(sec.TargetTable);
    var pkCol = sec.TargetPrimaryKey ?? "id";

    // グループ化
    var groups = rows
        .GroupBy(r => r.TryGetValue(groupBy, out var v) ? v?.ToString() ?? "—" : "—")
        .OrderBy(g => g.Key)
        .ToList();

    var allGroupKeys = groups.Select(g => g.Key).Where(k => k != "—").ToList();

    // ステータス別カラー（DaisyUI バッジ色）
    static string StatusBadge(string status) => status.ToLowerInvariant() switch
    {
        "done" or "completed" or "closed" or "shipped" => "badge-success",
        "in_progress" or "inprogress" or "active" or "doing" => "badge-info",
        "todo" or "new" or "pending" or "backlog" => "badge-ghost",
        "blocked" or "cancelled" or "error" => "badge-error",
        "review" or "testing" => "badge-warning",
        _ => "badge-neutral"
    };

    var updateUrl = Url.Content($"~/{Model.Project}/Page/{Model.PageName}/section/{sec.Id}/update-row");
    var deleteUrl = Url.Content($"~/{Model.Project}/Page/{Model.PageName}/section/{sec.Id}/delete-row");
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <div class="flex items-center justify-between mb-3">
        <h2 class="text-xl font-black text-base-content flex items-center gap-2">
            <span>📋 @sec.Title</span>
            <span class="badge badge-sm badge-neutral font-mono font-normal">@rows.Count 项</span>
        </h2>
        @if (!string.IsNullOrEmpty(sec.Description))
        {
            <p class="text-xs text-base-content/60">@sec.Description</p>
        }
    </div>
}

<div class="overflow-x-auto no-scrollbar touch-pan-x pb-4">
    <div class="flex gap-4 min-w-max items-start">
        @foreach (var group in groups)
        {
            var badgeClass = StatusBadge(group.Key);
            <div class="w-[82vw] sm:w-72 2xl:w-80 flex-shrink-0 bg-base-200/60 rounded-2xl p-3.5 border border-base-300/60 flex flex-col shadow-sm">
                <div class="flex items-center justify-between mb-3 px-1">
                    <div class="flex items-center gap-2">
                        <span class="badge @badgeClass badge-sm font-bold">@group.Key</span>
                        <span class="text-xs text-base-content/60 font-mono font-semibold">(@group.Count())</span>
                    </div>
                </div>

                <div class="space-y-3">
                    @foreach (var row in group)
                    {
                        var title = !string.IsNullOrEmpty(cardTitle) && row.TryGetValue(cardTitle, out var tv)
                            ? tv?.ToString() ?? "" : "";
                        var sub = !string.IsNullOrEmpty(cardSub) && row.TryGetValue(cardSub, out var sv)
                            ? sv?.ToString() ?? "" : "";

                        string? rowId = null;
                        var idKey = row.Keys.FirstOrDefault(k => k.Equals(pkCol, StringComparison.OrdinalIgnoreCase));
                        if (idKey != null) rowId = row[idKey]?.ToString();

                        <div class="card bg-base-100 shadow-sm border border-base-200 hover:border-primary/40 hover:shadow-md transition-all rounded-xl overflow-hidden">
                            <div class="card-body p-3.5">
                                <p class="font-bold text-sm text-base-content leading-snug">@title</p>
                                @if (!string.IsNullOrEmpty(sub))
                                {
                                    <p class="text-xs text-base-content/70 mt-1 leading-relaxed">@sub</p>
                                }

                                @* 残りのフィールドをタグ表示 *@
                                @{
                                    var extraFields = sec.Columns.Keys
                                        .Where(c => !string.Equals(c, groupBy, StringComparison.OrdinalIgnoreCase) && 
                                                    !string.Equals(c, cardTitle, StringComparison.OrdinalIgnoreCase) && 
                                                    !string.Equals(c, cardSub, StringComparison.OrdinalIgnoreCase) &&
                                                    !string.Equals(c, pkCol, StringComparison.OrdinalIgnoreCase))
                                        .ToList();
                                }
                                @if (extraFields.Any())
                                {
                                    <div class="flex flex-wrap gap-1 mt-2.5 pt-2 border-t border-base-200/60">
                                        @foreach (var ef in extraFields)
                                        {
                                            var efVal = row.TryGetValue(ef, out var ev) ? ev?.ToString() ?? "" : "";
                                            if (!string.IsNullOrEmpty(efVal))
                                            {
                                                <span class="badge badge-ghost badge-xs font-mono">@efVal</span>
                                            }
                                        }
                                    </div>
                                }

                                @if (canEdit && !string.IsNullOrEmpty(rowId))
                                {
                                    <div class="flex items-center justify-between gap-1 mt-3 pt-2 border-t border-base-200">
                                        <div class="text-[10px] text-base-content/40 font-mono">#@rowId</div>
                                        <div class="flex items-center gap-1">
                                            <!-- 快速状态流转下拉 -->
                                            <div class="dropdown dropdown-end">
                                                <label tabindex="0" class="btn btn-ghost btn-xs text-[11px] gap-1 px-1.5 h-6 min-h-0 text-primary font-medium hover:bg-primary/10">
                                                    <span>流转 ➔</span>
                                                </label>
                                                <ul tabindex="0" class="dropdown-content z-[10] menu p-1.5 shadow-lg bg-base-100 rounded-box w-36 border border-base-200 text-xs">
                                                    <li class="menu-title px-2 py-1 text-[10px] uppercase font-bold text-base-content/50">移动到阶段</li>
                                                    @foreach (var targetKey in allGroupKeys)
                                                    {
                                                        if (targetKey != group.Key)
                                                        {
                                                            <li>
                                                                <button type="button" 
                                                                        onclick="nyfKanbanMove('@updateUrl', '@rowId', '@groupBy', '@targetKey')"
                                                                        class="text-left font-medium">
                                                                    <span>@targetKey</span>
                                                                </button>
                                                            </li>
                                                        }
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (!group.Any())
                    {
                        <div class="text-xs text-base-content/40 text-center py-6 border border-dashed border-base-300 rounded-xl bg-base-100/40">
                            暂无任务卡片
                        </div>
                    }
                </div>
            </div>
        }

        @if (!groups.Any())
        {
            <div class="text-base-content/40 py-8 italic">暂无可呈现的看板数据</div>
        }
    </div>
</div>

<script>
if (typeof nyfKanbanMove === 'undefined') {
    window.nyfKanbanMove = function(endpoint, rowId, field, value) {
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        var fd = new FormData();
        fd.append('rowId', rowId);
        fd.append('field', field);
        fd.append('value', value);
        if (token) fd.append('__RequestVerificationToken', token);

        fetch(endpoint, {
            method: 'POST',
            body: fd
        }).then(function(res) {
            if (res.ok) {
                window.location.reload();
            } else {
                res.text().then(function(msg) {
                    alert('状态更新失败: ' + (msg || res.statusText));
                });
            }
        }).catch(function(err) {
            alert('网络请求异常: ' + err.message);
        });
    };
}
</script>
