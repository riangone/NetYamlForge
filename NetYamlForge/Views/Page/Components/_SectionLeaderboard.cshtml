@using NetYamlForge.Models
@model SectionRenderModel
@{
    var sec = Model.Sec;
    var rows = Model.Rows;
    var nameField = sec.NameField ?? (sec.GetColumnAt(0));
    var valueField = sec.ValueField ?? (sec.GetColumnAt(1));
    var avatarField = sec.AvatarField;
    var trendField = sec.TrendField;
    var maxVal = rows.Max(r => r.TryGetValue(valueField, out var v) ? Convert.ToDouble(v) : 0);
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <h2 class="text-lg font-semibold text-gray-700 mb-3">@sec.Title</h2>
}

<div class="leaderboard-container bg-base-100 rounded shadow">
    @if (rows.Any())
    {
        <div class="overflow-x-auto">
            <table class="table w-full">
                <thead>
                    <tr class="bg-base-200">
                        <th class="w-16 text-center">Rank</th>
                        <th>Name</th>
                        <th class="text-right">Value</th>
                        <th class="w-32">Progress</th>
                        @if (!string.IsNullOrEmpty(trendField))
                        {
                            <th class="w-24">Trend</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        var row = rows[i];
                        var name = row.TryGetValue(nameField, out var n) ? n?.ToString() ?? "" : "";
                        var value = row.TryGetValue(valueField, out var v) ? Convert.ToDouble(v) : 0;
                        var avatar = !string.IsNullOrEmpty(avatarField) && row.TryGetValue(avatarField, out var av) ? av?.ToString() ?? "" : "";
                        var trend = !string.IsNullOrEmpty(trendField) && row.TryGetValue(trendField, out var tr) ? tr?.ToString() ?? "" : "";
                        var percent = maxVal > 0 ? (value / maxVal * 100) : 0;
                        var rank = i + 1;
                        
                        <tr class="hover:bg-base-200 @(rank <= 3 ? "bg-primary/5" : "")">
                            <td class="text-center">
                                @if (rank == 1)
                                {
                                    <span class="text-2xl">🥇</span>
                                }
                                else if (rank == 2)
                                {
                                    <span class="text-2xl">🥈</span>
                                }
                                else if (rank == 3)
                                {
                                    <span class="text-2xl">🥉</span>
                                }
                                else
                                {
                                    <span class="font-bold text-gray-500">#@rank</span>
                                }
                            </td>
                            <td>
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(avatar))
                                    {
                                        <div class="avatar">
                                            <div class="mask mask-circle w-10 h-10">
                                                <img src="@avatar" alt="@name" />
                                            </div>
                                        </div>
                                    }
                                    <span class="font-medium">@name</span>
                                </div>
                            </td>
                            <td class="text-right font-bold">@value.ToString("N0")</td>
                            <td>
                                <div class="w-full bg-base-300 rounded-full h-2.5">
                                    <div class="bg-@(rank == 1 ? "primary" : rank == 2 ? "secondary" : rank == 3 ? "accent" : "info") h-2.5 rounded-full"
                                         style="width: @percent%"></div>
                                </div>
                            </td>
                            @if (!string.IsNullOrEmpty(trendField))
                            {
                                <td>
                                    @if (!string.IsNullOrEmpty(trend))
                                    {
                                        var isUp = trend.StartsWith("+");
                                        <span class="badge badge-@(isUp ? "success" : "error") badge-sm">
                                            @trend
                                        </span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center text-gray-400 py-8">No data available</div>
    }
</div>
