@using NetYamlForge.Models
@using NetYamlForge.Services.Common
@model SectionRenderModel
@{
    var sec = Model.Sec;
    var rows = Model.Rows;
    var titleField = sec.TitleField;
    var subtitleField = sec.SubtitleField;
    var dateField = sec.DateField;
    var contentField = sec.ContentField ?? (sec.GetColumnAt(0));
    var classAttr = sec.Class ?? "";
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <div class="flex items-center justify-between mb-4">
        <div>
            <h2 class="text-xl font-black text-base-content flex items-center gap-2">
                <span>📖 @sec.Title</span>
                <span class="badge badge-sm badge-neutral font-mono font-normal">@rows.Count 篇</span>
            </h2>
            @if (!string.IsNullOrEmpty(sec.Description))
            {
                <p class="text-xs text-base-content/60 mt-0.5">@sec.Description</p>
            }
        </div>
    </div>
}

@if (!rows.Any())
{
    <div class="rounded-2xl border border-dashed border-base-300 p-8 text-center text-base-content/50 bg-base-100">
        <div class="text-2xl mb-1">📝</div>
        <div class="text-sm font-medium">@(sec.EmptyMessage ?? "暂无文章或文档内容")</div>
    </div>
}
else
{
    <div class="space-y-6 @classAttr">
        @foreach (var row in rows)
        {
            var rawContent = !string.IsNullOrEmpty(contentField) && row.TryGetValue(contentField, out var cv)
                ? cv?.ToString() ?? ""
                : "";
            var title = !string.IsNullOrEmpty(titleField) && row.TryGetValue(titleField, out var tv)
                ? tv?.ToString()
                : null;
            var subtitle = !string.IsNullOrEmpty(subtitleField) && row.TryGetValue(subtitleField, out var sv)
                ? sv?.ToString()
                : null;
            var dateVal = !string.IsNullOrEmpty(dateField) && row.TryGetValue(dateField, out var dv)
                ? dv?.ToString()
                : null;

            <article class="card bg-base-100 shadow-sm border border-base-200/90 rounded-2xl overflow-hidden hover:border-primary/40 transition-all">
                <div class="card-body p-4 sm:p-6 md:p-8">
                    @if (!string.IsNullOrWhiteSpace(title) || !string.IsNullOrWhiteSpace(subtitle) || !string.IsNullOrWhiteSpace(dateVal))
                    {
                        <header class="mb-4 pb-3 border-b border-base-200/80">
                            <div class="flex flex-wrap items-center gap-2 mb-2">
                                @if (!string.IsNullOrWhiteSpace(subtitle))
                                {
                                    <span class="badge badge-primary badge-outline text-xs font-semibold">@subtitle</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(dateVal))
                                {
                                    <span class="text-xs text-base-content/50 font-mono">📅 @dateVal</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(title))
                            {
                                <h3 class="text-lg sm:text-xl md:text-2xl font-black text-base-content tracking-tight">@title</h3>
                            }
                        </header>
                    }

                    <div class="markdown-body text-sm text-base-content/90 leading-relaxed overflow-x-auto touch-pan-x" data-markdown="@rawContent">
                        @Html.Raw(MarkdownRenderHelper.Render(rawContent))
                    </div>
                </div>
            </article>
        }
    </div>
}
