@using NetYamlForge.Models
@model SectionRenderModel
@{
    var sec  = Model.Sec;
    var rows = Model.Rows;
    var contentField = sec.ContentField ?? (sec.GetColumnAt(0));
    var classAttr = sec.Class ?? "";
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <h2 class="text-lg font-semibold text-gray-700 mb-3">@sec.Title</h2>
}
@foreach (var row in rows)
{
    var rawContent = !string.IsNullOrEmpty(contentField) && row.TryGetValue(contentField, out var val)
        ? val?.ToString() ?? ""
        : "";
    <div class="markdown-section @classAttr" data-markdown="@rawContent"></div>
}
@if (!rows.Any())
{
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center text-gray-400">
        No data
    </div>
}