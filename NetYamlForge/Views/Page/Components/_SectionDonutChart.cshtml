@using NetYamlForge.Models
@model SectionRenderModel
@{
    var sec = Model.Sec;
    var rows = Model.Rows;
    var labelField = sec.LabelField ?? (sec.GetColumnAt(0));
    var valueField = sec.ValueField ?? (sec.GetColumnAt(1));
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <h2 class="text-lg font-semibold text-gray-700 mb-3">@sec.Title</h2>
}

<div class="donut-chart-container bg-base-100 p-4 rounded shadow">
    @if (rows.Any())
    {
        var total = rows.Sum(r => r.TryGetValue(valueField, out var v) ? Convert.ToDouble(v) : 0);
        var colors = new[] { "primary", "secondary", "accent", "info", "success", "warning", "error" };
        var colorIdx = 0;
        var cumulativePercent = 0.0;
        
        <div class="flex flex-col lg:flex-row gap-6 items-center">
            @* ドーナツチャート *@
            <div class="relative w-48 h-48">
                <svg viewBox="0 0 100 100" class="w-full h-full -rotate-90">
                    @foreach (var row in rows)
                    {
                        var value = row.TryGetValue(valueField, out var v) ? Convert.ToDouble(v) : 0;
                        var percent = total > 0 ? (value / total * 100) : 0;
                        var strokeDasharray = $"{percent:F2} {100 - percent:F2}";
                        var strokeDashoffset = -(int)cumulativePercent;
                        cumulativePercent += percent;
                        
                        <circle cx="50" cy="50" r="40" fill="none" 
                                stroke="var(--fallback-@colors[colorIdx % colors.Length])" 
                                stroke-width="20"
                                stroke-dasharray="@strokeDasharray"
                                stroke-dashoffset="@strokeDashoffset"
                                class="transition-all duration-300 hover:opacity-80" />
                        colorIdx++;
                    }
                </svg>
                <div class="absolute inset-0 flex items-center justify-center">
                    <div class="text-center">
                        <div class="text-2xl font-bold">@total.ToString("N0")</div>
                        <div class="text-xs text-gray-500">Total</div>
                    </div>
                </div>
            </div>
            
            @* 凡例 *@
            <div class="flex-1">
                @{
                    colorIdx = 0;
                    cumulativePercent = 0;
                }
                @foreach (var row in rows)
                {
                    var label = row.TryGetValue(labelField, out var l) ? l?.ToString() ?? "" : "";
                    var value = row.TryGetValue(valueField, out var v) ? Convert.ToDouble(v) : 0;
                    var percent = total > 0 ? (value / total * 100) : 0;
                    
                    <div class="flex items-center gap-2 mb-2">
                        <div class="w-4 h-4 rounded bg-@colors[colorIdx % colors.Length]"></div>
                        <span class="flex-1 text-sm">@label</span>
                        <span class="text-sm font-medium">@value.ToString("N0") (@percent.ToString("F1")%)</span>
                    </div>
                    colorIdx++;
                }
            </div>
        </div>
    }
    else
    {
        <div class="text-center text-gray-400 py-8">No data available</div>
    }
</div>
