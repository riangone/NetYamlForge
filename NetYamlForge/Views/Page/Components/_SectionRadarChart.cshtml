@using NetYamlForge.Models
@using System.Text.Json
@model SectionRenderModel
@{
    var sec        = Model.Sec;
    var rows       = Model.Rows;
    var labelField = sec.LabelField ?? sec.XField ?? (sec.GetColumnAt(0));
    // YField: カンマ区切りで複数系列 "alice,bob,carol" または単一値フィールド
    var yFields    = (sec.YField ?? string.Join(",", sec.Columns.Skip(1)))
                        .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
    var chartId    = $"chart-radar-{sec.Id}";

    // ラベル（軸ラベル）= labelField の値一覧
    var axisLabels = rows.Select(r => r.TryGetValue(labelField, out var v) ? v?.ToString() ?? "" : "").ToList();
    var axisJson   = JsonSerializer.Serialize(axisLabels);

    string[] palette = [
        "rgba(99,102,241,0.25)",  "rgba(34,197,94,0.25)",  "rgba(251,146,60,0.25)",
        "rgba(236,72,153,0.25)",  "rgba(14,165,233,0.25)", "rgba(168,85,247,0.25)"
    ];
    string[] borderPalette = [
        "rgba(99,102,241,1)",  "rgba(34,197,94,1)",  "rgba(251,146,60,1)",
        "rgba(236,72,153,1)",  "rgba(14,165,233,1)", "rgba(168,85,247,1)"
    ];

    // データセット: 各 yField が1系列（行ごとのデータではなく、列ごとに系列）
    var datasets = yFields.Select((yf, i) =>
    {
        var vals = rows.Select(r =>
        {
            if (!r.TryGetValue(yf, out var v) || v == null) return 0.0;
            return double.TryParse(v.ToString(), System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0.0;
        }).ToList();
        return new
        {
            label = yf,
            data  = JsonSerializer.Serialize(vals),
            bg    = palette[i % palette.Length],
            border= borderPalette[i % borderPalette.Length]
        };
    }).ToList();
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <h2 class="text-lg font-semibold text-gray-700 mb-3">@sec.Title</h2>
}
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
    <div class="flex flex-col md:flex-row gap-6 items-center">
        <div style="position:relative;height:320px;width:320px;flex-shrink:0;">
            <canvas id="@chartId"></canvas>
        </div>
        @if (datasets.Count > 1)
        {
            <div class="flex-1">
                <table class="text-sm w-full">
                    <thead>
                        <tr class="border-b border-gray-100">
                            <th class="text-left py-1 pr-4 font-medium text-gray-500">@labelField</th>
                            @foreach (var ds in datasets)
                            {
                                <th class="text-right py-1 px-2 font-medium text-gray-500">@ds.label</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int ri = 0; ri < rows.Count; ri++)
                        {
                            var row = rows[ri];
                            var lbl = row.TryGetValue(labelField, out var lv) ? lv?.ToString() ?? "" : "";
                            <tr class="border-b border-gray-50">
                                <td class="py-1 pr-4">@lbl</td>
                                @foreach (var yf in yFields)
                                {
                                    var val = row.TryGetValue(yf, out var vv) ? vv?.ToString() ?? "" : "";
                                    <td class="py-1 px-2 text-right font-mono">@val</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<script>
(function() {
    function initChart() {
        if (typeof Chart === 'undefined') { setTimeout(initChart, 100); return; }
        var ctx = document.getElementById('@chartId');
        if (!ctx) return;
        new Chart(ctx, {
            type: 'radar',
            data: {
                labels: @Html.Raw(axisJson),
                datasets: [
                    @foreach (var ds in datasets)
                    {
                        <text>
                        {
                            label: '@ds.label',
                            data: @Html.Raw(ds.data),
                            backgroundColor: '@ds.bg',
                            borderColor: '@ds.border',
                            borderWidth: 2,
                            pointRadius: 3,
                            pointBackgroundColor: '@ds.border'
                        },
                        </text>
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        beginAtZero: true,
                        ticks: { stepSize: 20 },
                        pointLabels: { font: { size: 12 } }
                    }
                },
                plugins: {
                    legend: {
                        display: @(datasets.Count > 1 ? "true" : "false"),
                        position: 'bottom',
                        labels: { boxWidth: 12, padding: 10 }
                    }
                }
            }
        });
    }
    initChart();
})();
</script>
