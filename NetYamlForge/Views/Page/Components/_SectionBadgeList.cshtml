@using NetYamlForge.Models
@model SectionRenderModel
@{
    var sec        = Model.Sec;
    var rows       = Model.Rows;
    var labelField = sec.LabelField  ?? (sec.GetColumnAt(0));
    var valueField = sec.ValueField  ?? (sec.GetColumnAt(1));
    var colorField = sec.SubValueField; // color/type 判定フィールド

    // 値またはカラーフィールドからバッジ色を決定
    static string BadgeColor(string? val) => (val ?? "").ToLowerInvariant() switch
    {
        "high" or "error" or "critical" or "urgent" or "red"    => "badge-error",
        "medium" or "warning" or "warn" or "orange" or "yellow" => "badge-warning",
        "low" or "info" or "blue"                                => "badge-info",
        "done" or "success" or "active" or "green"              => "badge-success",
        "draft" or "pending" or "gray" or "grey"                 => "badge-ghost",
        _ => "badge-neutral"
    };
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <h2 class="text-lg font-semibold text-gray-700 mb-3">@sec.Title</h2>
}
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
    <div class="flex flex-wrap gap-2">
        @foreach (var row in rows)
        {
            var label    = !string.IsNullOrEmpty(labelField) && row.TryGetValue(labelField, out var lv) ? lv?.ToString() ?? "" : "";
            var value    = !string.IsNullOrEmpty(valueField) && row.TryGetValue(valueField, out var vv) ? vv?.ToString() ?? "" : "";
            var colorKey = !string.IsNullOrEmpty(colorField) && row.TryGetValue(colorField, out var cv) ? cv?.ToString() : value;
            var badgeCls = BadgeColor(colorKey);

            <div class="badge @badgeCls badge-lg gap-2 py-3 px-4">
                <span class="font-medium">@label</span>
                @if (!string.IsNullOrEmpty(value) && value != label)
                {
                    <span class="opacity-70 text-xs">@value</span>
                }
            </div>
        }
        @if (!rows.Any())
        {
            <span class="text-gray-400">No data</span>
        }
    </div>

    @* テーブル形式でも表示 *@
    @if (rows.Any() && sec.Columns.Count > 2)
    {
        <div class="overflow-x-auto mt-5 border-t border-gray-100 pt-4">
            <table class="min-w-full text-sm divide-y divide-gray-100">
                <thead class="bg-gray-50">
                    <tr>
                        @foreach (var col in sec.Columns.Keys)
                        {
                            <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase">@col</th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @foreach (var row in rows)
                    {
                        <tr class="hover:bg-gray-50">
                            @foreach (var col in sec.Columns.Keys)
                            {
                                var val = row.TryGetValue(col, out var v) ? v?.ToString() ?? "" : "";
                                <td class="px-3 py-2 text-gray-700">@val</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
