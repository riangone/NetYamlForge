@using NetYamlForge.Models
@using System.Text.Encodings.Web
@using NetYamlForge.Localization
@model NetYamlForge.Models.SectionRenderModel
@{
    var sec = Model.Sec;
    var rows = Model.Rows;
    var currentProject = Model.Project;

    // Helper to resolve localization
    string T(string key, string fallback) => I18nText.ResolveByKey(key) ?? fallback;

    // Helper to convert PascalCase to snake_case for API route resolution
    string ToSnakeCase(string? input) {
        if (string.IsNullOrEmpty(input)) return "";
        return string.Concat(input.Select((x, i) => i > 0 && char.IsUpper(x) ? "_" + x.ToString() : x.ToString())).ToLower();
    }

    // Emojis mapping helpers
    string GetMoodEmoji(string? mood) => mood?.Trim() switch {
        "喜悦" => "🌸",
        "平静" => "🍃",
        "轻松" => "🍹",
        "期待" => "🌟",
        "狂喜" => "🎉",
        "欣慰" => "🥰",
        "专注" => "🎯",
        "治愈" => "🍀",
        "焦虑" => "🌪️",
        "忧郁" => "🌧️",
        "愤怒" => "⚡",
        "疲惫" => "💤",
        "委屈" => "🥺",
        "迷茫" => "🌀",
        _ => "📝"
    };

    string GetWeatherEmoji(string? weather) => weather?.Trim() switch {
        "晴朗" => "☀️",
        "多云" => "⛅",
        "阴天" => "☁️",
        "雨天" => "🌧️",
        "雪天" => "❄️",
        "微风" => "🌬️",
        _ => "🌡️"
    };

    (string text, string badgeClass, string borderClass, string bgClass) GetSentimentStyle(string? sentiment) => sentiment?.Trim() switch {
        "积极" or "Positive" or "ポジティブ" => (T("projects.diary-companion.sentiment.positive", "充满阳光"), "bg-emerald-100 text-emerald-800 border-emerald-300", "border-emerald-200", "bg-emerald-50/50"),
        "消极" or "Negative" or "ネガティブ" => (T("projects.diary-companion.sentiment.negative", "雨过天晴"), "bg-rose-100 text-rose-800 border-rose-300", "border-rose-200", "bg-rose-50/50"),
        "平和" or "Neutral" or "ニュートラル" => (T("projects.diary-companion.sentiment.neutral", "风平浪静"), "bg-sky-100 text-sky-800 border-sky-300", "border-sky-200", "bg-sky-50/50"),
        _ => (sentiment ?? T("projects.diary-companion.sentiment.unknown", "未知情绪"), "bg-gray-100 text-gray-800 border-gray-300", "border-gray-200", "bg-gray-50/50")
    };

    // Helper to find column keys case-insensitively
    string? FindKey(Dictionary<string, object> row, params string[] possibleKeys) {
        foreach (var pk in possibleKeys) {
            var found = row.Keys.FirstOrDefault(k => k.Equals(pk, StringComparison.OrdinalIgnoreCase));
            if (found != null) return found;
        }
        return null;
    }

    // Default Edit Page resolution (convention or custom action)
    var editPageName = "DiaryForm"; // Default fallback
    var rawEntity = sec.TargetTable ?? sec.Source ?? sec.Id;
    var apiEntity = ToSnakeCase(rawEntity);
    if (sec.Actions != null && sec.Actions.Any()) {
        // If there's an action configured, we can extract URL pattern or handle it
    }

    // Pagination parameters
    var qParams = Context.Request.Query.ToDictionary(k => k.Key, v => v.Value.ToString(), StringComparer.OrdinalIgnoreCase);
    var pageKey = $"{sec.Id}__page";
    var psSizeKey = $"{sec.Id}__pagesize";
    var effectivePageSize = sec.GetEffectivePageSize();
    var currentPageSize = qParams.TryGetValue(psSizeKey, out var psStr2) &&
                          int.TryParse(psStr2, out var psVal2) && psVal2 > 0
        ? psVal2 : effectivePageSize;
    var currentPage = qParams.TryGetValue(pageKey, out var pgStr) && int.TryParse(pgStr, out var pg)
        ? Math.Max(1, pg) : 1;
    var totalPages = currentPageSize > 0 && Model.Total > currentPageSize
        ? (int)Math.Ceiling(Model.Total / (double)currentPageSize) : 1;

    string BuildPageUrl(int pageNum)
    {
        var q = new Dictionary<string, string>(qParams, StringComparer.OrdinalIgnoreCase);
        if (pageNum <= 1) q.Remove(pageKey);
        else q[pageKey] = pageNum.ToString();
        
        if (currentPageSize != effectivePageSize) q[psSizeKey] = currentPageSize.ToString();
        else q.Remove(psSizeKey);
        
        var baseUrl = Context.Request.Path.Value ?? "/";
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(baseUrl, q.ToDictionary(kv => kv.Key, kv => (string?)kv.Value));
    }
}

<style>
    .diary-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .diary-card:hover {
        transform: translateY(-4px) scale(1.01);
        box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.08);
    }
    .glass-panel {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }
    @@keyframes zoomIn {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
    .animate-zoom-in {
        animation: zoomIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
            📂 @(string.IsNullOrEmpty(sec.Title) ? T("projects.diary-companion.views.form.back_to_list", "内容列表") : sec.Title) 
            <span class="badge badge-sm badge-ghost border-gray-300">@Html.Raw(string.Format(T("projects.diary-companion.views.list.total_entries", "共 {0} 篇"), Model.Total))</span>
        </h2>
    </div>

    @if (rows.Count == 0)
    {
        <!-- Empty State -->
        <div class="border-2 border-dashed border-gray-200 rounded-3xl p-12 text-center space-y-4 bg-white/50">
            <div class="text-6xl text-gray-300">🍃</div>
            <div class="space-y-1">
                <p class="text-gray-700 font-medium">@T("projects.diary-companion.views.list.empty_title", "这里还空空如也呢")</p>
                <p class="text-xs text-gray-400">@T("projects.diary-companion.views.list.empty_desc", "点击页面上方按钮开启第一篇记录吧")</p>
            </div>
        </div>
    }
    else
    {
        <!-- Diary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            @foreach (var row in rows)
            {
                // Resolve values dynamically
                var idKey = FindKey(row, "Id", "id") ?? "Id";
                var id = row.TryGetValue(idKey, out var idVal) ? idVal?.ToString() : "";
                
                var titleKey = FindKey(row, "Title", "title", "subject", "name") ?? "Title";
                var title = row.TryGetValue(titleKey, out var titleVal) ? titleVal?.ToString() ?? T("projects.diary-companion.views.list.untitled", "无标题") : T("projects.diary-companion.views.list.untitled", "无标题");
                
                var contentKey = FindKey(row, "Content", "content", "body", "text", "description") ?? "Content";
                var content = row.TryGetValue(contentKey, out var contentVal) ? contentVal?.ToString() ?? "" : "";
                
                var weatherKey = FindKey(row, "Weather", "weather") ?? "Weather";
                var weather = row.TryGetValue(weatherKey, out var weatherVal) ? weatherVal?.ToString() ?? "" : "";
                
                var moodKey = FindKey(row, "MoodBefore", "mood", "category") ?? "MoodBefore";
                var mood = row.TryGetValue(moodKey, out var moodVal) ? moodVal?.ToString() ?? "" : "";
                
                var locationKey = FindKey(row, "Location", "location", "place") ?? "Location";
                var location = row.TryGetValue(locationKey, out var locVal) ? locVal?.ToString() ?? "" : "";
                
                var sentimentKey = FindKey(row, "Sentiment", "sentiment", "status") ?? "Sentiment";
                var sentiment = row.TryGetValue(sentimentKey, out var sentVal) ? sentVal?.ToString() ?? "" : "";
                
                var aiRespKey = FindKey(row, "AiResponse", "ai_response", "comment") ?? "AiResponse";
                var aiResp = row.TryGetValue(aiRespKey, out var aiVal) ? aiVal?.ToString() ?? "" : "";
                
                var createdAtKey = FindKey(row, "CreatedAt", "created_at", "date") ?? "CreatedAt";
                var createdAt = "";
                if (row.TryGetValue(createdAtKey, out var caVal) && caVal != null) {
                    if (DateTime.TryParse(caVal.ToString(), out var dt)) {
                        createdAt = dt.ToString("yyyy年MM月dd日 HH:mm");
                    } else {
                        createdAt = caVal.ToString() ?? "";
                    }
                }

                var imageThumbnailBase64Key = FindKey(row, "ImageThumbnailBase64") ?? "ImageThumbnailBase64";
                var imageThumbnailBase64 = row.TryGetValue(imageThumbnailBase64Key, out var imgThumbVal) ? imgThumbVal?.ToString() ?? "" : "";
                
                var imageLabelKey = FindKey(row, "ImageLabel") ?? "ImageLabel";
                var imageLabel = row.TryGetValue(imageLabelKey, out var imgLabelVal) ? imgLabelVal?.ToString() ?? "" : "";

                var shortContent = content.Length > 65 ? content.Substring(0, 62) + "..." : content;
                var sentimentStyle = GetSentimentStyle(sentiment);

                // Build Edit Link
                var editUrl = Url.Action("Index", "Page", new { project = currentProject, pageName = editPageName, id = id });
                if (sec.Actions != null) {
                    var editAct = sec.Actions.FirstOrDefault(a => a.Label?.Contains("编辑") == true || a.Label?.Contains("Edit") == true);
                    if (editAct != null && !string.IsNullOrEmpty(editAct.Url)) {
                        editUrl = editAct.Url.Replace("{id}", id).Replace("{project}", currentProject);
                    }
                }

                <div id="diary-card-@id" class="diary-card card bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm flex flex-col justify-between">
                    <div class="p-5 space-y-3">
                        <!-- Top status bar -->
                        <div class="flex items-center justify-between text-xs">
                            <div class="flex items-center gap-2">
                                @if (!string.IsNullOrEmpty(weather)) {
                                    <span class="tooltip" data-tip="@T("projects.diary-companion.views.list.weather", "天气")：@T($"projects.diary-companion.weathers.{weather}.name", weather)">@GetWeatherEmoji(weather)</span>
                                }
                                @if (!string.IsNullOrEmpty(mood)) {
                                    <span class="tooltip" data-tip="@T("projects.diary-companion.entity.diary_entry.fields.moodBefore", "记录前心情")：@T($"projects.diary-companion.moods.{mood}.name", mood)">@GetMoodEmoji(mood)</span>
                                }
                                @if (!string.IsNullOrEmpty(location))
                                {
                                    <span class="text-gray-400 flex items-center gap-0.5 max-w-[100px] truncate" title="@location">
                                        📍 @location
                                    </span>
                                }
                            </div>
                            <span class="text-gray-400">@createdAt</span>
                        </div>

                        <!-- Title and Content -->
                        <div class="space-y-1.5">
                            <h4 class="font-bold text-gray-800 text-base line-clamp-1">@title</h4>
                            <p class="text-xs text-gray-500 leading-relaxed min-h-[48px] whitespace-pre-line">@shortContent</p>
                            
                            @if (!string.IsNullOrEmpty(imageThumbnailBase64))
                            {
                                <div class="mt-2 rounded-xl overflow-hidden border border-purple-100/40 max-h-36 flex items-center justify-center bg-gradient-to-br from-purple-50/50 via-pink-50/30 to-blue-50/50 backdrop-blur-sm">
                                    <img src="@imageThumbnailBase64" alt="@imageLabel" loading="lazy" class="object-cover w-full h-full max-h-36 cursor-zoom-in hover:scale-105 transition-all duration-500 ease-out" onclick="window.showLightboxLazy_@(sec.Id)('@id', `@Html.Raw(JavaScriptEncoder.Default.Encode(imageLabel))`)" />
                                </div>
                            }
                        </div>

                        <!-- AI response / sentiment snippet -->
                        @if (!string.IsNullOrEmpty(sentiment) || !string.IsNullOrEmpty(aiResp))
                        {
                            <div class="p-3 rounded-xl border @sentimentStyle.borderClass @sentimentStyle.bgClass space-y-1.5">
                                <div class="flex items-center justify-between">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border @sentimentStyle.badgeClass">
                                        ✨ @T("projects.diary-companion.views.list.ai_title", "AI 伴侣评估")：@sentimentStyle.text
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(aiResp))
                                {
                                    <p class="text-[11px] text-gray-600 italic leading-relaxed line-clamp-2">
                                        “@aiResp”
                                    </p>
                                }
                            </div>
                        }
                    </div>

                    <div class="px-5 py-3 bg-gray-50/50 border-t border-gray-100 flex items-center justify-between">
                        <button onclick="showDetailModal_@(sec.Id)('@id')" class="btn btn-ghost btn-xs text-indigo-600 hover:text-indigo-800 font-semibold p-0 flex items-center gap-0.5">
                            🔍 @T("projects.diary-companion.views.list.expand_read", "展开阅读")
                        </button>
                        <div class="flex items-center gap-2">
                            <a href="@editUrl" class="btn btn-ghost btn-xs text-gray-500 hover:text-indigo-600 font-semibold p-0">
                                @T("projects.diary-companion.views.list.edit", "编辑")
                            </a>
                            <button onclick="confirmDeleteDiary_@(sec.Id)('@id')" class="btn btn-ghost btn-xs text-rose-500 hover:text-rose-700 font-semibold p-0">
                                @T("projects.diary-companion.views.list.delete", "删除")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination UI -->
        @if (totalPages > 1)
        {
            <div class="flex justify-center items-center gap-2 mt-8 pt-4 border-t border-gray-100">
                <div class="join bg-white/60 backdrop-blur border border-gray-100 p-1 rounded-2xl shadow-sm">
                    @if (currentPage > 1)
                    {
                        <a href="@BuildPageUrl(currentPage - 1)" class="join-item btn btn-sm btn-ghost hover:bg-indigo-50 text-gray-500 rounded-xl transition-all">
                            @T("projects.diary-companion.views.list.prev_page", "‹ 上一页")
                        </a>
                    }
                    else
                    {
                        <button class="join-item btn btn-sm btn-ghost btn-disabled text-gray-300 rounded-xl">
                            @T("projects.diary-companion.views.list.prev_page", "‹ 上一页")
                        </button>
                    }

                    @{
                        var maxPageLinks = 5;
                        var half = maxPageLinks / 2;
                        var startPage = Math.Max(1, currentPage - half);
                        var endPage = Math.Min(totalPages, startPage + maxPageLinks - 1);
                        if (endPage - startPage + 1 < maxPageLinks)
                            startPage = Math.Max(1, endPage - maxPageLinks + 1);
                    }

                    @if (startPage > 1)
                    {
                        <a href="@BuildPageUrl(1)" class="join-item btn btn-sm btn-ghost hover:bg-indigo-50 text-gray-500 rounded-xl transition-all">1</a>
                        @if (startPage > 2)
                        {
                            <span class="join-item btn btn-sm btn-ghost btn-disabled text-gray-400">...</span>
                        }
                    }

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        if (p == currentPage)
                        {
                            <button class="join-item btn btn-sm btn-primary bg-indigo-600 text-white border-none rounded-xl shadow-sm shadow-indigo-100 font-bold">
                                @p
                            </button>
                        }
                        else
                        {
                            <a href="@BuildPageUrl(p)" class="join-item btn btn-sm btn-ghost hover:bg-indigo-50 text-gray-600 rounded-xl transition-all font-medium">
                                @p
                            </a>
                        }
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <span class="join-item btn btn-sm btn-ghost btn-disabled text-gray-400">...</span>
                        }
                        <a href="@BuildPageUrl(totalPages)" class="join-item btn btn-sm btn-ghost hover:bg-indigo-50 text-gray-500 rounded-xl transition-all">@totalPages</a>
                    }

                    @if (currentPage < totalPages)
                    {
                        <a href="@BuildPageUrl(currentPage + 1)" class="join-item btn btn-sm btn-ghost hover:bg-indigo-50 text-gray-500 rounded-xl transition-all">
                            @T("projects.diary-companion.views.list.next_page", "下一页 ›")
                        </a>
                    }
                    else
                    {
                        <button class="join-item btn btn-sm btn-ghost btn-disabled text-gray-300 rounded-xl">
                            @T("projects.diary-companion.views.list.next_page", "下一页 ›")
                        </button>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- ===== Detail View Modal ===== -->
<dialog id="detail_modal_@(sec.Id)" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box glass-panel border border-white/60 p-6 rounded-2xl max-w-lg space-y-4">
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 text-gray-500">✕</button>
        </form>
        <div class="flex items-center gap-2.5 text-xs text-gray-400" id="modal_meta_@(sec.Id)">
            <!-- Filled dynamically -->
        </div>
        <h3 class="font-extrabold text-xl text-gray-800" id="modal_title_@(sec.Id)"><!-- Filled dynamically --></h3>
        <hr class="border-gray-100" />
        <div class="text-sm text-gray-700 leading-relaxed whitespace-pre-line max-h-60 overflow-y-auto" id="modal_content_@(sec.Id)">
            <!-- Filled dynamically -->
        </div>
        <div id="modal_image_container_@(sec.Id)" class="hidden mt-3 text-center space-y-1 bg-gray-50/50 p-2.5 rounded-xl border border-gray-100">
            <img id="modal_image_@(sec.Id)" src="" class="max-h-64 mx-auto rounded-lg shadow-sm object-contain cursor-zoom-in hover:scale-[1.02] transition-transform duration-300" onclick="window.showLightboxLazy_@(sec.Id)(currentDetailDiaryId, document.getElementById('modal_image_label_@(sec.Id)').innerText.replace('@T("projects.diary-companion.views.list.image_label_prefix", "📸 图片标注：")', ''))" />
            <p id="modal_image_label_@(sec.Id)" class="text-[10px] text-gray-500 italic mt-1"></p>
        </div>
        <div class="hidden p-4 rounded-xl border border-indigo-100 bg-indigo-50/30 space-y-2" id="modal_ai_section_@(sec.Id)">
            <div class="flex items-center justify-between text-xs font-bold text-indigo-700">
                <span>@T("projects.diary-companion.views.list.ai_title", "🤖 AI 伴侣评估")</span>
                <span class="badge badge-sm badge-primary text-white" id="modal_ai_sentiment_@(sec.Id)"><!-- Sentiment --></span>
            </div>
            <p class="text-base text-gray-700 italic leading-relaxed" id="modal_ai_response_@(sec.Id)">
                <!-- Filled dynamically -->
            </p>
        </div>
        <div class="modal-action">
            <form method="dialog" class="w-full flex justify-end gap-2">
                <a href="#" id="modal_edit_btn_@(sec.Id)" class="btn btn-sm btn-ghost rounded-lg text-gray-600">@T("projects.diary-companion.views.list.edit_record", "编辑记录")</a>
                <button class="btn btn-sm btn-primary bg-indigo-600 hover:bg-indigo-700 border-none text-white rounded-lg">@T("projects.diary-companion.views.list.close", "关闭")</button>
            </form>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>

<!-- ===== Delete Confirmation Modal ===== -->
<dialog id="delete_modal_@(sec.Id)" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box p-6 rounded-2xl max-w-sm space-y-4">
        <h3 class="font-bold text-lg text-gray-800 flex items-center gap-2">
            @T("projects.diary-companion.views.list.delete_confirm_title", "⚠️ 确定要删除该记录吗？")
        </h3>
        <p class="text-xs text-gray-500 leading-relaxed">
            @T("projects.diary-companion.views.list.delete_confirm_desc", "此操作将永久删除此记录，无法恢复。")
        </p>
        <div class="modal-action flex justify-end gap-2">
            <form method="dialog">
                <button class="btn btn-sm btn-ghost rounded-lg">@T("projects.diary-companion.views.list.cancel", "取消")</button>
            </form>
            <button onclick="executeDeleteDiary_@(sec.Id)()" class="btn btn-sm btn-error bg-rose-500 hover:bg-rose-600 text-white border-none rounded-lg">
                @T("projects.diary-companion.views.list.confirm_delete", "确定删除")
            </button>
        </div>
    </div>
</dialog>

<!-- ===== Lightbox Modal ===== -->
<dialog id="lightbox_modal_@(sec.Id)" class="modal modal-middle bg-black/85 backdrop-blur-md cursor-zoom-out" onclick="this.close()">
    <div class="relative max-w-4xl max-h-[85vh] flex flex-col items-center justify-center p-4 cursor-default animate-zoom-in" onclick="event.stopPropagation()">
        <button onclick="document.getElementById('lightbox_modal_@(sec.Id)').close()" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2 text-white bg-black/40 hover:bg-black/60 border-none z-10">✕</button>
        <img id="lightbox_image_@(sec.Id)" src="" class="max-w-full max-h-[75vh] rounded-xl shadow-2xl object-contain border border-white/10" />
        <p id="lightbox_label_@(sec.Id)" class="text-xs text-gray-200 mt-3 font-medium bg-black/40 px-3 py-1.5 rounded-full backdrop-blur-sm hidden"></p>
    </div>
</dialog>

<script>
    (function() {
        // Store items dynamically inside a block-scoped variable
        const diaryData = {
            @foreach (var row in rows)
            {
                var idKey = FindKey(row, "Id", "id") ?? "Id";
                var id = row[idKey].ToString();
                
                var titleKey = FindKey(row, "Title", "title", "subject", "name") ?? "Title";
                var title = row.TryGetValue(titleKey, out var t) ? t?.ToString() ?? T("projects.diary-companion.views.list.untitled", "无标题") : T("projects.diary-companion.views.list.untitled", "无标题");
                
                var contentKey = FindKey(row, "Content", "content", "body") ?? "Content";
                var content = row.TryGetValue(contentKey, out var cn) ? cn?.ToString() ?? "" : "";
                
                var weatherKey = FindKey(row, "Weather", "weather") ?? "Weather";
                var weather = row.TryGetValue(weatherKey, out var w) ? w?.ToString() ?? "" : "";
                var weatherText = weather != null ? T($"projects.diary-companion.weathers.{weather}.name", weather) : "";
                
                var moodKey = FindKey(row, "MoodBefore", "mood", "category") ?? "MoodBefore";
                var mood = row.TryGetValue(moodKey, out var m) ? m?.ToString() ?? "" : "";
                var moodText = mood != null ? T($"projects.diary-companion.moods.{mood}.name", mood) : "";
                
                var locationKey = FindKey(row, "Location", "location") ?? "Location";
                var location = row.TryGetValue(locationKey, out var l) ? l?.ToString() ?? "" : "";
                
                var sentimentKey = FindKey(row, "Sentiment", "sentiment") ?? "Sentiment";
                var sentiment = row.TryGetValue(sentimentKey, out var s) ? s?.ToString() ?? "" : "";
                var sentimentText = sentiment.Trim() switch {
                    "积极" or "Positive" or "ポジティブ" => T("projects.diary-companion.sentiment.positive", "充满阳光"),
                    "消极" or "Negative" or "ネガティブ" => T("projects.diary-companion.sentiment.negative", "雨过天晴"),
                    "平和" or "Neutral" or "ニュートラル" => T("projects.diary-companion.sentiment.neutral", "风平浪静"),
                    _ => sentiment
                };
                
                var aiRespKey = FindKey(row, "AiResponse", "ai_response") ?? "AiResponse";
                var aiResp = row.TryGetValue(aiRespKey, out var ar) ? ar?.ToString() ?? "" : "";
                
                var createdAtKey = FindKey(row, "CreatedAt", "created_at") ?? "CreatedAt";
                var createdAt = "";
                if (row.TryGetValue(createdAtKey, out var caVal) && caVal != null) {
                    if (DateTime.TryParse(caVal.ToString(), out var dt)) {
                        createdAt = dt.ToString("yyyy年MM月dd日 HH:mm");
                    } else {
                        createdAt = caVal.ToString() ?? "";
                    }
                }

                 var imageThumbnailBase64Key = FindKey(row, "ImageThumbnailBase64") ?? "ImageThumbnailBase64";
                 var imageThumbnailBase64 = row.TryGetValue(imageThumbnailBase64Key, out var imgThumbVal) ? imgThumbVal?.ToString() ?? "" : "";
                 
                 var imageLabelKey = FindKey(row, "ImageLabel") ?? "ImageLabel";
                 var imageLabel = row.TryGetValue(imageLabelKey, out var imgLabelVal) ? imgLabelVal?.ToString() ?? "" : "";
 
                 var editUrl = Url.Action("Index", "Page", new { project = currentProject, pageName = editPageName, id = id });
                 if (sec.Actions != null) {
                     var editAct = sec.Actions.FirstOrDefault(a => a.Label?.Contains("编辑") == true || a.Label?.Contains("Edit") == true);
                     if (editAct != null && !string.IsNullOrEmpty(editAct.Url)) {
                         editUrl = editAct.Url.Replace("{id}", id).Replace("{project}", currentProject);
                     }
                 }
 
                 <text>
                 "@id": {
                     id: "@id",
                     title: `@Html.Raw(JavaScriptEncoder.Default.Encode(title))`,
                     content: `@Html.Raw(JavaScriptEncoder.Default.Encode(content))`,
                     weather: "@weather",
                     weatherText: "@weatherText",
                     weatherEmoji: "@GetWeatherEmoji(weather)",
                     mood: "@mood",
                     moodText: "@moodText",
                     moodEmoji: "@GetMoodEmoji(mood)",
                     location: `@Html.Raw(JavaScriptEncoder.Default.Encode(location))`,
                     sentiment: "@sentimentText",
                     aiResponse: `@Html.Raw(JavaScriptEncoder.Default.Encode(aiResp))`,
                     createdAt: "@createdAt",
                     editUrl: "@editUrl",
                     imageBase64: "",
                     imageThumbnailBase64: `@Html.Raw(imageThumbnailBase64)`,
                     imageLabel: `@Html.Raw(JavaScriptEncoder.Default.Encode(imageLabel))`
                 },
                 </text>
             }
         };
 
         let selectedDiaryId = null;
         let currentDetailDiaryId = null;
 
         window.showDetailModal_@(sec.Id) = async function(id) {
             currentDetailDiaryId = id;
             const diary = diaryData[id];
             if (!diary) return;
 
             document.getElementById('modal_title_@(sec.Id)').innerText = diary.title;
             document.getElementById('modal_content_@(sec.Id)').innerText = diary.content;
             
             let metaHtml = "";
             if (diary.weather) metaHtml += `<span>${diary.weatherEmoji} ${diary.weatherText}</span><span>•</span>`;
             if (diary.mood) metaHtml += `<span>${diary.moodEmoji} ${diary.moodText}</span><span>•</span>`;
             metaHtml += `<span>${diary.createdAt}</span>`;
             if (diary.location) {
                 metaHtml += `<span>•</span><span>📍 ${diary.location}</span>`;
             }
             document.getElementById('modal_meta_@(sec.Id)').innerHTML = metaHtml;
 
             const imgContainer = document.getElementById('modal_image_container_@(sec.Id)');
             const modalImg = document.getElementById('modal_image_@(sec.Id)');
             const modalImgLabel = document.getElementById('modal_image_label_@(sec.Id)');
             if (diary.imageThumbnailBase64 && diary.imageThumbnailBase64.trim() !== '') {
                 if (imgContainer && modalImg && modalImgLabel) {
                     imgContainer.classList.remove('hidden');
                     modalImg.src = diary.imageBase64 && diary.imageBase64.trim() !== '' ? diary.imageBase64 : diary.imageThumbnailBase64;
                     modalImg.style.filter = diary.imageBase64 ? 'none' : 'blur(4px)';
                     modalImg.style.transition = 'filter 0.3s ease-out';
                     modalImgLabel.innerText = diary.imageLabel ? `@T("projects.diary-companion.views.list.image_label_prefix", "📸 图片标注：")` + diary.imageLabel : '';
 
                     if (!diary.imageBase64 || diary.imageBase64.trim() === '') {
                         try {
                             const response = await fetch(`/api/${window.NetYamlForgeConfig?.currentProject || '@currentProject'}/@(apiEntity)/${id}`);
                             if (response.ok) {
                                  const result = await response.json();
                                  var imgBase64 = result && result.data && (result.data.ImageBase64 || result.data.imageBase64);
                                  if (imgBase64) {
                                      diary.imageBase64 = imgBase64;
                                      if (currentDetailDiaryId === id) {
                                          modalImg.src = diary.imageBase64;
                                          modalImg.style.filter = 'none';
                                      }
                                  }
                             }
                         } catch (err) {
                             console.error("加载大图失败:", err);
                         }
                     }
                 }
             } else {
                 if (imgContainer && modalImg && modalImgLabel) {
                     imgContainer.classList.add('hidden');
                     modalImg.src = '';
                     modalImgLabel.innerText = '';
                 }
             }
 
             const aiSection = document.getElementById('modal_ai_section_@(sec.Id)');
             if (diary.sentiment || diary.aiResponse) {
                 aiSection.classList.remove('hidden');
                 document.getElementById('modal_ai_sentiment_@(sec.Id)').innerText = diary.sentiment || `@T("projects.diary-companion.views.list.pending_evaluation", "有待评估")`;
                 document.getElementById('modal_ai_response_@(sec.Id)').innerText = diary.aiResponse || `@T("projects.diary-companion.views.list.ai_thinking", "AI 正在思考中...")`;
             } else {
                 aiSection.classList.add('hidden');
             }
 
             document.getElementById('modal_edit_btn_@(sec.Id)').href = diary.editUrl;
             document.getElementById('detail_modal_@(sec.Id)').showModal();
         }
 
         window.showLightbox_@(sec.Id) = function(src, label = '') {
             const lightbox = document.getElementById('lightbox_modal_@(sec.Id)');
             const img = document.getElementById('lightbox_image_@(sec.Id)');
             const lbl = document.getElementById('lightbox_label_@(sec.Id)');
             if (lightbox && img) {
                 img.src = src;
                 img.style.filter = 'none';
                 if (label && label.trim() !== '') {
                     lbl.innerText = label;
                     lbl.classList.remove('hidden');
                 } else {
                     lbl.innerText = '';
                     lbl.classList.add('hidden');
                 }
                 lightbox.showModal();
             }
         }
 
         window.showLightboxLazy_@(sec.Id) = async function(id, label = '') {
             const diary = diaryData[id];
             if (!diary) return;
 
             const lightbox = document.getElementById('lightbox_modal_@(sec.Id)');
             const img = document.getElementById('lightbox_image_@(sec.Id)');
             const lbl = document.getElementById('lightbox_label_@(sec.Id)');
             if (lightbox && img) {
                 img.src = diary.imageBase64 && diary.imageBase64.trim() !== '' ? diary.imageBase64 : diary.imageThumbnailBase64;
                 img.style.filter = diary.imageBase64 ? 'none' : 'blur(4px)';
                 img.style.transition = 'filter 0.3s ease-out';
 
                 if (label && label.trim() !== '') {
                     lbl.innerText = label;
                     lbl.classList.remove('hidden');
                 } else {
                     lbl.innerText = '';
                     lbl.classList.add('hidden');
                 }
                 lightbox.showModal();
 
                 if (!diary.imageBase64 || diary.imageBase64.trim() === '') {
                     try {
                         const response = await fetch(`/api/${window.NetYamlForgeConfig?.currentProject || '@currentProject'}/@(apiEntity)/${id}`);
                         if (response.ok) {
                             const result = await response.json();
                              var imgBase64 = result && result.data && (result.data.ImageBase64 || result.data.imageBase64);
                              if (imgBase64) {
                                  diary.imageBase64 = imgBase64;
                                  if (lightbox.open) {
                                      img.src = diary.imageBase64;
                                      img.style.filter = 'none';
                                  }
                              }
                         }
                     } catch (err) {
                         console.error("加载大图失败:", err);
                     }
                 }
             }
         }
 
         window.confirmDeleteDiary_@(sec.Id) = function(id) {
             selectedDiaryId = id;
             document.getElementById('delete_modal_@(sec.Id)').showModal();
         }
 
         window.executeDeleteDiary_@(sec.Id) = async function() {
             if (!selectedDiaryId) return;
             const id = selectedDiaryId;
             
             try {
                 const response = await fetch(`/api/${window.NetYamlForgeConfig?.currentProject || '@currentProject'}/@(apiEntity)/${id}`, {
                     method: 'DELETE',
                     headers: {
                         'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                     }
                 });
 
                 if (response.ok || response.status === 204) {
                     // Close Modal
                     document.getElementById('delete_modal_@(sec.Id)').close();
                     
                     // Elegant delete animation
                     const card = document.getElementById(`diary-card-${id}`);
                     if (card) {
                         card.style.opacity = '0';
                         card.style.transform = 'scale(0.9) translateY(10px)';
                         card.style.transition = 'all 0.4s ease-out';
                         
                         setTimeout(() => {
                             card.style.height = '0px';
                             card.style.padding = '0px';
                             card.style.margin = '0px';
                             card.style.border = 'none';
                             setTimeout(() => {
                                 card.remove();
                                 // Reload if no cards left to show empty state
                                 if (document.querySelectorAll('#section-@(sec.Id) .diary-card').length === 0) {
                                     window.location.reload();
                                 }
                             }, 300);
                         }, 400);
                     }
                 } else {
                     const data = await response.json();
                     alert(`@T("projects.diary-companion.views.list.unknown_error", "删除失败:") ${data.error || ''}`);
                 }
             } catch (error) {
                 console.error('Error deleting:', error);
                 alert(`@T("projects.diary-companion.views.list.unknown_error", "删除发生网络错误，请重试")`);
             }
         }
     })();
 </script>
 
 @Html.AntiForgeryToken()
