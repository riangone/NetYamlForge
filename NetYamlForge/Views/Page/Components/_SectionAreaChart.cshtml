@using NetYamlForge.Models
@model SectionRenderModel
@{
    var sec = Model.Sec;
    var rows = Model.Rows;
    var labelField = sec.LabelField ?? (sec.GetColumnAt(0));
    var valueField = sec.ValueField ?? (sec.GetColumnAt(1));
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <h2 class="text-lg font-semibold text-gray-700 mb-3">@sec.Title</h2>
}

<div class="area-chart-container bg-base-100 p-4 rounded shadow">
    @if (rows.Any())
    {
        var labels = rows.Select(r => labelField != null && r.TryGetValue(labelField, out var l) ? l?.ToString() ?? "" : "").ToList();
        var values = rows.Select(r => valueField != null && r.TryGetValue(valueField, out var v) ? Convert.ToDouble(v) : 0).ToList();
        var maxValue = values.Max();
        
        <div class="flex items-end h-64 gap-2 relative">
            @* Y 軸ラベル *@
            <div class="absolute left-0 top-0 bottom-0 w-12 text-xs text-gray-500 flex flex-col justify-between py-2">
                <span>@maxValue.ToString("N0")</span>
                <span>@(maxValue / 2).ToString("N0")</span>
                <span>0</span>
            </div>
            
            @* チャートエリア *@
            <div class="flex-1 ml-14 h-full flex items-end gap-1 relative">
                @* グリッド線 *@
                <div class="absolute inset-0 flex flex-col justify-between py-2 pointer-events-none">
                    <div class="border-t border-base-300"></div>
                    <div class="border-t border-base-300"></div>
                    <div class="border-t border-base-300"></div>
                </div>
                
                @* データポイント *@
                @for (int i = 0; i < values.Count; i++)
                {
                    var height = maxValue > 0 ? (values[i] / maxValue * 100) : 0;
                    <div class="flex-1 flex flex-col justify-end group relative">
                        <div class="bg-primary/60 hover:bg-primary transition-all rounded-t"
                             style="height: @height%"></div>
                        @* ツールチップ *@
                        <div class="opacity-0 group-hover:opacity-100 absolute bottom-full left-1/2 -translate-x-1/2 mb-1 px-2 py-1 bg-base-300 text-xs rounded whitespace-nowrap z-10">
                            @labels[i]: @values[i].ToString("N0")
                        </div>
                    </div>
                }
            </div>
        </div>
        
        @* X 軸ラベル *@
        <div class="flex gap-1 ml-14 mt-2">
            @foreach (var label in labels.Take(10))
            {
                <div class="flex-1 text-xs text-gray-500 text-center truncate">@label</div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-gray-400 py-8">No data available</div>
    }
</div>
