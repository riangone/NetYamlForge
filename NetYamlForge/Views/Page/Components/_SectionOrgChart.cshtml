@using NetYamlForge.Models
@model SectionRenderModel
@{
    var sec = Model.Sec;
    var rows = Model.Rows;
    var nameField = sec.NameField ?? (sec.GetColumnAt(0));
    var titleField = sec.TitleField ?? (sec.GetColumnAt(1));
    var parentField = sec.ParentField;
    var emailField = sec.EmailField;
    var avatarField = sec.AvatarField;
}

@if (!string.IsNullOrEmpty(sec.Title))
{
    <h2 class="text-lg font-semibold text-gray-700 mb-3">@sec.Title</h2>
}

<div class="org-chart-container bg-base-100 rounded shadow p-6 overflow-x-auto">
    @if (rows.Any())
    {
        <div class="flex flex-col items-center gap-8">
            @* 簡易版：ルートノードのみ表示（階層構造は将来的に拡張）*@
            @{
                var rootNodes = string.IsNullOrEmpty(parentField) 
                    ? rows 
                    : rows.Where(r => {
                        r.TryGetValue(parentField, out var pval);
                        return pval == null || string.IsNullOrEmpty(pval.ToString());
                    }).ToList();
            }
            
            @foreach (var node in rootNodes)
            {
                var name = node.TryGetValue(nameField, out var n) ? n?.ToString() ?? "" : "";
                var title = node.TryGetValue(titleField, out var t) ? t?.ToString() ?? "" : "";
                var email = !string.IsNullOrEmpty(emailField) && node.TryGetValue(emailField, out var e) ? e?.ToString() ?? "" : "";
                var avatar = !string.IsNullOrEmpty(avatarField) && node.TryGetValue(avatarField, out var av) ? av?.ToString() ?? "" : "";
                var firstChar = string.IsNullOrEmpty(name) ? "?" : name[0].ToString();
                
                <div class="card bg-base-200 shadow-md w-48 hover:shadow-lg transition-shadow cursor-pointer">
                    <div class="card-body p-4 items-center text-center">
                        @if (string.IsNullOrEmpty(avatar))
                        {
                            <div class="avatar placeholder">
                                <div class="bg-neutral-focus text-neutral-content rounded-full w-16 h-16">
                                    <span class="text-2xl">@firstChar</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="avatar">
                                <div class="rounded-full w-16 h-16">
                                    <img src="@avatar" alt="@name" />
                                </div>
                            </div>
                        }
                        <h3 class="font-bold text-sm">@name</h3>
                        <p class="text-xs text-gray-500">@title</p>
                        @if (!string.IsNullOrEmpty(email))
                        {
                            <p class="text-xs text-primary">@email</p>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-gray-400 py-8">No data available</div>
    }
</div>
