@* ops テーマ: オペレーション向け — 左列に統計リスト、右列にチャート *@
@model NetYamlForge.Controllers.DashboardViewModel
@{
    var projectName = ViewData["ProjectDisplayName"] as string ?? "Dashboard";
    var now         = DateTime.Now;
}

<div class="space-y-4">
    @* Ops header bar *@
    <div class="flex items-center justify-between bg-base-200 rounded-xl px-5 py-3">
        <div class="flex items-center gap-3">
            <div class="w-2.5 h-2.5 rounded-full bg-success animate-pulse"></div>
            <span class="font-bold text-base-content">@projectName</span>
            <span class="badge badge-sm badge-success">LIVE</span>
        </div>
        <span class="text-xs text-base-content/50">@now.ToString("yyyy-MM-dd HH:mm")</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        @* Left: compact stat list *@
        <div class="lg:col-span-1 bg-base-100 border border-base-300 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-5 py-3 bg-base-200 border-b border-base-300">
                <h2 class="text-xs font-semibold tracking-widest text-base-content/50 uppercase">Metrics</h2>
            </div>
            @if (Model.Stats.Count > 0)
            {
                <ul class="divide-y divide-base-200">
                    @foreach (var stat in Model.Stats)
                    {
                        var icon = string.IsNullOrEmpty(stat.Icon) ? "●" : stat.Icon;
                        <li>
                            @if (!string.IsNullOrEmpty(stat.EntityUrl))
                            {
                                <a href="@stat.EntityUrl"
                                   class="flex items-center gap-3 px-5 py-3.5 hover:bg-base-200 transition-colors no-underline group">
                                    <span class="text-lg w-6 text-center">@icon</span>
                                    <span class="flex-1 text-sm text-base-content group-hover:text-primary">@stat.Label</span>
                                    <span class="font-bold text-base-content/80 tabular-nums">@stat.Value</span>
                                    <span class="text-base-content/30 text-xs">→</span>
                                </a>
                            }
                            else
                            {
                                <div class="flex items-center gap-3 px-5 py-3.5">
                                    <span class="text-lg w-6 text-center">@icon</span>
                                    <span class="flex-1 text-sm text-base-content/70">@stat.Label</span>
                                    <span class="font-bold tabular-nums">@stat.Value</span>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="px-5 py-8 text-center text-sm text-base-content/40">No metrics configured</div>
            }
        </div>

        @* Right: charts *@
        <div class="lg:col-span-2 space-y-4">
            @if (Model.Charts.Count > 0)
            {
                @for (int i = 0; i < Model.Charts.Count; i++)
                {
                    var chart = Model.Charts[i];
                    <div class="bg-base-100 border border-base-300 rounded-2xl shadow-sm p-5">
                        <h2 class="text-xs font-semibold tracking-widest text-base-content/50 uppercase mb-3">@chart.Title</h2>
                        <div class="relative" style="height:220px">
                            <canvas id="chart-@i"></canvas>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="bg-base-100 border border-base-300 rounded-2xl shadow-sm p-8 text-center text-sm text-base-content/40">
                    チャートが未設定です
                </div>
            }
        </div>
    </div>
</div>
