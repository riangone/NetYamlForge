@* AI 自然语言查询页面 *@
@model NetYamlForge.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "AI 自然语言查询";
    var projectName = Context.GetRouteValue("project")?.ToString() ?? "";
    var examples = new List<dynamic>
    {
        new { title = "基础查询", examples = new List<string> { "显示所有产品", "找出价格高于 100 的商品", "显示库存为 0 的产品" } },
        new { title = "时间范围查询", examples = new List<string> { "显示上个月的订单", "找出本季度的销售记录", "显示去年的所有交易" } },
        new { title = "排序和限制", examples = new List<string> { "显示销售额前 10 的产品", "找出价格最低的 5 个商品", "按库存数量降序排列所有产品" } },
        new { title = "条件过滤", examples = new List<string> { "显示类别为'电子产品'的商品", "找出库存低于 10 且价格高于 50 的产品", "显示状态为'已完成'的订单" } }
    };
}

<div class="container-fluid py-4">
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="bi bi-robot"></i> AI 自然语言查询
                </h2>
                <button class="btn btn-outline-secondary btn-sm" onclick="showHelp()">
                    <i class="bi bi-question-circle"></i> 使用帮助
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="height: calc(100vh - 180px);">
                <div class="card-body p-0">
                    @await Component.InvokeAsync("AIQueryChat", new { project = projectName })
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/ai-query-chat.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
}

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="~/js/ai-query-chat.js"></script>
    
    <script>
        function showHelp() {
            const helpModal = new bootstrap.Modal(document.getElementById('helpModal'));
            helpModal.show();
        }

        // 显示使用示例
        const examples = [
            {
                title: "基础查询",
                examples: [
                    "显示所有产品",
                    "找出价格高于 100 的商品",
                    "显示库存为 0 的产品"
                ]
            },
            {
                title: "时间范围查询",
                examples: [
                    "显示上个月的订单",
                    "找出本季度的销售记录",
                    "显示去年的所有交易"
                ]
            },
            {
                title: "排序和限制",
                examples: [
                    "显示销售额前 10 的产品",
                    "找出价格最低的 5 个商品",
                    "按库存数量降序排列所有产品"
                ]
            },
            {
                title: "条件过滤",
                examples: [
                    "显示类别为'电子产品'的商品",
                    "找出库存低于 10 且价格高于 50 的产品",
                    "显示状态为'已完成'的订单"
                ]
            }
        ];
    </script>

    <!-- 帮助模态框 -->
    <div class="modal fade" id="helpModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">AI 自然语言查询使用帮助</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <h6>什么是 AI 自然语言查询？</h6>
                    <p>AI 自然语言查询允许您使用日常语言来查询数据库，无需编写 SQL 或了解复杂的查询语法。</p>
                    
                    <h6 class="mt-4">查询示例</h6>
                    @foreach (var category in examples)
                    {
                        <div class="mb-3">
                            <strong>@category.title</strong>
                            <ul>
                                @foreach (var ex in category.examples)
                                {
                                    <li><code>@ex</code></li>
                                }
                            </ul>
                        </div>
                    }

                    <h6 class="mt-4">支持的日期表达</h6>
                    <ul>
                        <li><code>today</code> - 今天</li>
                        <li><code>yesterday</code> - 昨天</li>
                        <li><code>this_week</code> - 本周</li>
                        <li><code>last_week</code> - 上周</li>
                        <li><code>this_month</code> - 本月</li>
                        <li><code>last_month</code> - 上月</li>
                        <li><code>this_quarter</code> - 本季度</li>
                        <li><code>last_quarter</code> - 上季度</li>
                        <li><code>this_year</code> - 今年</li>
                        <li><code>last_year</code> - 去年</li>
                    </ul>

                    <h6 class="mt-4">提示</h6>
                    <ul>
                        <li>使用 <strong>Shift+Enter</strong> 可以换行</li>
                        <li>点击建议文本可以快速发送查询</li>
                        <li>查询结果会以 Markdown 表格形式展示</li>
                        <li>AI 会尝试理解您的意图，但请尽量使用清晰的表达</li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">我知道了</button>
                </div>
            </div>
        </div>
    </div>
}
