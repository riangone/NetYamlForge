@using NetYamlForge.Controllers
@using System.Text.Json
@{
    ViewData["Title"] = "AI User Simulation Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var isRunning = (bool)ViewBag.IsRunning;
    var logs = (List<SimulationLogEntry>)ViewBag.Logs;
    var findings = (List<FindingLogEntry>)ViewBag.Findings;
    var schedulerLog = (string)ViewBag.SchedulerLog;
}

<div class="container mx-auto p-4 md:p-8 max-w-7xl">
    <!-- Header Card with Premium Gradient & Glassmorphism -->
    <div class="card bg-base-100/70 backdrop-blur-md shadow-2xl border border-base-content/10 mb-8 overflow-hidden relative">
        <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500"></div>
        <div class="card-body flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 p-6 md:p-8">
            <div class="space-y-2">
                <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight flex items-center flex-wrap gap-2 md:gap-3">
                    <span class="bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 bg-clip-text text-transparent">AI Simulation Control Center</span>
                    <span class="text-[10px] md:text-xs font-mono px-2 py-0.5 md:py-1 bg-base-content/5 border border-base-content/10 rounded-full text-base-content/60">v1.1 (REST/HTTP)</span>
                </h1>
                <p class="text-xs md:text-sm text-base-content/60 max-w-2xl leading-relaxed">
                    Automated multi-persona client simulator (PM, Developer, Observer) verifying NetYamlForge system security boundaries and domain invariants.
                </p>
            </div>
            
            <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
                <!-- Status Badge -->
                <div class="flex items-center gap-2 px-3 py-1.5 bg-base-content/5 rounded-xl border border-base-content/10 text-xs md:text-sm font-semibold shrink-0">
                    <span class="text-base-content/55">Engine Status:</span>
                    @if (isRunning)
                    {
                        <span class="flex items-center gap-1.5 text-success font-bold">
                            <span class="relative flex h-2.5 w-2.5">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-success"></span>
                            </span>
                            Running
                        </span>
                    }
                    else
                    {
                        <span class="flex items-center gap-1.5 text-base-content/40 font-bold">
                            <span class="inline-flex rounded-full h-2.5 w-2.5 bg-base-content/30"></span>
                            Stopped
                        </span>
                    }
                </div>

                <!-- Actions -->
                <div class="flex gap-2 w-full sm:w-auto">
                    <form asp-action="Start" method="post" class="inline flex-1 sm:flex-initial">
                        <button type="submit" class="btn btn-primary btn-sm w-full sm:w-auto @(isRunning ? "btn-disabled opacity-50" : "") shadow-lg hover:scale-105 active:scale-95 transition-all duration-200">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" />
                            </svg>
                            Start
                        </button>
                    </form>
                    
                    <form asp-action="Stop" method="post" class="inline flex-1 sm:flex-initial">
                        <button type="submit" class="btn btn-neutral btn-sm w-full sm:w-auto @(!isRunning ? "btn-disabled opacity-50" : "") shadow-lg hover:scale-105 active:scale-95 transition-all duration-200">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 7.5A2.25 2.25 0 0 1 7.5 5.25h9a2.25 2.25 0 0 1 2.25 2.25v9a2.25 2.25 0 0 1-2.25 2.25h-9a2.25 2.25 0 0 1-2.25-2.25v-9Z" />
                            </svg>
                            Stop
                        </button>
                    </form>

                    <form asp-action="ClearLogs" method="post" class="inline flex-1 sm:flex-initial" onsubmit="return confirm('Are you sure you want to clear all simulation logs?');">
                        <button type="submit" class="btn btn-ghost btn-outline btn-sm w-full sm:w-auto border-base-content/10 text-error hover:bg-error hover:text-error-content shadow-sm transition-all duration-200">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                            </svg>
                            Clear
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info shadow-lg mb-6 border border-info/20 animate-fade-in">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-xs md:text-sm">@TempData["Message"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error shadow-lg mb-6 border border-error/20 animate-fade-in">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span class="text-xs md:text-sm">@TempData["Error"]</span>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8">
        <!-- Left 2 Cols: Logs & Invariant Board -->
        <div class="lg:col-span-2 flex flex-col gap-6 md:gap-8">
            
            <!-- Invariant Violations Board -->
            <div class="card bg-base-100/40 backdrop-blur shadow-xl border border-base-content/10">
                <div class="card-body p-5 md:p-6">
                    <h2 class="text-lg md:text-xl font-bold mb-4 flex items-center gap-2 text-warning">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                        </svg>
                        Anomalies & Invariant Violations
                    </h2>

                    @if (findings == null || findings.Count == 0)
                    {
                        <div class="flex flex-col items-center justify-center p-6 md:p-8 bg-success/5 border border-success/20 rounded-xl text-success animate-pulse-slow">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-10 h-10 mb-2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                            </svg>
                            <span class="font-bold text-xs md:text-sm">All Invariants Active & Secure</span>
                            <span class="text-[10px] md:text-xs opacity-75 mt-1 text-center max-w-md">No anomalies or authorization bypasses detected. The API permission gates are guarding all entity operations.</span>
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col gap-3 max-h-[350px] overflow-y-auto pr-1">
                            @foreach (var finding in findings)
                            {
                                <div class="collapse collapse-arrow bg-error/5 border border-error/20 rounded-xl">
                                    <input type="checkbox" class="peer" />
                                    <div class="collapse-title font-semibold text-error flex justify-between items-center gap-2 py-3 px-4 pr-10">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class="badge badge-error badge-xs uppercase font-bold text-[9px] px-1.5 py-0.5 shrink-0">Anomaly</span>
                                            <span class="text-xs md:text-sm truncate">[@finding.User.ToUpper()] @finding.Method @finding.Path</span>
                                        </div>
                                        <span class="text-[9px] opacity-60 font-mono shrink-0">@finding.Timestamp.Substring(11, 8)</span>
                                    </div>
                                    <div class="collapse-content bg-base-200/40 p-4 text-[10px] md:text-xs font-mono border-t border-error/10 flex flex-col gap-3">
                                        <div>
                                            <span class="text-base-content/50 block mb-1 font-bold">Request Payload:</span>
                                            <pre class="bg-base-300/80 p-2.5 rounded text-base-content/85 overflow-x-auto text-[10px]">@JsonSerializer.Serialize(finding.Payload)</pre>
                                        </div>
                                        <div>
                                            <span class="text-base-content/50 block mb-1 font-bold">Runner Audit Log:</span>
                                            <pre class="bg-base-300/80 p-2.5 rounded text-error/90 overflow-x-auto whitespace-pre-wrap text-[10px]">@finding.RunnerOutput</pre>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Simulation History List (Responsive Table vs Cards) -->
            <div class="card bg-base-100/50 backdrop-blur shadow-xl border border-base-content/10">
                <div class="card-body p-0">
                    <div class="p-5 md:p-6 pb-2 flex justify-between items-center">
                        <h2 class="text-lg md:text-xl font-bold flex items-center gap-2 text-indigo-500">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.03 0 1.9.693 2.166 1.638m-7.377 12.408.01-.01m-.01.01H9m.01-.011-.01.01m0-.01.011-.01M9 17.25h.01L9.01 17.24m-.01.01H9m.01-.011-.01.01m0-.01.011-.01M9 15.75h.01l-.01.001m-.01-.001H9m.01-.01-.01.01M9 14.25h.01l-.01.001M9 12h.01L9.01 12m-.01.011-.01-.011m0.01-.01-.01.01" />
                            </svg>
                            Activity Log
                        </h2>
                        <span class="text-[10px] md:text-xs text-base-content/40 font-mono">Showing last 30 requests</span>
                    </div>

                    @if (logs == null || logs.Count == 0)
                    {
                        <div class="p-8 text-center text-base-content/40 text-xs md:text-sm">
                            No logs recorded yet. Start simulation to collect activities.
                        </div>
                    }
                    else
                    {
                        <!-- DESKTOP VIEW: Shown on Tablet & Desktop, hidden on Mobile -->
                        <div class="hidden md:block overflow-x-auto w-full">
                            <table class="table w-full border-collapse">
                                <thead>
                                    <tr class="bg-base-200/50 border-b border-base-content/10">
                                        <th class="rounded-none py-3 text-[11px] font-bold text-base-content/50 uppercase">User</th>
                                        <th class="py-3 text-[11px] font-bold text-base-content/50 uppercase">Action</th>
                                        <th class="py-3 text-[11px] font-bold text-base-content/50 uppercase">Endpoint</th>
                                        <th class="py-3 text-[11px] font-bold text-base-content/50 uppercase">Status</th>
                                        <th class="py-3 text-[11px] font-bold text-base-content/50 uppercase">Latency</th>
                                        <th class="py-3 text-[11px] font-bold text-base-content/50 uppercase">Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < logs.Count; i++)
                                    {
                                        var log = logs[i];
                                        var hasViolations = log.InvariantViolations != null && log.InvariantViolations.Count > 0;
                                        var statusClass = log.StatusCode >= 500 ? "text-error" 
                                                          : log.StatusCode >= 400 ? "text-warning" 
                                                          : "text-success";
                                        var badgeClass = log.Role == "pm" ? "badge-primary" 
                                                         : log.Role == "dev" ? "badge-secondary" 
                                                         : "badge-accent";
                                        
                                        <tr class="hover:bg-base-content/5 cursor-pointer border-b border-base-200/60 transition-colors" onclick="toggleDetails(@i)">
                                            <td class="py-3">
                                                <div class="flex items-center gap-2">
                                                    <span class="badge @badgeClass badge-xs font-bold uppercase text-[9px] px-1.5 py-1 shrink-0">@log.Role</span>
                                                    <span class="font-medium text-xs">@log.User</span>
                                                </div>
                                            </td>
                                            <td class="font-mono text-xs font-bold text-base-content/75 py-3">@log.Method</td>
                                            <td class="text-xs truncate max-w-[200px] py-3 text-base-content/70" title="@log.Path">@log.Path</td>
                                            <td class="font-bold text-xs @statusClass py-3">
                                                <span class="inline-flex items-center gap-1">
                                                    @if (hasViolations)
                                                    {
                                                        <span class="text-error font-black" title="Violations Detected">⚠ @log.StatusCode</span>
                                                    }
                                                    else
                                                    {
                                                        <span>@log.StatusCode</span>
                                                    }
                                                </span>
                                            </td>
                                            <td class="text-xs text-base-content/60 font-mono py-3">@log.DurationMs<span class="text-[10px] opacity-70">ms</span></td>
                                            <td class="text-xs text-base-content/40 py-3">@log.Timestamp.Substring(11, 8)</td>
                                        </tr>
                                        <tr id="details-@i" class="hidden bg-base-200/40 border-b border-base-200/60">
                                            <td colspan="6" class="p-4">
                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-[10px] md:text-xs font-mono">
                                                    <div>
                                                        <span class="text-base-content/50 block mb-1 font-bold">Request Payload:</span>
                                                        <pre class="bg-base-300/80 p-3 rounded overflow-x-auto max-h-48 text-[10px] md:text-[11px] text-base-content/85">@JsonSerializer.Serialize(log.RequestPayload, new JsonSerializerOptions { WriteIndented = true })</pre>
                                                    </div>
                                                    <div>
                                                        <span class="text-base-content/50 block mb-1 font-bold">Response Payload:</span>
                                                        <pre class="bg-base-300/80 p-3 rounded overflow-x-auto max-h-48 text-[10px] md:text-[11px] text-base-content/85">@JsonSerializer.Serialize(log.ResponsePayload, new JsonSerializerOptions { WriteIndented = true })</pre>
                                                    </div>
                                                </div>
                                                @if (hasViolations)
                                                {
                                                    <div class="mt-3 p-3 bg-error/10 rounded border border-error/20 flex flex-col gap-1 text-[11px] text-error">
                                                        <span class="font-bold uppercase tracking-wider text-[9px]">Violated Invariants:</span>
                                                        @foreach (var violation in log.InvariantViolations!)
                                                        {
                                                            <div class="flex items-start gap-2">
                                                                <span class="font-extrabold">•</span>
                                                                <span><strong class="font-bold">[@violation.Type]</strong> @violation.Message</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- MOBILE VIEW: Fully Optimized Responsive Card List (Hidden on Tablet/Desktop) -->
                        <div class="block md:hidden flex flex-col divide-y divide-base-content/10">
                            @for (var i = 0; i < logs.Count; i++)
                            {
                                var log = logs[i];
                                var hasViolations = log.InvariantViolations != null && log.InvariantViolations.Count > 0;
                                var badgeClass = log.Role == "pm" ? "badge-primary" 
                                                 : log.Role == "dev" ? "badge-secondary" 
                                                 : "badge-accent";
                                
                                var statusBadgeClass = log.StatusCode >= 500 ? "badge-error text-error-content" 
                                                      : log.StatusCode >= 400 ? "badge-warning text-warning-content" 
                                                      : "badge-success text-success-content";

                                <div class="p-4 hover:bg-base-content/5 transition-colors cursor-pointer" onclick="toggleDetailsMobile(@i)">
                                    <div class="flex items-center justify-between mb-2">
                                        <div class="flex items-center gap-2">
                                            <span class="badge @badgeClass badge-xs font-bold uppercase text-[8px] px-1.5 py-0.5">@log.Role</span>
                                            <span class="font-bold text-xs text-base-content/85">@log.User</span>
                                        </div>
                                        <span class="text-[9px] text-base-content/40 font-mono">@log.Timestamp.Substring(11, 8)</span>
                                    </div>
                                    
                                    <div class="flex items-center justify-between gap-3">
                                        <div class="flex items-center gap-1.5 min-w-0">
                                            <span class="text-[10px] font-mono font-bold px-1 py-0.5 bg-base-200 border border-base-content/10 rounded shrink-0">@log.Method</span>
                                            <span class="text-xs truncate font-mono text-base-content/70 min-w-0" title="@log.Path">@log.Path</span>
                                        </div>
                                        <div class="flex items-center gap-2 shrink-0">
                                            <span class="text-[9px] font-mono text-base-content/50">@log.DurationMs<span>ms</span></span>
                                            <span class="badge @statusBadgeClass badge-sm font-bold font-mono text-[10px] px-1.5 py-0.5">
                                                @if (hasViolations) { <text>⚠ </text> } @log.StatusCode
                                            </span>
                                        </div>
                                    </div>
                                    
                                    <!-- Mobile details expansion -->
                                    <div id="details-mobile-@i" class="hidden mt-3 pt-3 border-t border-base-content/5 flex flex-col gap-3">
                                        <div class="text-[10px] font-mono flex flex-col gap-2.5">
                                            <div>
                                                <span class="text-base-content/55 block mb-1 font-bold">Request Payload:</span>
                                                <pre class="bg-base-300/80 p-2.5 rounded overflow-x-auto text-[9px] max-h-36">@JsonSerializer.Serialize(log.RequestPayload)</pre>
                                            </div>
                                            <div>
                                                <span class="text-base-content/55 block mb-1 font-bold">Response Payload:</span>
                                                <pre class="bg-base-300/80 p-2.5 rounded overflow-x-auto text-[9px] max-h-36">@JsonSerializer.Serialize(log.ResponsePayload)</pre>
                                            </div>
                                        </div>
                                        @if (hasViolations)
                                        {
                                            <div class="p-2.5 bg-error/10 rounded border border-error/20 flex flex-col gap-1 text-[10px] text-error">
                                                <span class="font-bold uppercase tracking-wider text-[8px]">Violated Invariants:</span>
                                                @foreach (var violation in log.InvariantViolations!)
                                                {
                                                    <div class="flex items-start gap-1">
                                                        <span class="font-extrabold text-[9px]">•</span>
                                                        <span><strong class="font-bold">[@violation.Type]</strong> @violation.Message</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            
        </div>

        <!-- Right 1 Col: Terminal & Architecture info -->
        <div class="flex flex-col gap-6 md:gap-8">
            
            <!-- Terminal Console Box with Realistic Header -->
            <div class="card bg-neutral shadow-2xl border border-neutral-content/10 text-neutral-content overflow-hidden">
                <div class="card-body p-0">
                    <div class="bg-neutral-focus border-b border-neutral-content/10 px-4 py-3 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-error/85"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-warning/85"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-success/85"></span>
                            <span class="text-[10px] md:text-xs font-mono ml-2 text-neutral-content/65">scheduler_output.log</span>
                        </div>
                        <span class="text-[9px] uppercase font-mono px-2 py-0.5 bg-neutral-content/15 rounded text-neutral-content/60">Live Log</span>
                    </div>
                    <div class="p-4 font-mono text-[10px] md:text-[11px] leading-relaxed max-h-[300px] overflow-y-auto bg-neutral/95" id="console-logs">
                        <pre class="whitespace-pre-wrap select-all text-neutral-content/90">@schedulerLog</pre>
                    </div>
                </div>
            </div>

            <!-- Invariant Rules Summary Card -->
            <div class="card bg-base-100 shadow-xl border border-base-content/10">
                <div class="card-body p-5 md:p-6">
                    <h2 class="text-base md:text-lg font-bold mb-3 flex items-center gap-2 border-b border-base-content/10 pb-2 text-indigo-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4.5 h-4.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                        Security & Business Invariants
                    </h2>
                    
                    <ul class="flex flex-col gap-3 text-xs text-base-content/85">
                        <li class="flex items-start gap-2">
                            <div class="badge badge-sm badge-outline badge-primary mt-0.5 font-mono text-[9px] w-5 h-5 rounded-full flex items-center justify-center p-0 shrink-0">1</div>
                            <div>
