<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8602;CS8620;CS8625</NoWarn>
    <!-- ローカル開発環境では NuGet 監査ネットワーク依存警告（NU1900）を抑止。CI では監査を維持。 -->
    <NuGetAudit Condition="'$(CI)' != 'true'">false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schemas\project-schema.json" />
    <EmbeddedResource Include="Schemas\ui-page-schema.json" />
    <EmbeddedResource Include="Schemas\entity-schema.json" />
    <EmbeddedResource Include="Schemas\dashboard-schema.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- プロジェクト固有の pdf-templates/ ディレクトリをビルド出力にコピー -->
    <Content Include="projects\**\pdf-templates\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- スキル（プロンプトテンプレート）ディレクトリをコピー -->
    <Content Include="skills\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- アナライザープロジェクト：禁止パターンをビルド時に検出 (DCS001-DCS004) -->
    <ProjectReference Include="..\NetYamlForge.Analyzers\NetYamlForge.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- AI プロジェクト参照 (実際の場所がプロジェクトフォルダ内のため修正) -->
    <ProjectReference Include="NetYamlForge.AI\NetYamlForge.AI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="JsonSchema.Net" Version="8.0.0" />
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="MimeKit" Version="4.15.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="MySql.Data" Version="9.2.0" />
    <PackageReference Include="Npgsql" Version="8.0.6" />
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Stateless" Version="5.20.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="PDFsharp" Version="7.0.0-preview-1" />
  </ItemGroup>
  <!-- wwwroot/fonts のフォントファイルをビルド出力にコピー -->
  <ItemGroup>
    <None Include="wwwroot\fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyWwwrootFonts" AfterTargets="Build">
    <Copy SourceFiles="wwwroot/fonts/NotoSansJP-Regular.ttf" DestinationFiles="$(OutDir)wwwroot/fonts/NotoSansJP-Regular.ttf" SkipUnchangedFiles="true" />
    <Copy SourceFiles="wwwroot/fonts/NotoSansJP-Bold.ttf" DestinationFiles="$(OutDir)wwwroot/fonts/NotoSansJP-Bold.ttf" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <!-- Exclude AI project directories (they are separate projects with their own compilation) -->
    <Compile Remove="..\NetYamlForge.AI\**\*.cs" />
    <Compile Remove="..\NetYamlForge.AI.Web\**\*.cs" />
    <Compile Remove="NetYamlForge.AI\**\*.cs" />
    <Compile Remove="NetYamlForge.AI.Web\**\*.cs" />
    <EmbeddedResource Remove="..\NetYamlForge.AI\**\*.*resx" />
    <EmbeddedResource Remove="..\NetYamlForge.AI.Web\**\*.*resx" />
    <EmbeddedResource Remove="NetYamlForge.AI\**\*.*resx" />
    <EmbeddedResource Remove="NetYamlForge.AI.Web\**\*.*resx" />
    <None Include="..\NetYamlForge.AI\**\*.*" />
    <None Include="..\NetYamlForge.AI.Web\**\*.*" />
    <None Include="NetYamlForge.AI\**\*.*" />
    <None Include="NetYamlForge.AI.Web\**\*.*" />
  </ItemGroup>
</Project>
