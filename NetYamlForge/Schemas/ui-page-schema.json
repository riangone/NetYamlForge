{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamiccrudsample.local/schemas/ui-page-schema.json",
  "title": "UI Page Definition Schema",
  "type": "object",
  "required": ["title", "sections"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "mainTable": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "calendarUi": {
      "type": "object",
      "properties": {
        "mobileMonthCount":       { "type": "integer", "minimum": 1 },
        "desktopMinMonthCount":   { "type": "integer", "minimum": 1 },
        "desktopMaxMonthCount":   { "type": "integer", "minimum": 1 },
        "showJapanHolidays":      { "type": "boolean" },
        "japanHolidayProvider":   { "enum": ["hybrid", "api", "builtin"] },
        "japanHolidayApiUrlTemplate": { "type": "string" },
        "japanHolidayApiTimeoutMs":   { "type": "integer", "minimum": 0 },
        "showChineseLunar":       { "type": "boolean" },
        "thirdPartyHolidays":     { "type": "array" },
        "customHolidays":         { "type": "array" }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sourceType"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "visibleToRoles": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sourceType": {
            "enum": ["none", "table", "custom"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string"
          },
          "columns": {
            "anyOf": [
              {
                "type": "array",
                "items": { "type": "string" }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "label":      { "type": "string" },
                    "labelKey":   { "type": "string" },
                    "labelI18n":  { "type": "object" },
                    "type": {
                      "enum": ["string", "int", "long", "decimal", "double", "bool",
                               "date", "datetime", "textarea", "email", "select",
                               "radio", "color", "money", "rating", "file"]
                    },
                    "hidden":     { "type": "boolean" },
                    "sortable":   { "type": "boolean" },
                    "searchable": { "type": "boolean" },
                    "options":    {},
                    "foreignKey": { "type": "object" }
                  },
                  "additionalProperties": true
                }
              }
            ]
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "editable": {
            "type": "boolean"
          },
          "readOnly": {
            "type": "boolean"
          },
          "size": {
            "enum": ["xs", "sm", "md", "lg"]
          },
          "foreignKey": {
            "type": "string"
          },
          "localForeignKey": {
            "type": "string"
          },
          "targetTable": {
            "type": "string"
          },
          "targetPrimaryKey": {
            "type": "string"
          },
          "updatableFields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "filters": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "label":     { "type": "string" },
                "labelKey":  { "type": "string" },
                "labelI18n": { "type": "object" },
                "type": {
                  "enum": ["like", "eq", "dropdown", "date-range", "range",
                           "toggle-group", "bool-toggle", "multi-select",
                           "checkbox", "entity-picker", "entity-multi-picker",
                           "gte", "lte", "select"]
                },
                "options": {}
              },
              "additionalProperties": true
            }
          },
          "paging": {
            "type": "object",
            "properties": {
              "pageSize":    { "type": "integer", "minimum": 1 },
              "mode":        { "enum": ["offset", "cursor", "numbered", "keyset"] },
              "enableCount": { "type": "boolean" }
            },
            "additionalProperties": true
          },
          "forms": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "title":  { "type": "string" },
                "fields": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": true
            }
          },
          "fieldDefs": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "label":       { "type": "string" },
                "labelKey":    { "type": "string" },
                "labelI18n":   { "type": "object" },
                "type": {
                  "enum": ["string", "int", "long", "decimal", "double", "bool",
                           "date", "datetime", "textarea", "email", "select",
                           "radio", "color", "money", "rating", "file"]
                },
                "required":    { "type": "boolean" },
                "editable":    { "type": "boolean" },
                "options":     {},
                "placeholder": { "type": "string" },
                "foreignKey":  { "type": "object" }
              },
              "additionalProperties": true
            }
          },
          "hooks": {
            "type": "object",
            "properties": {
              "presets":      { "type": "object" },
              "beforeCreate": {},
              "afterCreate":  {},
              "beforeUpdate": {},
              "afterUpdate":  {},
              "beforeDelete": {},
              "afterDelete":  {}
            },
            "additionalProperties": true
          },
          "confirmation": {
            "type": "object",
            "properties": {
              "create": { "type": "string" },
              "update": { "type": "string" },
              "delete": { "type": "string" }
            }
          },
          "xField":            { "type": "string" },
          "yField":            { "type": "string" },
          "colorField":        { "type": "string" },
          "valueField":        { "type": "string" },
          "labelField":        { "type": "string" },
          "iconField":         { "type": "string" },
          "deltaField":        { "type": "string" },
          "subValueField":     { "type": "string" },
          "groupBy":           { "type": "string" },
          "cardTitle":         { "type": "string" },
          "cardSubtitle":      { "type": "string" },
          "dateField":         { "type": "string" },
          "eventField":        { "type": "string" },
          "descField":         { "type": "string" },
          "progressField":     { "type": "string" },
          "maxField":          { "type": "string" },
          "titleField":        { "type": "string" },
          "subtitleField":     { "type": "string" },
          "descriptionField":  { "type": "string" },
          "imageField":        { "type": "string" },
          "actionUrl":         { "type": "string" },
          "contentField":      { "type": "string" },
          "expandedByDefault": { "type": "boolean" },
          "nameField":         { "type": "string" },
          "avatarField":       { "type": "string" },
          "trendField":        { "type": "string" },
          "parentField":       { "type": "string" },
          "emailField":        { "type": "string" },
          "typeField":         { "type": "string" },
          "userField":         { "type": "string" },
          "currentField":      { "type": "string" },
          "targetField":       { "type": "string" },
          "unitField":         { "type": "string" },
          "deadlineField":     { "type": "string" },
          "uploadUrl":         { "type": "string" },
          "maxFileSize":       { "type": "integer", "minimum": 0 },
          "allowedTypes":      { "type": "string" },
          "multiple":          { "type": "boolean" },
          "startDateField":    { "type": "string" },
          "endDateField":      { "type": "string" },
          "color":             { "type": "string" },
          "icon":              { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
