{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamiccrudsample.local/schemas/ui-page-schema.json",
  "title": "UI Page Definition Schema",
  "type": "object",
  "required": ["title", "sections"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "main_table": {
      "type": "string"
    },
    "ui": {
      "type": "object",
      "properties": {
        "page": {
          "type": "object",
          "properties": {
            "layout": {
              "enum": ["single", "two-pane", "stack"]
            },
            "density": {
              "enum": ["compact", "comfortable", "spacious"]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_type", "source"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "source_type": {
            "enum": ["table", "custom"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "columns": {
            "anyOf": [
              {
                "type": "array",
                "items": { "type": "string" }
              },
              {
                "type": "object"
              }
            ]
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "editable": {
            "type": "boolean"
          },
          "read_only": {
            "type": "boolean"
          },
          "filters": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "type": { "enum": ["like", "eq", "select", "gte", "lte", "toggle_group", "bool_toggle", "date_range", "date-range", "range"] }
              },
              "additionalProperties": true
            }
          },
          "paging": {
            "type": "object",
            "properties": {
              "page_size": { "type": "integer", "minimum": 1 },
              "mode": { "enum": ["offset", "cursor", "numbered"] },
              "enable_count": { "type": "boolean" }
            },
            "additionalProperties": true
          },
          "forms": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "fields": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": true
            }
          },
          "field_defs": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" }
              },
              "additionalProperties": true
            }
          },
          "ui": {
            "type": "object",
            "properties": {
              "component": {
                "enum": ["DataTable", "StatsCard", "Chart", "FormPanel", "ActionBar"]
              },
              "selectable": {
                "enum": ["none", "single", "multi"]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
