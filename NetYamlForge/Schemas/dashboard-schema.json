{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynamiccrudsample.local/schemas/dashboard-schema.json",
  "title": "Dashboard Definition Schema",
  "type": "object",
  "properties": {
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity", "aggregate"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "labelKey": { "type": "string", "minLength": 1 },
          "labelI18n": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "entity": { "type": "string", "minLength": 1 },
          "aggregate": { "enum": ["count", "sum", "avg"] },
          "column": { "type": "string" },
          "filter": { "type": "string" },
          "icon": { "type": "string" },
          "color": { "type": "string" }
        },
        "anyOf": [
          { "required": ["label"] },
          { "required": ["labelKey"] }
        ],
        "additionalProperties": true
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "entity", "valueAggregate"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "titleKey": { "type": "string", "minLength": 1 },
          "titleI18n": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "type": { "enum": ["bar", "line", "doughnut", "pie"] },
          "entity": { "type": "string", "minLength": 1 },
          "valueAggregate": { "enum": ["count", "sum", "avg"] },
          "valueColumn": { "type": "string" },
          "groupExpression": { "type": "string" },
          "labelJoinEntity": { "type": "string" },
          "labelJoinKey": { "type": "string" },
          "labelJoinDisplay": { "type": "string" },
          "orderBy": { "enum": ["label", "value"] },
          "orderDir": { "enum": ["asc", "desc"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
          "filter": { "type": "string" },
          "colorBg": { "type": "string" },
          "colorBorder": { "type": "string" },
          "colors": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "anyOf": [
          { "required": ["title"] },
          { "required": ["titleKey"] }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
