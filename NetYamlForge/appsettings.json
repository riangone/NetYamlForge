{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "DatabaseProvider": "sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=chinook.db",
    "SqlServer": "Server=localhost;Database=Chinook;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AICli": {
    "DefaultTool": "qwen",
    "TaskTimeoutSeconds": 1800,
    "MaxConcurrentTasks": 2,
    "DefaultWorkingDirectory": "/home/ubuntu/ws/NetYamlForge",
    "DefaultAllowedTools": [
      "Read", "Write", "Edit", "Bash", "Git"
    ],
    "Claude": {
      "ApiKey": "",
      "Path": "/home/ubuntu/.local/bin/claude"
    },
    "QwenCode": {
      "ApiKey": "",
      "BaseUrl": "",
      "Model": "",
      "Path": "/home/ubuntu/.nvm/versions/node/v24.13.0/bin/qwen"
    },
    "Codex": {
      "ApiKey": "",
      "BaseUrl": "",
      "Organization": "",
      "Model": "",
      "Path": "/home/ubuntu/.nvm/versions/node/v24.13.0/bin/codex"
    },
    "Gemini": {
      "ApiKey": "",
      "ProjectId": "",
      "DeveloperMode": false,
      "Model": "",
      "Path": "/home/ubuntu/.nvm/versions/node/v24.13.0/bin/gemini"
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "qwen2.5-coder",
      "Path": "",
      "UseApi": true,
      "ContextSize": 4096,
      "Temperature": 0.7
    },
    "LmStudio": {
      "BaseUrl": "http://localhost:1234",
      "Model": "",
      "ContextSize": 4096,
      "Temperature": 0.7
    },
    "Copilot": {
      "Token": "",
      "Path": "/home/ubuntu/.local/bin/copilot"
    }
  },
  "AiWindow": {
    "CliFirst": true,
    "CliTimeoutSeconds": 30,
    "ProviderPriority": ["qwen", "claude", "gemini", "ollama"],
    "DefaultProvider": "qwen",
    "MaxResponseChars": 0,
    "Claude": {
      "ApiKey": "",
      "Model": "claude-sonnet-4-6",
      "MaxTokens": 1024
    },
    "DealerName": "AI 窓口ディーラー",
    "BusinessHours": "月〜土 9:00〜18:00（日曜・祝日定休）",
    "FallbackToTemplate": true
  },
  "HotReload": {
    "Enabled": true,
    "OnlyInDevelopment": true,
    "DebounceMs": 500
  },
  "AllowedHosts": "*"
}
