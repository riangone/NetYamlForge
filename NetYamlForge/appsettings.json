{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Paths": {
    "Data": "var/data",
    "Run": "var/run",
    "Log": "var/log"
  },
  "WebPush": {
    "Subject": "mailto:admin@netyamlforge.local"
  },
  "DirectoryImport": {
    "_comment": "directory_import バッチジョブ（例: photo-vault の「サーバーディレクトリ指定」インポート）が読み取りを許可するルートディレクトリの絶対パス一覧。空配列（既定）の場合は安全側に倒し、いかなる source_path も拒否する。管理者が信頼できるディレクトリのみを明示的に列挙すること。",
    "AllowedRoots": []
  },
  "DatabaseProvider": "sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=chinook.db",
    "SqlServer": "Server=localhost;Database=Chinook;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "HotReload": {
    "Enabled": true,
    "OnlyInDevelopment": true,
    "DebounceMs": 500
  },
  "AllowedHosts": "*",
  "EmbeddingProvider": "local",
  "AiCliChain": {
    "TimeoutSeconds": 90,
    "DefaultOrder": [ "opencode", "antigravity", "claude" ],
    "Providers": {
      "opencode": {
        "Command": "opencode",
        "ArgsTemplate": "run \"{prompt}\"{model}{variant} --dangerously-skip-permissions",
        "SupportsVariant": true,
        "VariantFlag": "--variant",
        "PreferredForImages": false,
        "DefaultModel": "",
        "DefaultVariant": ""
      },
      "antigravity": {
        "Command": "antigravity",
        "ArgsTemplate": "-p \"{prompt}\"{model} --dangerously-skip-permissions",
        "SupportsVariant": false,
        "VariantFlag": "--variant",
        "PreferredForImages": true,
        "DefaultModel": "",
        "DefaultVariant": ""
      },
      "claude": {
        "Command": "claude",
        "ArgsTemplate": "-p \"{prompt}\"{model}{variant} --dangerously-skip-permissions",
        "SupportsVariant": true,
        "VariantFlag": "--effort",
        "PreferredForImages": false,
        "DefaultModel": "",
        "DefaultVariant": ""
      }
    }
  },
  "SlotFilling": {
    "DefaultProjectId": "auto-dealer-demo"
  },
  "Appointment": {
    "DefaultProjectId": "auto-dealer-demo"
  },
  "Forge": {
    "SchemaValidation": {
      "Mode": "Warn",
      "FailFastOnStartup": false,
      "IncludeGlobs": [ "**/*.yml", "**/*.yaml" ],
      "ExcludeGlobs": [ "**/_disabled/**" ]
    }
  }
}
