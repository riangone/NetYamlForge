{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "DatabaseProvider": "sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=chinook.db",
    "SqlServer": "Server=localhost;Database=Chinook;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AICli": {
    "DefaultTool": "qwen",
    "TaskTimeoutSeconds": 1800,
    "MaxConcurrentTasks": 2,
    "DefaultWorkingDirectory": "/home/ubuntu/ws/NetYamlForge",
    "DefaultAllowedTools": [
      "Read", "Write", "Edit", "Bash", "Git"
    ],
    "Claude": {
      "ApiKey": "",
      "Path": ""
    },
    "QwenCode": {
      "ApiKey": "",
      "BaseUrl": "",
      "Model": "",
      "Path": ""
    }
  },
  "HotReload": {
    "Enabled": true,
    "OnlyInDevelopment": true,
    "DebounceMs": 500
  },
  "AllowedHosts": "*"
}
