{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "DatabaseProvider": "sqlite",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=chinook.db",
    "SqlServer": "Server=localhost;Database=Chinook;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AICli": {
    "DefaultTool": "claude",
    "TaskTimeoutSeconds": 3600,
    "MaxConcurrentTasks": 2,
    "DefaultWorkingDirectory": "/home/ubuntu/ws/NetYamlForge",
    "DefaultAllowedTools": [
      "Read", "Write", "Edit", "Bash", "Git"
    ],
    "QwenCode": {
      "Path": "/home/ubuntu/.nvm/versions/node/v24.13.0/bin/qwen",
      "Model": "qwen-plus"
    },
    "Claude": {
      "Path": "/home/ubuntu/.local/bin/claude",
      "Model": "haiku",
      "ChatEffort": "low"
    },
    "Codex": {
      "Path": "/home/ubuntu/.nvm/versions/node/v24.13.0/bin/codex",
      "Model": "gpt-4o-mini"
    },
    "Gemini": {
      "Path": "/home/ubuntu/.nvm/versions/node/v24.13.0/bin/gemini",
      "Model": "gemini-2.0-flash"
    },
    "Copilot": {
      "Path": "/home/ubuntu/.local/bin/copilot"
    }
  },
  "AiWindow": {
    "CliFirst": true,
    "CliTimeoutSeconds": 3600,
    "ChatResponseTimeoutSeconds": 3600,
    "ProviderPriority": ["claude", "qwen", "gemini", "ollama"],
    "DefaultProvider": "claude",
    "MaxResponseChars": 0,
    "FallbackToTemplate": false,
    "DealerName": "AI 窓口ディーラー",
    "BusinessHours": "月〜土 9:00〜18:00（日曜・祝日定休）"
  },
  "HotReload": {
    "Enabled": true,
    "OnlyInDevelopment": true,
    "DebounceMs": 500
  },
  "AllowedHosts": "*"
}
