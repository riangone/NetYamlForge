@model List<NetYamlForge.AI.Models.AiTaskRecord>
@{
    ViewData["Title"] = "AI Pipeline 管理";
}

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">AI Pipeline 管理</h1>

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            @TempData["Error"]
        </div>
    }

    <!-- 执行新任务表单 -->
    <div class="bg-white shadow-md rounded-lg p-6 mb-6">
        <h2 class="text-xl font-semibold mb-4">执行新任务</h2>
        <form asp-action="Execute" asp-controller="AiPipeline" method="post">
            @Html.AntiForgeryToken()
            
            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="prompt">
                    任务描述
                </label>
                <textarea 
                    id="prompt" 
                    name="prompt" 
                    rows="4"
                    class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
                    placeholder="例如：为 Task 实体创建 CRUD 页面和钩子代码"
                    required></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="projectName">
                        项目名称（可选）
                    </label>
                    <input 
                        type="text" 
                        id="projectName" 
                        name="projectName"
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
                        placeholder="例如：my-project">
                </div>

                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="targetDir">
                        目标目录（可选）
                    </label>
                    <input 
                        type="text" 
                        id="targetDir" 
                        name="targetDir"
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
                        placeholder="例如：/path/to/project">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="pipelineMode">
                        Pipeline 模式
                    </label>
                    <select 
                        id="pipelineMode" 
                        name="pipelineMode"
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline">
                        <option value="full">完整模式 (Planner → Generator → Evaluator)</option>
                        <option value="single">单 AI 模式</option>
                    </select>
                </div>

                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-2" for="timeout">
                        超时（秒，可选）
                    </label>
                    <input 
                        type="number" 
                        id="timeout" 
                        name="timeout"
                        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
                        placeholder="3600">
                </div>
            </div>

            <div class="flex items-center justify-end">
                <button 
                    type="submit" 
                    class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">
                    执行任务
                </button>
            </div>
        </form>
    </div>

    <!-- 任务列表 -->
    <div class="bg-white shadow-md rounded-lg p-6">
        <h2 class="text-xl font-semibold mb-4">任务历史</h2>

        @if (Model == null || Model.Count == 0)
        {
            <p class="text-gray-500">暂无任务</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full bg-white">
                    <thead>
                        <tr>
                            <th class="py-2 px-4 border-b">任务 ID</th>
                            <th class="py-2 px-4 border-b">Prompt</th>
                            <th class="py-2 px-4 border-b">项目</th>
                            <th class="py-2 px-4 border-b">状态</th>
                            <th class="py-2 px-4 border-b">文件数</th>
                            <th class="py-2 px-4 border-b">创建时间</th>
                            <th class="py-2 px-4 border-b">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.OrderByDescending(t => t.CreatedAt))
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="py-2 px-4 border-b font-mono text-sm">@task.TaskId</td>
                                <td class="py-2 px-4 border-b max-w-xs truncate">@task.Prompt</td>
                                <td class="py-2 px-4 border-b">@(task.ProjectName ?? "-")</td>
                                <td class="py-2 px-4 border-b">
                                    @if (task.Status == "completed")
                                    {
                                        <span class="bg-green-100 text-green-800 text-xs font-medium px-2 py-1 rounded">成功</span>
                                    }
                                    else if (task.Status == "failed")
                                    {
                                        <span class="bg-red-100 text-red-800 text-xs font-medium px-2 py-1 rounded">失败</span>
                                    }
                                    else
                                    {
                                        <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2 py-1 rounded">@task.Status</span>
                                    }
                                </td>
                                <td class="py-2 px-4 border-b">@task.GeneratedFilesCount</td>
                                <td class="py-2 px-4 border-b text-sm">@task.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="py-2 px-4 border-b">
                                    <a asp-action="Details" asp-route-taskId="@task.TaskId" class="text-blue-500 hover:text-blue-700">查看</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
