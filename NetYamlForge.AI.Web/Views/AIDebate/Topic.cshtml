@{
    var topic = ViewBag.Topic as NetYamlForge.AI.Models.Debate.DebateTopic;
    var messages = ViewBag.Messages as List<NetYamlForge.AI.Models.Debate.DebateMessage> ?? new();
    bool isRunning = ViewBag.IsRunning;
    ViewBag.Title = topic?.Title ?? "ディベート";
}

@section Styles {
    <link rel="stylesheet" href="/css/ai-debate.css" />
}

<div class="debate-topic-page">
    <!-- ヘッダー -->
    <div class="topic-header">
        <a href="/AIDebate" class="back-link">← ディベート一覧</a>
        <div class="topic-info">
            <h1>@topic?.Title</h1>
            @if (!string.IsNullOrWhiteSpace(topic?.Description))
            {
                <p class="topic-description">@topic.Description</p>
            }
            <div class="topic-meta">
                <span id="statusBadge" class="status-badge status-@topic?.Status">@GetStatusLabel(topic?.Status)</span>
                <span class="created-at">作成: @topic?.CreatedAt</span>
            </div>
        </div>
    </div>

    <!-- AI 情報バー -->
    <div class="ai-info-bar">
        <div class="ai-panel left-panel">
            <div class="ai-name">🤖 @topic?.LeftAi <span class="turn-counter">(<span id="leftCount">@topic?.LeftCount</span>/11)</span></div>
            @if (!string.IsNullOrWhiteSpace(topic?.LeftRole))
            {
                <div class="ai-role">役割: @topic.LeftRole</div>
            }
        </div>
        <div class="vs-divider">VS</div>
        <div class="ai-panel right-panel">
            <div class="ai-name">🤖 @topic?.RightAi <span class="turn-counter">(<span id="rightCount">@topic?.RightCount</span>/11)</span></div>
            @if (!string.IsNullOrWhiteSpace(topic?.RightRole))
            {
                <div class="ai-role">役割: @topic.RightRole</div>
            }
        </div>
    </div>

    <!-- コントロールバー -->
    <div class="control-bar">
        @if (topic?.Status == "pending")
        {
            <button id="startBtn" class="btn-start" onclick="startDebate(@topic.Id)">
                ▶ 議論を開始
            </button>
        }
        else if (topic?.Status == "running" || isRunning)
        {
            <button id="cancelBtn" class="btn-cancel" onclick="cancelDebate(@topic?.Id)">
                ⏹ 議論を中止
            </button>
            <div class="running-indicator">
                <div class="spinner"></div>
                <span>議論中...</span>
            </div>
        }
        else if (topic?.Status == "completed")
        {
            <div class="completed-badge">✅ 議論が完了しました</div>
        }
        else if (topic?.Status == "cancelled")
        {
            <div class="cancelled-badge">⛔ 議論がキャンセルされました</div>
            <button class="btn-start" onclick="startDebate(@topic?.Id)">▶ 再開</button>
        }
        else if (topic?.Status == "error")
        {
            <div class="error-badge">❌ エラーが発生しました</div>
            <button class="btn-start" onclick="startDebate(@topic?.Id)">▶ 再試行</button>
        }
    </div>

    <!-- チャットエリア -->
    <div class="chat-area">
        <div class="chat-header">
            <div class="chat-col-header left">🤖 @topic?.LeftAi（左）</div>
            <div class="chat-col-header right">🤖 @topic?.RightAi（右）</div>
        </div>
        <div class="messages-container" id="messagesContainer">
            @foreach (var msg in messages)
            {
                <div class="message-row @msg.AiSide-side" id="msg-@msg.Id">
                    <div class="message-bubble @msg.AiSide">
                        <div class="message-meta">
                            <span class="message-sender">@msg.AiProvider</span>
                            <span class="message-turn">第@msg.MessageIndex発言</span>
                            <span class="message-time">@msg.CreatedAt[11..]</span>
                        </div>
                        <div class="message-content markdown-content" data-md="@msg.Content"></div>
                    </div>
                </div>
            }
            <div id="typingIndicator" class="typing-indicator hidden">
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="/js/ai-debate-topic.js"></script>
    <script>
        const TOPIC_ID = @topic?.Id;
        const INITIAL_STATUS = '@topic?.Status';
        initDebatePage(TOPIC_ID, INITIAL_STATUS);
        // 既存メッセージを Markdown レンダリング
        document.querySelectorAll('.message-content[data-md]').forEach(function(el) {
            el.innerHTML = renderDebateMarkdown(el.getAttribute('data-md'));
        });
    </script>
}

@functions {
    string GetStatusLabel(string? status) => status switch {
        "pending" => "⏳ 待機中",
        "running" => "🔄 議論中",
        "completed" => "✅ 完了",
        "cancelled" => "⛔ キャンセル",
        "error" => "❌ エラー",
        _ => status ?? ""
    };
}
