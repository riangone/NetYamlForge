{
  "AI": {
    "ProjectName": "default",
    "ContentRootPath": "",
    "ProjectsRootPath": "projects",
    "SkillsRootPath": "skills"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ai-chat.db"
  },
  "Database": {
    "ConnectionString": "Data Source=ai-chat.db"
  },
  "AICli": {
    "DefaultTool": "qwen",
    "TaskTimeoutSeconds": 1800,
    "MaxConcurrentTasks": 2,
    "DefaultAllowedTools": ["Read", "Write", "Edit", "Bash", "Git"],
    "ProcessPool": {
      "EnableDaemonMode": true,
      "MaxPoolSize": 3,
      "IdleTimeoutMinutes": 10,
      "HealthCheckIntervalSeconds": 30,
      "MaxStartRetries": 3,
      "CooldownSeconds": 2,
      "MaxLifetimeMinutes": 60,
      "MaxRequestsPerProcess": 100,
      "EnablePersistentSessions": true
    },
    "Claude": {
      "Path": "claude"
    },
    "QwenCode": {
      "Path": "qwen"
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "qwen2.5-coder:7b",
      "UseApi": true,
      "ContextSize": 4096,
      "Temperature": 0.7
    },
    "LmStudio": {
      "BaseUrl": "http://localhost:1234",
      "Model": "qwen2.5-coder-7b-instruct",
      "ContextSize": 4096,
      "Temperature": 0.7
    }
  },
  "AiWindow": {
    "CliFirst": true,
    "ProviderPriority": ["qwen", "claude"],
    "Llm": {
      "Enabled": true,
      "Provider": "qwen",
      "Model": "qwen2.5-coder:7b",
      "Temperature": 0.7,
      "MaxTokens": 1000,
      "TimeoutSeconds": 3600
    },
    "Intent": {
      "RuleBasedEnabled": true,
      "LlmEnabled": true,
      "ConfidenceThreshold": 0.6
    },
    "Handover": {
      "AutoEnabled": true,
      "ConfidenceThreshold": 0.6,
      "NegativeSentimentThreshold": -0.5,
      "VipAutoHandover": true
    }
  },
  "ChatHistory": {
    "DbPath": "Data Source=chat-history.db"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": ["Console", "File"]
  },
  "AllowedHosts": "*",

  "Auth": {
    "Users": [
      {
        "Username": "admin",
        "Password": "Admin@123",
        "DisplayName": "管理者",
        "Roles": ["Admin", "User"]
      }
    ]
  },

  "Urls": "http://localhost:5005"
}
