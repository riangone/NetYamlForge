# ─────────────────────────────────────────────────────────
# NetYamlForge — Environment Configuration
#
# Copy this file to .env and adjust as needed.
#   cp .env.example .env
#
# The default configuration uses SQLite (no external database).
# For other databases, see DOCKER.md.
# ─────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
TZ=Asia/Tokyo

# ── Database (SQLite — default) ───────────────────────────
# Leave these empty to use SQLite databases (auto-initialised from seeds).
NYFORGE_TODO_APP_DB_TYPE=sqlite
NYFORGE_TODO_APP_CONNECTION_STRING=

NYFORGE_UI_SHOWCASE_DB_TYPE=sqlite
NYFORGE_UI_SHOWCASE_CONNECTION_STRING=

# ── PostgreSQL (used when --profile postgres) ─────────────
POSTGRES_DB=todo_app
POSTGRES_USER=nyforge
POSTGRES_PASSWORD=nyforge_pass

# ── MySQL (used when --profile mysql) ─────────────────────
MYSQL_DATABASE=todo_app
MYSQL_USER=nyforge
MYSQL_PASSWORD=nyforge_pass
MYSQL_ROOT_PASSWORD=root_pass

# ── SQL Server (used when --profile sqlserver) ────────────
MSSQL_DB=todo_app
MSSQL_USER=nyforge
MSSQL_PASSWORD=Nyforge@123
MSSQL_SA_PASSWORD=Sa@Nyforge123
