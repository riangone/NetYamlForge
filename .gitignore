# Build output
bin/
obj/

# User-specific files
*.user
*.suo
.vs/

# Rider
.idea/

# VS Code
.vscode/

# Logs
logs/
*.log

# NuGet
*.nupkg
packages/

# Runtime data (SQLite databases are rebuilt by the framework on startup;
# schema comes from YAML entity configs + init.sql, demo data from seed scripts)
*.db
*.db-shm
*.db-wal
*.db.backup

# App runtime files
*.pid
reports/
projects/*/jobs/output/

# Runtime variable data directory (data, run, log)
var/

# OS
.DS_Store
Thumbs.db

# Claude memory
memory/

# Claude Code internal snapshot
.shadow-git/

# ai-doc-processor: exclude uploaded files
NetYamlForge/wwwroot/uploads/ai-doc-processor/
NetYamlForge/wwwroot/watch-docs/
NetYamlForge/projects/*/jobs/output/
NetYamlForge/cache/
cache/
NetYamlForge/extract_tables.py
tests/node_modules/
tests/test-results/
