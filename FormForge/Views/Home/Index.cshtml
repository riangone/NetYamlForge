@model List<FormForge.Models.Form>
@{
    ViewData["Title"] = "FormForge — My Forms";
    ViewData["BodyClass"] = "dashboard-page";
}

<div class="dashboard">
    <header class="dash-header">
        <div class="dash-brand">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="28" height="28" rx="8" fill="#7C3AED"/>
                <path d="M7 9h14M7 14h10M7 19h8" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span>FormForge</span>
        </div>
        <div class="dash-header-right">
            <span class="dash-subtitle">Create and manage forms</span>
        </div>
    </header>

    <main class="dash-main">
        <div class="dash-top">
            <h1 class="dash-title">My Forms</h1>
            <form method="post" asp-action="Create" asp-controller="Home">
                <button type="submit" class="btn-create">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                    New Form
                </button>
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
                        <rect x="8" y="8" width="48" height="48" rx="12" fill="#EDE9FE"/>
                        <path d="M20 24h24M20 32h16M20 40h20" stroke="#7C3AED" stroke-width="3" stroke-linecap="round"/>
                    </svg>
                </div>
                <h2>No forms yet</h2>
                <p>Create your first form to start collecting responses.</p>
                <form method="post" asp-action="Create" asp-controller="Home">
                    <button type="submit" class="btn-create">Create a form</button>
                </form>
            </div>
        }
        else
        {
            <div class="forms-grid">
                @foreach (var form in Model)
                {
                    <div class="form-card" style="--card-color: @form.ThemeColor">
                        <div class="form-card-banner"></div>
                        <div class="form-card-body">
                            <h3 class="form-card-title">@form.Title</h3>
                            @if (!string.IsNullOrEmpty(form.Description))
                            {
                                <p class="form-card-desc">@form.Description</p>
                            }
                            <div class="form-card-meta">
                                <span class="badge @(form.IsPublished ? "badge-live" : "badge-draft")">
                                    @(form.IsPublished ? "Live" : "Draft")
                                </span>
                                <span class="meta-responses">@form.ResponseCount responses</span>
                            </div>
                        </div>
                        <div class="form-card-footer">
                            <a href="/Forms/Builder/@form.Id" class="card-action">Edit</a>
                            <a href="/Forms/Results/@form.Id" class="card-action">Results</a>
                            @if (form.IsPublished)
                            {
                                <a href="/f/@form.Id" target="_blank" class="card-action card-action-primary">Open ↗</a>
                            }
                            <form method="post" asp-action="Delete" asp-controller="Home" style="margin-left:auto">
                                <input type="hidden" name="id" value="@form.Id" />
                                <button type="submit" class="card-action card-action-danger"
                                        onclick="return confirm('Delete this form and all responses?')">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </main>
</div>
